<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.ForecastWidget">
        <div class="o_forecast_widget" t-att-class="state.loading ? 'opacity-50 pe-none' : ''">

            <!-- Filtros superiores -->
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted">Desde</label>
                    <input type="month" class="form-control form-control-sm"
                           style="max-width:150px;"
                           t-att-value="state.periodFrom"
                           t-on-change="onPeriodFromChange"/>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted">Hasta</label>
                    <input type="month" class="form-control form-control-sm"
                           style="max-width:150px;"
                           t-att-value="state.periodTo"
                           t-on-change="onPeriodToChange"/>
                </div>
                <div t-if="state.warehouses.length" class="d-flex align-items-center gap-1" t-on-click.stop="">
                    <label class="form-label mb-0 small text-muted">Depósito</label>
                    <div class="position-relative">
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                style="min-width:160px;"
                                t-on-click="toggleWhDropdown">
                            <span class="text-truncate" style="max-width:130px;"><t t-esc="selectedWhLabel"/></span>
                            <i t-att-class="'fa ms-auto ' + (state.whDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/>
                        </button>
                        <div t-if="state.whDropdownOpen"
                             class="dropdown-menu show shadow p-2"
                             style="min-width:200px; position:absolute; z-index:1050; top:100%; left:0; margin-top:2px;">
                            <input type="text" class="form-control form-control-sm mb-2"
                                   placeholder="Buscar depósito…"
                                   t-model="state.whSearch"
                                   autocomplete="off"/>
                            <div class="form-check mb-1">
                                <input type="checkbox" class="form-check-input" id="wh_filter_all"
                                       t-att-checked="!state.warehouseIds.length"
                                       t-on-change="clearWhFilter"/>
                                <label class="form-check-label fw-semibold small" for="wh_filter_all">Todos</label>
                            </div>
                            <div class="dropdown-divider my-1"/>
                            <t t-foreach="filteredWarehouses" t-as="wh" t-key="wh.id">
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'wh_filter_' + wh.id"
                                           t-att-data-wh-id="wh.id"
                                           t-att-checked="state.warehouseIds.includes(wh.id)"
                                           t-on-change="toggleWarehouse"/>
                                    <label class="form-check-label small" t-att-for="'wh_filter_' + wh.id">
                                        <t t-esc="wh.name"/>
                                    </label>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="input-group input-group-sm" style="max-width:220px;">
                    <span class="input-group-text"><i class="fa fa-search"/></span>
                    <input type="text" class="form-control"
                           placeholder="Buscar artículo…"
                           t-model="state.productSearch"
                           autocomplete="off"/>
                </div>
                <div class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="openForecastList">
                        <i class="fa fa-list me-1"/> Ver líneas
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="downloadExport">
                        <i class="fa fa-download me-1"/> Exportar
                    </button>
                    <button t-if="state.canEdit"
                            class="btn btn-sm btn-primary" t-on-click="openImport">
                        <i class="fa fa-upload me-1"/> Importar
                    </button>
                </div>
            </div>

            <!-- Sin datos -->
            <div t-if="!state.data" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"/>
                Cargando…
            </div>

            <t t-if="state.data">

                <!-- KPI cards -->
                <div class="row g-2 mb-4">
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card o_planner_card h-100">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-bar-chart fa-lg text-primary mb-2 d-block"/>
                                <div class="o_planner_number"><t t-esc="fmt(state.data.kpis.total_forecast)"/></div>
                                <div class="o_planner_label">Demanda forecast</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card o_planner_card h-100">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-industry fa-lg text-secondary mb-2 d-block"/>
                                <div class="o_planner_number"><t t-esc="fmt(state.data.kpis.total_mos)"/></div>
                                <div class="o_planner_label">Producción planificada</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div t-att-class="'card o_planner_card h-100' + (state.data.kpis.gap >= 0 ? '' : ' o_planner_card_danger')">
                            <div class="card-body text-center py-3">
                                <i t-att-class="'fa fa-lg mb-2 d-block ' + (state.data.kpis.gap >= 0 ? 'fa-check-circle text-success' : 'fa-exclamation-triangle text-danger')"/>
                                <div t-att-class="'o_planner_number ' + (state.data.kpis.gap >= 0 ? 'text-success' : 'text-danger')">
                                    <t t-esc="fmt(state.data.kpis.gap)"/>
                                </div>
                                <div class="o_planner_label">Brecha</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div t-att-class="'card o_planner_card h-100' + (state.data.kpis.coverage_pct >= 100 ? ' o_planner_card_success' : state.data.kpis.coverage_pct >= state.data.warning_pct ? '' : ' o_planner_card_danger')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-pie-chart fa-lg mb-2 d-block text-secondary"/>
                                <div t-att-class="'o_planner_number ' + (state.data.kpis.coverage_pct >= 100 ? 'text-success' : state.data.kpis.coverage_pct >= state.data.warning_pct ? 'text-warning' : 'text-danger')">
                                    <t t-esc="fmtPct(state.data.kpis.coverage_pct)"/>
                                </div>
                                <div class="o_planner_label">Cobertura</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div t-att-class="'card o_planner_card h-100' + (state.data.kpis.at_risk > 0 ? ' o_planner_card_danger' : ' o_planner_card_success')">
                            <div class="card-body text-center py-3">
                                <i t-att-class="'fa fa-lg mb-2 d-block ' + (state.data.kpis.at_risk > 0 ? 'fa-exclamation-circle text-danger' : 'fa-check-circle text-success')"/>
                                <div t-att-class="'o_planner_number ' + (state.data.kpis.at_risk > 0 ? 'text-danger' : 'text-success')">
                                    <t t-esc="state.data.kpis.at_risk"/>
                                </div>
                                <div class="o_planner_label">Artículos en riesgo</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-xl-2">
                        <div class="card o_planner_card h-100">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-cubes fa-lg text-secondary mb-2 d-block"/>
                                <div class="o_planner_number"><t t-esc="state.data.kpis.total_products"/></div>
                                <div class="o_planner_label">Artículos con forecast</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sin datos de forecast -->
                <div t-if="filteredRows.length === 0"
                     class="text-center text-muted py-4 border rounded">
                    <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                    <t t-if="state.productSearch">
                        No hay artículos que coincidan con "<t t-esc="state.productSearch"/>".
                    </t>
                    <t t-else="">
                        No hay líneas de forecast para el período seleccionado.
                        <div class="mt-2">
                            <button t-if="state.canEdit" class="btn btn-sm btn-primary"
                                    t-on-click="openImport">
                                Importar
                            </button>
                        </div>
                    </t>
                </div>

                <!-- Tabla pivotada -->
                <t t-if="filteredRows.length > 0">
                    <div class="border rounded" style="overflow:auto; max-height:520px;">
                        <table class="table table-sm table-bordered small mb-0" style="min-width:600px;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th rowspan="2" class="align-middle" style="min-width:180px;">Artículo</th>
                                    <t t-foreach="state.data.months" t-as="m" t-key="m">
                                        <th colspan="2" class="text-center text-nowrap">
                                            <t t-esc="monthLabels[m_index]"/>
                                        </th>
                                    </t>
                                    <th colspan="2" class="text-center text-nowrap fw-bold">Total</th>
                                </tr>
                                <tr>
                                    <t t-foreach="state.data.months" t-as="m" t-key="'h_' + m">
                                        <th class="text-end text-muted small" style="min-width:70px;">Forecast</th>
                                        <th class="text-end text-muted small" style="min-width:70px;">OFs</th>
                                    </t>
                                    <th class="text-end text-muted small fw-bold">Forecast</th>
                                    <th class="text-end text-muted small fw-bold">OFs</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="filteredRows" t-as="row" t-key="row.product_id">
                                    <tr>
                                        <td class="fw-semibold text-truncate" style="max-width:180px;"
                                            t-att-title="row.product">
                                            <t t-esc="row.product"/>
                                        </td>
                                        <t t-foreach="row.cells" t-as="cell" t-key="cell.month">
                                            <td class="text-end" t-att-class="cell.forecast > 0 ? 'forecast-cell ' + cellClass(cell) : 'text-muted'">
                                                <t t-if="cell.forecast > 0">
                                                    <span><t t-esc="fmt(cell.forecast)"/></span>
                                                </t>
                                                <span t-else="" class="text-muted">—</span>
                                            </td>
                                            <td class="text-end" t-att-class="cell.forecast > 0 ? 'forecast-cell ' + cellClass(cell) : 'text-muted'">
                                                <t t-if="cell.forecast > 0">
                                                    <span><t t-esc="fmt(cell.mos)"/></span>
                                                    <br/>
                                                    <small t-att-class="cellClass(cell) === 'forecast-ok' ? 'text-success' : cellClass(cell) === 'forecast-warning' ? 'text-warning' : 'text-danger'">
                                                        <t t-esc="fmtPct(cell.pct)"/>
                                                    </small>
                                                </t>
                                                <span t-else="" class="text-muted">—</span>
                                            </td>
                                        </t>
                                        <!-- Totales por artículo -->
                                        <td class="text-end fw-semibold"><t t-esc="fmt(row.total_forecast)"/></td>
                                        <td t-att-class="'text-end fw-semibold ' + cellClass({forecast: row.total_forecast, pct: row.total_pct})">
                                            <t t-esc="fmt(row.total_mos)"/>
                                            <br/>
                                            <small><t t-esc="fmtPct(row.total_pct)"/></small>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <!-- Fila totales globales -->
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td>Total</td>
                                    <t t-foreach="state.data.month_totals" t-as="mt" t-key="'mt_' + mt_index">
                                        <td class="text-end"><t t-esc="fmt(mt.forecast)"/></td>
                                        <td class="text-end"><t t-esc="fmt(mt.mos)"/></td>
                                    </t>
                                    <td class="text-end"><t t-esc="fmt(state.data.kpis.total_forecast)"/></td>
                                    <td class="text-end"><t t-esc="fmt(state.data.kpis.total_mos)"/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Leyenda -->
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <small class="text-muted">Cobertura:</small>
                        <span class="badge forecast-ok text-dark">≥ 100%</span>
                        <span class="badge forecast-warning text-dark">≥ <t t-esc="state.data.warning_pct"/>%</span>
                        <span class="badge forecast-critical text-white">&lt; <t t-esc="state.data.warning_pct"/>%</span>
                    </div>
                </t>

            </t>
        </div>
    </t>

</templates>
