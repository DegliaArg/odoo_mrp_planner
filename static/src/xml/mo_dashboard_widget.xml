<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_reschedule.MoDashboardWidget">
        <div class="o_mo_dashboard_widget">

            <!-- Pestañas principales -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'ofs' ? ' active' : '')"
                            t-on-click="() => this.setTab('ofs')">
                        <i class="fa fa-industry me-1"/>OFs
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'requests' ? ' active' : '')"
                            t-on-click="() => this.setTab('requests')">
                        <i class="fa fa-calendar me-1"/>Programaciones
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'comparison' ? ' active' : '')"
                            t-on-click="() => this.setTab('comparison')">
                        <i class="fa fa-bar-chart me-1"/>Producido vs Programado
                    </button>
                </li>
            </ul>

            <!-- Filtros (fecha + sector), ocultos en pestaña Programaciones -->
            <div t-if="showFilters" class="row g-2 mb-3">
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Desde</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                </div>
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Hasta</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>
                <div class="col-auto" t-if="state.tags.length > 0">
                    <label class="col-form-label col-form-label-sm me-1">Sector</label>
                    <select class="form-select form-select-sm d-inline-block"
                            style="width:auto"
                            t-on-change="onTagChange">
                        <option value="">Todos</option>
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <option t-att-value="tag.id"
                                    t-att-selected="state.selectedTag == tag.id"
                                    t-esc="tag.name"/>
                        </t>
                    </select>
                </div>
            </div>

            <!-- Contenido con dimming durante carga -->
            <div t-att-class="'row g-3' + (state.loading ? ' opacity-50 pe-none' : '')">

                <!-- ══ TAB: OFs ════════════════════════════════════════════════ -->
                <t t-if="state.tab === 'ofs'">

                    <!-- KPIs -->
                    <div class="col-12 col-lg-4 o_kpi_height_src">
                        <div class="row g-2">

                            <div class="col-6">
                                <div class="card o_planner_card h-100"
                                     style="cursor:pointer" t-on-click="onClickTotal"
                                     t-att-data-kpi-tip="'OFs confirmadas o en progreso no\ncanceladas con fecha de fin en\nel período seleccionado.\nEstados: Confirmada · En progreso · Por cerrar'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                        <div class="o_planner_number" t-esc="fmt(state.ofs_kpis.total)"/>
                                        <div class="o_planner_label">Activas</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_info h-100"
                                     style="cursor:pointer" t-on-click="onClickInProgress"
                                     t-att-data-kpi-tip="'OFs cuya producción ya fue\niniciada formalmente en el sistema.\nEstados: En progreso · Por cerrar'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-cog fa-lg text-info mb-2 d-block"/>
                                        <div class="o_planner_number text-info" t-esc="fmt(state.ofs_kpis.in_progress)"/>
                                        <div class="o_planner_label">En progreso</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_danger h-100"
                                     style="cursor:pointer" t-on-click="onClickDelayed"
                                     t-att-data-kpi-tip="'OFs activas cuya fecha de fin\nplanificada ya superó la fecha actual.\nCondición: fecha_fin &lt; hoy\nY estado distinto de completada'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-warning fa-lg text-danger mb-2 d-block"/>
                                        <div class="o_planner_number text-danger" t-esc="fmt(state.ofs_kpis.delayed)"/>
                                        <div class="o_planner_label">Atrasadas</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_warning h-100"
                                     style="cursor:pointer" t-on-click="onClickReschedule"
                                     t-att-data-kpi-tip="'OFs marcadas manualmente como\nnecesitan reprogramación.\nCampo: Requiere reprogramación = Sí'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-refresh fa-lg text-warning mb-2 d-block"/>
                                        <div class="o_planner_number text-warning" t-esc="fmt(state.ofs_kpis.reschedule)"/>
                                        <div class="o_planner_label">Para reprogramar</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_success h-100"
                                     style="cursor:pointer" t-on-click="onClickDone"
                                     t-att-data-kpi-tip="'OFs cerradas formalmente\ndurante el período seleccionado.\nEstado: Completada\nFecha fin dentro del rango'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                        <div class="o_planner_number text-success" t-esc="fmt(state.ofs_kpis.done)"/>
                                        <div class="o_planner_label">Finalizadas</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card h-100"
                                     style="cursor:pointer" t-on-click="onClickPartial"
                                     t-att-data-kpi-tip="'OFs con producción terminada\npendientes de cierre formal.\nEstado: Por cerrar (to_close)\nProducción completa, sin registrar'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-hourglass-half fa-lg text-secondary mb-2 d-block"/>
                                        <div class="o_planner_number text-secondary" t-esc="fmt(state.ofs_kpis.partial)"/>
                                        <div class="o_planner_label">Por cerrar</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Lista de OFs -->
                    <div class="col-12 col-lg-8">
                        <div t-if="state.mos.length === 0"
                             class="d-flex align-items-center justify-content-center border rounded o_table_scroll"
                             style="height:330px;">
                            <div class="text-center small text-muted">
                                <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                                Sin órdenes en el período.
                            </div>
                        </div>
                        <div t-else=""
                             class="border rounded d-flex flex-column o_table_scroll"
                             style="overflow:hidden; height:330px;">
                            <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                <colgroup>
                                    <col style="width:18%"/><col style="width:32%"/>
                                    <col style="width:20%"/><col style="width:15%"/><col style="width:15%"/>
                                </colgroup>
                                <thead>
                                    <tr class="text-muted o_sortable_header">
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('product')">Producto <i t-att-class="sortIcon('product')"/></th>
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('date_finished')">Fin planificado <i t-att-class="sortIcon('date_finished')"/></th>
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('state')">Estado <i t-att-class="sortIcon('state')"/></th>
                                        <th class="text-end" style="cursor:pointer" title="Entregas pendientes del producto" t-on-click="() => this.sortBy('pending_delivery')">Entregas <i t-att-class="sortIcon('pending_delivery')"/></th>
                                    </tr>
                                </thead>
                            </table>
                            <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                    <colgroup>
                                        <col style="width:18%"/><col style="width:32%"/>
                                        <col style="width:20%"/><col style="width:15%"/><col style="width:15%"/>
                                    </colgroup>
                                    <tbody>
                                        <t t-foreach="sortedMos" t-as="mo" t-key="mo.id">
                                            <tr style="cursor:pointer" t-on-click="openMoFromRow"
                                                t-att-data-mo-id="mo.id"
                                                t-att-class="mo.delayed ? 'table-danger' : ''">
                                                <td class="fw-semibold" t-esc="mo.name"/>
                                                <td t-esc="mo.product"/>
                                                <td t-esc="mo.date_finished"/>
                                                <td>
                                                    <span t-att-class="stateClass(mo.state)"
                                                          t-esc="stateLabel(mo.state)"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-if="mo.pending_delivery > 0"
                                                          class="text-warning fw-semibold"
                                                          t-esc="fmt(mo.pending_delivery)"/>
                                                    <span t-else="" class="text-muted">—</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Paginación -->
                            <div t-if="totalPages > 1"
                                 class="d-flex align-items-center justify-content-between px-2 py-1 border-top"
                                 style="flex-shrink:0;">
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasPrevPage"
                                        t-on-click="prevPage">
                                    <i class="fa fa-chevron-left"/>
                                </button>
                                <small class="text-muted">Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/> · <t t-esc="fmt(activeCount)"/> registros</small>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasNextPage"
                                        t-on-click="nextPage">
                                    <i class="fa fa-chevron-right"/>
                                </button>
                            </div>
                        </div>
                    </div>

                </t>

                <!-- ══ TAB: Programaciones ════════════════════════════════════ -->
                <t t-elif="state.tab === 'requests'">

                    <!-- KPIs -->
                    <div class="col-12 col-lg-4 o_kpi_height_src">
                        <div class="row g-2">

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_success h-100"
                                     style="cursor:pointer" t-on-click="onClickReqActive"
                                     t-att-data-kpi-tip="'Programaciones activas con OFs\nconfirmadas generadas.\nEstado de la programación: Confirmada'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                        <div class="o_planner_number text-success" t-esc="fmt(state.req_kpis.active)"/>
                                        <div class="o_planner_label">OFs creadas</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_info h-100"
                                     style="cursor:pointer" t-on-click="onClickReqCalc"
                                     t-att-data-kpi-tip="'Programaciones que pasaron por\nel proceso de cálculo de carga\ny capacidad de los centros de trabajo.\nEstado: Calculada'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-calculator fa-lg text-info mb-2 d-block"/>
                                        <div class="o_planner_number text-info" t-esc="fmt(state.req_kpis.calculated)"/>
                                        <div class="o_planner_label">Calculadas</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_warning h-100"
                                     style="cursor:pointer" t-on-click="onClickReqReschedule"
                                     t-att-data-kpi-tip="'Programaciones que tienen al menos\nuna OF marcada como requiere\nreprogramación.\nCampo: x_reschedule_needed = Sí'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-random fa-lg text-warning mb-2 d-block"/>
                                        <div class="o_planner_number text-warning" t-esc="fmt(state.req_kpis.reschedule)"/>
                                        <div class="o_planner_label">Con reprogramación</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_danger h-100"
                                     t-att-data-kpi-tip="'Total de OFs atrasadas asociadas\na las programaciones activas.\nCondición: fecha_fin &lt; hoy\nY estado activo'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-clock-o fa-lg text-danger mb-2 d-block"/>
                                        <div class="o_planner_number text-danger" t-esc="fmt(state.req_kpis.mos_delayed)"/>
                                        <div class="o_planner_label">OFs atrasadas</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Lista de programaciones -->
                    <div class="col-12 col-lg-8">
                        <div t-if="state.requests.length === 0"
                             class="d-flex align-items-center justify-content-center border rounded o_table_scroll"
                             style="height:260px;">
                            <div class="text-center small text-muted">
                                <i class="fa fa-calendar-check-o fa-2x mb-2 d-block text-muted"/>
                                Sin programaciones activas.
                            </div>
                        </div>
                        <div t-else=""
                             class="border rounded d-flex flex-column o_table_scroll"
                             style="overflow:hidden; height:260px;">
                            <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                <colgroup>
                                    <col style="width:45%"/><col style="width:35%"/><col style="width:20%"/>
                                </colgroup>
                                <thead>
                                    <tr class="text-muted o_sortable_header">
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('start_from')">Disponible desde <i t-att-class="sortIcon('start_from')"/></th>
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('state')">Estado <i t-att-class="sortIcon('state')"/></th>
                                    </tr>
                                </thead>
                            </table>
                            <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                    <colgroup>
                                        <col style="width:45%"/><col style="width:35%"/><col style="width:20%"/>
                                    </colgroup>
                                    <tbody>
                                        <t t-foreach="sortedRequests" t-as="req" t-key="req.id">
                                            <tr style="cursor:pointer" t-on-click="openRequestFromRow"
                                                t-att-data-req-id="req.id">
                                                <td class="fw-semibold" t-esc="req.name"/>
                                                <td t-esc="req.start_from"/>
                                                <td>
                                                    <span t-att-class="reqStateClass(req.state)"
                                                          t-esc="reqStateLabel(req.state)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <!-- Paginación -->
                            <div t-if="totalPages > 1"
                                 class="d-flex align-items-center justify-content-between px-2 py-1 border-top"
                                 style="flex-shrink:0;">
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasPrevPage"
                                        t-on-click="prevPage">
                                    <i class="fa fa-chevron-left"/>
                                </button>
                                <small class="text-muted">Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/> · <t t-esc="fmt(activeCount)"/> registros</small>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasNextPage"
                                        t-on-click="nextPage">
                                    <i class="fa fa-chevron-right"/>
                                </button>
                            </div>
                        </div>
                    </div>

                </t>

                <!-- ══ TAB: Producido vs Programado ══════════════════════════ -->
                <t t-else="">

                    <!-- KPIs -->
                    <div class="col-12 col-lg-4 o_kpi_height_src">
                        <div class="row g-2">

                            <div class="col-6">
                                <div class="card o_planner_card h-100"
                                     t-att-data-kpi-tip="'Total de unidades planificadas\nen las OFs del período seleccionado.\nFuente: product_qty de OFs\nen el rango de fechas'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-cubes fa-lg text-secondary mb-2 d-block"/>
                                        <div class="o_planner_number" t-esc="fmt(state.cmp_kpis.planned)"/>
                                        <div class="o_planner_label">Programado</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_success h-100"
                                     t-att-data-kpi-tip="'Total de unidades efectivamente\nproducidas y registradas\nen las OFs completadas del período.\nFuente: qty_produced de OFs done'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-check-square fa-lg text-success mb-2 d-block"/>
                                        <div class="o_planner_number text-success" t-esc="fmt(state.cmp_kpis.produced)"/>
                                        <div class="o_planner_label">Producido</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card h-100"
                                     t-att-data-kpi-tip="'Porcentaje de producción ejecutada\nsobre la producción planificada.\nVerde &gt;=90%  Amarillo &gt;=50%  Rojo &lt;50%\nFórmula: Producido ÷ Programado × 100'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-pie-chart fa-lg text-secondary mb-2 d-block"/>
                                        <div t-att-class="'o_planner_number ' + pctClass(state.cmp_kpis.pct)"
                                             t-esc="state.cmp_kpis.pct + '%'"/>
                                        <div class="o_planner_label">Cumplimiento</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="card o_planner_card o_planner_card_info h-100"
                                     t-att-data-kpi-tip="'Cantidad de OFs formalmente\nfinalizadas dentro del período\nseleccionado.\nEstado: Completada (done)'">
                                    <div class="card-body text-center py-3">
                                        <i class="fa fa-flag-checkered fa-lg text-info mb-2 d-block"/>
                                        <div class="o_planner_number text-info" t-esc="fmt(state.cmp_kpis.ofs_done)"/>
                                        <div class="o_planner_label">OFs completadas</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Tabla comparativa -->
                    <div class="col-12 col-lg-8">
                        <div t-if="state.comparison.length === 0"
                             class="d-flex align-items-center justify-content-center border rounded o_table_scroll"
                             style="height:260px;">
                            <div class="text-center small text-muted">
                                <i class="fa fa-bar-chart fa-2x mb-2 d-block text-muted"/>
                                Sin datos en el período.
                            </div>
                        </div>
                        <div t-else=""
                             class="border rounded d-flex flex-column o_table_scroll"
                             style="overflow:hidden; height:260px;">
                            <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                <colgroup>
                                    <col style="width:46%"/><col style="width:18%"/>
                                    <col style="width:18%"/><col style="width:18%"/>
                                </colgroup>
                                <thead>
                                    <tr class="text-muted o_sortable_header">
                                        <th style="cursor:pointer" t-on-click="() => this.sortBy('product')">Producto <i t-att-class="sortIcon('product')"/></th>
                                        <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('planned_qty')">Programado <i t-att-class="sortIcon('planned_qty')"/></th>
                                        <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('produced_qty')">Producido <i t-att-class="sortIcon('produced_qty')"/></th>
                                        <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('pct')">% <i t-att-class="sortIcon('pct')"/></th>
                                    </tr>
                                </thead>
                            </table>
                            <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                    <colgroup>
                                        <col style="width:46%"/><col style="width:18%"/>
                                        <col style="width:18%"/><col style="width:18%"/>
                                    </colgroup>
                                    <tbody>
                                        <t t-foreach="sortedComparison" t-as="item" t-key="item.product_id">
                                            <tr>
                                                <td t-esc="item.product"/>
                                                <td class="text-end" t-esc="fmt(item.planned_qty)"/>
                                                <td class="text-end" t-esc="fmt(item.produced_qty)"/>
                                                <td class="text-end">
                                                    <span t-att-class="pctClass(item.pct)"
                                                          t-esc="item.pct + '%'"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </t>

            </div>

            <!-- Ver todas (fuera del kpiRow para no afectar la alineación) -->
            <div class="text-end mt-1">
                <button t-if="state.tab === 'ofs'"
                        class="btn btn-sm btn-link text-secondary p-0 small"
                        t-on-click="onClickTotal">Ver todas →</button>
                <button t-elif="state.tab === 'requests'"
                        class="btn btn-sm btn-link text-secondary p-0 small"
                        t-on-click="onClickAllRequests">Ver todas →</button>
            </div>
        </div>
    </t>

</templates>
