<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="odoo_mrp_planner.CustomerAnalysisWidget">
    <div t-att-class="state.loading ? 'opacity-50 pe-none' : ''"
         style="font-size:13px; min-height:500px;">

        <!-- ══ Main content ══════════════════════════════════════════════════ -->
        <div class="d-flex flex-column">

            <!-- ── Barra de filtros unificada ──────────────────────────────── -->
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

                <!-- Período -->
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted">Desde</label>
                    <input type="date" class="form-control form-control-sm" style="max-width:140px;"
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted">Hasta</label>
                    <input type="date" class="form-control form-control-sm" style="max-width:140px;"
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>

                <!-- Categoría de cliente -->
                <t t-if="availableCategories.length">
                    <div class="vr" style="height:22px;"/>
                    <div class="d-flex align-items-center gap-1">
                        <span class="small text-muted fw-semibold" style="white-space:nowrap;">Cat.:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-att-class="state.filterCategory === null ? 'btn btn-secondary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 7px;"
                                    t-on-click="() => this.setFilterCategory(null)">Todas</button>
                            <t t-foreach="availableCategories" t-as="cat" t-key="cat">
                                <button t-att-class="state.filterCategory === cat ? 'btn btn-secondary' : 'btn btn-outline-secondary'"
                                        style="font-size:11px; padding:1px 7px;"
                                        t-on-click="() => this.setFilterCategory(cat)">
                                    <t t-esc="cat"/>
                                </button>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- Segmento ABC -->
                <div class="vr" style="height:22px;"/>
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted fw-semibold">ABC:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-att-class="state.filterABC === null ? 'btn btn-secondary' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterABC(null)">Todos</button>
                        <button t-att-class="state.filterABC === 'A' ? 'btn btn-success' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterABC('A')">A</button>
                        <button t-att-class="state.filterABC === 'B' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterABC('B')">B</button>
                        <button t-att-class="state.filterABC === 'C' ? 'btn btn-warning' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterABC('C')">C</button>
                    </div>
                </div>

                <!-- Frecuencia -->
                <div class="vr" style="height:22px;"/>
                <div class="d-flex align-items-center gap-1">
                    <span class="small text-muted fw-semibold" style="white-space:nowrap;">Frec.:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-att-class="state.filterFreq === null ? 'btn btn-secondary' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterFreq(null)">Todos</button>
                        <button t-att-class="state.filterFreq === 'frecuente' ? 'btn btn-success' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterFreq('frecuente')">Frecuente</button>
                        <button t-att-class="state.filterFreq === 'ocasional' ? 'btn btn-warning' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterFreq('ocasional')">Ocasional</button>
                        <button t-att-class="state.filterFreq === 'en_riesgo' ? 'btn btn-danger' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterFreq('en_riesgo')">Riesgo</button>
                        <button t-att-class="state.filterFreq === 'inactivo' ? 'btn btn-dark' : 'btn btn-outline-secondary'"
                                style="font-size:11px; padding:1px 7px;"
                                t-on-click="() => this.setFilterFreq('inactivo')">Inactivo</button>
                    </div>
                </div>

            </div>

            <!-- ── Gráficos superiores ───────────────────────────────────────── -->
            <t t-if="!state.loading and state.allRows.length">

                <!-- Filtros de gráficos (misma estética que panel de ventas) -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">

                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="[['pxq','PxQ'],['pedidos','Pedidos'],['ticket','Ticket']]"
                           t-as="m" t-key="m[0]">
                            <button t-att-class="'btn ' + (state.chartMetric === m[0] ? 'btn-info' : 'btn-outline-secondary')"
                                    t-on-click="() => this.setChartMetric(m[0])">
                                <t t-esc="m[1]"/>
                            </button>
                        </t>
                    </div>

                    <div class="vr" style="height:22px;"/>

                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                            <button t-att-class="'btn ' + (state.chartTopN === n ? 'btn-secondary' : 'btn-outline-secondary')"
                                    t-on-click="() => this.setChartTopN(n)">
                                <t t-esc="'Top ' + n"/>
                            </button>
                        </t>
                        <button t-att-class="'btn ' + (state.chartTopN === null ? 'btn-secondary' : 'btn-outline-secondary')"
                                t-on-click="() => this.setChartTopN(null)">Todos</button>
                    </div>

                </div>

                <!-- Torta (flex:1 ≈ 30%) + Barras (flex:2 ≈ 70%) -->
                <div class="d-flex gap-3 align-items-start mb-4">

                    <div style="flex:1; min-width:0;">
                        <!-- Selector de vista del donut — local al gráfico -->
                        <div class="d-flex justify-content-center mb-1">
                            <div class="btn-group btn-group-sm" role="group">
                                <t t-foreach="[['abc','Segmento'],['cat','Categoría'],['freq','Frecuencia']]"
                                   t-as="d" t-key="d[0]">
                                    <button t-att-class="'btn ' + (state.chartDonut === d[0] ? 'btn-dark' : 'btn-outline-secondary')"
                                            style="font-size:10px; padding:1px 7px;"
                                            t-on-click="() => this.setChartDonut(d[0])">
                                        <t t-esc="d[1]"/>
                                    </button>
                                </t>
                            </div>
                        </div>
                        <div style="position:relative; height:300px;">
                            <canvas t-ref="topDonut"/>
                        </div>
                    </div>

                    <div style="flex:2; min-width:0; position:relative; height:320px;">
                        <canvas t-ref="topChart"/>
                    </div>

                </div>

            </t>

            <!-- ── Sección: Detalle de clientes ────────────────────────────── -->
            <div class="o_planner_section_title mb-3">
                <i class="fa fa-table me-2 text-muted"/>
                <span class="text-uppercase fw-bold text-muted small">Detalle de clientes</span>
            </div>
            <hr class="mt-0 mb-3"/>

            <!-- ── KPI cards globales ───────────────────────────────────────── -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md">
                        <div class="card o_planner_card h-100"
                             title="Clientes con al menos un pedido confirmado en el período.">
                            <div class="card-body text-center py-2 d-flex flex-column align-items-center">
                                <i class="fa fa-users fa-lg text-primary mb-1 d-block"/>
                                <div class="o_planner_number flex-grow-1 d-flex align-items-center"
                                     t-esc="fmt(state.kpis.total_customers)"/>
                                <div class="o_planner_label mb-1">Clientes activos</div>
                                <button class="btn btn-link btn-sm py-0 px-0"
                                        style="font-size:11px; line-height:1.2;"
                                        t-on-click="() => this.openKpiDrilldown('customers')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="card o_planner_card h-100"
                             title="Total de pedidos confirmados (sale + done) de todos los clientes en el período.">
                            <div class="card-body text-center py-2 d-flex flex-column align-items-center">
                                <i class="fa fa-shopping-cart fa-lg text-warning mb-1 d-block"/>
                                <div class="o_planner_number text-warning flex-grow-1 d-flex align-items-center"
                                     t-esc="fmt(state.kpis.total_orders)"/>
                                <div class="o_planner_label mb-1">Total pedidos</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="card o_planner_card h-100"
                             title="Monto neto promedio por pedido (monto total ÷ cantidad de pedidos).">
                            <div class="card-body text-center py-2 d-flex flex-column align-items-center">
                                <i class="fa fa-tag fa-lg text-success mb-1 d-block"/>
                                <div class="o_planner_number text-success flex-grow-1 d-flex align-items-center"
                                     style="white-space:nowrap;"
                                     t-esc="fmtMoney(state.kpis.avg_ticket)"/>
                                <div class="o_planner_label mb-1">Ticket promedio</div>
                                <button class="btn btn-link btn-sm py-0 px-0"
                                        style="font-size:11px; line-height:1.2;"
                                        t-on-click="() => this.openKpiDrilldown('ticket')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="card o_planner_card h-100"
                             title="Promedio de % entrega entre todos los clientes.">
                            <div class="card-body text-center py-2 d-flex flex-column align-items-center">
                                <i class="fa fa-truck fa-lg mb-1 d-block text-secondary"/>
                                <div t-att-class="'o_planner_number flex-grow-1 d-flex align-items-center ' + deliveryClass(state.kpis.avg_delivery_pct)"
                                     t-esc="fmtPct(state.kpis.avg_delivery_pct)"/>
                                <div class="o_planner_label mb-1">% Entrega promedio</div>
                                <button class="btn btn-link btn-sm py-0 px-0"
                                        style="font-size:11px; line-height:1.2;"
                                        t-on-click="() => this.openKpiDrilldown('delivery')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="card o_planner_card h-100"
                             title="Promedio de % entregas a tiempo. El criterio se configura en Ajustes.">
                            <div class="card-body text-center py-2 d-flex flex-column align-items-center">
                                <i class="fa fa-clock-o fa-lg mb-1 d-block text-secondary"/>
                                <div t-att-class="'o_planner_number flex-grow-1 d-flex align-items-center ' + ontimeClass(state.kpis.avg_ontime_pct)"
                                     t-esc="fmtPct(state.kpis.avg_ontime_pct)"/>
                                <div class="o_planner_label mb-1">% A tiempo promedio</div>
                                <button class="btn btn-link btn-sm py-0 px-0"
                                        style="font-size:11px; line-height:1.2;"
                                        t-on-click="() => this.openKpiDrilldown('ontime')">Ver →</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Controles -->
                <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

                    <PlannerSearchBar
                        widgetKey="'customer_analysis'"
                        placeholder="'Buscar cliente, producto, familia…'"
                        t-props="{
                            search:          state.productSearch,
                            activeGroupBy:   state.groupBy,
                            groupByDefs:     groupByDefs,
                            onSearch:        (t) => this.setSearch(t),
                            onGroupByChange: (k) => this.setGroupBy(k)
                        }"/>

                    <div class="position-relative" t-on-click.stop="">
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                t-on-click="toggleColsDropdown">
                            <i class="fa fa-columns"/>
                            <span>Columnas</span>
                            <i t-att-class="'fa ' + (state.colsDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/>
                        </button>
                        <div t-if="state.colsDropdownOpen"
                             class="dropdown-menu show shadow p-2"
                             style="min-width:220px; position:absolute; z-index:1050; top:100%; left:0; margin-top:2px;">
                            <p class="small text-muted mb-1 px-1">Cliente</p>
                            <t t-foreach="[
                                ['customer_category', 'Cat. global (A–E del contacto)'],
                                ['abc_segment',       'ABC período (ranking dinámico)'],
                                ['salesperson',       'Vendedor'],
                                ['country',           'País'],
                                ['province',          'Provincia'],
                            ]" t-as="col" t-key="col[0]">
                                <div t-if="col[0] !== 'customer_category' or state.config.show_category"
                                     class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'ca_col_' + col[0]"
                                           t-att-checked="state.visibleCols[col[0]]"
                                           t-on-change="() => this.toggleCol(col[0])"/>
                                    <label class="form-check-label small" t-att-for="'ca_col_' + col[0]">
                                        <t t-esc="col[1]"/>
                                    </label>
                                </div>
                            </t>
                            <div class="dropdown-divider my-1"/>
                            <p class="small text-muted mb-1 px-1">Compras</p>
                            <t t-foreach="[
                                ['order_count',  'Pedidos'],
                                ['total_amount', 'Monto total'],
                                ['avg_ticket',   'Ticket promedio'],
                                ['trend_pct',    'Tendencia vs período anterior'],
                            ]" t-as="col" t-key="col[0]">
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'ca_col_' + col[0]"
                                           t-att-checked="state.visibleCols[col[0]]"
                                           t-on-change="() => this.toggleCol(col[0])"/>
                                    <label class="form-check-label small" t-att-for="'ca_col_' + col[0]">
                                        <t t-esc="col[1]"/>
                                    </label>
                                </div>
                            </t>
                            <div class="dropdown-divider my-1"/>
                            <p class="small text-muted mb-1 px-1">Entrega</p>
                            <t t-foreach="[
                                ['delivery_pct', '% Entrega'],
                                ['ontime_pct',   '% A tiempo'],
                            ]" t-as="col" t-key="col[0]">
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'ca_col_' + col[0]"
                                           t-att-checked="state.visibleCols[col[0]]"
                                           t-on-change="() => this.toggleCol(col[0])"/>
                                    <label class="form-check-label small" t-att-for="'ca_col_' + col[0]">
                                        <t t-esc="col[1]"/>
                                    </label>
                                </div>
                            </t>
                            <div class="dropdown-divider my-1"/>
                            <p class="small text-muted mb-1 px-1">Frecuencia y productos</p>
                            <t t-foreach="[
                                ['avg_days_between',  'Frecuencia (días entre pedidos)'],
                                ['days_since_last',   'Días sin comprar'],
                                ['last_order_date',   'Última compra'],
                                ['frequency_segment', 'Segmento de frecuencia'],
                                ['distinct_products', 'Productos distintos'],
                                ['top_product',       'Top producto'],
                                ['top_family',        'Familia principal'],
                            ]" t-as="col" t-key="col[0]">
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'ca_col_' + col[0]"
                                           t-att-checked="state.visibleCols[col[0]]"
                                           t-on-change="() => this.toggleCol(col[0])"/>
                                    <label class="form-check-label small" t-att-for="'ca_col_' + col[0]">
                                        <t t-esc="col[1]"/>
                                    </label>
                                </div>
                            </t>
                        </div>
                    </div>

                    <span class="ms-auto text-muted small">
                        <t t-esc="state.totalFiltered"/> cliente(s)
                    </span>

                    <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1"
                            title="Exportar tabla a Excel (.xls) con las columnas visibles"
                            t-on-click="exportToExcel">
                        <i class="fa fa-download"/>
                        <span>Exportar</span>
                    </button>
                </div>

                <!-- Error backend -->
                <div t-if="state.loadError" class="alert alert-danger py-2 mb-2" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    Error: <strong><t t-esc="state.loadError"/></strong>
                </div>

                <!-- Tabla -->
                <div class="border rounded" style="max-height:72vh; overflow-y:auto;">
                    <table class="table table-sm table-bordered mb-0 align-middle"
                           style="font-size:12px; width:100%; table-layout:fixed;">

                        <thead style="position:sticky; top:0; z-index:3;">
                            <tr>
                                <th style="padding:4px 4px; background:#f8f9fa; width:28px;"/>
                                <t t-foreach="staticVisibleCols" t-as="col" t-key="col.key">
                                    <th t-att-class="'align-middle ' + (col.align ? 'text-' + col.align + ' ' : '') + (cols.state.dragOver === col.key ? 'o_col_drag_over' : '')"
                                        t-att-style="'padding:4px 8px; background:#f8f9fa; cursor:pointer; user-select:none; position:relative; overflow:hidden; ' + (cols.colGroupStyle(col.key) || '')"
                                        t-att-title="colTitle(col)"
                                        t-att-data-col-key="col.key"
                                        t-att-draggable="col.fixed ? 'false' : 'true'"
                                        t-on-dragstart="cols.onDragStart"
                                        t-on-dragover="cols.onDragOver"
                                        t-on-drop="cols.onDrop"
                                        t-on-dragend="cols.onDragEnd"
                                        t-on-click="() => this.onColHeaderClick(col)">
                                        <t t-esc="col.label"/>
                                        <i t-att-class="sortIcon(caSortKeys[col.key])"/>
                                        <div class="o_col_resize_handle"
                                             t-att-data-col-key="col.key"
                                             t-on-mousedown.stop="cols.onResizeStart"
                                             t-on-click.stop="() => {}"/>
                                    </th>
                                </t>
                                <th style="padding:4px 8px; background:#f8f9fa; width:36px;"/>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-if="state.groupBy">
                                <t t-foreach="groupedRows" t-as="group" t-key="group.label">
                                    <tr style="background:#e9ecef;">
                                        <td t-att-colspan="staticVisibleCols.length + 2"
                                            style="padding:4px 8px; font-weight:600;">
                                            <i class="fa fa-folder-open-o me-1 text-muted"/>
                                            <t t-esc="group.label"/>
                                            <span class="text-muted fw-normal ms-2 small">
                                                <t t-esc="group.items.length"/> clientes ·
                                                <t t-esc="fmtMoney(group.total_amount)"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <t t-foreach="group.items" t-as="row" t-key="row.partner_id">
                                        <t t-call="odoo_mrp_planner.CustomerAnalysisRow"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-foreach="state.rows" t-as="row" t-key="row.partner_id">
                                    <t t-call="odoo_mrp_planner.CustomerAnalysisRow"/>
                                </t>
                            </t>
                            <tr t-if="state.totalFiltered === 0 and !state.loading">
                                <td t-att-colspan="staticVisibleCols.length + 2"
                                    class="text-center text-muted py-4">
                                    No se encontraron clientes para el período seleccionado.
                                </td>
                            </tr>
                        </tbody>

                        <tfoot t-if="!state.groupBy and state.allRows.length > 0"
                               class="fw-bold" style="background:#f8f9fa;">
                            <tr>
                                <td/>
                                <t t-foreach="staticVisibleCols" t-as="col" t-key="'tf_' + col.key">
                                    <td style="padding:3px 6px;"
                                        t-att-class="col.align ? 'text-' + col.align : ''">
                                        <t t-if="col.key === 'partner_name'">Total</t>
                                        <t t-elif="col.key === 'order_count'"
                                           t-esc="fmt(state.allRows.reduce((s, r) => s + r.order_count, 0))"/>
                                        <t t-elif="col.key === 'total_amount'"
                                           t-esc="fmtMoney(state.allRows.reduce((s, r) => s + r.total_amount, 0))"/>
                                    </td>
                                </t>
                                <td/>
                            </tr>
                        </tfoot>

                    </table>
                </div>

                <!-- Paginación -->
                <div t-if="totalPages > 1"
                     class="d-flex align-items-center justify-content-between px-2 py-1 border-top"
                     style="flex-shrink:0;">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                            t-att-disabled="!hasPrevPage" t-on-click="prevPage">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <small class="text-muted">
                        Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/>
                        · <t t-esc="state.totalFiltered"/> registros
                    </small>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                            t-att-disabled="!hasNextPage" t-on-click="nextPage">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>

        </div>
        <!-- ── fin main content ── -->

    </div>
</t>

<!-- ── Sub-template: fila ─────────────────────────────────────────────────── -->
<t t-name="odoo_mrp_planner.CustomerAnalysisRow">

    <!-- Fila principal -->
    <tr>
        <!-- Toggle expandir pedidos -->
        <td style="padding:3px 4px; text-align:center; width:28px;">
            <button class="btn btn-sm btn-link p-0 text-muted"
                    style="font-size:11px; line-height:1;"
                    title="Ver pedidos del período"
                    t-on-click="() => this.toggleRow(row.partner_id)">
                <i t-att-class="state.expandedRows[row.partner_id] ? 'fa fa-chevron-down' : 'fa fa-chevron-right'"/>
            </button>
        </td>

        <t t-foreach="staticVisibleCols" t-as="col" t-key="'td_' + col.key + '_' + row.partner_id">

            <td t-if="col.key === 'partner_name'"
                class="text-primary"
                style="padding:3px 8px; white-space:nowrap; max-width:200px; overflow:hidden; text-overflow:ellipsis; cursor:pointer;"
                t-att-title="'Abrir contacto: ' + row.partner_name"
                t-on-click="() => this.openCustomer(row.partner_id)"
                t-esc="row.partner_name"/>

            <td t-elif="col.key === 'customer_category'"
                class="text-center" style="padding:3px 6px;"
                t-att-title="'Categoría global de cliente: ' + (row.customer_category || '—')">
                <span t-if="row.customer_category"
                      t-att-class="'badge ' + catBadgeClass(row.customer_category)"
                      t-esc="row.customer_category"/>
                <span t-else="" class="text-muted">—</span>
            </td>

            <td t-elif="col.key === 'abc_segment'"
                class="text-center" style="padding:3px 6px;"
                title="Clasifica a los clientes del período según cuánto compraron en esa ventana de tiempo. No altera la categoría permanente del contacto.">
                <span t-if="row.abc_segment"
                      t-att-class="'badge ' + abcBadgeClass(row.abc_segment)"
                      t-esc="row.abc_segment"/>
                <span t-else="" class="text-muted">—</span>
            </td>

            <td t-elif="col.key === 'salesperson'"
                style="padding:3px 8px;" t-esc="row.salesperson || '—'"/>

            <td t-elif="col.key === 'country'"
                style="padding:3px 8px;" t-esc="row.country || '—'"/>

            <td t-elif="col.key === 'province'"
                style="padding:3px 8px;" t-esc="row.province || '—'"/>

            <td t-elif="col.key === 'order_count'"
                class="text-end" style="padding:3px 8px;"
                title="Pedidos confirmados en el período."
                t-esc="fmt(row.order_count)"/>

            <td t-elif="col.key === 'total_amount'"
                class="text-end" style="padding:3px 8px;"
                title="Monto total neto del período."
                t-esc="fmtMoney(row.total_amount)"/>

            <td t-elif="col.key === 'avg_ticket'"
                class="text-end" style="padding:3px 8px;"
                title="Monto total ÷ cantidad de pedidos."
                t-esc="fmtMoney(row.avg_ticket)"/>

            <td t-elif="col.key === 'delivery_pct'"
                t-att-class="'text-end ' + deliveryClass(row.delivery_pct)"
                style="padding:3px 8px;"
                title="% Entrega: qty entregada ÷ qty pedida × 100."
                t-esc="fmtPct(row.delivery_pct)"/>

            <td t-elif="col.key === 'ontime_pct'"
                t-att-class="'text-end ' + ontimeClass(row.ontime_pct)"
                style="padding:3px 8px;"
                title="% entregas dentro del plazo configurado."
                t-esc="fmtPct(row.ontime_pct)"/>

            <td t-elif="col.key === 'avg_days_between'"
                class="text-end" style="padding:3px 8px;"
                title="Días promedio entre pedidos consecutivos.">
                <t t-if="row.avg_days_between !== null and row.avg_days_between !== undefined">
                    <t t-esc="row.avg_days_between"/> d
                </t>
                <span t-else="" class="text-muted">—</span>
            </td>

            <td t-elif="col.key === 'days_since_last'"
                t-att-class="'text-end ' + riskClass(row.days_since_last)"
                style="padding:3px 8px;"
                t-att-title="'Días sin comprar. Umbral de riesgo: ' + (state.config.risk_days || 90) + ' días.'">
                <t t-esc="row.days_since_last"/> d
            </td>

            <td t-elif="col.key === 'last_order_date'"
                class="text-end" style="padding:3px 8px;"
                title="Fecha del último pedido confirmado."
                t-esc="row.last_order_date || '—'"/>

            <td t-elif="col.key === 'distinct_products'"
                class="text-end" style="padding:3px 8px;"
                title="Productos distintos comprados en el período."
                t-esc="fmt(row.distinct_products)"/>

            <td t-elif="col.key === 'top_product'"
                style="padding:3px 8px; max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                t-att-title="row.top_product" t-esc="row.top_product || '—'"/>

            <td t-elif="col.key === 'top_family'"
                style="padding:3px 8px; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                t-att-title="row.top_family" t-esc="row.top_family || '—'"/>

            <td t-elif="col.key === 'trend_pct'"
                t-att-class="'text-end ' + trendClass(row.trend_pct)"
                style="padding:3px 8px;"
                title="Variación del monto vs período anterior de igual duración."
                t-esc="fmtTrend(row.trend_pct)"/>

            <td t-elif="col.key === 'frequency_segment'"
                class="text-center" style="padding:3px 6px;"
                title="Frecuente: ≤30 d · Ocasional: 31–90 d · Inactivo: >90 d · En riesgo: sin comprar más del umbral configurado.">
                <span t-att-class="'badge ' + freqBadgeClass(row.frequency_segment)"
                      t-esc="freqLabel(row.frequency_segment)"/>
            </td>

            <td t-else="" style="padding:3px 8px;">
                <t t-esc="row[col.key] !== null and row[col.key] !== undefined ? row[col.key] : '—'"/>
            </td>

        </t>

        <!-- Botón detalle (activo cuando está expandido) -->
        <td style="padding:3px 4px; text-align:center; width:36px;">
            <button t-att-class="state.panelPartnerId === row.partner_id
                        ? 'btn btn-sm btn-primary p-0 px-1'
                        : 'btn btn-sm btn-link p-0'"
                    style="font-size:11px;"
                    title="Ver análisis del cliente"
                    t-on-click="() => this.toggleDetail(row.partner_id)">
                <i class="fa fa-bar-chart"/>
            </button>
        </td>
    </tr>

    <!-- Sub-fila expandible: detalle del cliente (gráficos) -->
    <tr t-if="state.panelPartnerId === row.partner_id">
        <td t-att-colspan="staticVisibleCols.length + 2"
            style="padding:12px 16px; background:#f8f9fa; border-top:none;">

            <t t-if="state.panelLoading">
                <div class="d-flex align-items-center gap-2 py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"/>
                    <span class="text-muted small">Cargando análisis…</span>
                </div>
            </t>

            <t t-if="!state.panelLoading and state.panelData">

                <!-- KPI strip -->
                <div class="d-flex border rounded mb-3 bg-white" style="overflow:hidden;">
                    <div class="text-center px-3 py-2 flex-fill">
                        <div class="fw-bold" style="font-size:1rem;"
                             t-esc="fmtMoney(row.total_amount)"/>
                        <div class="small text-muted">Monto total</div>
                    </div>
                    <div class="text-center px-3 py-2 flex-fill border-start">
                        <div class="fw-bold" style="font-size:1rem;"
                             t-esc="fmtMoney(row.avg_ticket)"/>
                        <div class="small text-muted">Ticket promedio</div>
                    </div>
                    <div class="text-center px-3 py-2 flex-fill border-start">
                        <div t-att-class="'fw-bold ' + deliveryClass(row.delivery_pct)"
                             style="font-size:1rem;" t-esc="fmtPct(row.delivery_pct)"/>
                        <div class="small text-muted">% Entrega</div>
                    </div>
                    <div class="text-center px-3 py-2 flex-fill border-start">
                        <div t-att-class="'fw-bold ' + ontimeClass(row.ontime_pct)"
                             style="font-size:1rem;" t-esc="fmtPct(row.ontime_pct)"/>
                        <div class="small text-muted">% A tiempo</div>
                    </div>
                    <div class="text-center px-3 py-2 flex-fill border-start">
                        <div t-att-class="'fw-bold ' + riskClass(row.days_since_last)"
                             style="font-size:1rem;">
                            <t t-esc="row.days_since_last"/> d
                        </div>
                        <div class="small text-muted">Sin comprar</div>
                    </div>
                    <div class="text-center px-3 py-2 flex-fill border-start">
                        <div class="fw-bold" style="font-size:1rem;" t-esc="fmt(row.order_count)"/>
                        <div class="small text-muted">Pedidos</div>
                    </div>
                    <div class="d-flex align-items-center px-3 border-start">
                        <button class="btn btn-sm btn-outline-primary py-0 px-2"
                                style="font-size:11px; white-space:nowrap;"
                                title="Ver pedidos de este cliente en el período"
                                t-on-click="() => this.openCustomerOrders(row.partner_id)">
                            <i class="fa fa-list me-1"/>Pedidos
                        </button>
                    </div>
                </div>

                <!-- Toggle métrica + sección gráficos -->
                <t t-if="state.panelData.monthly_data and state.panelData.monthly_data.length">

                    <!-- Barra de controles: $ Monto / # Piezas -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="o_planner_section_title" style="margin-bottom:0;">
                            <i class="fa fa-bar-chart me-1 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución mensual</span>
                        </div>
                        <div class="btn-group btn-group-sm ms-auto" role="group">
                            <button t-att-class="state.panelMetric === 'amount' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelMetric('amount')">
                                $ Monto
                            </button>
                            <button t-att-class="state.panelMetric === 'qty' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelMetric('qty')">
                                # Piezas
                            </button>
                        </div>
                    </div>

                    <!-- Gráficos: barras agrupadas (flex:3) + donut familias (flex:2) -->
                    <div class="d-flex gap-3 mb-3 align-items-start">
                        <div style="flex:3; min-width:0; overflow:hidden;">
                            <div style="position:relative; height:190px; width:100%;">
                                <canvas t-ref="panelBarCanvas"/>
                            </div>
                        </div>
                        <div t-if="state.panelData.family_mix and state.panelData.family_mix.length"
                             style="flex:2; min-width:0; overflow:hidden;">
                            <div class="o_planner_section_title mb-1">
                                <i class="fa fa-pie-chart me-1 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Mix de familias</span>
                            </div>
                            <div style="position:relative; height:190px; width:100%;">
                                <canvas t-ref="panelDonutCanvas"/>
                            </div>
                        </div>
                    </div>
                </t>

                <!-- Línea % entrega — ancho completo -->
                <t t-if="state.panelData.monthly_data and state.panelData.monthly_data.filter(m => m.delivery_pct !== null).length > 1">
                    <div class="o_planner_section_title mb-1">
                        <i class="fa fa-line-chart me-1 text-muted"/>
                        <span class="text-uppercase fw-bold text-muted small">% Entrega mensual</span>
                    </div>
                    <div style="position:relative; height:140px; width:100%; overflow:hidden;">
                        <canvas t-ref="panelLineCanvas"/>
                    </div>
                </t>

                <!-- Top artículos -->
                <t t-if="state.panelData.top_products and state.panelData.top_products.length">
                    <div class="d-flex align-items-center gap-2 mt-3 mb-1">
                        <div class="o_planner_section_title" style="margin-bottom:0;">
                            <i class="fa fa-cubes me-1 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Top artículos</span>
                        </div>
                        <div class="btn-group btn-group-sm ms-auto" role="group">
                            <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                                <button t-att-class="state.panelTopN === n ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                        style="font-size:11px; padding:1px 8px;"
                                        t-on-click="() => this.setPanelTopN(n)">
                                    <t t-esc="'Top ' + n"/>
                                </button>
                            </t>
                        </div>
                    </div>
                    <div class="border rounded bg-white" style="overflow:auto; max-height:220px;">
                        <table class="table table-sm table-hover mb-0" style="font-size:11px;">
                            <thead style="position:sticky; top:0; background:#f8f9fa; z-index:1;">
                                <tr>
                                    <th style="padding:3px 6px; width:24px;">#</th>
                                    <th style="padding:3px 8px;">Artículo</th>
                                    <th class="text-end" style="padding:3px 8px;">Pedido</th>
                                    <th class="text-end" style="padding:3px 8px;">Entregado</th>
                                    <th class="text-end" style="padding:3px 8px;">Monto</th>
                                    <th class="text-end" style="padding:3px 8px;">% Entrega</th>
                                    <th class="text-end" style="padding:3px 8px;">OVs</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="panelTopProducts" t-as="prod" t-key="prod_index">
                                    <tr>
                                        <td class="text-muted" style="padding:2px 6px;">
                                            <t t-esc="prod_index + 1"/>
                                        </td>
                                        <td style="padding:2px 8px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                            t-att-title="prod.name">
                                            <t t-esc="prod.name"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmt(prod.qty_ordered)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmt(prod.qty_delivered)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmtMoney(prod.amount)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <span t-att-class="deliveryClass(prod.delivery_pct)">
                                                <t t-esc="fmtPct(prod.delivery_pct)"/>
                                            </span>
                                        </td>
                                        <td class="text-end text-muted" style="padding:2px 8px;">
                                            <t t-esc="prod.order_count"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

            </t>

        </td>
    </tr>

    <!-- Sub-fila expandible: pedidos -->
    <tr t-if="state.expandedRows[row.partner_id]">
        <td t-att-colspan="staticVisibleCols.length + 2"
            style="padding:0; background:#f8f9fa; border-top:none;">

            <t t-if="state.rowOrdersLoading[row.partner_id]">
                <div class="d-flex align-items-center justify-content-center py-2 gap-2">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"/>
                    <span class="text-muted small">Cargando pedidos…</span>
                </div>
            </t>

            <t t-elif="state.rowOrders[row.partner_id] and state.rowOrders[row.partner_id].length">
                <table class="table table-sm mb-0" style="font-size:11px;">
                    <thead>
                        <tr style="background:#e2e6ea;">
                            <th style="padding:3px 8px 3px 40px; width:140px;">Pedido</th>
                            <th style="padding:3px 8px;">Fecha</th>
                            <th class="text-end" style="padding:3px 8px;">Monto</th>
                            <th class="text-end" style="padding:3px 8px;">% Entrega</th>
                            <th style="padding:3px 8px;">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.rowOrders[row.partner_id]" t-as="ord" t-key="ord.name">
                            <tr style="cursor:pointer;" title="Abrir pedido."
                                t-on-click="() => this.openOrder(ord.order_id)">
                                <td style="padding:3px 8px 3px 40px;" class="text-primary fw-semibold">
                                    <t t-esc="ord.name"/>
                                </td>
                                <td style="padding:3px 8px; color:#6c757d;"><t t-esc="ord.date"/></td>
                                <td class="text-end" style="padding:3px 8px;">
                                    <t t-esc="fmtMoney(ord.amount)"/>
                                </td>
                                <td t-att-class="'text-end ' + deliveryClass(ord.delivery_pct)"
                                    style="padding:3px 8px;" t-esc="fmtPct(ord.delivery_pct)"/>
                                <td style="padding:3px 8px; color:#6c757d;"><t t-esc="ord.state"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <t t-else="">
                <div t-if="!state.rowOrdersLoading[row.partner_id]"
                     class="text-center text-muted small py-2">
                    Sin pedidos en el período.
                </div>
            </t>

        </td>
    </tr>

</t>

</templates>
