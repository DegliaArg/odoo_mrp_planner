<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_mrp_workcenters" model="ir.ui.view">
        <field name="name">product.template.form.mrp.workcenters</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Planificador" name="mrp_planner_tab">
                    <group string="Categoría de venta" invisible="not sale_ok">
                        <field name="x_sale_category"
                               string="Categoría"
                               help="Clasificación A–E de rotación (A = alta rotación, E = baja). Se puede asignar automáticamente desde Configuración del planificador."/>
                    </group>
                    <group string="Centros de trabajo">
                        <field name="x_centros_compatibles" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="workcenter_id" required="1"/>
                                <field name="is_preferred"/>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="exclusion_reason" invisible="active"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
