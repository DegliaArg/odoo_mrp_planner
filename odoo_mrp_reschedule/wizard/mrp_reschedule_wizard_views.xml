<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mrp_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">mrp.reschedule.wizard.form</field>
        <field name="model">mrp.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprogramar en cascada">
                <sheet>

                    <!-- ── Encabezado: orden pivot + fecha + delta ── -->
                    <group>
                        <group string="Orden de referencia (pivot)">
                            <field name="production_id"
                                   options="{'no_create': True, 'no_edit': True}"
                                   domain="[('state', 'not in', ['cancel'])]"/>
                            <field name="delta_display"
                                   string="Desplazamiento calculado"
                                   readonly="1"/>
                        </group>
                        <group string="Fecha real de finalización">
                            <field name="new_finish_date" nolabel="1"/>
                        </group>
                    </group>

                    <!-- ── Botón de cálculo ── -->
                    <div style="margin: 0 0 12px 0;">
                        <button name="action_recalculate"
                                type="object"
                                string="↻  Calcular / Recalcular cambios"
                                class="btn btn-secondary"/>
                        <span style="margin-left: 12px; font-size: 12px; color: var(--color-text-secondary);">
                            Ajuste la fecha de fin y haga clic para ver
                            todas las órdenes afectadas.
                        </span>
                    </div>

                    <!-- ── Aviso cuando no hay líneas aún ── -->
                    <field name="has_lines" invisible="1"/>
                    <div invisible="has_lines"
                         class="alert alert-info"
                         role="alert"
                         style="margin-bottom: 8px;">
                        Haga clic en "Calcular / Recalcular cambios" para ver las órdenes
                        subsecuentes en los mismos centros de trabajo.
                    </div>

                    <!-- ── Tabla de cambios propuestos ── -->
                    <field name="line_ids"
                           nolabel="1"
                           invisible="not has_lines">
                        <list editable="bottom"
                              no_open="1"
                              decoration-info="record_type == 'mrp' and level == 0"
                              decoration-warning="record_type == 'mrp' and level > 0"
                              decoration-muted="record_type == 'purchase'">

                            <!-- Campo level disponible para decoraciones pero no visible -->
                            <field name="level" column_invisible="1"/>

                            <field name="apply" string="✓"/>

                            <field name="record_type"
                                   widget="badge"
                                   options="{'colors': {'mrp': 'info', 'purchase': 'success'}}"/>

                            <field name="record_label"
                                   string="Referencia"
                                   readonly="1"/>

                            <field name="description_label"
                                   string="Producto / Proveedor"
                                   readonly="1"/>

                            <field name="parent_label"
                                   string="Generado por"
                                   readonly="1"
                                   optional="show"/>

                            <field name="state_display"
                                   string="Estado actual"
                                   readonly="1"
                                   optional="show"/>

                            <field name="current_date_finish"
                                   string="Fin planificado"
                                   readonly="1"/>

                            <field name="new_date_start"
                                   string="Nuevo inicio"
                                   readonly="record_type == 'purchase'"
                                   optional="show"/>

                            <field name="new_date_finish"
                                   string="Nuevo fin"/>

                        </list>
                    </field>

                </sheet>

                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Aplicar cambios"
                            class="btn-primary"
                            confirm="¿Confirmar la reprogramación? Se modificarán todas las órdenes marcadas y se replanificarán sus órdenes de trabajo en el centro de trabajo."/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
