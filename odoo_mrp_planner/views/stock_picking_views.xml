<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Listas de los drills de los paneles del planificador ──
         Vistas dedicadas (priority alta para no ser las default de
         stock.picking); los "Ver →" de los paneles las eligen vía
         list_view_ref. El módulo de despacho les agrega su columna. -->

    <!-- Drill genérico: remito + cantidad con total -->
    <record id="view_picking_list_planner_drill" model="ir.ui.view">
        <field name="name">stock.picking.list.planner.drill</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Remitos" create="false">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id" optional="show" string="Contacto"/>
                <field name="origin" optional="show" string="Documento origen"/>
                <field name="picking_type_id" optional="hide" string="Tipo de operación"/>
                <field name="scheduled_date" optional="show" string="Fecha programada"/>
                <field name="date_done" optional="hide" string="Fecha de validación"/>
                <!-- Campo almacenado: Odoo suma por grupo y en el total nativamente -->
                <field name="x_qty_done" sum="Total" string="Cantidad"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Drill de PENDIENTES: demanda, con stock y sin stock con totales;
         los pies de columna cierran con las cards del panel. -->
    <record id="view_picking_list_planner_drill_pending" model="ir.ui.view">
        <field name="name">stock.picking.list.planner.drill.pending</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Demanda pendiente" create="false">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id" optional="show" string="Contacto"/>
                <field name="origin" optional="show" string="Documento origen"/>
                <field name="picking_type_id" optional="hide" string="Tipo de operación"/>
                <field name="scheduled_date" optional="show" string="Fecha programada"/>
                <!-- Las TRES columnas se recortan al rango de fechas del panel
                     (mismo universo por línea que los KPIs): Demanda = Con
                     stock + Sin stock, y el total al pie cierra con las cards.
                     Al depender del rango no pueden almacenarse: totalizan al
                     pie (suma de las filas cargadas), no por grupo. -->
                <field name="x_qty_pending_chain" sum="Total" string="Demanda"/>
                <field name="x_qty_available_chain" sum="Total" string="Con stock"/>
                <field name="x_qty_blocked_chain" sum="Total" string="Sin stock"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'assigned'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

</odoo>
