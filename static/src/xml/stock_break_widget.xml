<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.StockBreakWidget">
        <div class="o_stock_break_widget" t-att-class="state.loading ? 'opacity-50 pe-none' : ''">

            <!-- Sin ubicación configurada -->
            <div t-if="state.error === 'no_location'" class="alert alert-warning d-flex align-items-center gap-2 py-2">
                <i class="fa fa-map-marker fa-lg"/>
                <span>No hay ubicación de stock configurada para este widget.</span>
                <button class="btn btn-sm btn-warning ms-auto" t-on-click="openConfig">
                    Configurar →
                </button>
            </div>

            <t t-else="">

                <!-- Ubicación(es) activa(s) -->
                <div class="text-muted small mb-2">
                    <i class="fa fa-map-marker me-1"/>
                    <t t-esc="state.locationName || '—'"/>
                </div>

                <!-- KPI cards -->
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="card o_planner_card h-100" style="cursor:pointer"
                             t-on-click="() => this.setFilter('all')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-cubes fa-lg text-secondary mb-2 d-block"/>
                                <div class="o_planner_number"><t t-esc="state.kpis.total"/></div>
                                <div class="o_planner_label">Vendibles</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card o_planner_card o_planner_card_danger h-100" style="cursor:pointer"
                             t-on-click="() => this.setFilter('broken')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-exclamation-triangle fa-lg text-danger mb-2 d-block"/>
                                <div class="o_planner_number text-danger"><t t-esc="state.kpis.broken"/></div>
                                <div class="o_planner_label">Quiebres</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card o_planner_card o_planner_card_success h-100" style="cursor:pointer"
                             t-on-click="() => this.setFilter('ok')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                <div class="o_planner_number text-success"><t t-esc="state.kpis.ok"/></div>
                                <div class="o_planner_label">Stock OK</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card o_planner_card h-100" style="cursor:pointer"
                             t-on-click="() => this.setFilter('no_min')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-minus-circle fa-lg text-muted mb-2 d-block"/>
                                <div class="o_planner_number text-muted"><t t-esc="state.kpis.no_min"/></div>
                                <div class="o_planner_label">Sin mínimo</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Buscador + filtro + selector de depósito -->
                <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                    <div class="input-group input-group-sm" style="max-width:240px;">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input type="text"
                               class="form-control"
                               placeholder="Buscar producto o código…"
                               t-att-value="state.search"
                               t-on-input="onSearchInput"/>
                    </div>
                    <div class="input-group input-group-sm" style="max-width:180px;">
                        <span class="input-group-text"><i class="fa fa-filter"/></span>
                        <select class="form-select form-select-sm" t-on-change="onFilterChange">
                            <option value="all"    t-att-selected="state.filterType === 'all'">Todos</option>
                            <option value="broken" t-att-selected="state.filterType === 'broken'">Quiebres</option>
                            <option value="ok"     t-att-selected="state.filterType === 'ok'">De acuerdo</option>
                            <option value="no_min" t-att-selected="state.filterType === 'no_min'">Sin mínimo</option>
                        </select>
                    </div>
                    <div t-if="state.locations.length" class="d-flex align-items-center gap-1" t-on-click.stop="">
                        <label class="form-label mb-0 small text-muted">Ubicación</label>
                        <div class="position-relative">
                            <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                                    style="min-width:160px;"
                                    t-on-click="toggleLocDropdown">
                                <span class="text-truncate" style="max-width:130px;"><t t-esc="selectedLocLabel"/></span>
                                <i t-att-class="'fa ms-auto ' + (state.locDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/>
                            </button>
                            <div t-if="state.locDropdownOpen"
                                 class="dropdown-menu show shadow p-2"
                                 style="min-width:220px; position:absolute; z-index:1050; top:100%; left:0; margin-top:2px;">
                                <input type="text" class="form-control form-control-sm mb-2"
                                       placeholder="Buscar ubicación…"
                                       t-model="state.locSearch"
                                       autocomplete="off"/>
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input" id="loc_filter_all"
                                           t-att-checked="!state.locationIds.length"
                                           t-on-change="clearLocFilter"/>
                                    <label class="form-check-label fw-semibold small" for="loc_filter_all">Todas</label>
                                </div>
                                <div class="dropdown-divider my-1"/>
                                <t t-foreach="filteredLocations" t-as="loc" t-key="loc.id">
                                    <div class="form-check mb-1">
                                        <input type="checkbox" class="form-check-input"
                                               t-att-id="'loc_filter_' + loc.id"
                                               t-att-data-loc-id="loc.id"
                                               t-att-checked="state.locationIds.includes(loc.id)"
                                               t-on-change="toggleLocation"/>
                                        <label class="form-check-label small" t-att-for="'loc_filter_' + loc.id">
                                            <t t-esc="loc.name"/>
                                        </label>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tabla -->
                <div t-if="state.products.length === 0"
                     class="text-center text-muted py-4 border rounded">
                    <i class="fa fa-check-circle fa-2x text-success mb-2 d-block"/>
                    No hay productos en esta categoría.
                </div>

                <t t-else="">
                    <div class="border rounded" style="overflow:hidden;">
                        <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                            <colgroup>
                                <col style="width:32px"/>
                                <col style="width:44%"/>
                                <col style="width:17%"/>
                                <col style="width:17%"/>
                                <col style="width:17%"/>
                            </colgroup>
                            <thead class="table-light">
                                <tr class="text-muted">
                                    <th/>
                                    <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">
                                        Producto <i t-att-class="sortIcon('name')"/>
                                    </th>
                                    <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('qty')">
                                        Stock actual <i t-att-class="sortIcon('qty')"/>
                                    </th>
                                    <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('min_qty')">
                                        Mínimo <i t-att-class="sortIcon('min_qty')"/>
                                    </th>
                                    <th class="text-center" style="cursor:pointer" t-on-click="() => this.sortBy('status')">
                                        Estado <i t-att-class="sortIcon('status')"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.products" t-as="prod" t-key="prod.id">
                                    <!-- Fila principal -->
                                    <tr t-att-class="prod.is_broken ? 'table-danger' : ''"
                                        style="cursor:pointer"
                                        t-att-data-product-id="prod.id"
                                        t-on-click="openProductFromRow">
                                        <td class="text-center align-middle p-0" style="width:32px;">
                                            <button t-if="prod.mo_count"
                                                    class="btn btn-sm btn-link p-0 px-1 text-muted"
                                                    t-att-title="state.expandedProducts[prod.id] ? 'Cerrar OFs' : 'Ver OFs activas'"
                                                    t-on-click="(ev) => this.toggleAccordion(prod, ev)">
                                                <i t-att-class="'fa fa-fw ' + (state.expandedProducts[prod.id] ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                            </button>
                                        </td>
                                        <td class="fw-semibold text-truncate" t-esc="prod.name"/>
                                        <td class="text-end" t-esc="fmt(prod.qty)"/>
                                        <td class="text-end">
                                            <t t-if="prod.has_min" t-esc="fmt(prod.min_qty)"/>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="prod.is_broken"
                                                  class="badge text-bg-danger"
                                                  t-att-title="`Stock ${fmt(prod.qty)} &lt; mínimo ${fmt(prod.min_qty)}`">
                                                Quiebre
                                            </span>
                                            <span t-elif="prod.has_min"
                                                  class="badge text-bg-success"
                                                  title="Stock sobre el mínimo configurado">
                                                OK
                                            </span>
                                            <span t-else=""
                                                  class="text-muted fst-italic small"
                                                  title="Sin punto de reorden con ruta Fabricación">
                                                Sin mínimo
                                            </span>
                                        </td>
                                    </tr>
                                    <!-- Acordeón: OFs activas -->
                                    <tr t-if="prod.mo_count and state.expandedProducts[prod.id]">
                                        <td colspan="5" class="p-0" style="background:#f8f9fa; border-top:none;">
                                            <div class="px-3 py-2">

                                                <div t-if="state.mosLoading[prod.id]"
                                                     class="text-center text-muted py-2 small">
                                                    <i class="fa fa-spinner fa-spin me-1"/> Cargando OFs…
                                                </div>

                                                <div t-elif="!state.mosByProduct[prod.id] or !state.mosByProduct[prod.id].length"
                                                     class="text-muted small py-1">
                                                    <i class="fa fa-info-circle me-1"/>
                                                    No hay órdenes de fabricación activas para este producto.
                                                </div>

                                                <table t-else=""
                                                       class="table table-sm table-hover mb-0"
                                                       style="font-size:11px; background:white;">
                                                    <thead>
                                                        <tr class="text-muted">
                                                            <th style="padding:3px 8px;">Referencia</th>
                                                            <th style="padding:3px 8px;">Estado</th>
                                                            <th class="text-end" style="padding:3px 8px;">Planificado</th>
                                                            <th class="text-end" style="padding:3px 8px;">Producido</th>
                                                            <th style="padding:3px 8px;">Fin planificado</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="state.mosByProduct[prod.id]" t-as="mo" t-key="mo.id">
                                                            <tr style="cursor:pointer;"
                                                                t-on-click="() => this.openMo(mo.id)"
                                                                title="Abrir orden de fabricación">
                                                                <td style="padding:3px 8px;" class="text-primary fw-semibold">
                                                                    <i class="fa fa-external-link me-1" style="font-size:10px;"/>
                                                                    <t t-esc="mo.name"/>
                                                                </td>
                                                                <td style="padding:3px 8px;">
                                                                    <span t-att-class="moStateBadge(mo.state)"
                                                                          style="font-size:10px; padding:2px 5px;">
                                                                        <t t-esc="mo.state_label"/>
                                                                    </span>
                                                                </td>
                                                                <td class="text-end" style="padding:3px 8px;">
                                                                    <t t-esc="fmt(mo.product_qty)"/>
                                                                    <span class="text-muted ms-1"><t t-esc="mo.uom"/></span>
                                                                </td>
                                                                <td class="text-end" style="padding:3px 8px;">
                                                                    <t t-esc="fmt(mo.qty_produced)"/>
                                                                </td>
                                                                <td style="padding:3px 8px;" class="text-muted">
                                                                    <t t-esc="mo.date_finished"/>
                                                                </td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginación -->
                    <div t-if="totalPages > 1"
                         class="d-flex align-items-center justify-content-between px-1 py-1 mt-1">
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                t-att-disabled="!hasPrevPage" t-on-click="prevPage">
                            <i class="fa fa-chevron-left"/>
                        </button>
                        <small class="text-muted">
                            Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/>
                            · <t t-esc="state.totalFiltered"/> registros
                        </small>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                t-att-disabled="!hasNextPage" t-on-click="nextPage">
                            <i class="fa fa-chevron-right"/>
                        </button>
                    </div>
                </t>

            </t>
        </div>
    </t>

</templates>
