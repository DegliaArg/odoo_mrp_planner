<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">mrp.reschedule.wizard.form</field>
        <field name="model">mrp.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprogramar en cascada">

                <group>
                    <group>
                        <field name="production_id"/>
                        <field name="new_finish_date"/>
                    </group>
                    <group>
                        <field name="delta_display" readonly="1"/>
                    </group>
                </group>

                <div class="o_horizontal_separator mt8 mb8"
                     style="display:flex; justify-content:space-between; align-items:center;">
                    <span>Cambios propuestos</span>
                    <button name="action_open_gantt"
                            type="object"
                            string="Ver Gantt"
                            class="btn btn-sm btn-secondary"
                            invisible="not has_lines"/>
                </div>

                <field name="line_ids" nolabel="1">
                    <list string="Cambios propuestos"
                          editable="bottom"
                          decoration-muted="is_anchor"
                          decoration-info="record_type == 'mrp' and not warning_type and not is_anchor"
                          decoration-warning="record_type == 'purchase' and not warning_type"
                          decoration-danger="warning_type == 'confirmed_po'"
                          decoration-success="warning_type == 'child_adjusted'">

                        <!--
                            Fase 3: Campo de orden manual.
                            Solo editable en líneas de nivel 0 de tipo mrp.
                            El usuario cambia el número y hace clic en "Calcular"
                            para que el algoritmo respete ese orden (requiere que
                            el criterio esté configurado en "Manual" en Ajustes).
                        -->
                        <field name="reschedule_sequence"
                               string="Orden"
                               readonly="level != 0 or record_type != 'mrp' or is_anchor"
                               optional="show"/>

                        <!-- Fase 1: columnas principales -->
                        <field name="apply"
                               string="Aplicar"
                               readonly="is_anchor"/>
                        <field name="is_anchor"
                               string="Fijo"
                               readonly="record_type != 'mrp'"
                               widget="boolean_toggle"/>
                        <field name="record_label"
                               string="Referencia"
                               readonly="1"/>
                        <field name="description_label"
                               string="Producto / Proveedor"
                               readonly="1"/>
                        <field name="product_qty_display"
                               string="Cantidad"
                               readonly="1"
                               optional="show"/>
                        <field name="workcenter_label"
                               string="Centros de trabajo"
                               readonly="1"
                               optional="show"/>
                        <field name="duration_hours"
                               string="Duración (hs)"
                               readonly="record_type != 'mrp' or is_anchor"
                               optional="show"/>
                        <field name="current_date_finish"
                               string="Fin actual"
                               readonly="1"/>
                        <field name="new_date_finish"
                               string="Nuevo fin"
                               readonly="1"/>
                        <field name="state_display"
                               string="Estado"
                               readonly="1"/>
                        <field name="warning_message"
                               string="Advertencia"
                               readonly="1"
                               optional="show"/>

                        <!-- Campos ocultos: necesarios para decoraciones y Gantt -->
                        <field name="record_type"        column_invisible="True"/>
                        <field name="level"              column_invisible="True"/>
                        <field name="warning_type"       column_invisible="True"/>
                        <field name="production_id"      column_invisible="True"/>
                        <field name="purchase_id"        column_invisible="True"/>
                        <field name="current_date_start" column_invisible="True"/>
                        <field name="new_date_start"     column_invisible="True"/>
                        <field name="workcenter_label"   column_invisible="True"/>
                        <field name="product_qty_display" column_invisible="True"/>

                    </list>
                </field>

                <footer>
                    <button name="action_recalculate"
                            type="object"
                            string="Calcular"
                            class="btn-secondary"/>
                    <button name="action_apply"
                            type="object"
                            string="Confirmar"
                            class="btn-primary"
                            invisible="not has_lines"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>


    <!-- Vista Gantt nativa para líneas de reprogramación -->
    <record id="mrp_reschedule_wizard_line_gantt" model="ir.ui.view">
        <field name="name">mrp.reschedule.wizard.line.gantt</field>
        <field name="model">mrp.reschedule.wizard.line</field>
        <field name="arch" type="xml">
            <gantt date_start="new_date_start"
                   date_stop="new_date_finish"
                   string="Cambios propuestos"
                   default_scale="week"
                   create="0"
                   edit="0"
                   delete="0">
                <field name="record_label"/>
                <field name="description_label"/>
                <field name="workcenter_label"/>
                <field name="product_qty_display"/>
                <field name="state_display"/>
                <field name="is_anchor"/>
                <field name="apply"/>
            </gantt>
        </field>
    </record>

</odoo>
