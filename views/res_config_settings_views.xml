<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Registro singleton del planificador (se crea una sola vez) -->
    <data noupdate="1">
        <record id="mrp_reschedule_config_singleton" model="mrp.reschedule.config">
            <field name="wc_fallback">ldm</field>
            <field name="priority">chronological</field>
            <field name="cron_interval_number">30</field>
            <field name="cron_interval_type">minutes</field>
        </record>
    </data>

    <!-- Vista del formulario de configuración dedicado -->
    <record id="mrp_reschedule_config_form_view" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.form</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="arch" type="xml">
            <form string="Configuración del planificador" create="false" delete="false">
                <sheet>
                    <h2>Planificador de producción</h2>
                    <notebook>

                        <!-- ══ GENERAL ═══════════════════════════════════════════ -->
                        <page string="General" name="general">
                            <div class="row">
                                <div class="col-6">
                                    <group string="Alertas — Frecuencia de actualización">
                                        <label for="cron_interval_number" string="Revisar alertas cada"/>
                                        <div class="o_row">
                                            <field name="cron_interval_number" class="o_field_small"
                                                   help="Frecuencia con que el cron de detección revisa las OFs y OCs para generar o resolver alertas automáticamente."/>
                                            <field name="cron_interval_type" class="ms-2" nolabel="1"/>
                                        </div>
                                    </group>
                                </div>
                                <div class="col-6">
                                    <group string="Depósitos por usuario">
                                        <div class="text-muted small mb-3">
                                            Configurá qué depósitos puede ver cada usuario en el Planificador MRP.
                                            Por defecto todos los usuarios ven todos los depósitos.
                                        </div>
                                        <button name="action_open_user_warehouses"
                                                type="object"
                                                string="Gestionar depósitos por usuario →"
                                                class="btn btn-primary"/>
                                    </group>
                                </div>
                            </div>
                        </page>

                        <!-- ══ PRODUCCIÓN ════════════════════════════════════════ -->
                        <page string="Producción" name="production">
                            <div class="row">

                                <!-- Columna izquierda: reprogramación -->
                                <div class="col-6">
                                    <group string="Reprogramación — Centro de trabajo sin configurar">
                                        <field name="wc_fallback" widget="radio" nolabel="1"
                                               help="Qué hace el planificador cuando un producto no tiene centros de trabajo compatibles configurados."/>
                                    </group>
                                    <group string="Reprogramación — Criterio de prioridad">
                                        <field name="priority" widget="radio" nolabel="1"
                                               help="Criterio con que se ordenan las OFs cuando compiten por el mismo centro de trabajo. Cronológico: prioriza la OF con fecha de inicio más próxima. SPT (más cortas primero): minimiza el tiempo de espera promedio. Manual: el operador arrastra y ordena las OFs en el wizard de reprogramación."/>
                                    </group>
                                    <group string="Reprogramación — Opciones avanzadas">
                                        <field name="include_wc_heuristic" widget="boolean_toggle"
                                               help="Incluye OFs que comparten centros de trabajo con el pivot como dependientes. Puede generar reprogramaciones masivas en instalaciones con alta carga de CTs."/>
                                    </group>
                                </div>

                                <!-- Columna derecha: alertas y quiebres -->
                                <div class="col-6">
                                    <group string="Alertas — Órdenes de fabricación">
                                        <field name="alert_mo_critical_days"
                                               help="Días de retraso a partir de los cuales una OF pasa a alerta roja."/>
                                        <field name="alert_mo_warning_days"
                                               help="Días antes del vencimiento en que se genera la alerta 'por vencer' para las OFs."/>
                                        <field name="qty_tolerance_pct"
                                               help="Diferencia porcentual máxima entre cantidad planificada y producida sin disparar alerta."/>
                                    </group>
                                    <group string="Quiebres de stock">
                                        <field name="stock_location_id"
                                               help="Ubicación interna desde la cual se mide el stock en el widget de quiebres."/>
                                    </group>
                                </div>

                            </div>
                        </page>

                        <!-- ══ COMPRAS ══════════════════════════════════════════ -->
                        <page string="Compras" name="purchases">
                            <div class="row">

                                <!-- Columna izquierda: alertas + panel + umbrales análisis -->
                                <div class="col-6">
                                    <group string="Alertas — OCs y recepciones">
                                        <field name="alert_po_critical_days"
                                               help="Días de retraso a partir de los cuales una OC vencida pasa de alerta amarilla a roja."/>
                                        <field name="alert_po_warning_days"
                                               help="Días antes del vencimiento en que se genera una alerta 'por vencer' para las OCs."/>
                                        <field name="alert_receipt_critical_days"
                                               help="Días de retraso a partir de los cuales una recepción atrasada pasa de alerta amarilla a roja."/>
                                    </group>
                                    <group string="Panel de compras">
                                        <field name="show_po_services_tab"
                                               help="Cuando está activo, las OCs de servicios se muestran en una pestaña propia dentro del widget de OCs."/>
                                        <field name="supplier_analysis_date_field"
                                               help="Campo de fecha que se usa para filtrar OCs en el análisis de proveedores."/>
                                    </group>
                                    <group string="Análisis de proveedores — Umbrales de color">
                                        <field name="sup_on_time_green_pct"   help="% entregas a tiempo ≥ este valor → verde."/>
                                        <field name="sup_on_time_yellow_pct"  help="% entregas a tiempo ≥ este valor (y menor que verde) → amarillo."/>
                                        <field name="sup_delay_green_days"    help="Retraso promedio ≤ este valor → verde."/>
                                        <field name="sup_delay_yellow_days"   help="Retraso promedio ≤ este valor (y mayor que verde) → amarillo."/>
                                        <field name="sup_complete_green_pct"  help="% recepciones completas ≥ este valor → verde."/>
                                        <field name="sup_complete_yellow_pct" help="% recepciones completas ≥ este valor (y menor que verde) → amarillo."/>
                                        <field name="sup_price_var_green_pct"  help="|Variación de precio| ≤ este % → verde."/>
                                        <field name="sup_price_var_yellow_pct" help="|Variación de precio| ≤ este % (y mayor que verde) → amarillo."/>
                                    </group>
                                </div>

                                <!-- Columna derecha: categorías de proveedor -->
                                <div class="col-6">
                                    <group string="Categorías de proveedor">
                                        <field name="enable_supplier_categories" widget="boolean_toggle"
                                               help="Activa el campo Categoría de proveedor (A–E) en los contactos y lo muestra en la tabla de análisis de proveedores."/>
                                        <div invisible="not enable_supplier_categories" class="mt-2">
                                            <div class="row">
                                                <div class="col-7">
                                                    <div class="o_planner_method_radio">
                                                        <field name="supplier_cat_method" widget="radio" nolabel="1"/>
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'manual'">
                                                        Asignás la categoría directamente desde la ficha de cada proveedor. No se recalcula automáticamente.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_volume'">
                                                        <b>Pareto por importe:</b> ordena proveedores de mayor a menor importe de OCs confirmadas en el último año. Primero 20% acumulado = A, hasta 50% = B, hasta 80% = C, hasta 95% = D, resto = E.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_frequency'">
                                                        <b>Pareto por cantidad de OCs:</b> igual que por volumen pero usa el número de órdenes como peso. Favorece proveedores con alta frecuencia de compra independientemente del importe.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_rfm'">
                                                        <b>Recencia + Frecuencia + Monetario (1–3 pts c/u):</b> Recencia: &lt;30 d = 3 pts, &lt;90 d = 2 pts, resto = 1 pt. Frecuencia: &gt;10 OCs = 3 pts, ≥3 = 2 pts, resto = 1 pt. Monetario: percentil 33/66 del grupo. Suma 8–9 = A, 6–7 = B, 4–5 = C, 3 = D, &lt;3 = E.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_delivery_pct'">
                                                        <b>Pareto por % entrega a tiempo:</b> calcula qué porcentaje de recepciones de cada proveedor llegaron en la fecha planificada o antes. Mayor % = mejor categoría (A).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_price_var'">
                                                        <b>Pareto invertido por variación de precio:</b> promedio de |precio OC − costo estándar| / costo estándar × 100 por proveedor. Menor variación = mejor categoría (A).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_quality_qty'">
                                                        <b>Pareto por exactitud de cantidad:</b> % de líneas de recepción donde la cantidad recibida coincide con la pedida (tolerancia 0,001 u.). Mayor exactitud = mejor categoría (A).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_quality_returns'">
                                                        <b>Pareto invertido por devoluciones:</b> cantidad de recepciones revertidas al proveedor en el último año. Menos devoluciones = mejor categoría (A).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="supplier_cat_method != 'abc_quality_combo'">
                                                        <b>Combinado entrega + cantidad:</b> promedio simple entre % de recepciones a tiempo y % de recepciones sin diferencia de cantidad. Mayor score = mejor categoría (A).
                                                    </div>
                                                </div>
                                                <div class="col-5">
                                                    <div invisible="supplier_cat_method == 'manual'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Frecuencia de actualización</span>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <field name="supplier_cat_cron_number" nolabel="1"/>
                                                            <field name="supplier_cat_cron_type" nolabel="1"/>
                                                        </div>
                                                    </div>
                                                    <div invisible="supplier_cat_method in ('manual', 'abc_rfm')" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Umbrales Pareto (%)</span>
                                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                                            <span class="text-muted small">A ≤</span>
                                                            <field name="abc_pct_a" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">B ≤</span>
                                                            <field name="abc_pct_b" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">C ≤</span>
                                                            <field name="abc_pct_c" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">D ≤</span>
                                                            <field name="abc_pct_d" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">E = resto</span>
                                                        </div>
                                                    </div>
                                                    <button name="action_compute_supplier_categories"
                                                            type="object"
                                                            string="Calcular ahora"
                                                            class="btn btn-primary btn-sm"/>
                                                </div>
                                            </div>
                                        </div>
                                    </group>
                                </div>

                            </div>
                        </page>

                        <!-- ══ VENTAS ════════════════════════════════════════════ -->
                        <page string="Ventas" name="sales">
                            <div class="row">

                                <!-- Columna izquierda: categorías de venta y cliente -->
                                <div class="col-6">

                                    <group string="Categorías de venta">
                                        <field name="enable_sale_categories" widget="boolean_toggle"
                                               help="Activa el campo Categoría de venta (A–E) en los productos y permite calcularlo automáticamente según el modo elegido."/>
                                        <div invisible="not enable_sale_categories" class="mt-2">
                                            <div class="row">
                                                <div class="col-7">
                                                    <div class="o_planner_method_radio">
                                                        <field name="sale_cat_mode" widget="radio" nolabel="1"/>
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="sale_cat_mode != 'manual'">
                                                        Asignás la categoría directamente desde la ficha de cada artículo. No se recalcula automáticamente.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="sale_cat_mode != 'automatic'">
                                                        <b>Por rotación de inventario:</b> calcula stock actual ÷ ventas promedio mensual. El resultado en días se compara con los umbrales configurados (ej.: ≤30 d = A, ≤60 d = B…).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="sale_cat_mode != 'demand'">
                                                        <b>Por volumen de demanda:</b> promedia las unidades entregadas por mes en el período de análisis y compara con los umbrales mínimos A/B/C/D (ej.: ≥100 u/mes = A, ≥50 = B…).
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="sale_cat_mode != 'share'">
                                                        <b>Por participación acumulada (Pareto):</b> ordena todos los artículos por la métrica elegida y asigna categoría por % acumulado del total. Los que generan el primer X% = A, siguiente tramo = B, etc.
                                                    </div>
                                                </div>
                                                <div class="col-5">
                                                    <div invisible="sale_cat_mode == 'manual'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Período de análisis</span>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <field name="sale_cat_lookback_months" nolabel="1"/>
                                                            <span class="text-muted small">meses</span>
                                                        </div>
                                                    </div>
                                                    <!-- Umbrales rotación -->
                                                    <div invisible="sale_cat_mode != 'automatic'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Umbrales — Rotación (días)</span>
                                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                                            <span class="text-muted small">A ≤</span>
                                                            <field name="sale_cat_a_days" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">B ≤</span>
                                                            <field name="sale_cat_b_days" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">C ≤</span>
                                                            <field name="sale_cat_c_days" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">D ≤</span>
                                                            <field name="sale_cat_d_days" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">E = resto</span>
                                                        </div>
                                                    </div>
                                                    <!-- Umbrales demanda -->
                                                    <div invisible="sale_cat_mode != 'demand'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Umbrales — Demanda (u./mes)</span>
                                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                                            <span class="text-muted small">A ≥</span>
                                                            <field name="sale_cat_demand_a_qty" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">B ≥</span>
                                                            <field name="sale_cat_demand_b_qty" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">C ≥</span>
                                                            <field name="sale_cat_demand_c_qty" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">D ≥</span>
                                                            <field name="sale_cat_demand_d_qty" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">E = resto</span>
                                                        </div>
                                                    </div>
                                                    <!-- Umbrales participación -->
                                                    <div invisible="sale_cat_mode != 'share'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Métrica</span>
                                                        <field name="sale_cat_share_metric" widget="radio" nolabel="1"/>
                                                        <span class="fw-semibold d-block mb-1 mt-2" style="font-size:0.85rem; color:#6c757d;">Umbrales — Participación (%)</span>
                                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                                            <span class="text-muted small">A ≤</span>
                                                            <field name="sale_cat_share_a_pct" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">B ≤</span>
                                                            <field name="sale_cat_share_b_pct" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">C ≤</span>
                                                            <field name="sale_cat_share_c_pct" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">D ≤</span>
                                                            <field name="sale_cat_share_d_pct" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">E = resto</span>
                                                        </div>
                                                    </div>
                                                    <!-- Actualización automática -->
                                                    <div invisible="sale_cat_mode == 'manual'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Frecuencia de actualización</span>
                                                        <div class="d-flex align-items-center gap-2 mb-2">
                                                            <field name="sale_cat_auto_cron" widget="boolean_toggle" nolabel="1"/>
                                                            <span class="text-muted small">Automática</span>
                                                        </div>
                                                        <div invisible="not sale_cat_auto_cron" class="d-flex align-items-center gap-2">
                                                            <field name="sale_cat_cron_number" nolabel="1"/>
                                                            <field name="sale_cat_cron_type" nolabel="1"/>
                                                        </div>
                                                    </div>
                                                    <button name="action_auto_assign_sale_categories"
                                                            type="object"
                                                            string="Asignar ahora"
                                                            class="btn btn-primary btn-sm"/>
                                                </div>
                                            </div>
                                        </div>
                                    </group>

                                    <group string="Categorías de cliente">
                                        <field name="enable_customer_categories" widget="boolean_toggle"
                                               help="Activa el campo Categoría de cliente (A–E) en los contactos y permite calcularlo automáticamente según el método elegido."/>
                                        <div invisible="not enable_customer_categories" class="mt-2">
                                            <div class="row">
                                                <div class="col-7">
                                                    <div class="o_planner_method_radio">
                                                        <field name="customer_cat_method" widget="radio" nolabel="1"/>
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="customer_cat_method != 'manual'">
                                                        Asignás la categoría directamente desde la ficha de cada cliente. No se recalcula automáticamente.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="customer_cat_method != 'abc_volume'">
                                                        <b>Pareto por importe de SOs:</b> ordena clientes de mayor a menor importe de SOs confirmadas en el último año. Primero 20% acumulado = A, hasta 50% = B, hasta 80% = C, hasta 95% = D, resto = E.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="customer_cat_method != 'abc_frequency'">
                                                        <b>Pareto por cantidad de SOs:</b> igual que por volumen pero usa el número de pedidos como peso. Favorece clientes con alta frecuencia de compra independientemente del importe.
                                                    </div>
                                                    <div class="text-muted small border-start border-2 ps-2 mt-2"
                                                         invisible="customer_cat_method != 'abc_rfm'">
                                                        <b>Recencia + Frecuencia + Monetario (1–3 pts c/u):</b> Recencia: &lt;30 d = 3 pts, &lt;90 d = 2 pts, resto = 1 pt. Frecuencia: &gt;10 SOs = 3 pts, ≥3 = 2 pts, resto = 1 pt. Monetario: percentil 33/66 del grupo. Suma 8–9 = A, 6–7 = B, 4–5 = C, 3 = D, &lt;3 = E.
                                                    </div>
                                                </div>
                                                <div class="col-5">
                                                    <div invisible="customer_cat_method == 'manual'" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Frecuencia de actualización</span>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <field name="customer_cat_cron_number" nolabel="1"/>
                                                            <field name="customer_cat_cron_type" nolabel="1"/>
                                                        </div>
                                                    </div>
                                                    <div invisible="customer_cat_method in ('manual', 'abc_rfm')" class="mb-3">
                                                        <span class="fw-semibold d-block mb-1" style="font-size:0.85rem; color:#6c757d;">Umbrales Pareto (%)</span>
                                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                                            <span class="text-muted small">A ≤</span>
                                                            <field name="abc_pct_a" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">B ≤</span>
                                                            <field name="abc_pct_b" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">C ≤</span>
                                                            <field name="abc_pct_c" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">D ≤</span>
                                                            <field name="abc_pct_d" nolabel="1" style="width:52px;"/>
                                                            <span class="text-muted small">E = resto</span>
                                                        </div>
                                                        <div class="text-muted" style="font-size:0.75rem; margin-top:4px;">
                                                            Mismos umbrales que categorías de proveedor.
                                                        </div>
                                                    </div>
                                                    <button name="action_compute_customer_categories"
                                                            type="object"
                                                            string="Calcular ahora"
                                                            class="btn btn-primary btn-sm"/>
                                                </div>
                                            </div>
                                        </div>
                                    </group>

                                </div>

                                <!-- Columna derecha: forecast -->
                                <div class="col-6">
                                    <group string="Forecast — Visualización">
                                        <field name="forecast_default_months"
                                               help="Cantidad de meses a mostrar por defecto al abrir el widget de forecast."/>
                                        <field name="forecast_warning_pct"
                                               help="Cobertura por debajo de este % se muestra en amarillo (aviso)."/>
                                        <field name="forecast_critical_pct"
                                               help="Cobertura por debajo de este % se muestra en rojo (crítico)."/>
                                    </group>
                                    <group string="Forecast — Método de rotación">
                                        <field name="forecast_rotation_method" widget="radio" nolabel="1"/>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_rotation_method != 'units'">
                                            <b>Por unidades:</b> días del período × stock actual ÷ total entregado.
                                            No requiere valorización de stock. Ideal para comparar velocidad de rotación entre productos.
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_rotation_method != 'cogs'">
                                            <b>Por COGS (a costo):</b> días del período × inventario promedio (valorizado a costo) ÷ costo de lo vendido en el período.
                                            La más correcta contablemente. Requiere valorización de stock activa (AVCO o FIFO).
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_rotation_method != 'sales'">
                                            <b>Por ventas (a precio):</b> días del período × inventario promedio (a costo) ÷ ventas netas (a precio de venta).
                                            Mezcla costo e ingreso — menos precisa, pero más intuitiva para el área comercial.
                                        </div>
                                        <field name="forecast_rotation_unit"
                                               help="Unidad en que se muestra la rotación de inventario: días o meses."
                                               class="mt-2"/>
                                    </group>
                                    <group string="Forecast — Precisión">
                                        <field name="forecast_acc_formula" widget="radio" nolabel="1"/>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_acc_formula != 'simple'">
                                            <b>Simple:</b> entregado ÷ forecast × 100. Fácil de interpretar pero puede superar 100% si se sobre-entrega.
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_acc_formula != 'mape'">
                                            <b>MAPE — Error porcentual absoluto medio:</b> promedia los errores porcentuales por período. Muy sensible a períodos con volumen real bajo o cero.
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_acc_formula != 'wape'">
                                            <b>WAPE — Error porcentual absoluto ponderado:</b> pondera por volumen real; robusto cuando hay ceros en el forecast. Recomendado para demanda intermitente.
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_acc_formula != 'wmape'">
                                            <b>WMAPE — Error ponderado por forecast:</b> pondera por el volumen planificado. Estándar en supply chain cuando los planes son el punto de referencia.
                                        </div>
                                        <div class="text-muted small border-start border-2 ps-2 mt-1"
                                             invisible="forecast_acc_formula != 'bias'">
                                            <b>Sesgo (Bias):</b> (entregado − forecast) / forecast × 100. Positivo = sobreentrega. Negativo = déficit. Mide dirección sistemática, no magnitud del error.
                                        </div>
                                    </group>
                                    <group string="Forecast — OFs incluidas en la cobertura">
                                        <field name="forecast_mo_state_draft"     widget="boolean_toggle"/>
                                        <field name="forecast_mo_state_confirmed" widget="boolean_toggle"/>
                                        <field name="forecast_mo_state_progress"  widget="boolean_toggle"/>
                                        <field name="forecast_mo_state_to_close"  widget="boolean_toggle"/>
                                        <field name="forecast_mo_state_done"      widget="boolean_toggle"/>
                                    </group>
                                </div>

                            </div>
                        </page>


                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mrp_reschedule_config" model="ir.actions.act_window">
        <field name="name">Configuración del planificador</field>
        <field name="res_model">mrp.reschedule.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_reschedule_config_form_view"/>
        <field name="res_id" ref="mrp_reschedule_config_singleton"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False, 'no_pager': 1}</field>
    </record>

    <menuitem id="mrp_reschedule_menu_config"
              name="Configuración"
              parent="mrp_planner_menu_root"
              sequence="99"
              action="action_mrp_reschedule_config"
              groups="odoo_mrp_planner.group_admin,base.group_system"/>

    <!-- Herencia: agrega toggle de rotación al grupo Quiebres de stock -->
    <record id="mrp_reschedule_config_form_view_rotation" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.form.rotation</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="inherit_id" ref="mrp_reschedule_config_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stock_location_id']" position="after">
                <field name="stock_break_show_rotation"
                       widget="boolean_toggle"
                       help="Muestra la columna de rotación de inventario en la tabla de quiebres de stock."/>
                <field name="stock_break_rotation_method"
                       widget="radio"
                       invisible="not stock_break_show_rotation"
                       help="Fórmula base para calcular la rotación en el widget de quiebres de stock."/>
                <div class="text-muted small border-start border-2 ps-2 mt-1"
                     invisible="not stock_break_show_rotation or stock_break_rotation_method != 'units'">
                    <b>Por unidades:</b> stock actual ÷ (entregas del período ÷ meses configurados) × 30.
                    No requiere valorización de stock. Ideal para medir cuántos días de stock quedan al ritmo de despacho actual.
                </div>
                <div class="text-muted small border-start border-2 ps-2 mt-1"
                     invisible="not stock_break_show_rotation or stock_break_rotation_method != 'cogs'">
                    <b>Por COGS (a costo):</b> días del período × inventario promedio (valorizado a costo) ÷ costo de lo vendido en el período.
                    La más correcta contablemente. Requiere valorización de stock activa (AVCO o FIFO).
                </div>
                <div class="text-muted small border-start border-2 ps-2 mt-1"
                     invisible="not stock_break_show_rotation or stock_break_rotation_method != 'sales'">
                    <b>Por ventas (a precio):</b> días del período × inventario promedio (a costo) ÷ ventas netas (a precio de venta).
                    Mezcla costo e ingreso — menos precisa, pero más intuitiva para el área comercial.
                </div>
                <field name="stock_break_rotation_months"
                       invisible="not stock_break_show_rotation"
                       help="Cantidad de meses de historial a considerar para calcular la rotación en quiebres de stock."/>
                <field name="stock_break_rotation_alerts_enabled"
                       widget="boolean_toggle"
                       invisible="not stock_break_show_rotation"/>
                <div class="d-flex align-items-center gap-2"
                     invisible="not stock_break_show_rotation or not stock_break_rotation_alerts_enabled">
                    <field name="stock_break_rotation_warn_days"/>
                    <span class="text-muted small">días → amarillo</span>
                    <field name="stock_break_rotation_critical_days"/>
                    <span class="text-muted small">días → rojo ⚠</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Bloque en Ajustes → Fabricación (mantiene compatibilidad con el menú estándar) -->
    <record id="res_config_settings_view_mrp_reschedule" model="ir.ui.view">
        <field name="name">res.config.settings.view.mrp.reschedule</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mrp.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='mrp']" position="inside">
                <block title="Planificador de producción" name="mrp_reschedule_block">
                    <setting
                        string="Centro de trabajo sin configurar"
                        help="Qué hace el planificador cuando un producto no tiene centros de trabajo compatibles definidos.">
                        <field name="mrp_reschedule_wc_fallback"/>
                    </setting>
                    <setting
                        string="Criterio de prioridad"
                        help="Orden en que se programan las OFs cuando compiten por el mismo WC.">
                        <field name="mrp_reschedule_priority"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
