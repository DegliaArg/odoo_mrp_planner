<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Artículo: pestaña Planificador (centros de trabajo compatibles) ── -->
    <record id="product_template_form_scheduling_workcenters" model="ir.ui.view">
        <field name="name">product.template.form.scheduling.workcenters</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="mrp_enable_scheduling" invisible="1"/>
            </field>
            <!-- Pestaña de scheduling: solo centros de trabajo compatibles. Desaparece
                 cuando la programación está desactivada. -->
            <xpath expr="//notebook" position="inside">
                <page string="Planificador" name="mrp_planner_tab"
                      invisible="not mrp_enable_scheduling">
                    <group string="Centros de trabajo">
                        <field name="x_centros_compatibles" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="workcenter_id" required="1"/>
                                <field name="is_preferred"/>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="exclusion_reason" invisible="active"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
