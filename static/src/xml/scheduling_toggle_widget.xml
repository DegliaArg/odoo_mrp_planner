<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="odoo_mrp_planner.SchedulingToggleField">
        <div class="o_field_boolean_toggle form-check form-switch ms-1">
            <input t-ref="checkbox"
                   class="form-check-input"
                   type="checkbox"
                   role="switch"
                   t-att-checked="value"
                   t-att-disabled="props.readonly"
                   t-on-change="onChange"/>
        </div>
    </t>
</templates>
