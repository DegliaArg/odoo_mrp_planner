<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- Panel de análisis detallado de un cliente individual (KPI strip, gráfico
     de evolución mensual, mix de familias y top artículos).
     Llamado desde CustomerAnalysisRow; requiere `row` y `state` en scope. -->
<t t-name="odoo_mrp_planner.CustomerAnalysisDetailPanel">

    <tr t-if="state.panelPartnerId === row.partner_id">
        <td t-att-colspan="staticVisibleCols.length + 2"
            style="padding:12px 16px; background:#f8f9fa; border-top:none;">

            <t t-if="state.panelLoading">
                <div class="d-flex align-items-center gap-2 py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"/>
                    <span class="text-muted small">Cargando análisis…</span>
                </div>
            </t>

            <t t-if="!state.panelLoading and state.panelData">

                <!-- KPI strip -->
                <div class="row g-2 mb-3">
                    <div class="col">
                        <div class="card h-100" title="Total de unidades pedidas en el período (suma de qty de todas las líneas).">
                            <div class="card-body text-center py-2">
                                <div class="fw-bold" style="font-size:1rem;" t-esc="fmtQty(state.panelData.total_qty_ordered)"/>
                                <div class="small text-muted">Piezas</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" title="Suma del importe sin impuestos de todos los pedidos del cliente en el período.">
                            <div class="card-body text-center py-2">
                                <div class="fw-bold" style="font-size:1rem;" t-esc="fmtMoney(row.total_amount)"/>
                                <div class="small text-muted">Monto total</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" title="Pedidos confirmados del cliente en el período.">
                            <div class="card-body text-center py-2">
                                <div class="fw-bold" style="font-size:1rem;" t-esc="fmt(row.order_count)"/>
                                <div class="small text-muted">Pedidos</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" t-att-title="cellTooltip('avg_ticket', row)">
                            <div class="card-body text-center py-2">
                                <div class="fw-bold" style="font-size:1rem;" t-esc="fmtMoney(row.avg_ticket)"/>
                                <div class="small text-muted">Ticket promedio</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" t-att-title="cellTooltip('delivery_pct', row)">
                            <div class="card-body text-center py-2">
                                <div t-att-class="'fw-bold ' + deliveryClass(row.delivery_pct)" style="font-size:1rem;" t-esc="fmtPct(row.delivery_pct)"/>
                                <div class="small text-muted">% Entrega</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" t-att-title="cellTooltip('ontime_pct', row)">
                            <div class="card-body text-center py-2">
                                <div t-att-class="'fw-bold ' + ontimeClass(row.ontime_pct)" style="font-size:1rem;" t-esc="fmtPct(row.ontime_pct)"/>
                                <div class="small text-muted">% A tiempo</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100" t-att-title="cellTooltip('days_since_last', row)">
                            <div class="card-body text-center py-2">
                                <div t-att-class="'fw-bold ' + riskClass(row.days_since_last)" style="font-size:1rem;">
                                    <t t-esc="row.days_since_last"/> d
                                </div>
                                <div class="small text-muted">Sin comprar</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => this.openCustomerOrders(row.partner_id)">Ver →</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Sección gráficos: donuts + gráfico unificado -->
                <t t-if="state.panelData.monthly_data and state.panelData.monthly_data.length">

                    <!-- Controles: tipo de gráfico + métrica -->
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="o_planner_section_title" style="margin-bottom:0;">
                            <i class="fa fa-bar-chart me-1 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución</span>
                        </div>
                        <div class="btn-group btn-group-sm ms-auto" role="group">
                            <button t-att-class="state.panelChartMode === 'bar'  ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelChartMode('bar')">
                                <i class="fa fa-bar-chart me-1"/>Barras
                            </button>
                            <button t-att-class="state.panelChartMode === 'line' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelChartMode('line')">
                                <i class="fa fa-line-chart me-1"/>Línea
                            </button>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button t-att-class="state.panelMetric === 'amount' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelMetric('amount')">
                                $ Monto
                            </button>
                            <button t-att-class="state.panelMetric === 'qty' ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                    style="font-size:11px; padding:1px 8px;"
                                    t-on-click="() => this.setPanelMetric('qty')">
                                # Piezas
                            </button>
                        </div>
                    </div>

                    <!-- Fila de donuts: cat. venta (izq.) + familias (der.) -->
                    <div class="d-flex gap-3 mb-2 align-items-start">

                        <!-- Donut: mix por categoría de venta -->
                        <t t-if="state.panelData.sale_category_mix and state.panelData.sale_category_mix.length">
                            <div style="flex:1; min-width:0; overflow:hidden;">
                                <div class="o_planner_section_title mb-1">
                                    <i class="fa fa-pie-chart me-1 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Mix cat. venta</span>
                                </div>
                                <div class="d-flex gap-2" style="height:160px;">
                                    <div style="flex:0 0 120px; position:relative;">
                                        <canvas t-ref="panelSaleCatCanvas"/>
                                    </div>
                                    <div style="flex:1; overflow-y:auto; min-width:0; display:flex; flex-direction:column; gap:4px; padding-top:2px;">
                                        <t t-foreach="state.panelData.sale_category_mix" t-as="sc" t-key="sc.name">
                                            <div class="d-flex align-items-center gap-1" style="min-width:0;">
                                                <span t-att-style="'flex-shrink:0; display:inline-block; width:10px; height:10px; border-radius:2px; background:' + saleCatColor(sc.name)"/>
                                                <span class="small fw-bold" style="flex-shrink:0; font-size:11px;" t-esc="sc.name"/>
                                                <span class="small text-muted ms-auto" style="flex-shrink:0; font-size:11px;"
                                                      t-esc="(state.panelMetric === 'qty' ? sc.pct : sc.pct_amount) + '%'"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- Donut: mix de familias -->
                        <t t-if="state.panelData.family_mix and state.panelData.family_mix.length">
                            <div style="flex:1; min-width:0; overflow:hidden;">
                                <div class="o_planner_section_title mb-1">
                                    <i class="fa fa-pie-chart me-1 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Mix familias</span>
                                </div>
                                <div class="d-flex gap-2" style="height:160px;">
                                    <div style="flex:0 0 120px; position:relative;">
                                        <canvas t-ref="panelDonutCanvas"/>
                                    </div>
                                    <div style="flex:1; overflow-y:auto; min-width:0; display:flex; flex-direction:column; gap:4px; padding-top:2px;">
                                        <t t-foreach="state.panelData.family_mix" t-as="f" t-key="f_index">
                                            <div class="d-flex align-items-center gap-1" style="min-width:0;">
                                                <span t-att-style="'flex-shrink:0; display:inline-block; width:10px; height:10px; border-radius:2px; background:' + donutColor(f_index)"/>
                                                <span class="small text-truncate" style="flex:1; min-width:0; font-size:11px;" t-esc="f.name"/>
                                                <span class="small text-muted ms-1" style="flex-shrink:0; font-size:11px;"
                                                      t-esc="(state.panelMetric === 'qty' ? f.pct : f.pct_amount) + '%'"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Gráfico unificado (barras o línea) -->
                    <div style="position:relative; height:190px; width:100%; overflow:hidden;">
                        <canvas t-ref="panelBarCanvas"/>
                    </div>

                </t>

                <!-- Top artículos -->
                <t t-if="state.panelData.top_products and state.panelData.top_products.length">
                    <div class="d-flex align-items-center gap-2 mt-3 mb-1">
                        <div class="o_planner_section_title" style="margin-bottom:0;">
                            <i class="fa fa-cubes me-1 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Top artículos</span>
                        </div>
                        <div class="btn-group btn-group-sm ms-auto" role="group">
                            <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                                <button t-att-class="state.panelTopN === n ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                        style="font-size:11px; padding:1px 8px;"
                                        t-on-click="() => this.setPanelTopN(n)">
                                    <t t-esc="'Top ' + n"/>
                                </button>
                            </t>
                        </div>
                    </div>
                    <div class="border rounded bg-white" style="overflow:auto; max-height:220px;">
                        <table class="table table-sm table-hover mb-0" style="font-size:11px;">
                            <thead style="position:sticky; top:0; background:#f8f9fa; z-index:1;">
                                <tr>
                                    <th style="padding:3px 6px; width:24px;">#</th>
                                    <t t-foreach="[
                                        {key:'name',          label:'Artículo',   cls:'',            tip:'Nombre del artículo (variante de producto). Clic para abrir ficha.'},
                                        {key:'sale_category', label:'Cat.',        cls:'text-center', tip:'Categoría de venta A–E asignada al artículo.'},
                                        {key:'family',        label:'Familia',     cls:'',            tip:'Familia (categoría interna) del producto.'},
                                        {key:'qty_ordered',   label:'Pedido',      cls:'text-end',    tip:'Total de unidades pedidas del artículo en el período.'},
                                        {key:'qty_delivered', label:'Entregado',   cls:'text-end',    tip:'Total de unidades entregadas (qty_delivered) en el período.'},
                                        {key:'amount',        label:'Monto',       cls:'text-end',    tip:'Importe total sin impuestos de las líneas del artículo en el período.'},
                                        {key:'delivery_pct',  label:'% Entrega',   cls:'text-end',    tip:'Entregado ÷ Pedido × 100. Semáforo configurable en Ajustes.'},
                                        {key:'order_count',   label:'OVs',         cls:'text-end',    tip:'Cantidad de órdenes de venta que incluyen este artículo.'},
                                    ]" t-as="col" t-key="col.key">
                                        <th t-att-class="col.cls + ' user-select-none'"
                                            t-att-title="col.tip"
                                            style="padding:3px 8px; cursor:pointer; white-space:nowrap;"
                                            t-on-click="() => this.sortPanelProds(col.key)">
                                            <t t-esc="col.label"/>
                                            <t t-if="state.panelProdSort === col.key">
                                                <i t-att-class="state.panelProdDir === 'desc' ? 'fa fa-sort-desc ms-1' : 'fa fa-sort-asc ms-1'"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-sort ms-1 text-muted" style="opacity:0.35;"/>
                                            </t>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="panelTopProducts" t-as="prod" t-key="prod_index">
                                    <tr>
                                        <td class="text-muted" style="padding:2px 6px;">
                                            <t t-esc="prod_index + 1"/>
                                        </td>
                                        <td style="padding:2px 8px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                            t-att-title="prod.name">
                                            <a href="#" class="text-decoration-none"
                                               t-on-click.prevent="() => this.openProduct(prod.tmpl_id)"
                                               t-esc="prod.name"/>
                                        </td>
                                        <td class="text-center" style="padding:2px 8px;">
                                            <t t-if="prod.sale_category">
                                                <span t-att-style="'display:inline-block; width:18px; height:18px; border-radius:3px; line-height:18px; text-align:center; font-size:10px; font-weight:bold; color:#fff; background:' + saleCatColor(prod.sale_category)"
                                                      t-esc="prod.sale_category"/>
                                            </t>
                                            <t t-else=""><span class="text-muted">—</span></t>
                                        </td>
                                        <td style="padding:2px 8px; max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                            t-att-title="prod.family">
                                            <t t-esc="prod.family or '—'"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmt(prod.qty_ordered)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmt(prod.qty_delivered)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;">
                                            <t t-esc="fmtMoney(prod.amount)"/>
                                        </td>
                                        <td class="text-end" style="padding:2px 8px;"
                                            t-att-title="prodCellTooltip(prod)">
                                            <span t-att-class="deliveryClass(prod.delivery_pct)">
                                                <t t-esc="fmtPct(prod.delivery_pct)"/>
                                            </span>
                                        </td>
                                        <td class="text-end text-muted" style="padding:2px 8px;"
                                            title="Cantidad de OVs que incluyen este artículo en el período.">
                                            <t t-esc="prod.order_count"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>

            </t>

        </td>
    </tr>

</t>

</templates>
