<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="odoo_mrp_planner_scheduling.SchedulingMatrixWidget">
    <div class="sm-root" t-on-click.stop="closeDropdowns">

        <!-- ── Spinner ── -->
        <div t-if="state.loading" class="sm-loading text-center py-5">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            <p class="text-muted mt-2">Cargando tablero…</p>
        </div>

        <!-- ── Error ── -->
        <div t-elif="state.error" class="alert alert-danger m-3">
            <i class="fa fa-exclamation-triangle me-2"/>
            <t t-esc="state.error"/>
        </div>

        <!-- ── Contenido principal ── -->
        <t t-else="">

            <!-- ══ Barra de filtros ════════════════════════════════════════════ -->
            <div class="sm-filters d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom bg-light">

                <!-- Granularidad -->
                <div class="sm-filter-group btn-group btn-group-sm" role="group">
                    <button type="button"
                            t-att-class="'btn ' + (state.granularity === 'day'   ? 'btn-primary' : 'btn-outline-secondary')"
                            t-on-click="() => this.setGranularity('day')">Días</button>
                    <button type="button"
                            t-att-class="'btn ' + (state.granularity === 'week'  ? 'btn-primary' : 'btn-outline-secondary')"
                            t-on-click="() => this.setGranularity('week')">Semanas</button>
                    <button type="button"
                            t-att-class="'btn ' + (state.granularity === 'month' ? 'btn-primary' : 'btn-outline-secondary')"
                            t-on-click="() => this.setGranularity('month')">Meses</button>
                </div>

                <div class="vr mx-1"/>

                <!-- Sector -->
                <div class="sm-filter-group position-relative">
                    <span class="sm-filter-label text-muted small me-1">Sector:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleTagDropdown">
                        <t t-esc="tagFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.tagDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.tagMenuPos.top}px;left:${state.tagMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleTag(tag.id)">
                                <input type="checkbox"
                                       t-att-checked="state.tagIds.includes(tag.id)"
                                       t-on-click.stop="() => this.toggleTag(tag.id)"/>
                                <span t-esc="tag.name"/>
                            </label>
                        </t>
                        <div t-if="!state.tags.length" class="px-3 py-2 text-muted small">
                            Sin sectores configurados
                        </div>
                    </div>
                </div>

                <!-- CT -->
                <div class="sm-filter-group position-relative" t-if="state.wcs.length">
                    <span class="sm-filter-label text-muted small me-1">CT:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleWcDropdown">
                        <t t-esc="wcFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.wcDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.wcMenuPos.top}px;left:${state.wcMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.wcs" t-as="wc" t-key="wc.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleWc(wc.id)">
                                <input type="checkbox"
                                       t-att-checked="state.wcFilterIds.includes(wc.id)"
                                       t-on-click.stop="() => this.toggleWc(wc.id)"/>
                                <span t-esc="wc.name"/>
                            </label>
                        </t>
                    </div>
                </div>

                <div class="vr mx-1"/>

                <!-- Rango de fechas -->
                <div class="sm-filter-group d-flex align-items-center gap-1">
                    <span class="text-muted small">Desde</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                    <span class="text-muted small">hasta</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>

                <div class="vr mx-1"/>

                <!-- Búsqueda -->
                <div class="sm-filter-group">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Buscar OF o producto…"
                               t-att-value="state.searchText"
                               t-on-input="onSearchChange"/>
                    </div>
                </div>

                <!-- Toggle ocultar vacíos -->
                <div class="sm-filter-group d-flex align-items-center gap-2 ms-auto">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="sm-hide-empty"
                               t-att-checked="state.hideEmptyRows"
                               t-on-change="toggleHideEmptyRows"/>
                        <label class="form-check-label small text-muted" for="sm-hide-empty">
                            Ocultar vacíos
                        </label>
                    </div>
                </div>

                <!-- Contador -->
                <div t-if="state.totalMos" class="text-muted small">
                    <strong t-esc="state.totalMos"/> OFs
                </div>

            </div><!-- /sm-filters -->

            <!-- ══ Mensaje inicial ══════════════════════════════════════════════ -->
            <div t-if="!state.tagIds.length"
                 class="text-center text-muted py-5">
                <i class="fa fa-sitemap fa-3x mb-3 d-block"/>
                <p>Seleccioná un <strong>sector</strong> para ver el tablero de programación.</p>
            </div>

            <!-- ══ Sin períodos ═════════════════════════════════════════════════ -->
            <div t-elif="!state.loading and !state.periodKeys.length"
                 class="text-center text-muted py-5">
                <i class="fa fa-calendar-o fa-3x mb-3 d-block"/>
                <p class="fw-semibold">Sin datos en el período seleccionado.</p>
                <p class="small" t-if="state.emptyReason === 'no_dates'">
                    Ajustá el rango de fechas.
                </p>
            </div>

            <!-- ══ Tablero ══════════════════════════════════════════════════════ -->
            <t t-elif="state.periodKeys.length">

                <!-- Slider de períodos -->
                <div t-if="sliderMax > 0"
                     class="sm-slider-wrap d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="prevPage">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <input type="range" class="form-range flex-grow-1"
                           min="0" t-att-max="sliderMax" t-att-value="state.periodPage"
                           t-on-input="onSliderChange"/>
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="nextPage">
                        <i class="fa fa-chevron-right"/>
                    </button>
                    <span class="text-muted small text-nowrap" t-esc="periodRangeLabel"/>
                </div>

                <!-- Tabla -->
                <div class="sm-table-wrap table-responsive">
                    <table class="sm-table table table-bordered mb-0">

                        <!-- ── Cabecera ── -->
                        <thead class="sm-thead">
                            <tr>
                                <th class="sm-th-wc">Máquina</th>
                                <th t-if="state.hasShifts" class="sm-th-shift">Turno</th>
                                <t t-foreach="visiblePeriodKeys" t-as="pk" t-key="pk">
                                    <th class="sm-th-period">
                                        <div class="fw-semibold small"
                                             t-esc="state.periodLabels[pk]?.label"/>
                                        <div class="text-muted sm-period-sub"
                                             t-esc="state.periodLabels[pk]?.date_from
                                                     ? state.periodLabels[pk].date_from + ' – ' + state.periodLabels[pk].date_to
                                                     : state.periodLabels[pk]?.sublabel"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>

                        <!-- ── Filas CT × Turno ── -->
                        <tbody>
                            <t t-foreach="state.filteredRows" t-as="row" t-key="row.row_id">
                                <tr class="sm-row">

                                    <!-- Celda máquina (rowspan cuando hay turnos) -->
                                    <td t-if="row.is_first_shift"
                                        class="sm-wc-cell align-middle"
                                        t-att-rowspan="row.shift_count > 1 ? row.shift_count : false">
                                        <div class="sm-wc-name fw-semibold" t-esc="row.wc_name"/>
                                        <div class="sm-wc-tags mt-1">
                                            <t t-foreach="row.tag_names" t-as="tagName" t-key="tagName">
                                                <span class="badge bg-secondary bg-opacity-25 text-secondary me-1 sm-sector-badge"
                                                      t-esc="tagName"/>
                                            </t>
                                        </div>
                                    </td>

                                    <!-- Celda turno -->
                                    <td t-if="state.hasShifts" class="sm-shift-cell align-middle">
                                        <span class="sm-shift-label small fw-semibold"
                                              t-esc="row.shift_label"/>
                                    </td>

                                    <!-- Celdas por período -->
                                    <t t-foreach="visiblePeriodKeys" t-as="pk" t-key="pk">
                                        <t t-set="cellMos" t-value="row.cells[pk] || []"/>

                                        <td class="sm-cell align-top">

                                            <!-- Chips de OF -->
                                            <t t-foreach="cellMos" t-as="mo" t-key="mo.mo_id">
                                                <div class="sm-chip"
                                                     t-att-class="{ 'sm-chip-expanded': isExpanded(mo.mo_id) }"
                                                     t-on-click.stop="() => this.toggleChip(mo.mo_id)">

                                                    <!-- Línea 1: referencia OF + estado + botón abrir -->
                                                    <div class="sm-chip-header d-flex align-items-center gap-1">
                                                        <span class="sm-chip-ref fw-semibold text-truncate flex-grow-1"
                                                              t-esc="mo.mo_name"/>
                                                        <span class="sm-chip-state badge small"
                                                              t-att-class="moStateClass(mo.state)"
                                                              t-esc="moStateLabel(mo.state)"/>
                                                        <button class="btn btn-link btn-sm p-0 ms-1 sm-open-btn"
                                                                t-att-title="'Abrir ' + mo.mo_name"
                                                                t-on-click="(ev) => this.openMo(ev, mo)">
                                                            <i class="fa fa-external-link small"/>
                                                        </button>
                                                    </div>

                                                    <!-- Línea 2: producto -->
                                                    <div class="sm-chip-product text-truncate"
                                                         t-att-title="mo.product_name"
                                                         t-esc="mo.product_name"/>

                                                    <!-- Línea 3: cantidad · duración · inicio -->
                                                    <div class="sm-chip-meta text-muted small">
                                                        <span t-esc="fmtQty(mo.qty)"/>
                                                        <t t-if="mo.uom">
                                                            <span class="mx-1">·</span>
                                                            <span t-esc="mo.uom"/>
                                                        </t>
                                                        <t t-if="mo.duration_hours">
                                                            <span class="mx-1">·</span>
                                                            <i class="fa fa-clock-o me-1"/>
                                                            <span t-esc="fmtHours(mo.duration_hours)"/>
                                                        </t>
                                                    </div>

                                                    <!-- Componentes expandibles -->
                                                    <div t-if="isExpanded(mo.mo_id)"
                                                         class="sm-chip-components mt-2 border-top pt-1">
                                                        <div t-if="isLoadingComp(mo.mo_id)"
                                                             class="text-muted small text-center py-1">
                                                            <i class="fa fa-spinner fa-spin"/>
                                                        </div>
                                                        <t t-elif="getComponents(mo.mo_id).length">
                                                            <div class="sm-comp-label text-muted small fw-semibold mb-1">
                                                                Componentes:
                                                            </div>
                                                            <t t-foreach="getComponents(mo.mo_id)" t-as="comp" t-key="comp_index">
                                                                <div class="sm-comp-row d-flex justify-content-between small">
                                                                    <span class="text-truncate me-1"
                                                                          t-esc="comp.product_name"/>
                                                                    <span class="text-nowrap text-muted">
                                                                        <t t-esc="fmtQty(comp.qty)"/>
                                                                        <t t-if="comp.uom">
                                                                            <span class="ms-1" t-esc="comp.uom"/>
                                                                        </t>
                                                                    </span>
                                                                </div>
                                                            </t>
                                                        </t>
                                                        <div t-else="" class="text-muted small">Sin componentes.</div>
                                                    </div>

                                                </div><!-- /sm-chip -->
                                            </t><!-- /t-foreach mos -->

                                            <!-- Celda vacía -->
                                            <div t-if="!cellMos.length" class="sm-cell-empty"/>

                                        </td><!-- /sm-cell -->
                                    </t><!-- /t-foreach periods -->

                                </tr><!-- /sm-row -->
                            </t><!-- /t-foreach rows -->

                            <!-- Sin filas visibles -->
                            <tr t-if="!state.filteredRows.length">
                                <td t-att-colspan="visiblePeriodKeys.length + (state.hasShifts ? 2 : 1)"
                                    class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x d-block mb-2"/>
                                    Sin OFs para los filtros seleccionados.
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div><!-- /sm-table-wrap -->

            </t><!-- /t-elif periodKeys -->

        </t><!-- /t-else contenido principal -->

    </div><!-- /sm-root -->
</t>

</templates>
