<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         ACCIÓN SERVIDOR — Producción
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_mrp_planner_dashboard_open" model="ir.actions.server">
        <field name="name">Panel de Producción</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         ACCIÓN SERVIDOR — Compras
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_mrp_planner_compras_open" model="ir.actions.server">
        <field name="name">Panel de Compras</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_compras()</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         VISTA FORM — Panel de Producción
         Muestra: alertas OFs · OFs widget · quiebres de stock · carga WC
    ════════════════════════════════════════════════════════════════════ -->
    <record id="mrp_planner_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.produccion.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Producción" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- Encabezado -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Panel de Producción</h4>
                            </div>
                            <div class="col-auto d-flex gap-2">
                                <button name="action_new_request" type="object"
                                        string="+ Nueva programación"
                                        class="btn btn-primary btn-sm"
                                        invisible="not can_schedule"/>
                                <button name="action_new_plan" type="object"
                                        string="+ Reprogramar OF"
                                        class="btn btn-outline-secondary btn-sm"
                                        invisible="not can_reschedule"/>
                                <button name="action_refresh" type="object"
                                        string="Actualizar"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                            <!-- Campos de permisos (ocultos) -->
                            <field name="can_see_alerts"       invisible="1"/>
                            <field name="can_see_mo"           invisible="1"/>
                            <field name="can_see_stock_breaks" invisible="1"/>
                            <field name="can_schedule"         invisible="1"/>
                            <field name="can_reschedule"       invisible="1"/>
                            <field name="alert_mo_upcoming"    invisible="1"/>
                        </div>

                        <!-- ALERTAS — solo OFs -->
                        <div class="o_planner_section mb-4" invisible="not can_see_alerts">
                            <div class="o_planner_section_title mb-3 gap-2">
                                <i class="fa fa-bell me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Alertas de producción</span>
                                <button name="action_view_critical" type="object"
                                        class="badge bg-danger border-0 text-white ms-2"
                                        style="cursor:pointer"
                                        invisible="alert_critical == 0">
                                    <i class="fa fa-exclamation-circle me-1"/>
                                    <field name="alert_critical" nolabel="1" readonly="1"/> críticas →
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-clock-o fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_mo_delayed" nolabel="1"/></div>
                                            <div class="o_planner_label">OFs atrasadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_mo_delayed_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                                    string="Ver →" invisible="alert_mo_delayed == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-hourglass-half fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning"><field name="alert_mo_upcoming" nolabel="1"/></div>
                                            <div class="o_planner_label">OFs por vencer</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_mo_upcoming_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning"
                                                    string="Ver →" invisible="alert_mo_upcoming == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-balance-scale fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_qty_mismatch" nolabel="1"/></div>
                                            <div class="o_planner_label">Cant. diferentes</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_qty_mismatch_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                                    string="Ver →" invisible="alert_qty_mismatch == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-ban fa-lg text-muted mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_mo_cancelled" nolabel="1"/></div>
                                            <div class="o_planner_label">OFs canceladas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_mo_cancelled_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-muted"
                                                    string="Ver →" invisible="alert_mo_cancelled == 0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ÓRDENES DE FABRICACIÓN -->
                        <div class="o_planner_section mb-4" invisible="not can_see_mo">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-industry me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de fabricación</span>
                            </div>
                            <widget name="mo_dashboard_widget"/>
                        </div>

                        <!-- CARGA DE CENTROS DE TRABAJO -->
                        <div class="o_planner_section mb-4" invisible="not can_see_mo">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-tachometer me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Carga de centros de trabajo</span>
                            </div>
                            <widget name="wc_load_chart"/>
                        </div>

                        <!-- QUIEBRES DE STOCK -->
                        <div class="o_planner_section mb-4" invisible="not can_see_stock_breaks">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-exclamation-triangle me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Quiebres de stock</span>
                            </div>
                            <widget name="stock_break_widget"/>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         VISTA FORM — Panel de Compras
         Muestra: alertas OCs/recepciones · widget OCs
    ════════════════════════════════════════════════════════════════════ -->
    <record id="mrp_compras_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.compras.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Compras" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- Encabezado -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Panel de Compras</h4>
                            </div>
                            <div class="col-auto">
                                <button name="action_refresh_compras" type="object"
                                        string="Actualizar"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                            <!-- Campos de permisos (ocultos) -->
                            <field name="can_see_alerts"    invisible="1"/>
                            <field name="can_see_po"        invisible="1"/>
                            <field name="alert_po_upcoming" invisible="1"/>
                        </div>

                        <!-- ALERTAS — solo OCs y recepciones -->
                        <div class="o_planner_section mb-4" invisible="not can_see_alerts">
                            <div class="o_planner_section_title mb-3 gap-2">
                                <i class="fa fa-bell me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Alertas de compras</span>
                                <button name="action_view_critical" type="object"
                                        class="badge bg-danger border-0 text-white ms-2"
                                        style="cursor:pointer"
                                        invisible="alert_critical == 0">
                                    <i class="fa fa-exclamation-circle me-1"/>
                                    <field name="alert_critical" nolabel="1" readonly="1"/> críticas →
                                </button>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-shopping-cart fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_po_delayed" nolabel="1"/></div>
                                            <div class="o_planner_label">OCs vencidas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_po_delayed_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                                    string="Ver →" invisible="alert_po_delayed == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-hourglass-half fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning"><field name="alert_po_upcoming" nolabel="1"/></div>
                                            <div class="o_planner_label">OCs por vencer</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_po_upcoming_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning"
                                                    string="Ver →" invisible="alert_po_upcoming == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-ban fa-lg text-muted mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_po_cancelled" nolabel="1"/></div>
                                            <div class="o_planner_label">OCs canceladas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_po_cancelled_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-muted"
                                                    string="Ver →" invisible="alert_po_cancelled == 0"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-truck fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number"><field name="alert_receipt_delayed" nolabel="1"/></div>
                                            <div class="o_planner_label">Recepciones</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_receipt_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                                    string="Ver →" invisible="alert_receipt_delayed == 0"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ÓRDENES DE COMPRA -->
                        <div class="o_planner_section mb-4" invisible="not can_see_po">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-shopping-cart me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de compra</span>
                            </div>
                            <widget name="po_dashboard_widget"/>
                        </div>

                        <!-- ANÁLISIS DE PROVEEDORES -->
                        <div class="o_planner_section mb-4" invisible="not can_see_po">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-bar-chart me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Análisis de proveedores</span>
                            </div>
                            <widget name="supplier_analysis_widget"/>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         MENÚ
    ════════════════════════════════════════════════════════════════════ -->

    <!-- ── App raíz ──────────────────────────────────────────────────────── -->
    <menuitem id="mrp_planner_menu_root"
              name="Planificación"
              sequence="65"
              web_icon="odoo_mrp_planner,static/description/icon.png"/>

    <!-- ── Barra superior 1: Planificación ───────────────────────────────── -->
    <menuitem id="mrp_planeacion_menu"
              name="Planificación"
              parent="mrp_planner_menu_root"
              sequence="10"
              groups="odoo_mrp_planner.group_prod_read,odoo_mrp_planner.group_prod,odoo_mrp_planner.group_purchase,odoo_mrp_planner.group_admin,base.group_system"/>

    <!-- Grupo Producción (contenedor bajo Planificación) -->
    <menuitem id="mrp_produccion_menu"
              name="Producción"
              parent="mrp_planeacion_menu"
              sequence="10"
              groups="odoo_mrp_planner.group_prod_read,odoo_mrp_planner.group_prod,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_produccion_panel_menu"
              name="Panel de Producción"
              parent="mrp_produccion_menu"
              sequence="1"
              action="action_mrp_planner_dashboard_open"
              groups="odoo_mrp_planner.group_prod_read,odoo_mrp_planner.group_prod,odoo_mrp_planner.group_admin,base.group_system"/>

    <!-- Grupo Compras (contenedor bajo Planificación) -->
    <menuitem id="mrp_compras_menu"
              name="Compras"
              parent="mrp_planeacion_menu"
              sequence="20"
              groups="odoo_mrp_planner.group_purchase,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_compras_panel_menu"
              name="Panel de Compras"
              parent="mrp_compras_menu"
              sequence="1"
              action="action_mrp_planner_compras_open"
              groups="odoo_mrp_planner.group_purchase,odoo_mrp_planner.group_admin,base.group_system"/>

</odoo>
