<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">mrp.reschedule.wizard.form</field>
        <field name="model">mrp.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprogramar en cascada">

                <group>
                    <group>
                        <field name="production_id"/>
                        <field name="new_finish_date"/>
                    </group>
                    <group>
                        <field name="delta_display" readonly="1"/>
                    </group>
                </group>

                <div class="o_horizontal_separator mt8 mb8">Cambios propuestos</div>

                <!--
                    Widget OWL: lee line_ids del record y dibuja el Gantt.
                    Debe ir ANTES del field line_ids para que aparezca encima.
                -->
                <widget name="reschedule_gantt"/>

                <!--
                    line_ids: lista editable solo en el campo "apply".
                    Los campos con column_invisible="True" son necesarios para
                    que el widget Gantt los pueda leer desde
                    props.record.data.line_ids.records[i].data.
                -->
                <field name="line_ids" nolabel="1">
                    <list string="Cambios propuestos"
                          editable="1"
                          decoration-info="record_type == 'mrp'"
                          decoration-warning="record_type == 'purchase'">

                        <!-- Columnas visibles -->
                        <field name="apply"               string="Aplicar"/>
                        <field name="record_label"        string="Referencia"          readonly="1"/>
                        <field name="description_label"   string="Producto / Proveedor" readonly="1"/>
                        <field name="current_date_finish" string="Fin actual"           readonly="1"/>
                        <field name="new_date_finish"     string="Nuevo fin"            readonly="1"/>
                        <field name="state_display"       string="Estado"               readonly="1"/>

                        <!-- Campos ocultos requeridos por el widget Gantt -->
                        <field name="record_type"        column_invisible="True"/>
                        <field name="level"              column_invisible="True"/>
                        <field name="production_id"      column_invisible="True"/>
                        <field name="purchase_id"        column_invisible="True"/>
                        <field name="current_date_start" column_invisible="True"/>
                        <field name="new_date_start"     column_invisible="True"/>

                    </list>
                </field>

                <footer>
                    <button name="action_recalculate"
                            type="object"
                            string="Calcular"
                            class="btn-secondary"/>
                    <button name="action_apply"
                            type="object"
                            string="Confirmar"
                            class="btn-primary"
                            invisible="not has_lines"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
