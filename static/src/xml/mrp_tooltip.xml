<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        MrpTooltip — tooltip accesible WCAG 2.1 AA.

        Estructura:
          .o_mrp_tooltip_wrapper      — posición relativa; gestiona eventos hover/focus
            slot default              — el elemento trigger (cualquier contenido)
            .o_mrp_tooltip            — el tooltip propiamente dicho
              role="tooltip"          — semántica ARIA
              [id]                    — vinculado con aria-describedby del wrapper

        El wrapper usa aria-describedby para que lectores de pantalla anuncien
        el tooltip cuando el trigger recibe foco.

        Posiciones soportadas vía clase:
          o_mrp_tooltip_top (default)
          o_mrp_tooltip_bottom
          o_mrp_tooltip_left
          o_mrp_tooltip_right
    -->

    <t t-name="odoo_mrp_planner.MrpTooltip">
        <span class="o_mrp_tooltip_wrapper"
              t-att-aria-describedby="state.visible ? tooltipId : false"
              t-on-mouseenter="showTooltip"
              t-on-mouseleave="hideTooltip"
              t-on-focusin="showTooltip"
              t-on-focusout="hideTooltip"
              t-on-keydown="onKeydown">

            <!-- Slot: el elemento trigger envuelto por el componente -->
            <t t-slot="default"/>

            <!-- Tooltip: visible solo cuando state.visible es true -->
            <span t-if="state.visible"
                  t-att-id="tooltipId"
                  role="tooltip"
                  t-att-class="'o_mrp_tooltip o_mrp_tooltip--' + props.position"
                  aria-live="polite">
                <t t-esc="props.content"/>
            </span>

        </span>
    </t>

</templates>
