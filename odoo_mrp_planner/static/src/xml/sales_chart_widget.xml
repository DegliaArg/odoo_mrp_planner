<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.SalesChartWidget">
        <div t-att-class="'o_sales_chart_widget' + (state.loading ? ' opacity-50 pe-none' : '')">

            <!-- Fila única de filtros -->
            <div class="d-flex flex-nowrap align-items-center gap-1 mb-3">

                <!-- Rango de fechas propio de los gráficos (independiente de la tabla) -->
                <div class="d-flex align-items-center gap-1" aria-label="Período de análisis">
                    <input type="date" class="form-control form-control-sm"
                           style="font-size:10px; padding:1px 4px; width:110px;"
                           title="Fecha inicial del rango de los gráficos"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                    <span class="text-muted" style="font-size:10px;">→</span>
                    <input type="date" class="form-control form-control-sm"
                           style="font-size:10px; padding:1px 4px; width:110px;"
                           title="Fecha final del rango de los gráficos"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                    <button t-att-class="'btn btn-sm ' + (isCurrentMonth ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Fijar el rango al mes calendario en curso"
                            t-att-aria-pressed="isCurrentMonth ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="setCurrentMonth">
                        Mes en curso
                    </button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Métrica -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Métrica de visualización">
                    <button t-att-class="'btn ' + (state.metric === 'sku' ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Distribución de categorías por cantidad de SKUs (productos distintos)"
                            t-att-aria-pressed="state.metric === 'sku' ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setMetric('sku')">SKU</button>
                    <button t-att-class="'btn ' + (state.metric === 'qty' ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Mostrar cantidad (Q): unidades demandadas o entregadas según la fuente seleccionada"
                            t-att-aria-pressed="state.metric === 'qty' ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setMetric('qty')">Unidades</button>
                    <button t-att-class="'btn ' + (state.metric === 'amount' ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Mostrar PxQ = precio de lista del artículo × cantidad (demandada o entregada según la fuente seleccionada)."
                            t-att-aria-pressed="state.metric === 'amount' ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setMetric('amount')">PxQ</button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Top N + Todos -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Cantidad de productos a mostrar">
                    <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                        <button t-att-class="'btn ' + (state.topN === n ? 'btn-primary' : 'btn-outline-secondary')"
                                t-att-title="'Mostrar sólo los top ' + n + ' productos por volumen'"
                                t-att-aria-pressed="state.topN === n ? 'true' : 'false'"
                                style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                t-on-click="() => this.setTopN(n)">
                            <t t-esc="'Top ' + n"/>
                        </button>
                    </t>
                    <button t-att-class="'btn ' + (state.topN === 0 ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Mostrar todos los productos sin límite"
                            t-att-aria-pressed="state.topN === 0 ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setTopN(0)">Todos</button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Fuente -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Fuente de datos">
                    <button t-att-class="'btn ' + (state.docType === 'sales' ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Demandadas: unidades en órdenes de venta confirmadas del período. PxQ = precio de lista × cantidad."
                            t-att-aria-pressed="state.docType === 'sales' ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setDocType('sales')">Demandadas</button>
                    <button t-att-class="'btn ' + (state.docType === 'delivery' ? 'btn-primary' : 'btn-outline-secondary')"
                            title="Entregadas: unidades en movimientos de salida completados del período. PxQ = precio de lista × cantidad."
                            t-att-aria-pressed="state.docType === 'delivery' ? 'true' : 'false'"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setDocType('delivery')">Entregadas</button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Categoría de venta -->
                <div class="d-flex align-items-center gap-1">
                    <span style="font-size:10px;" class="text-muted fw-semibold">Cat.:</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Categoría de venta ABC">
                        <t t-foreach="[['','Todas'],['A','A'],['B','B'],['C','C'],['D','D'],['E','E'],['__none__','—']]"
                           t-as="c" t-key="c[0]">
                            <button t-att-class="'btn ' + (state.saleCategory === c[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                    t-att-title="c[0] === '' ? 'Ver todas las categorías de venta' : c[0] === '__none__' ? 'Productos sin categoría de venta asignada' : 'Filtrar productos de categoría de venta ' + c[0]"
                                    t-att-aria-pressed="state.saleCategory === c[0] ? 'true' : 'false'"
                                    style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                    t-on-click="() => this.setSaleCat(c[0])">
                                <t t-esc="c[1]"/>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Categoría de producto -->
                <div t-if="state.productCategs.length" class="d-flex align-items-center gap-1">
                    <span style="font-size:10px;" class="text-muted fw-semibold">Cat.:</span>
                    <select class="form-select form-select-sm" style="min-width:90px; max-width:130px; font-size:10px;"
                            title="Filtrar por familia/categoría interna de producto"
                            aria-label="Categoría de producto"
                            t-on-change="setProductCat">
                        <option value="">Todas</option>
                        <t t-foreach="state.productCategs" t-as="cat" t-key="cat.id">
                            <option t-att-value="cat.id" t-esc="cat.name"/>
                        </t>
                    </select>
                </div>

            </div>

            <!-- Spinner solo en la PRIMERA carga; en las recargas por cambio de
                 filtros los gráficos quedan montados y atenuados (soft reload) -->
            <div t-if="state.loading and !state.rows.length" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <!-- Error de backend -->
            <div t-elif="state.loadError" class="alert alert-danger py-2 mb-2" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                Error al cargar ventas: <strong><t t-esc="state.loadError"/></strong>
            </div>

            <!-- Sin datos -->
            <div t-elif="!state.rows.length" class="text-center text-muted py-5">
                <i class="fa fa-bar-chart fa-3x mb-3 d-block opacity-50"/>
                <span>No hay ventas registradas para los filtros seleccionados.</span>
            </div>

            <!-- Gráficos: torta + barras -->
            <div t-else="" class="d-flex gap-3 align-items-start">

                <!-- Torta — distribución por categoría de venta (1/3) -->
                <div style="flex:1; min-width:0;">
                    <p class="text-center small text-muted fw-semibold mb-1" style="font-size:11px;">
                        <t t-if="state.metric === 'qty'">Distribución por categoría — Unidades</t>
                        <t t-elif="state.metric === 'amount'">Distribución por categoría — PxQ</t>
                        <t t-else="">Distribución por categoría — SKUs</t>
                    </p>
                    <div style="position:relative; height:340px;">
                        <canvas t-ref="pieCanvas"/>
                    </div>
                </div>

                <!-- Barras — top N productos (2/3) -->
                <div style="flex:2; min-width:0;">
                    <t t-if="state.metric === 'sku'">
                        <div class="d-flex flex-column align-items-center justify-content-center text-muted"
                             style="height:360px;">
                            <i class="fa fa-bar-chart fa-2x mb-2 opacity-50"/>
                            <span style="font-size:12px;">El ranking de productos no aplica en modo SKU</span>
                        </div>
                    </t>
                    <t t-else="">
                        <div style="position:relative; height:360px;">
                            <canvas t-ref="salesCanvas"/>
                        </div>
                    </t>
                </div>

            </div>

        </div>
    </t>

</templates>
