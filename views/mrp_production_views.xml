<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Acción servidor: botón en vista lista de MOs ── -->
    <record id="action_mrp_reschedule" model="ir.actions.server">
        <field name="name">Reprogramar en cascada</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_open_reschedule_plan()
        </field>
    </record>

    <!-- ── Filtro de búsqueda: excluir subcontratación ── -->
    <record id="mrp_production_search_inherit_no_subcontract" model="ir.ui.view">
        <field name="name">mrp.production.search.inherit.no_subcontract</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="no_subcontract"
                        string="Sólo internas"
                        domain="[('subcontracting_type', '=', 'none')]"/>
            </xpath>
        </field>
    </record>

    <!-- Activar filtro por defecto en la vista lista estándar de OFs -->
    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="context">{'search_default_no_subcontract': 1}</field>
    </record>

    <!-- ── Extensión del form de mrp.production ── -->
    <record id="mrp_production_form_inherit_reschedule" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.reschedule</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!--
                Fase 4: Botón inteligente "Reprogramar sugerido".
                Solo visible cuando x_reschedule_needed = True.
            -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_planner_dashboard"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-tachometer">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Panel</span>
                    </div>
                </button>
                <button name="action_view_alerts"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exclamation-triangle"
                        invisible="alert_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="alert_count"/>
                        </span>
                        <span class="o_stat_text">Alertas</span>
                    </div>
                </button>
                <button name="action_view_reschedule_plans"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="reschedule_plan_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="reschedule_plan_count"/>
                        </span>
                        <span class="o_stat_text">Planes</span>
                    </div>
                </button>
                <button name="action_open_reschedule_plan"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        invisible="not x_reschedule_needed">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Reprogramar</span>
                        <span class="o_stat_text">sugerido</span>
                    </div>
                </button>
            </xpath>

            <!--
                Fase 2: Campo x_parent_mo_id junto al campo Origen.
                Readonly, solo visible cuando está definido.
            -->
            <xpath expr="//page[@name='miscellaneous']//field[@name='origin']" position="after">
                <field name="x_parent_mo_id"
                       readonly="1"
                       invisible="not x_parent_mo_id"
                       string="OF madre"/>
            </xpath>

        </field>
    </record>

</odoo>
