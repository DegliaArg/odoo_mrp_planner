<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="odoo_mrp_planner.PurchaseAnalysisWidget">
    <div class="o_purchase_analysis_widget">

        <!-- ── Filtros (una sola línea, scroll horizontal si hace falta) ─── -->
        <div class="o_pca_filters card mb-3 border-0 bg-light px-3 py-2" style="overflow-x:auto;">
            <div class="d-flex align-items-center gap-2" style="min-width:max-content;">

                <!-- Fechas -->
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small fw-semibold">Desde:</span>
                    <input type="date" class="form-control form-control-sm" style="width:128px"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                    <span class="text-muted small">hasta:</span>
                    <input type="date" class="form-control form-control-sm" style="width:128px"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>

                <div class="vr mx-1"/>

                <!-- Sector -->
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small fw-semibold">Sector:</span>
                    <select class="form-select form-select-sm" style="width:auto;min-width:140px"
                            t-on-change="onTagChange">
                        <option value="">Seleccionar sector…</option>
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <option t-att-value="tag.id"
                                    t-att-selected="state.tagIds.length &amp;&amp; state.tagIds[0] == tag.id">
                                <t t-esc="tag.name"/>
                            </option>
                        </t>
                    </select>
                    <t t-if="!state.tags.length">
                        <span class="text-muted small fst-italic">Sin sectores</span>
                    </t>
                </div>

                <!-- CT -->
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted small fw-semibold">CT:</span>
                    <select class="form-select form-select-sm" style="width:auto;min-width:140px"
                            t-att-disabled="!state.tagIds.length"
                            t-on-change="onWcChange">
                        <option value="">Todos</option>
                        <t t-foreach="state.wcs" t-as="wc" t-key="wc.id">
                            <option t-att-value="wc.id"
                                    t-att-selected="state.wcFilterId == wc.id">
                                <t t-esc="wc.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <div class="vr mx-1"/>

                <!-- Búsqueda por producto -->
                <div class="input-group input-group-sm" style="width:170px">
                    <span class="input-group-text"><i class="fa fa-search"/></span>
                    <input type="text" class="form-control" placeholder="Buscar producto…"
                           t-att-value="state.searchText"
                           t-on-input="onSearchChange"/>
                </div>

                <!-- Toggle OFs terminadas -->
                <div class="form-check form-switch d-flex align-items-center gap-2 mb-0 ms-1">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="pca_show_finished"
                           t-att-checked="state.showFinished"
                           t-on-change="toggleShowFinished"/>
                    <label class="form-check-label text-muted small fw-semibold mb-0"
                           for="pca_show_finished">Mostrar OFs terminadas</label>
                </div>

                <!-- Exportar PDF (solo icono, rojo) — ms-auto empuja a la derecha sin wrap -->
                <button class="btn btn-sm btn-outline-secondary ms-auto" title="Exportar tabla a PDF"
                        t-on-click="exportToPdf">
                    <i class="fa fa-file-pdf-o" style="color:#dc3545;"/>
                </button>

            </div>
        </div>

        <!-- ── Sin sector seleccionado ────────────────────────────────────── -->
        <t t-if="!state.tagIds.length &amp;&amp; !state.loading">
            <div class="text-center text-muted py-5">
                <i class="fa fa-filter fa-2x mb-2 d-block"/>
                <p class="mb-0">Seleccioná un sector para ver el análisis.</p>
            </div>
        </t>

        <!-- ── Loading ─────────────────────────────────────────────────────── -->
        <t t-if="state.loading">
            <div class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"/>
                <p class="mb-0">Cargando…</p>
            </div>
        </t>

        <!-- ── Error ───────────────────────────────────────────────────────── -->
        <t t-if="state.error &amp;&amp; !state.loading">
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-triangle me-1"/>
                <t t-esc="state.error"/>
            </div>
        </t>

        <!-- ── Sin resultados ──────────────────────────────────────────────── -->
        <t t-if="!state.loading &amp;&amp; !state.error &amp;&amp; state.tagIds.length &amp;&amp; !filteredWcRows().length">
            <div class="text-center text-muted py-5">
                <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                <p class="mb-0">No hay OTs del sector en el período seleccionado.</p>
            </div>
        </t>

        <!-- ── Tabla CT × Semana ───────────────────────────────────────────── -->
        <t t-if="!state.loading &amp;&amp; filteredWcRows().length">

            <!-- KPI cards — calculadas una sola vez con t-set -->
            <t t-set="kpi" t-value="kpiData"/>
            <div class="d-flex gap-3 mb-3">

                <!-- OCs vencidas (rojo) -->
                <div class="flex-fill" style="min-width:0;flex-basis:0;">
                    <div class="card o_planner_card o_planner_card_danger o_planner_kpi_card_lg h-100"
                         title="OFs del sector que tienen al menos una OC con fecha de entrega vencida y sin recibir completamente">
                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                            <i class="fa fa-exclamation-circle fa-lg text-danger mb-1 d-block"/>
                            <div class="o_planner_number text-danger" t-esc="kpi.late.length"/>
                            <div class="o_planner_label">OFs con OC vencida</div>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1"
                                    t-att-disabled="!kpi.late.length"
                                    t-on-click="() => this.openKpiMos(kpi.late, 'OFs con OC vencida')">Ver →</button>
                        </div>
                    </div>
                </div>

                <!-- OCs sin confirmar (naranja) -->
                <div class="flex-fill" style="min-width:0;flex-basis:0;">
                    <div class="card o_planner_card o_planner_card_warning o_planner_kpi_card_lg h-100"
                         title="OFs con OCs todavía en borrador o enviadas (no confirmadas como OC)">
                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                            <i class="fa fa-clock-o fa-lg text-warning mb-1 d-block"/>
                            <div class="o_planner_number text-warning" t-esc="kpi.pending.length"/>
                            <div class="o_planner_label">OFs con OC sin confirmar</div>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1"
                                    t-att-disabled="!kpi.pending.length"
                                    t-on-click="() => this.openKpiMos(kpi.pending, 'OFs con OC sin confirmar')">Ver →</button>
                        </div>
                    </div>
                </div>

                <!-- Sin OC en cadena (gris) -->
                <div class="flex-fill" style="min-width:0;flex-basis:0;">
                    <div class="card o_planner_card o_planner_kpi_card_lg h-100"
                         title="OFs activas del sector sin ninguna OC asociada en su cadena MTO">
                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                            <i class="fa fa-chain-broken fa-lg text-secondary mb-1 d-block"/>
                            <div class="o_planner_number text-secondary" t-esc="kpi.noPos.length"/>
                            <div class="o_planner_label">OFs sin OC en cadena</div>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1"
                                    t-att-disabled="!kpi.noPos.length"
                                    t-on-click="() => this.openKpiMos(kpi.noPos, 'OFs sin OC en cadena')">Ver →</button>
                        </div>
                    </div>
                </div>

                <!-- Al día (verde) -->
                <div class="flex-fill" style="min-width:0;flex-basis:0;">
                    <div class="card o_planner_card o_planner_card_success o_planner_kpi_card_lg h-100"
                         title="OFs con OCs confirmadas y sin retrasos en la cadena de abastecimiento">
                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                            <i class="fa fa-check-circle fa-lg text-success mb-1 d-block"/>
                            <div class="o_planner_number text-success" t-esc="kpi.ok.length"/>
                            <div class="o_planner_label">OFs con OC al día</div>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1"
                                    t-att-disabled="!kpi.ok.length"
                                    t-on-click="() => this.openKpiMos(kpi.ok, 'OFs con OC al día')">Ver →</button>
                        </div>
                    </div>
                </div>

            </div>

            <div class="table-responsive mb-3">
                <table class="table table-hover o_pca_matrix" style="min-width:500px;table-layout:fixed">
                    <thead>
                        <tr>
                            <th class="o_pca_wc_header" style="width:160px">
                                CT
                            </th>
                            <t t-foreach="state.weekKeys" t-as="wk" t-key="wk">
                                <th t-att-class="'text-center o_pca_week_header' + (wk == currentWeekKey ? ' table-active' : '')"
                                    style="width:160px">
                                    <div class="fw-bold">
                                        <t t-esc="state.weekLabels[wk].label"/>
                                        <span class="text-muted fw-normal ms-1">
                                            <t t-esc="state.weekLabels[wk].year"/>
                                        </span>
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem">
                                        <t t-esc="fmtDate(state.weekLabels[wk].date_from)"/>
                                        <span> – </span>
                                        <t t-esc="fmtDate(state.weekLabels[wk].date_to)"/>
                                    </div>
                                    <t t-if="wk == currentWeekKey">
                                        <span class="badge bg-light text-muted border mt-1" style="font-size:0.62rem">Esta semana</span>
                                    </t>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="filteredWcRows()" t-as="row" t-key="row.wc_id">
                            <t>
                                <tr>
                                    <td class="o_pca_wc_cell">
                                        <t t-esc="row.wc_name"/>
                                    </td>
                                    <t t-foreach="state.weekKeys" t-as="wk" t-key="wk">
                                        <td t-att-class="'o_pca_cell' + (wk == currentWeekKey ? ' bg-secondary bg-opacity-10' : '')">
                                            <t t-foreach="row.cells[wk]" t-as="mo" t-key="mo.wo_id">
                                                <div t-att-class="'o_pca_mo_chip rounded p-1 mb-1 border ' + (state.activeMoId == mo.mo_id ? 'o_pca_mo_chip_active' : (mo.has_late_pos ? 'border-danger' : 'o_pca_chip_default'))"
                                                     style="cursor:pointer;font-size:0.8rem"
                                                     t-att-title="moTooltip(mo)"
                                                     t-on-click="() => this.selectMo(mo, row.wc_id)">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i t-att-class="'fa fa-fw fa-xs ' + moAlertIcon(mo) + ' ' + moAlertClass(mo)"/>
                                                        <span class="fw-semibold text-truncate flex-grow-1" style="max-width:100px" t-esc="mo.mo_name"/>
                                                        <button class="btn p-0 ms-auto o_pca_chip_open"
                                                                title="Abrir OF"
                                                                t-on-click.stop="() => this.openMo(mo)">
                                                            <i class="fa fa-external-link fa-xs text-muted"/>
                                                        </button>
                                                    </div>
                                                    <div class="text-muted text-truncate" style="font-size:0.72rem;max-width:130px" t-esc="mo.product_name"/>
                                                    <div class="text-muted" style="font-size:0.72rem">
                                                        <i class="fa fa-cubes fa-xs me-1"/>
                                                        <t t-esc="fmtQty(mo.qty)"/>
                                                        <span class="ms-1" t-esc="mo.uom"/>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-2 mt-1" style="font-size:0.72rem">
                                                        <span t-att-class="moStateClass(mo.state)" t-esc="mo.state_label"/>
                                                        <span class="text-muted">
                                                            <i class="fa fa-shopping-cart fa-xs me-1"/>
                                                            <t t-esc="mo.pos_count"/>
                                                        </span>
                                                    </div>

                                                    <!-- Lista inline de OCs (visible solo cuando el chip está activo) -->
                                                    <t t-if="state.activeMoId == mo.mo_id">
                                                        <div class="mt-2 pt-2 border-top">
                                                            <t t-if="!mo.pos.length">
                                                                <span class="text-muted fst-italic" style="font-size:0.78rem">Sin OCs</span>
                                                            </t>
                                                            <t t-foreach="mo.pos" t-as="poc" t-key="poc.po_id + '_' + poc.product">
                                                                <div class="d-flex align-items-center gap-2 mb-1" style="font-size:0.78rem">
                                                                    <i t-att-class="'fa fa-fw ' + (poc.pct_received >= 100 ? 'fa-check-circle text-success' : poc.is_late ? 'fa-exclamation-circle text-danger' : poc.state === 'purchase' ? 'fa-clock-o text-warning' : 'fa-circle-o text-muted')"/>
                                                                    <span class="flex-grow-1 text-truncate" t-esc="poc.product"/>
                                                                </div>
                                                            </t>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </td>
                                    </t>
                                </tr>

                                <!-- Panel detalle inline: aparece bajo el CT de la tarjeta activa -->
                                <t t-if="state.activeMoData and state.activeMoWcId == row.wc_id">
                                    <tr class="o_pca_detail_row">
                                        <td t-att-colspan="state.weekKeys.length + 1" style="padding:10px 0 4px;border:none;">
                                            <div class="o_pca_detail">
                                                <div class="o_pca_detail_header d-flex align-items-center gap-2 py-2 px-3">
                                                    <i class="fa fa-industry text-muted"/>
                                                    <span class="fw-bold" t-esc="state.activeMoData.mo_name"/>
                                                    <span class="text-muted">–</span>
                                                    <span t-esc="state.activeMoData.product_name"/>
                                                    <span class="text-muted small">
                                                        (<t t-esc="fmtQty(state.activeMoData.qty)"/>
                                                        <span class="ms-1"><t t-esc="state.activeMoData.uom"/></span>)
                                                    </span>
                                                    <span t-att-class="moStateClass(state.activeMoData.state)" t-esc="state.activeMoData.state_label"/>
                                                    <button class="btn btn-sm btn-link text-muted p-0" title="Abrir OF"
                                                            t-on-click="() => this.openMo(state.activeMoData)">
                                                        <i class="fa fa-external-link"/>
                                                    </button>
                                                    <button class="btn btn-sm btn-link text-muted ms-auto p-0" title="Cerrar"
                                                            t-on-click="closeMoDetail">
                                                        <i class="fa fa-times"/>
                                                    </button>
                                                </div>
                                                <t t-if="!state.activeMoData.pos.length">
                                                    <div class="px-4 py-3 text-muted fst-italic small">
                                                        Sin órdenes de compra encontradas en la cadena MTO.
                                                    </div>
                                                </t>
                                                <t t-if="state.activeMoData.pos.length">
                                                    <table class="table table-sm table-hover mb-0" style="font-size:0.82rem">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th class="ps-3">OC</th>
                                                                <th>Proveedor</th>
                                                                <th>Componente</th>
                                                                <th class="text-center">Fecha de entrega</th>
                                                                <th class="text-end">Pedido</th>
                                                                <th class="text-end">Recibido</th>
                                                                <th class="text-center">%</th>
                                                                <th class="text-center">Estado</th>
                                                                <th/>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <t t-foreach="state.activeMoData.pos" t-as="po" t-key="po.po_id + '_' + po.product">
                                                                <tr t-att-class="rowClass(po)">
                                                                    <td class="ps-3" style="white-space:nowrap">
                                                                        <t t-esc="po.po_name"/>
                                                                        <t t-if="po.is_subcontract">
                                                                            <span class="badge bg-info text-dark ms-1" title="Subcontratación">SC</span>
                                                                        </t>
                                                                    </td>
                                                                    <td t-esc="po.partner"/>
                                                                    <td class="text-muted" t-esc="po.product_ref"/>
                                                                    <td class="text-center">
                                                                        <t t-if="po.is_late">
                                                                            <span class="text-danger fw-semibold">
                                                                                <i class="fa fa-exclamation-triangle me-1"/>
                                                                                <t t-esc="fmtDate(po.date_planned)"/>
                                                                            </span>
                                                                        </t>
                                                                        <t t-else="">
                                                                            <t t-esc="fmtDate(po.date_planned)"/>
                                                                        </t>
                                                                    </td>
                                                                    <td class="text-end" t-esc="fmtQty(po.qty_ordered)"/>
                                                                    <td class="text-end" t-esc="fmtQty(po.qty_received)"/>
                                                                    <td class="text-center">
                                                                        <t t-if="po.pct_received >= 100">
                                                                            <span class="text-success fw-semibold">
                                                                                <i class="fa fa-check me-1"/>100%
                                                                            </span>
                                                                        </t>
                                                                        <t t-else="">
                                                                            <t t-esc="fmtPct(po.pct_received)"/>
                                                                        </t>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <span t-att-class="poStateClass(po.state)" t-esc="po.state_label"/>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <button class="btn btn-sm btn-link p-0"
                                                                                title="Abrir OC"
                                                                                t-on-click="() => this.openPo(po)">
                                                                            <i class="fa fa-external-link"/>
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                            </t>
                                                        </tbody>
                                                    </table>
                                                </t>
                                            </div>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>
            </div>

        </t>
        <!-- fin contenido -->

    </div>
</t>

</templates>
