<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Lista ──────────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_list" model="ir.ui.view">
        <field name="name">mrp.forecast.line.list</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <list string="Forecast" editable="bottom" default_order="period desc, product_id">
                <field name="period" widget="date" string="Período" options="{'datepicker': {'defaultView': 'months', 'minViewMode': 'months'}}"/>
                <field name="period_display" string="Mes" readonly="1"/>
                <field name="product_id" domain="[('sale_ok', '=', True)]"/>
                <field name="forecast_qty" string="Cantidad forecast"/>
                <field name="uom_id" string="Unidad" readonly="1"/>
                <field name="warehouse_id" optional="show"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Formulario ────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_form" model="ir.ui.view">
        <field name="name">mrp.forecast.line.form</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <form string="Línea de forecast">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" domain="[('sale_ok', '=', True)]"/>
                            <field name="forecast_qty"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="period"/>
                            <field name="period_display" readonly="1"/>
                            <field name="warehouse_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Búsqueda ──────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_search" model="ir.ui.view">
        <field name="name">mrp.forecast.line.search</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <search string="Forecast">
                <field name="product_id"/>
                <field name="period"/>
                <field name="warehouse_id"/>
                <separator/>
                <filter string="Este mes" name="this_month"
                        domain="[('period', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                  ('period', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Próximos 3 meses" name="next_3m"
                        domain="[('period', '&gt;=', context_today().strftime('%Y-%m-01')),
                                  ('period', '&lt;=', (context_today() + relativedelta(months=2, day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Artículo"   name="by_product"   context="{'group_by': 'product_id'}"/>
                    <filter string="Período"    name="by_period"    context="{'group_by': 'period:month'}"/>
                    <filter string="Depósito"   name="by_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Empresa"    name="by_company"   context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción principal (líneas) ─────────────────────────────────────── -->
    <record id="action_mrp_forecast_line" model="ir.actions.act_window">
        <field name="name">Forecast de Ventas</field>
        <field name="res_model">mrp.forecast.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_next_3m': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay líneas de forecast aún.
            </p>
            <p>
                Cargá manualmente o usá el botón <strong>Importar desde Excel</strong> para cargar datos en bloque.
            </p>
        </field>
    </record>

    <!-- ── Vista del panel de Ventas (solo forecast) ─────────────────────── -->
    <record id="mrp_ventas_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.ventas.dashboard.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Forecast de Ventas" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Forecast de Ventas</h4>
                            </div>
                        </div>
                        <field name="can_edit_forecast" invisible="1"/>
                        <widget name="forecast_widget"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción de servidor para abrir el panel de Ventas ──────────────── -->
    <record id="action_mrp_ventas_dashboard_open" model="ir.actions.server">
        <field name="name">Panel de Ventas</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_ventas()</field>
    </record>

    <!-- ── Menú Ventas (dentro de Planificador) ─────────────────────────── -->
    <menuitem id="mrp_ventas_menu_root"
              name="Ventas"
              parent="mrp_planner_menu_root"
              sequence="2"/>

    <!-- ── Sub-menús bajo Ventas ─────────────────────────────────────────── -->
    <menuitem id="mrp_ventas_panel_menu"
              name="Forecast"
              parent="mrp_ventas_menu_root"
              sequence="1"
              action="action_mrp_ventas_dashboard_open"/>

</odoo>
