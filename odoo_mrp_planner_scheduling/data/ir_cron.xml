<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recalcula los campos de planificación (vulcanizado y componente comprado)
         recorriendo la BOM, para que el panel no la explore en cada carga. -->
    <record id="ir_cron_recompute_planning_sources" model="ir.cron">
        <field name="name">Planificación: recalcular vulcanizado y componente comprado</field>
        <field name="model_id" ref="model_mrp_production_needs"/>
        <field name="state">code</field>
        <field name="code">model._recompute_planning_sources()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
