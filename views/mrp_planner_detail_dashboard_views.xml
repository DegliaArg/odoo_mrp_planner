<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_planner_detail_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.detail.dashboard.form</field>
        <field name="model">mrp.planner.detail.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- ── Encabezado con botón volver ─────────────────── -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col-auto">
                                <button name="action_back" type="object"
                                        string="← Panel"
                                        class="btn btn-outline-secondary btn-sm"/>
                            </div>
                            <div class="col">
                                <h4 class="mb-0 fw-bold">
                                    <field name="name" nolabel="1"/>
                                </h4>
                            </div>
                        </div>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- ── ÓRDENES DE FABRICACIÓN ──────────────────── -->
                        <!-- ════════════════════════════════════════════════ -->
                        <div invisible="category != 'mos'">

                            <!-- Fila 1: estados -->
                            <div class="o_planner_section mb-4">
                                <div class="o_planner_section_title mb-3">
                                    <i class="fa fa-industry me-2 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Estado general</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="mo_total" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Activas total</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_all_mos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-check-square-o fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="mo_confirmed" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Confirmadas</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card o_planner_card_info h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-cog fa-lg text-info mb-2 d-block"/>
                                                <div class="o_planner_number text-info">
                                                    <field name="mo_in_progress" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">En progreso</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card o_planner_card_success h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                                <div class="o_planner_number text-success">
                                                    <field name="mo_done" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Completadas</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card o_planner_card_danger h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-warning fa-lg text-danger mb-2 d-block"/>
                                                <div class="o_planner_number text-danger">
                                                    <field name="mo_delayed" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Atrasadas</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_delayed_mos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-4 col-lg-2">
                                        <div class="card o_planner_card o_planner_card_warning h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-refresh fa-lg text-warning mb-2 d-block"/>
                                                <div class="o_planner_number text-warning">
                                                    <field name="mo_reschedule_needed" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Para reprogramar</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_reschedule_mos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Carga de centros de trabajo -->
                            <div class="o_planner_section mb-4">
                                <div class="o_planner_section_title mb-3">
                                    <i class="fa fa-wrench me-2 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Centros de trabajo</span>
                                </div>
                                <div class="row g-2 align-items-center">
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-sitemap fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="mo_wc_count" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">CTs con OFs activas</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_wc_load" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver carga →</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- ── ÓRDENES DE COMPRA ────────────────────────── -->
                        <!-- ════════════════════════════════════════════════ -->
                        <div invisible="category != 'pos'">

                            <div class="o_planner_section mb-4">
                                <div class="o_planner_section_title mb-3">
                                    <i class="fa fa-shopping-cart me-2 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Estado general</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="po_total" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Total activas</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_all_pos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_success h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-check fa-lg text-success mb-2 d-block"/>
                                                <div class="o_planner_number text-success">
                                                    <field name="po_pending" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">A tiempo</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_danger h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-exclamation-triangle fa-lg text-danger mb-2 d-block"/>
                                                <div class="o_planner_number text-danger">
                                                    <field name="po_overdue" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Vencidas</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_overdue_pos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_danger h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-exclamation-circle fa-lg text-danger mb-2 d-block"/>
                                                <div class="o_planner_number text-danger">
                                                    <field name="po_overdue_critical" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Críticas (+5 días)</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_overdue_pos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- ════════════════════════════════════════════════ -->
                        <!-- ── PROGRAMACIONES ───────────────────────────── -->
                        <!-- ════════════════════════════════════════════════ -->
                        <div invisible="category != 'requests'">

                            <!-- Programaciones -->
                            <div class="o_planner_section mb-4">
                                <div class="o_planner_section_title mb-3">
                                    <i class="fa fa-calendar me-2 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">Programaciones</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-list-alt fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="req_total" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">En curso</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_all_requests" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_warning h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-random fa-lg text-warning mb-2 d-block"/>
                                                <div class="o_planner_number text-warning">
                                                    <field name="req_reschedule" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Con reprogramación</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_reschedule_requests" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- OFs en programaciones -->
                            <div class="o_planner_section mb-4">
                                <div class="o_planner_section_title mb-3">
                                    <i class="fa fa-industry me-2 text-muted"/>
                                    <span class="text-uppercase fw-bold text-muted small">OFs en estas programaciones</span>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                                <div class="o_planner_number">
                                                    <field name="req_mos_total" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Total OFs</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_req_mos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_success h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                                <div class="o_planner_number text-success">
                                                    <field name="req_mos_done" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Completadas</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="card o_planner_card o_planner_card_danger h-100">
                                            <div class="card-body text-center py-3">
                                                <i class="fa fa-clock-o fa-lg text-danger mb-2 d-block"/>
                                                <div class="o_planner_number text-danger">
                                                    <field name="req_mos_delayed" nolabel="1"/>
                                                </div>
                                                <div class="o_planner_label">Atrasadas</div>
                                            </div>
                                            <div class="card-footer p-0">
                                                <button name="action_view_req_delayed_mos" type="object"
                                                        class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
