<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Cron diario de detección de desvíos -->
        <record id="ir_cron_check_delays" model="ir.cron">
            <field name="name">Planificador: detectar desvíos de producción</field>
            <field name="model_id" ref="model_mrp_reschedule_alert"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_delays()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="hour">7</field>
        </record>
    </data>

    <!-- ── Vista búsqueda ── -->
    <record id="mrp_reschedule_alert_search" model="ir.ui.view">
        <field name="name">mrp.reschedule.alert.search</field>
        <field name="model">mrp.reschedule.alert</field>
        <field name="arch" type="xml">
            <search string="Buscar alertas">
                <field name="name"/>
                <field name="production_id"/>
                <field name="purchase_id"/>
                <field name="picking_id"/>
                <separator/>
                <filter string="Sin resolver"  name="unresolved" domain="[('resolved','=',False)]" default="1"/>
                <filter string="Críticas"       name="critical"   domain="[('severity','=','critical')]"/>
                <filter string="Avisos"         name="warning"    domain="[('severity','=','warning')]"/>
                <separator/>
                <filter string="OFs atrasadas"    name="mo_delayed"      domain="[('alert_type','=','mo_delayed')]"/>
                <filter string="OCs vencidas"     name="po_delayed"      domain="[('alert_type','=','po_delayed')]"/>
                <filter string="Recepciones"      name="receipt_delayed" domain="[('alert_type','=','receipt_delayed')]"/>
                <filter string="OFs canceladas"   name="mo_cancelled"    domain="[('alert_type','=','mo_cancelled')]"/>
                <separator/>
                <filter string="Resueltas" name="resolved" domain="[('resolved','=',True)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo"      name="group_type"     context="{'group_by': 'alert_type'}"/>
                    <filter string="Severidad" name="group_severity" context="{'group_by': 'severity'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Vista lista ── -->
    <record id="mrp_reschedule_alert_list" model="ir.ui.view">
        <field name="name">mrp.reschedule.alert.list</field>
        <field name="model">mrp.reschedule.alert</field>
        <field name="arch" type="xml">
            <list string="Alertas de planificación"
                  decoration-danger="severity == 'critical' and not resolved"
                  decoration-warning="severity == 'warning' and not resolved"
                  decoration-muted="resolved">
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'warning'"/>
                <field name="alert_type" widget="badge"
                       decoration-info="alert_type in ('mo_delayed','po_delayed','receipt_delayed')"
                       decoration-danger="alert_type == 'mo_cancelled'"/>
                <field name="days_late" string="Atraso (días)"
                       decoration-danger="days_late >= 3"
                       decoration-warning="days_late > 0 and days_late &lt; 3"/>
                <field name="production_id" string="OF" optional="show"/>
                <field name="purchase_id"   string="OC" optional="show"/>
                <field name="picking_id"    string="Recepción" optional="show"/>
                <field name="message"       string="Detalle" optional="show"/>
                <field name="plan_id"       string="Plan" optional="show"/>
                <field name="resolved"      string="Resuelta"/>
                <field name="resolve_date"  string="Resuelta el" optional="hide"/>
                <button name="action_create_reschedule_plan"
                        type="object"
                        string="Reprogramar"
                        class="btn-primary btn-sm"
                        invisible="resolved"/>
                <button name="action_resolve"
                        type="object"
                        string="Resolver"
                        class="btn-secondary btn-sm"
                        invisible="resolved"/>
            </list>
        </field>
    </record>

    <!-- ── Acción ── -->
    <record id="action_mrp_reschedule_alert" model="ir.actions.act_window">
        <field name="name">Alertas de planificación</field>
        <field name="res_model">mrp.reschedule.alert</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="mrp_reschedule_alert_search"/>
        <field name="context">{'search_default_unresolved': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin alertas pendientes
            </p>
            <p>
                El sistema detecta automáticamente OFs atrasadas, OCs vencidas
                y recepciones demoradas. Desde aquí podés crear el plan de
                reprogramación con un solo clic.
            </p>
        </field>
    </record>

    <!-- ── Menús bajo "Planificador" ── -->
    <menuitem id="mrp_planner_menu_root"
              name="Planificador"
              parent="mrp.menu_mrp_root"
              sequence="25"/>

    <menuitem id="mrp_planner_menu_alerts"
              name="Alertas"
              parent="mrp_planner_menu_root"
              sequence="5"
              action="action_mrp_reschedule_alert"/>

</odoo>
