<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.ProductionAnalysisWidget">
        <div class="o_production_analysis_widget">

            <!-- ── Pestañas ─────────────────────────────────────────────── -->
            <ul class="nav nav-tabs mb-3" style="flex-wrap:nowrap; overflow-x:auto;">
                <t t-foreach="tabs" t-as="tb" t-key="tb.key">
                    <li class="nav-item">
                        <button t-att-class="'nav-link' + (state.tab === tb.key ? ' active fw-semibold' : ' text-muted')"
                                t-on-click="() => this.setTab(tb.key)">
                            <i t-att-class="'fa me-1 ' + tb.icon"/>
                            <t t-esc="tb.label"/>
                        </button>
                    </li>
                </t>
            </ul>

            <!-- ════════════════ PESTAÑA: Carga de CT ════════════════ -->
            <t t-if="state.tab === 'wc'">

                <!-- Filtros de la vista (rango + sector) -->
                <div class="d-flex align-items-end gap-3 mb-3 flex-wrap">
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Desde</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Hasta</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Sector</label>
                        <select class="form-select form-select-sm" style="width:180px;" t-on-change="onTagChange">
                            <option value="" t-att-selected="!state.tagId">Todos los sectores</option>
                            <t t-foreach="state.tags" t-as="tg" t-key="tg.id">
                                <option t-att-value="tg.id" t-att-selected="state.tagId === tg.id" t-esc="tg.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Tipo producto</label>
                        <select class="form-select form-select-sm" multiple="multiple"
                                style="width:180px;" t-on-change="onProductTypeChange">
                            <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                                <option t-att-value="pt.id"
                                        t-att-selected="state.productTypeIds.includes(pt.id)"
                                        t-esc="pt.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Turno</label>
                        <select class="form-select form-select-sm" multiple="multiple"
                                style="width:160px;" t-on-change="onShiftChange">
                            <t t-foreach="state.shifts" t-as="sh" t-key="sh.id">
                                <option t-att-value="sh.id"
                                        t-att-selected="state.shiftIds.includes(sh.id)"
                                        t-esc="sh.name"/>
                            </t>
                        </select>
                    </div>
                </div>

                <div t-if="state.error" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.error"/>
                </div>

                <!-- Spinner solo en la primera carga -->
                <div t-if="state.loading and !state.rows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <div class="mt-2 small">Cargando datos…</div>
                </div>

                <t t-if="!state.error and (state.rows.length or !state.loading)">
                    <div t-att-class="state.loading ? 'opacity-50 pe-none' : ''">

                        <!-- Evolución mensual de la carga % -->
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución de la carga (%)</span>
                        </div>
                        <div style="height:220px;" class="mb-4">
                            <canvas t-ref="wcTrend"/>
                        </div>

                        <!-- KPIs (describen las filas visibles) -->
                        <div class="d-flex gap-2 mb-3">
                            <t t-foreach="kpiCards" t-as="card" t-key="card.key">
                                <div class="flex-fill" style="min-width:0; flex-basis:0;">
                                    <div class="card o_planner_card o_planner_kpi_card_lg h-100"
                                         t-att-title="kpiTooltip(card.key)">
                                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                                            <div t-att-class="'o_planner_number ' + card.cls" t-esc="card.value"/>
                                            <div class="o_planner_label" t-esc="card.label"/>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button class="btn btn-sm btn-link w-100 py-1"
                                                    t-on-click="openVisibleOrders">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Barra de búsqueda (búsqueda + agrupar por sector + filtro numérico) -->
                        <div class="mb-2">
                            <PlannerSearchBar
                                widgetKey="'production_analysis_wc'"
                                placeholder="'Buscar centro de trabajo…'"
                                t-props="{
                                    search:         state.search,
                                    activeGroupBy:  state.groupBy,
                                    groupByDefs: [ { key: 'tag', label: 'Sector' } ],
                                    onSearch:        (t) => this.setSearch(t),
                                    onGroupByChange: (k) => this.setGroupBy(k),
                                    numericFields:     numColOptions,
                                    numFilters:        state.numFilters,
                                    onNumFilterAdd:    (c) => this.addNumFilter(c),
                                    onNumFilterRemove: (i) => this.removeNumFilter(i)
                                }"/>
                        </div>

                        <!-- Pestañas de agrupamiento por sector -->
                        <t t-if="state.groupBy === 'tag' and allGroupsForTabs">
                            <ul class="nav nav-tabs mb-0" style="flex-wrap:nowrap; overflow-x:auto;">
                                <t t-foreach="allGroupsForTabs" t-as="g" t-key="'gt_' + g.key">
                                    <li class="nav-item">
                                        <button t-att-class="'nav-link px-3 py-1 ' + (activeGroupKey === g.key ? 'active fw-semibold' : 'text-muted')"
                                                style="font-size:12px; white-space:nowrap;"
                                                t-on-click="() => this.setGroup(g.key)">
                                            <t t-esc="g.label"/>
                                            <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="g.count"/>)</span>
                                        </button>
                                    </li>
                                </t>
                            </ul>
                        </t>

                        <!-- Tabla por CT -->
                        <div class="table-responsive" style="max-height:60vh; overflow:auto;">
                            <table class="table table-sm table-hover table-bordered mb-0">
                                <thead class="table-light" style="position:sticky; top:0; z-index:3;">
                                    <tr>
                                        <t t-foreach="tableCols" t-as="col" t-key="col.key">
                                            <th t-att-class="(col.align === 'center' ? 'text-center ' : (col.align === 'end' ? 'text-end ' : '')) + 'user-select-none'"
                                                style="cursor:pointer; white-space:nowrap;"
                                                t-att-title="colTitle(col)"
                                                t-on-click="() => this.setSort(col.key)">
                                                <t t-esc="col.label"/>
                                                <i t-att-class="sortIcon(col.key)"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="pagedRows" t-as="row" t-key="row.wc_id">
                                        <t t-foreach="tableCols" t-as="col" t-key="col.key">
                                            <td t-att-class="col.align === 'center' ? 'text-center' : (col.align === 'end' ? 'text-end' : '')">
                                                <t t-if="col.key === 'name'">
                                                    <a href="#" t-on-click.prevent="() => this.openWc(row)"
                                                       t-esc="row.name"/>
                                                    <button class="btn btn-sm btn-link py-0 px-1 ms-1"
                                                            title="Ver órdenes de trabajo del centro"
                                                            t-on-click.stop="() => this.openWcOrders(row)">
                                                        <i class="fa fa-external-link"/>
                                                    </button>
                                                </t>
                                                <t t-elif="col.key === 'carga_pct'">
                                                    <span t-att-class="cargaClass(row.carga_pct)" t-esc="fmtPct(row.carga_pct)"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="cellValue(row, col.key)"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                    <tr t-if="!pagedRows.length">
                                        <td t-att-colspan="tableCols.length" class="text-center text-muted py-3">
                                            Sin centros de trabajo con actividad en el período/filtros.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        <div t-if="totalPages > 1" class="d-flex align-items-center justify-content-between px-2 py-1 border-top">
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    t-att-disabled="!hasPrevPage" t-on-click="prevPage">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <small class="text-muted">Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/> · <t t-esc="sortedRows.length"/> centro(s)</small>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    t-att-disabled="!hasNextPage" t-on-click="nextPage">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>

                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: Scrap ════════════════ -->
            <t t-if="state.tab === 'scrap'">

                <!-- Filtros de la vista (rango + sector; comparte fechas con Carga de CT) -->
                <div class="d-flex align-items-end gap-3 mb-3 flex-wrap">
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Desde</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Hasta</label>
                        <input type="date" class="form-control form-control-sm" style="width:150px;"
                               t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Sector</label>
                        <select class="form-select form-select-sm" style="width:180px;" t-on-change="onTagChange">
                            <option value="" t-att-selected="!state.tagId">Todos los sectores</option>
                            <t t-foreach="state.tags" t-as="tg" t-key="tg.id">
                                <option t-att-value="tg.id" t-att-selected="state.tagId === tg.id" t-esc="tg.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Tipo producto</label>
                        <select class="form-select form-select-sm" multiple="multiple"
                                style="width:180px;" t-on-change="onProductTypeChange">
                            <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                                <option t-att-value="pt.id"
                                        t-att-selected="state.productTypeIds.includes(pt.id)"
                                        t-esc="pt.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <label class="form-label mb-0 small text-muted">Turno</label>
                        <select class="form-select form-select-sm" multiple="multiple"
                                style="width:160px;" t-on-change="onShiftChange">
                            <t t-foreach="state.shifts" t-as="sh" t-key="sh.id">
                                <option t-att-value="sh.id"
                                        t-att-selected="state.shiftIds.includes(sh.id)"
                                        t-esc="sh.name"/>
                            </t>
                        </select>
                    </div>
                </div>

                <div t-if="state.scrapError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.scrapError"/>
                </div>

                <div t-if="state.scrapLoading and !state.scrapRows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <div class="mt-2 small">Cargando datos…</div>
                </div>

                <t t-if="!state.scrapError and (state.scrapRows.length or (state.scrapLoaded and !state.scrapLoading))">
                    <div t-att-class="state.scrapLoading ? 'opacity-50 pe-none' : ''">

                        <!-- Evolución mensual de la cantidad desechada -->
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-bar-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución del scrap (cantidad)</span>
                        </div>
                        <div style="height:220px;" class="mb-4">
                            <canvas t-ref="scrapTrend"/>
                        </div>

                        <!-- Scrap por producto (barras, top-N) -->
                        <div class="o_planner_section_title mb-2 d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-sort-amount-desc me-2 text-muted"/><span class="text-uppercase fw-bold text-muted small">Scrap por producto</span></span>
                            <select class="form-select form-select-sm" style="width:auto;" t-on-change="onBarTopNChange">
                                <option value="10" t-att-selected="state.barTopN === 10">Top 10</option>
                                <option value="20" t-att-selected="state.barTopN === 20">Top 20</option>
                                <option value="50" t-att-selected="state.barTopN === 50">Top 50</option>
                            </select>
                        </div>
                        <div style="height:340px;" class="mb-4">
                            <canvas t-ref="scrapPareto"/>
                        </div>

                        <!-- KPIs (describen las filas visibles) -->
                        <div class="d-flex gap-2 mb-3">
                            <t t-foreach="scrapKpiCards" t-as="card" t-key="card.key">
                                <div class="flex-fill" style="min-width:0; flex-basis:0;">
                                    <div class="card o_planner_card o_planner_kpi_card_lg h-100"
                                         t-att-title="scrapKpiTooltip(card.key)">
                                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                                            <div t-att-class="'o_planner_number ' + card.cls" t-esc="card.value"/>
                                            <div class="o_planner_label" t-esc="card.label"/>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button class="btn btn-sm btn-link w-100 py-1"
                                                    t-on-click="openScrapAll">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Barra de búsqueda (búsqueda + agrupar por categoría + filtro numérico) -->
                        <div class="mb-2">
                            <PlannerSearchBar
                                widgetKey="'production_analysis_scrap'"
                                placeholder="'Buscar producto, categoría o centro…'"
                                t-props="{
                                    search:         state.scrapSearch,
                                    activeGroupBy:  state.scrapGroupBy,
                                    groupByDefs: [ { key: 'sector', label: 'Sector' }, { key: 'category', label: 'Categoría' } ],
                                    onSearch:        (t) => this.setScrapSearch(t),
                                    onGroupByChange: (k) => this.setScrapGroupBy(k),
                                    numericFields:     scrapNumColOptions,
                                    numFilters:        state.scrapNumFilters,
                                    onNumFilterAdd:    (c) => this.addScrapNumFilter(c),
                                    onNumFilterRemove: (i) => this.removeScrapNumFilter(i)
                                }"/>
                        </div>

                        <!-- Pestañas de agrupamiento por categoría -->
                        <t t-if="scrapAllGroupsForTabs">
                            <ul class="nav nav-tabs mb-0" style="flex-wrap:nowrap; overflow-x:auto;">
                                <t t-foreach="scrapAllGroupsForTabs" t-as="g" t-key="'sgt_' + g.key">
                                    <li class="nav-item">
                                        <button t-att-class="'nav-link px-3 py-1 ' + (scrapActiveGroupKey === g.key ? 'active fw-semibold' : 'text-muted')"
                                                style="font-size:12px; white-space:nowrap;"
                                                t-on-click="() => this.setScrapGroup(g.key)">
                                            <t t-esc="g.label"/>
                                            <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="g.count"/>)</span>
                                        </button>
                                    </li>
                                </t>
                            </ul>
                        </t>

                        <!-- Tabla por producto -->
                        <div class="table-responsive" style="max-height:60vh; overflow:auto;">
                            <table class="table table-sm table-hover table-bordered mb-0">
                                <thead class="table-light" style="position:sticky; top:0; z-index:3;">
                                    <tr>
                                        <t t-foreach="scrapCols" t-as="col" t-key="col.key">
                                            <th t-att-class="(col.align === 'center' ? 'text-center ' : (col.align === 'end' ? 'text-end ' : '')) + 'user-select-none'"
                                                style="cursor:pointer; white-space:nowrap;"
                                                t-att-title="scrapColTitle(col)"
                                                t-on-click="() => this.setScrapSort(col.key)">
                                                <t t-esc="col.label"/>
                                                <i t-att-class="scrapSortIcon(col.key)"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="scrapPagedRows" t-as="row" t-key="row.product_id">
                                        <t t-foreach="scrapCols" t-as="col" t-key="col.key">
                                            <td t-att-class="(col.align === 'center' ? 'text-center ' : (col.align === 'end' ? 'text-end ' : '')) + scrapCellClass(row, col.key)">
                                                <t t-if="col.key === 'name'">
                                                    <span t-esc="row.name"/>
                                                    <button class="btn btn-sm btn-link py-0 px-1 ms-1"
                                                            title="Ver operaciones de desecho del producto"
                                                            t-on-click.stop="() => this.openProductScraps(row)">
                                                        <i class="fa fa-external-link"/>
                                                    </button>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="scrapCellValue(row, col.key)"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                    <tr t-if="!scrapPagedRows.length">
                                        <td t-att-colspan="scrapCols.length" class="text-center text-muted py-3">
                                            Sin desechos en el período/filtros.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Paginación -->
                        <div t-if="scrapTotalPages > 1" class="d-flex align-items-center justify-content-between px-2 py-1 border-top">
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    t-att-disabled="!scrapHasPrevPage" t-on-click="scrapPrevPage">
                                <i class="fa fa-chevron-left"/>
                            </button>
                            <small class="text-muted">Pág. <t t-esc="state.scrapPage"/> / <t t-esc="scrapTotalPages"/> · <t t-esc="scrapSortedRows.length"/> producto(s)</small>
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    t-att-disabled="!scrapHasNextPage" t-on-click="scrapNextPage">
                                <i class="fa fa-chevron-right"/>
                            </button>
                        </div>

                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: OFs ════════════════ -->
            <t t-if="state.tab === 'ofs'">
                <t t-call="odoo_mrp_planner.ProdAnalysisDateBar"/>
                <div t-if="state.ofError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.ofError"/>
                </div>
                <div t-if="state.ofLoading and !ctls.of.rows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/><div class="mt-2 small">Cargando datos…</div>
                </div>
                <t t-if="!state.ofError and (ctls.of.rows.length or (state.ofLoaded and !state.ofLoading))">
                    <div t-att-class="state.ofLoading ? 'opacity-50 pe-none' : ''">
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución de OFs</span>
                        </div>
                        <div style="height:220px;" class="mb-4"><canvas t-ref="ofTrend"/></div>
                        <div class="o_planner_section_title mb-2 d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-bar-chart me-2 text-muted"/><span class="text-uppercase fw-bold text-muted small">Programado vs producido</span></span>
                            <select class="form-select form-select-sm" style="width:auto;" t-on-change="onBarTopNChange">
                                <option value="10" t-att-selected="state.barTopN === 10">Top 10</option>
                                <option value="20" t-att-selected="state.barTopN === 20">Top 20</option>
                                <option value="50" t-att-selected="state.barTopN === 50">Top 50</option>
                            </select>
                        </div>
                        <div style="height:320px;" class="mb-4"><canvas t-ref="ofBars"/></div>
                        <t t-call="odoo_mrp_planner.ProdAnalysisTableBlock">
                            <t t-set="ctl" t-value="ctls.of"/>
                        </t>
                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: Producido vs Programado ════════════════ -->
            <t t-if="state.tab === 'cumpl'">
                <t t-call="odoo_mrp_planner.ProdAnalysisDateBar"/>
                <div t-if="state.cmpError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.cmpError"/>
                </div>
                <div t-if="state.cmpLoading and !ctls.cmp.rows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/><div class="mt-2 small">Cargando datos…</div>
                </div>
                <t t-if="!state.cmpError and (ctls.cmp.rows.length or (state.cmpLoaded and !state.cmpLoading))">
                    <div t-att-class="state.cmpLoading ? 'opacity-50 pe-none' : ''">
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución del cumplimiento (%)</span>
                        </div>
                        <div style="height:220px;" class="mb-4"><canvas t-ref="cmpTrend"/></div>
                        <div class="o_planner_section_title mb-2 d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-bar-chart me-2 text-muted"/><span class="text-uppercase fw-bold text-muted small">Programado vs producido por producto</span></span>
                            <select class="form-select form-select-sm" style="width:auto;" t-on-change="onBarTopNChange">
                                <option value="10" t-att-selected="state.barTopN === 10">Top 10</option>
                                <option value="20" t-att-selected="state.barTopN === 20">Top 20</option>
                                <option value="50" t-att-selected="state.barTopN === 50">Top 50</option>
                            </select>
                        </div>
                        <div style="height:320px;" class="mb-4"><canvas t-ref="cmpBars"/></div>
                        <div t-if="state.cmpTruncated" class="alert alert-warning py-1 px-2 small mb-2">
                            <i class="fa fa-info-circle me-1"/>Mostrando los primeros <t t-esc="ctls.cmp.rows.length"/> de <t t-esc="state.cmpTotal"/> productos (los de mayor cantidad programada). Los KPIs consideran todo el período.
                        </div>
                        <t t-call="odoo_mrp_planner.ProdAnalysisTableBlock">
                            <t t-set="ctl" t-value="ctls.cmp"/>
                        </t>
                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: Plan vs Real (precisión de planificación) ════════════════ -->
            <t t-if="state.tab === 'efic'">
                <t t-call="odoo_mrp_planner.ProdAnalysisDateBar"/>
                <div class="alert alert-light border py-1 px-2 small mb-2 text-muted">
                    <i class="fa fa-info-circle me-1"/>Precisión de planificación: tiempo <b>real</b> vs <b>planificado</b> de las OT. <b>No</b> es el Performance del OEE (eso requiere registro de paros en taller).
                </div>
                <div t-if="state.efError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.efError"/>
                </div>
                <div t-if="state.efLoading and !ctls.ef.rows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/><div class="mt-2 small">Cargando datos…</div>
                </div>
                <t t-if="!state.efError and (ctls.ef.rows.length or (state.efLoaded and !state.efLoading))">
                    <div t-att-class="state.efLoading ? 'opacity-50 pe-none' : ''">
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución del cumplimiento de tiempos (%)</span>
                        </div>
                        <div style="height:220px;" class="mb-4"><canvas t-ref="efTrend"/></div>
                        <div class="o_planner_section_title mb-2 d-flex align-items-center justify-content-between">
                            <span><i class="fa fa-bar-chart me-2 text-muted"/><span class="text-uppercase fw-bold text-muted small">Horas plan vs real por producto</span></span>
                            <select class="form-select form-select-sm" style="width:auto;" t-on-change="onBarTopNChange">
                                <option value="10" t-att-selected="state.barTopN === 10">Top 10</option>
                                <option value="20" t-att-selected="state.barTopN === 20">Top 20</option>
                                <option value="50" t-att-selected="state.barTopN === 50">Top 50</option>
                            </select>
                        </div>
                        <div style="height:320px;" class="mb-4"><canvas t-ref="efBars"/></div>
                        <t t-call="odoo_mrp_planner.ProdAnalysisTableBlock">
                            <t t-set="ctl" t-value="ctls.ef"/>
                        </t>
                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: OEE (avanzado, gateada por Ajustes) ════════════════ -->
            <t t-if="state.tab === 'oee'">
                <t t-call="odoo_mrp_planner.ProdAnalysisDateBar"/>
                <div class="alert alert-light border py-1 px-2 small mb-2 text-muted">
                    <i class="fa fa-info-circle me-1"/>OEE = Disponibilidad × Rendimiento × Calidad, por centro de trabajo. Se calcula con el <b>registro nativo de paros</b> de Odoo (app Taller). OEE vs OOE vs TEEP = mismo numerador sobre tiempo registrado / turno / calendario 24×7.
                </div>
                <div t-if="state.oeeError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.oeeError"/>
                </div>
                <div t-if="state.oeeLoading and !ctls.oee.rows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/><div class="mt-2 small">Cargando datos…</div>
                </div>
                <!-- Sin registro de productividad: avisar en vez de mostrar ceros -->
                <div t-if="!state.oeeError and state.oeeLoaded and !state.oeeLoading and !ctls.oee.rows.length"
                     class="alert alert-warning py-3">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    <b>Sin registros de productividad en el período.</b>
                    El OEE necesita que se registren tiempos y paros de los centros en la app Taller/Órdenes de trabajo. Sin ese dato no se puede calcular (no se muestran ceros para no confundir).
                </div>
                <t t-if="!state.oeeError and ctls.oee.rows.length">
                    <div t-att-class="state.oeeLoading ? 'opacity-50 pe-none' : ''">
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución de OEE / OOE / TEEP (%)</span>
                        </div>
                        <div style="height:240px;" class="mb-4"><canvas t-ref="oeeTrend"/></div>
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-bar-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Componentes e índices del período (%)</span>
                        </div>
                        <div style="height:260px;" class="mb-4"><canvas t-ref="oeeBars"/></div>
                        <t t-call="odoo_mrp_planner.ProdAnalysisTableBlock">
                            <t t-set="ctl" t-value="ctls.oee"/>
                        </t>
                    </div>
                </t>
            </t>

            <!-- ════════════════ PESTAÑA: Evolución ════════════════ -->
            <t t-if="state.tab === 'evol'">
                <t t-call="odoo_mrp_planner.ProdAnalysisDateBar"/>
                <div t-if="state.evolError" class="alert alert-danger py-2 mb-2">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-esc="state.evolError"/>
                </div>
                <div t-if="state.evolLoading and !state.evolRows.length" class="text-center text-muted py-5">
                    <i class="fa fa-spinner fa-spin fa-2x"/><div class="mt-2 small">Cargando datos…</div>
                </div>
                <t t-if="!state.evolError and (state.evolRows.length or (state.evolLoaded and !state.evolLoading))">
                    <div t-att-class="state.evolLoading ? 'opacity-50 pe-none' : ''">
                        <div class="o_planner_section_title mb-2">
                            <i class="fa fa-line-chart me-2 text-muted"/>
                            <span class="text-uppercase fw-bold text-muted small">Evolución mensual de las tasas (%)</span>
                        </div>
                        <div style="height:240px;" class="mb-4"><canvas t-ref="evolTrend"/></div>

                        <!-- KPIs (totales del período) -->
                        <div class="d-flex gap-2 mb-3">
                            <t t-foreach="evolKpiCards" t-as="card" t-key="card.key">
                                <div class="flex-fill" style="min-width:0; flex-basis:0;">
                                    <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="card.tip">
                                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                                            <div t-att-class="'o_planner_number ' + card.cls" t-esc="card.value"/>
                                            <div class="o_planner_label" t-esc="card.label"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Tabla mensual -->
                        <div class="table-responsive" style="max-height:60vh; overflow:auto;">
                            <table class="table table-sm table-hover table-bordered mb-0">
                                <thead class="table-light" style="position:sticky; top:0; z-index:3;">
                                    <tr>
                                        <t t-foreach="evolCols" t-as="col" t-key="col.key">
                                            <th t-att-class="col.align === 'center' ? 'text-center' : ''"
                                                style="white-space:nowrap;" t-att-title="evolColTitle(col)" t-esc="col.label"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.evolRows" t-as="row" t-key="row.ym">
                                        <t t-foreach="evolCols" t-as="col" t-key="col.key">
                                            <td t-att-class="(col.align === 'center' ? 'text-center ' : '') + evolCellClass(row, col.key)"
                                                t-esc="evolCellValue(row, col.key)"/>
                                        </t>
                                    </tr>
                                    <tr t-if="!state.evolRows.length">
                                        <td t-att-colspan="evolCols.length" class="text-center text-muted py-3">
                                            Sin datos en el período.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>

        </div>
    </t>

    <!-- ════════════════ Barra de rango + sector (reusada por las nuevas pestañas) ════════════════ -->
    <t t-name="odoo_mrp_planner.ProdAnalysisDateBar">
        <div class="d-flex align-items-end gap-3 mb-3 flex-wrap">
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Desde</label>
                <input type="date" class="form-control form-control-sm" style="width:150px;"
                       t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Hasta</label>
                <input type="date" class="form-control form-control-sm" style="width:150px;"
                       t-att-value="state.dateTo" t-on-change="onDateToChange"/>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Sector</label>
                <select class="form-select form-select-sm" style="width:180px;" t-on-change="onTagChange">
                    <option value="" t-att-selected="!state.tagId">Todos los sectores</option>
                    <t t-foreach="state.tags" t-as="tg" t-key="tg.id">
                        <option t-att-value="tg.id" t-att-selected="state.tagId === tg.id" t-esc="tg.name"/>
                    </t>
                </select>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Tipo producto</label>
                <select class="form-select form-select-sm" multiple="multiple"
                        style="width:180px;" t-on-change="onProductTypeChange">
                    <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                        <option t-att-value="pt.id"
                                t-att-selected="state.productTypeIds.includes(pt.id)"
                                t-esc="pt.name"/>
                    </t>
                </select>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Turno</label>
                <select class="form-select form-select-sm" multiple="multiple"
                        style="width:160px;" t-on-change="onShiftChange">
                    <t t-foreach="state.shifts" t-as="sh" t-key="sh.id">
                        <option t-att-value="sh.id"
                                t-att-selected="state.shiftIds.includes(sh.id)"
                                t-esc="sh.name"/>
                    </t>
                </select>
            </div>
        </div>
    </t>

    <!-- ════════════════ Bloque tabla+KPIs+búsqueda (parametrizado por ctl) ════════════════ -->
    <t t-name="odoo_mrp_planner.ProdAnalysisTableBlock">
        <!-- KPIs (describen las filas visibles) -->
        <div class="d-flex gap-2 mb-3">
            <t t-foreach="ctl.kpiCards" t-as="card" t-key="card.key">
                <div class="flex-fill" style="min-width:0; flex-basis:0;">
                    <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="ctl.kpiTooltip(card.key)">
                        <div class="card-body text-center py-2 d-flex flex-column align-items-center justify-content-center">
                            <div t-att-class="'o_planner_number ' + card.cls" t-esc="card.value"/>
                            <div class="o_planner_label" t-esc="card.label"/>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1" t-on-click="() => ctl.viewAll()">Ver →</button>
                        </div>
                    </div>
                </div>
            </t>
        </div>

        <!-- Barra de búsqueda -->
        <div class="mb-2">
            <PlannerSearchBar
                widgetKey="ctl.widgetKey"
                placeholder="ctl.placeholder"
                t-props="{
                    search:         ctl.search,
                    activeGroupBy:  ctl.groupBy,
                    groupByDefs:    ctl.groupByDefs,
                    onSearch:        (t) => ctl.setSearch(t),
                    onGroupByChange: (k) => ctl.setGroupBy(k),
                    numericFields:     ctl.numColOptions,
                    numFilters:        ctl.numFilters,
                    onNumFilterAdd:    (c) => ctl.addNumFilter(c),
                    onNumFilterRemove: (i) => ctl.removeNumFilter(i)
                }"/>
        </div>

        <!-- Pestañas de agrupamiento -->
        <t t-if="ctl.groupsForTabs">
            <ul class="nav nav-tabs mb-0" style="flex-wrap:nowrap; overflow-x:auto;">
                <t t-foreach="ctl.groupsForTabs" t-as="g" t-key="'pg_' + g.key">
                    <li class="nav-item">
                        <button t-att-class="'nav-link px-3 py-1 ' + (ctl.activeGroupKey === g.key ? 'active fw-semibold' : 'text-muted')"
                                style="font-size:12px; white-space:nowrap;"
                                t-on-click="() => ctl.setGroup(g.key)">
                            <t t-esc="g.label"/>
                            <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="g.count"/>)</span>
                        </button>
                    </li>
                </t>
            </ul>
        </t>

        <!-- Tabla -->
        <div class="table-responsive" style="max-height:60vh; overflow:auto;">
            <table class="table table-sm table-hover table-bordered mb-0">
                <thead class="table-light" style="position:sticky; top:0; z-index:3;">
                    <tr>
                        <t t-foreach="ctl.cols" t-as="col" t-key="col.key">
                            <th t-att-class="(col.align === 'center' ? 'text-center ' : (col.align === 'end' ? 'text-end ' : '')) + 'user-select-none'"
                                style="cursor:pointer; white-space:nowrap;"
                                t-att-title="ctl.colTitle(col)"
                                t-on-click="() => ctl.setSort(col.key)">
                                <t t-esc="col.label"/>
                                <i t-att-class="ctl.sortIcon(col.key)"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="ctl.pagedRows" t-as="row" t-key="row_index">
                        <t t-foreach="ctl.cols" t-as="col" t-key="col.key">
                            <td t-att-class="(col.align === 'center' ? 'text-center ' : (col.align === 'end' ? 'text-end ' : '')) + ctl.cellClass(row, col.key)">
                                <t t-if="col.key === 'name'">
                                    <span t-esc="row.name"/>
                                    <button class="btn btn-sm btn-link py-0 px-1 ms-1"
                                            title="Ver detalle" t-on-click.stop="() => ctl.viewRow(row)">
                                        <i class="fa fa-external-link"/>
                                    </button>
                                </t>
                                <t t-else="">
                                    <t t-esc="ctl.cellValue(row, col.key)"/>
                                </t>
                            </td>
                        </t>
                    </tr>
                    <tr t-if="!ctl.pagedRows.length">
                        <td t-att-colspan="ctl.cols.length" class="text-center text-muted py-3" t-esc="ctl.emptyMsg"/>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Paginación -->
        <div t-if="ctl.totalPages > 1" class="d-flex align-items-center justify-content-between px-2 py-1 border-top">
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" t-att-disabled="!ctl.hasPrev" t-on-click="() => ctl.prev()">
                <i class="fa fa-chevron-left"/>
            </button>
            <small class="text-muted">Pág. <t t-esc="ctl.page"/> / <t t-esc="ctl.totalPages"/> · <t t-esc="ctl.sortedRows.length"/> <t t-esc="ctl.unit"/></small>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2" t-att-disabled="!ctl.hasNext" t-on-click="() => ctl.next()">
                <i class="fa fa-chevron-right"/>
            </button>
        </div>
    </t>

</templates>
