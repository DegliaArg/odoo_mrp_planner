<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_mrp_workcenters" model="ir.ui.view">
        <field name="name">product.template.form.mrp.workcenters</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Centros de trabajo" name="mrp_workcenters">
                    <field name="x_centros_compatibles">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="workcenter_id" required="1"/>
                            <field name="is_preferred"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="exclusion_reason" invisible="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
