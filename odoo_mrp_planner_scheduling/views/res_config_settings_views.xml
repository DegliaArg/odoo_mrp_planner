<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista propia de configuración del módulo de Planificación ── -->
    <record id="mrp_scheduling_config_form_view" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.scheduling.form</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de planificación" create="false" delete="false">
                <sheet>
                    <h2>Planificación y reprogramación</h2>

                    <!-- ══ HABILITACIÓN MAESTRA ══════════════════════════════════ -->
                    <group string="Activación">
                        <field name="enable_scheduling" widget="scheduling_toggle" nolabel="1"/>
                        <div class="text-muted small border-start border-2 ps-2 mt-1">
                            <p class="mb-1">
                                Interruptor maestro de todas las funciones de programación
                                y reprogramación. Installar el módulo <b>no</b> activa estas
                                funciones automáticamente: se habilitan desde aquí.
                            </p>
                            <p class="mb-0">
                                Cuando está <b>desactivado</b> se ocultan:
                                los botones de reprogramación en las OFs,
                                las tarjetas KPI "Para reprogramar" y "Con reprogramación"
                                en el panel de producción,
                                y la pestaña de centros de trabajo compatibles en los artículos.
                            </p>
                        </div>
                    </group>

                    <!-- ══ OPCIONES DE REPROGRAMACIÓN (visibles solo si habilitado) ══ -->
                    <div invisible="not enable_scheduling">

                        <group string="Centro de trabajo sin configurar">
                            <div class="text-muted small mb-2">
                                Qué hace el motor de reprogramación cuando una OF corresponde a
                                un producto que no tiene centros de trabajo compatibles asignados.
                            </div>
                            <field name="wc_fallback" widget="radio" nolabel="1"/>
                        </group>

                        <group string="Criterio de prioridad entre OFs">
                            <div class="text-muted small mb-2">
                                Cuando dos o más OFs compiten por el mismo centro de trabajo,
                                este criterio define cuál se programa primero.
                            </div>
                            <field name="priority" widget="radio" nolabel="1"/>
                        </group>

                        <group string="Opciones avanzadas">
                            <field name="include_wc_heuristic" widget="boolean_toggle"
                                   help="Incluye como dependientes las OFs que comparten centros de trabajo con la OF pivot, aunque no estén encadenadas por BOM. Útil en plantas con alta carga de CTs, pero puede generar reprogramaciones masivas."/>
                        </group>

                    </div>

                    <!-- ══ TABLERO DE PROGRAMACIÓN ══════════════════════════════════ -->
                    <group string="Tablero de programación">
                        <field name="default_scheduling_tag_id"
                               help="Sector que se preselecciona automáticamente al abrir el tablero de programación de producción."/>
                    </group>

                    <!-- ══ TURNOS (compartidos con los paneles) ════════════════════ -->
                    <group string="Turnos de producción">
                        <div class="text-muted small mb-2">
                            Los turnos definen cómo se desglosan las filas del tablero por
                            franja horaria (ej. 1°(06-14), 2°(14-22), 3°(22-06)).
                            La configuración es compartida con el Panel de Producción.
                        </div>
                        <field name="enable_shifts" widget="boolean_toggle"
                               string="Habilitar desglose por turnos en el tablero"/>
                        <field name="shift_ids" nolabel="1"
                               invisible="not enable_shifts"
                               help="Defina los turnos para desglosar el tablero por horario. Los turnos que cruzan la medianoche (Hora fin &lt; Hora inicio) se detectan automáticamente.">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="hour_from" widget="float_time"/>
                                <field name="hour_to"   widget="float_time"/>
                            </list>
                        </field>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción: abre el singleton de config apuntando a la vista de scheduling ── -->
    <record id="action_mrp_scheduling_config" model="ir.actions.act_window">
        <field name="name">Configuración de planificación</field>
        <field name="res_model">mrp.reschedule.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_scheduling_config_form_view"/>
        <field name="res_id" ref="odoo_mrp_planner.mrp_reschedule_config_singleton"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False, 'no_pager': 1}</field>
    </record>

</odoo>
