<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.SupplierAnalysisWidget">
        <div class="o_supplier_analysis_widget" t-att-class="state.loading ? 'opacity-50 pe-none' : ''">

            <!-- Error de backend -->
            <div t-if="state.loadError" class="alert alert-danger py-2 mb-2" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                Error al cargar análisis de proveedores: <strong><t t-esc="state.loadError"/></strong>
            </div>

            <!-- KPI cards -->
            <t t-if="state.data and state.data.rows.length > 0">
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('suppliers')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-users fa-lg text-secondary mb-2 d-block" aria-hidden="true"/>
                                <div class="o_planner_number"
                                     aria-live="polite" aria-label="Proveedores"><t t-esc="state.data.kpis.supplier_count"/></div>
                                <div class="o_planner_label" aria-hidden="true">Proveedores</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1"
                                        aria-label="Ver proveedores"
                                        t-on-click="openSupplierList">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('amount')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-money fa-lg text-primary mb-2 d-block" aria-hidden="true"/>
                                <div class="o_planner_number"
                                     aria-live="polite" aria-label="Monto comprado"><t t-esc="fmtMoney(state.data.kpis.total_amount)"/></div>
                                <div class="o_planner_label" aria-hidden="true">Monto comprado</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1"
                                        aria-label="Ver monto comprado"
                                        t-on-click="openKpiList">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('orders')">
                            <div class="card-body text-center py-3">
                                <i class="fa fa-file-text fa-lg text-secondary mb-2 d-block" aria-hidden="true"/>
                                <div class="o_planner_number"
                                     aria-live="polite" aria-label="Órdenes de compra"><t t-esc="state.data.kpis.total_orders"/></div>
                                <div class="o_planner_label" aria-hidden="true">Órdenes</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1"
                                        aria-label="Ver órdenes de compra"
                                        t-on-click="openKpiList">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('on_time')">
                            <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                                <i class="fa fa-clock-o fa-lg text-secondary mb-2 d-block" aria-hidden="true"/>
                                <div t-att-class="'o_planner_number ' + onTimeCls(state.data.kpis.avg_on_time_pct)"
                                     aria-live="polite" aria-label="Porcentaje de entregas a tiempo">
                                    <t t-if="state.data.kpis.avg_on_time_pct !== null">
                                        <t t-esc="state.data.kpis.avg_on_time_pct"/>%
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                                <div class="o_planner_label" aria-hidden="true">A tiempo</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('lead_time')">
                            <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                                <i class="fa fa-hourglass-half fa-lg text-secondary mb-2 d-block" aria-hidden="true"/>
                                <div class="o_planner_number"
                                     aria-live="polite" aria-label="Lead time promedio en días">
                                    <t t-if="state.data.kpis.avg_lead_time_days !== null">
                                        <t t-esc="state.data.kpis.avg_lead_time_days"/> d
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                                <div class="o_planner_label" aria-hidden="true">Lead time</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-2">
                        <div class="card o_planner_card h-100"
                             t-att-title="supplierKpiTooltip('price_var')">
                            <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                                <i class="fa fa-tag fa-lg text-secondary mb-2 d-block" aria-hidden="true"/>
                                <div t-att-class="'o_planner_number ' + priceVarCls(state.data.kpis.avg_price_var_pct)"
                                     aria-live="polite" aria-label="Variación de precio promedio">
                                    <t t-if="state.data.kpis.avg_price_var_pct !== null">
                                        <t t-esc="fmtPct(state.data.kpis.avg_price_var_pct)"/>
                                    </t>
                                    <t t-else="">—</t>
                                </div>
                                <div class="o_planner_label" aria-hidden="true">Var. precio</div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Toolbar unificada -->
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

                <!-- Período -->
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted" for="sup_period_from">Desde</label>
                    <input type="date" id="sup_period_from" class="form-control form-control-sm"
                           style="max-width:140px;"
                           t-att-value="state.periodFrom"
                           t-on-change="onPeriodFromChange"/>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="form-label mb-0 small text-muted" for="sup_period_to">Hasta</label>
                    <input type="date" id="sup_period_to" class="form-control form-control-sm"
                           style="max-width:140px;"
                           t-att-value="state.periodTo"
                           t-on-change="onPeriodToChange"/>
                </div>

                <!-- Buscador con agrupamiento -->
                <PlannerSearchBar
                    class="flex-grow-1"
                    widgetKey="'supplier_analysis'"
                    placeholder="'Buscar proveedor…'"
                    t-props="{
                        search:          state.search,
                        activeFilter:    state.activeFilter,
                        activeGroupBy:   state.groupBy,
                        groupByDefs: [
                            { key: 'supplier_cat', label: 'Categoría' },
                        ],
                        onSearch:        (t) => this.setSearch(t),
                        onFilterChange:  (k) => this.setActiveFilter(k),
                        onGroupByChange: (k) => this.onGroupByChange(k),
                        numericFields:     numColOptions,
                        numFilters:        state.numFilters,
                        onNumFilterAdd:    (c) => this.addNumFilter(c),
                        onNumFilterRemove: (i) => this.removeNumFilter(i),
                    }"/>

                <!-- Tipo dropdown (Bienes / Servicios) -->
                <div class="position-relative" t-on-click.stop="">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                            aria-label="Filtrar por tipo de OC"
                            t-att-aria-expanded="state.tipoDropdownOpen ? 'true' : 'false'"
                            t-on-click="toggleTipoDropdown">
                        <i class="fa fa-filter" aria-hidden="true"/>
                        <span><t t-esc="poTypeDropdownLabel"/></span>
                        <i t-att-class="'fa ' + (state.tipoDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')" aria-hidden="true"/>
                    </button>
                    <div t-if="state.tipoDropdownOpen"
                         class="dropdown-menu show shadow p-2"
                         style="min-width:160px; position:absolute; z-index:1050; top:100%; left:0; margin-top:2px;">
                        <div class="form-check mb-1">
                            <input type="checkbox" class="form-check-input" id="sup_type_goods"
                                   t-att-checked="state.poTypeGoods"
                                   t-on-change="() => this.togglePoType('goods')"/>
                            <label class="form-check-label small" for="sup_type_goods">Bienes</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="sup_type_services"
                                   t-att-checked="state.poTypeServices"
                                   t-on-change="() => this.togglePoType('services')"/>
                            <label class="form-check-label small" for="sup_type_services">Servicios</label>
                        </div>
                    </div>
                </div>

                <!-- Columnas ▼ -->
                <div class="position-relative" t-on-click.stop="">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                            aria-label="Seleccionar columnas visibles"
                            t-att-aria-expanded="state.colsDropdownOpen ? 'true' : 'false'"
                            t-on-click="toggleColsDropdown">
                        <i class="fa fa-columns" aria-hidden="true"/>
                        <span>Columnas</span>
                        <i t-att-class="'fa ' + (state.colsDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')" aria-hidden="true"/>
                    </button>
                    <div t-if="state.colsDropdownOpen"
                         class="dropdown-menu show shadow p-2"
                         style="min-width:200px; position:absolute; z-index:1050; top:100%; left:0; margin-top:2px;">
                        <t t-foreach="colsSup.visibleCols()" t-as="col" t-key="col.key">
                            <t t-if="!col.fixed">
                                <div class="form-check mb-1">
                                    <input type="checkbox" class="form-check-input"
                                           t-att-id="'sup_col_' + col.key"
                                           t-att-checked="state.colsVisible[col.key] !== false"
                                           t-on-change="() => this.toggleSupCol(col.key)"/>
                                    <label class="form-check-label small" t-att-for="'sup_col_' + col.key">
                                        <t t-esc="col.label"/>
                                    </label>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- Exportar -->
                <button class="btn btn-sm btn-outline-success ms-auto d-flex align-items-center gap-1"
                        aria-label="Exportar tabla de proveedores a CSV"
                        t-on-click="downloadExport">
                    <i class="fa fa-download" aria-hidden="true"/>
                    <span>Exportar</span>
                </button>

            </div>

            <!-- Sin datos -->
            <div t-if="!state.loading and state.data and state.data.rows.length === 0"
                 class="text-center text-muted py-4 border rounded"
                 role="status" aria-live="polite">
                <i class="fa fa-search fa-2x mb-2 d-block" aria-hidden="true"/>
                No hay proveedores con órdenes confirmadas en el período seleccionado.
            </div>

            <!-- Tabs de agrupamiento por categoría -->
            <t t-if="state.groupBy and allGroupsForTabs">
                <ul class="nav nav-tabs mb-0" style="flex-wrap:nowrap; overflow-x:auto;">
                    <t t-foreach="allGroupsForTabs" t-as="g" t-key="'tab_sup_' + g.key">
                        <li class="nav-item">
                            <button t-att-class="'nav-link px-3 py-1 ' + (state.selectedGroup === g.key ? 'active fw-semibold' : 'text-muted')"
                                    style="font-size:12px; white-space:nowrap;"
                                    t-on-click="() => this.setGroup(g.key)">
                                <span t-att-class="'badge text-bg-' + ({'A':'success','B':'primary','C':'warning','D':'secondary','E':'danger'}[g.key] || 'secondary')"
                                      style="font-size:10px; padding:1px 6px; margin-right:4px;">
                                    <t t-esc="g.label"/>
                                </span>
                                <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="g.count"/>)</span>
                            </button>
                        </li>
                    </t>
                </ul>
            </t>

            <t t-if="state.data and sortedRows.length > 0">

                <!-- Tabla -->
                <div class="border rounded" style="overflow:auto;">
                    <table class="table table-sm table-hover mb-0" style="font-size:12px; min-width:700px; table-layout:fixed;">
                        <colgroup>
                            <col t-foreach="supVisibleCols" t-as="col" t-key="col.key"
                                 t-att-style="colsSup.colGroupStyle(col.key)"/>
                        </colgroup>
                        <thead>
                            <tr class="table-light text-muted">
                                <th t-foreach="supVisibleCols" t-as="col" t-key="col.key"
                                    t-att-class="(col.align ? 'text-' + col.align + ' ' : '') + (colsSup.state.dragOver === col.key ? 'o_col_drag_over ' : '')"
                                    style="padding:6px 8px; position:relative; user-select:none;"
                                    t-att-title="col.title || col.label"
                                    t-att-data-col-key="col.key"
                                    t-att-data-sort-key="col.sortKey || ''"
                                    t-att-draggable="col.fixed ? 'false' : 'true'"
                                    t-on-click="onHeaderClick"
                                    t-on-dragstart="colsSup.onDragStart"
                                    t-on-dragover="colsSup.onDragOver"
                                    t-on-drop="colsSup.onDrop"
                                    t-on-dragend="colsSup.onDragEnd">
                                    <t t-esc="col.label"/>
                                    <i t-if="col.sortKey" t-att-class="sortIcon(col.sortKey)"/>
                                    <div t-if="!col.noResize" class="o_col_resize_handle"
                                         t-att-data-col-key="col.key"
                                         t-on-mousedown.stop="colsSup.onResizeStart"
                                         t-on-click.stop="() => {}"/>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pagedRows" t-as="row" t-key="row.partner_id">

                                <!-- Fila principal -->
                                <tr>
                                    <td t-foreach="supVisibleCols" t-as="col" t-key="col.key"
                                        style="padding:5px 8px;"
                                        t-att-class="col.align ? 'text-' + col.align : ''">
                                        <t t-if="col.key === 'supplier_cat'">
                                            <span t-if="row.supplier_cat"
                                                  t-att-class="'badge ' + catBadgeClass(row.supplier_cat)"
                                                  t-att-title="'Categoría de proveedor: ' + row.supplier_cat"
                                                  t-esc="row.supplier_cat"/>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                        <t t-elif="col.key === 'partner_name'">
                                            <button class="btn btn-link btn-sm p-0 me-1 text-muted"
                                                    style="line-height:1; vertical-align:middle;"
                                                    t-att-title="state.expandedSuppliers[row.partner_id] ? 'Cerrar OCs' : 'Ver OCs del proveedor'"
                                                    t-att-aria-label="state.expandedSuppliers[row.partner_id] ? 'Cerrar órdenes de compra de ' + row.partner_name : 'Ver órdenes de compra de ' + row.partner_name"
                                                    t-att-aria-expanded="state.expandedSuppliers[row.partner_id] ? 'true' : 'false'"
                                                    t-on-click.stop="() => this.toggleAccordion(row)">
                                                <i t-att-class="'fa ' + (state.expandedSuppliers[row.partner_id] ? 'fa-chevron-down' : 'fa-chevron-right')" aria-hidden="true"/>
                                            </button>
                                            <a href="#"
                                               class="text-truncate d-inline-block fw-semibold"
                                               style="max-width:130px; vertical-align:middle; color:inherit; text-decoration:none;"
                                               t-att-title="'Abrir ficha de ' + row.partner_name"
                                               t-on-click.stop="(ev) => this.openSupplier(ev, row)">
                                                <t t-esc="row.partner_name"/>
                                            </a>
                                        </t>
                                        <t t-elif="col.key === 'order_count'">
                                            <a href="#" class="text-primary"
                                               t-att-title="'Ver las ' + row.order_count + ' OCs de ' + row.partner_name"
                                               t-on-click.stop="(ev) => this.openPOs(ev, row)">
                                                <t t-esc="row.order_count"/>
                                            </a>
                                        </t>
                                        <t t-elif="col.key === 'distinct_products'">
                                            <span class="text-muted"><t t-esc="row.distinct_products"/></span>
                                        </t>
                                        <t t-elif="col.key === 'total_amount'">
                                            <span class="fw-semibold"><t t-esc="fmtMoney(row.total_amount)"/></span>
                                        </t>
                                        <t t-elif="col.key === 'on_time_pct'">
                                            <span t-if="row.on_time_pct !== null"
                                                  t-att-class="onTimeCls(row.on_time_pct)"
                                                  t-att-title="supplierCellTooltip('on_time_pct', row)">
                                                <t t-esc="row.on_time_pct"/>%
                                            </span>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                        <t t-elif="col.key === 'avg_delay_days'">
                                            <span t-if="row.avg_delay_days !== null"
                                                  t-att-class="delayCls(row.avg_delay_days)"
                                                  t-att-title="'Retraso promedio: ' + row.avg_delay_days + ' d'">
                                                <t t-esc="row.avg_delay_days"/> d
                                            </span>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                        <t t-elif="col.key === 'complete_pct'">
                                            <span t-if="row.complete_pct !== null"
                                                  t-att-class="completeCls(row.complete_pct)"
                                                  t-att-title="supplierCellTooltip('complete_pct', row)">
                                                <t t-esc="row.complete_pct"/>%
                                            </span>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                        <t t-elif="col.key === 'avg_lead_time'">
                                            <span class="text-muted"
                                                  t-att-title="row.avg_lead_time !== null ? ('Lead time promedio: ' + row.avg_lead_time + ' días') : 'Sin datos'">
                                                <t t-if="row.avg_lead_time !== null"><t t-esc="row.avg_lead_time"/> d</t>
                                                <t t-else="">—</t>
                                            </span>
                                        </t>
                                        <t t-elif="col.key === 'avg_price_var_pct'">
                                            <span t-if="row.avg_price_var_pct !== null"
                                                  t-att-class="priceVarCls(row.avg_price_var_pct)"
                                                  t-att-title="supplierCellTooltip('avg_price_var_pct', row)">
                                                <t t-esc="fmtPct(row.avg_price_var_pct)"/>
                                            </span>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                        <t t-elif="col.key === 'pending_inv'">
                                            <span t-if="row.pending_inv" class="text-danger fw-semibold"
                                                  t-att-title="'Facturas pendientes: ' + fmtMoney(row.pending_inv)">
                                                <t t-esc="fmtMoney(row.pending_inv)"/>
                                            </span>
                                            <span t-else="" class="text-muted small">—</span>
                                        </t>
                                    </td>
                                </tr>

                                <!-- Acordeón de OCs -->
                                <tr t-if="state.expandedSuppliers[row.partner_id]">
                                    <td t-att-colspan="tableColspan"

                                        class="p-0" style="background:#f8f9fa; border-top:none;">
                                        <div class="px-4 py-2">

                                            <div t-if="state.posLoading[row.partner_id]"
                                                 class="text-center text-muted py-2 small"
                                                 role="status" aria-live="polite">
                                                <i class="fa fa-spinner fa-spin me-1" aria-hidden="true"/> Cargando OCs…
                                            </div>

                                            <div t-elif="!state.posBySupplier[row.partner_id] or !state.posBySupplier[row.partner_id].length"
                                                 class="text-muted small py-1">
                                                <i class="fa fa-info-circle me-1" aria-hidden="true"/>
                                                No hay órdenes de compra en el período.
                                            </div>

                                            <table t-else=""
                                                   class="table table-sm table-borderless mb-0"
                                                   style="font-size:11px; background:transparent;">
                                                <thead>
                                                    <tr class="text-muted" style="border-bottom:1px solid #dee2e6;">
                                                        <th style="padding:3px 6px;">N° OC</th>
                                                        <th style="padding:3px 6px;">Aprobación</th>
                                                        <th style="padding:3px 6px;">Recep. estim.</th>
                                                        <th class="text-end" style="padding:3px 6px;">Monto</th>
                                                        <th class="text-center" style="padding:3px 6px;">Artículos</th>
                                                        <th class="text-center" style="padding:3px 6px;">Recepción</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="state.posBySupplier[row.partner_id]" t-as="po" t-key="po.po_id">
                                                        <tr style="cursor:pointer;"
                                                            t-att-aria-label="'Abrir orden de compra ' + po.name"
                                                            t-on-click="(ev) => this.openPO(ev, po)">
                                                            <td style="padding:3px 6px;" class="fw-semibold text-primary">
                                                                <t t-esc="po.name"/>
                                                            </td>
                                                            <td class="text-muted" style="padding:3px 6px;">
                                                                <t t-esc="po.date_approve || '—'"/>
                                                            </td>
                                                            <td class="text-muted" style="padding:3px 6px;">
                                                                <t t-esc="po.date_planned || '—'"/>
                                                            </td>
                                                            <td class="text-end fw-semibold" style="padding:3px 6px;">
                                                                <t t-esc="fmtMoney(po.amount_total)"/>
                                                            </td>
                                                            <td class="text-center text-muted" style="padding:3px 6px;">
                                                                <t t-esc="po.product_count"/>
                                                            </td>
                                                            <td class="text-center" style="padding:3px 6px;">
                                                                <span t-att-class="receiptBadge(po.receipt_status)"
                                                                      style="font-size:10px; padding:2px 5px;">
                                                                    <t t-esc="receiptLabel(po.receipt_status)"/>
                                                                </span>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>

                                        </div>
                                    </td>
                                </tr>

                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                <div t-if="totalPages > 1"
                     class="d-flex align-items-center justify-content-between px-1 py-1 mt-1">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                            aria-label="Página anterior"
                            t-att-disabled="!hasPrevPage" t-on-click="prevPage">
                        <i class="fa fa-chevron-left" aria-hidden="true"/>
                    </button>
                    <small class="text-muted" aria-live="polite">
                        Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/>
                    </small>
                    <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                            aria-label="Página siguiente"
                            t-att-disabled="!hasNextPage" t-on-click="nextPage">
                        <i class="fa fa-chevron-right" aria-hidden="true"/>
                    </button>
                </div>

            </t>

        </div>
    </t>

</templates>
