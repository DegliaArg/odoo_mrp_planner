<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.SalesChartWidget">
        <div class="o_sales_chart_widget">

            <!-- Fila 1: Período + Métrica + Top N -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">

                <div class="btn-group btn-group-sm" role="group">
                    <t t-foreach="[['1m','1 mes'],['3m','3 meses'],['6m','6 meses'],['12m','12 meses']]"
                       t-as="p" t-key="p[0]">
                        <button t-att-class="'btn ' + (state.period === p[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                t-att-title="'Mostrar ventas de los últimos ' + p[1]"
                                t-on-click="() => this.setPeriod(p[0])">
                            <t t-esc="p[1]"/>
                        </button>
                    </t>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <div class="btn-group btn-group-sm" role="group">
                        <button t-att-class="'btn ' + (state.metric === 'qty' ? 'btn-info' : 'btn-outline-secondary')"
                                title="Ordenar y mostrar por unidades entregadas (stock.move.line.quantity)"
                                t-on-click="() => this.setMetric('qty')">Unidades</button>
                        <button t-att-class="'btn ' + (state.metric === 'amount' ? 'btn-info' : 'btn-outline-secondary')"
                                title="Ordenar y mostrar por importe estimado (precio de lista × unidades entregadas)"
                                t-on-click="() => this.setMetric('amount')">Importe</button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                            <button t-att-class="'btn ' + (state.topN === n ? 'btn-secondary' : 'btn-outline-secondary')"
                                    t-att-title="'Mostrar los ' + n + ' productos más vendidos según la métrica seleccionada'"
                                    t-on-click="() => this.setTopN(n)">
                                <t t-esc="'Top ' + n"/>
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Fila 2: Fuente de datos -->
            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                <span class="small text-muted fw-semibold me-1">Fuente:</span>
                <t t-foreach="[['sales','OVs'],['rfq','Cotizaciones'],['all','Ambas'],['deliveries','Entregas']]"
                   t-as="d" t-key="d[0]">
                    <button t-att-class="'btn btn-sm ' + (state.docType === d[0] ? 'btn-primary' : 'btn-outline-secondary')"
                            style="padding:1px 10px; font-size:11px;"
                            t-att-title="d[0] === 'sales' ? 'OVs confirmadas y entregadas (sale.order.line, estado: sale/done)' : d[0] === 'rfq' ? 'Cotizaciones y borradores (sale.order.line, estado: draft/sent)' : d[0] === 'all' ? 'Todas las OVs y cotizaciones' : 'Entregas físicas completadas (stock.move.line)'"
                            t-on-click="() => this.setDocType(d[0])">
                        <t t-esc="d[1]"/>
                    </button>
                </t>
            </div>

            <!-- Fila 3: Filtros -->
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">

                <!-- Categoría de venta -->
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="small text-muted fw-semibold me-1">Cat. venta:</span>
                    <t t-foreach="[['','Todas'],['A','A'],['B','B'],['C','C'],['D','D'],['E','E'],['__none__','Sin cat.']]"
                       t-as="c" t-key="c[0]">
                        <button t-att-class="'btn btn-sm ' + (state.saleCategory === c[0] ? 'btn-dark' : 'btn-outline-secondary')"
                                style="padding:1px 8px; font-size:11px;"
                                t-att-title="c[0] === '' ? 'Mostrar todas las categorías' : c[0] === '__none__' ? 'Productos sin categoría de venta asignada' : 'Filtrar por categoría ' + c[0] + ' (asignada en Configuración → Categorías de venta)'"
                                t-on-click="() => this.setSaleCat(c[0])">
                            <t t-esc="c[1]"/>
                        </button>
                    </t>
                </div>

                <!-- Categoría de producto -->
                <div t-if="state.productCategs.length" class="d-flex align-items-center gap-1">
                    <span class="small text-muted fw-semibold me-1">Cat. producto:</span>
                    <select class="form-select form-select-sm" style="min-width:160px; font-size:11px;"
                            title="Filtrar el gráfico por familia de producto (product.category)"
                            t-on-change="setProductCat">
                        <option value="">Todas</option>
                        <t t-foreach="state.productCategs" t-as="cat" t-key="cat.id">
                            <option t-att-value="cat.id" t-esc="cat.name"/>
                        </t>
                    </select>
                </div>
            </div>

            <!-- Cargando -->
            <div t-if="state.loading" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <!-- Sin datos -->
            <div t-elif="!state.rows.length" class="text-center text-muted py-5">
                <i class="fa fa-bar-chart fa-3x mb-3 d-block opacity-50"/>
                <span>No hay ventas registradas para los filtros seleccionados.</span>
            </div>

            <!-- Gráficos: torta + barras -->
            <div t-else="" class="d-flex gap-3 align-items-start">

                <!-- Torta — distribución por categoría de venta (1/3) -->
                <div style="flex:1; min-width:0;">
                    <p class="text-center small text-muted fw-semibold mb-1" style="font-size:11px;">
                        Distribución por categoría de venta
                    </p>
                    <div style="position:relative; height:340px;">
                        <canvas t-ref="pieCanvas"/>
                    </div>
                </div>

                <!-- Barras — top N productos (2/3) -->
                <div style="flex:2; min-width:0; position:relative; height:360px;">
                    <canvas t-ref="salesCanvas"/>
                </div>

            </div>

        </div>
    </t>

</templates>
