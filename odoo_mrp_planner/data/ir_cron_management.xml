<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron del envío del Resumen diario de Gerencia por mail.
         noupdate="1": el estado activo lo administra la configuración (campo
         management_report_enabled por empresa); el método sale solo si ninguna
         config tiene el envío activado. El cron corre cada 15 minutos y dispara
         el envío al llegar a la hora Y minuto configurados (interpretados en la
         zona horaria de la empresa de cada configuración, no en la del usuario
         del cron). La granularidad fina (vs. el viejo cron horario) es la que
         permite respetar los minutos, p. ej. 15:30 y no solo la hora redonda. -->
    <data noupdate="1">
        <record id="ir_cron_management_daily_report" model="ir.cron">
            <field name="name">Planificador: envío del Resumen diario de Gerencia</field>
            <field name="model_id" ref="model_mrp_planner_dashboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_management_report()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>

</odoo>
