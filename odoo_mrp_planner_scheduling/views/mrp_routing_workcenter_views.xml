<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tabla de operaciones en la LdM: columna de CTs alternativos ── -->
    <!-- La tabla usa mrp_routing_workcenter_bom_tree_view via list_view_ref.
         El detalle (centro + tiempo) se edita abriendo la operación; en la tabla
         se muestran solo como chips de solo-lectura para vista rápida. -->
    <record id="mrp_routing_workcenter_bom_tree_scheduling_alt_wc" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.bom.tree.scheduling.alt.wc</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_bom_tree_view"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="editable">bottom</attribute>
            </list>
            <field name="workcenter_id" position="after">
                <field name="alternative_workcenter_ids"
                       widget="many2many_tags"
                       optional="show"
                       readonly="1"
                       string="Centros alternativos"/>
            </field>
        </field>
    </record>

    <!-- ── Popup de operación: tabla de CTs alternativos (centro + tiempo) ── -->
    <!-- Cada línea precarga el time_cycle_manual de la operación via context;
         se puede ajustar por centro. -->
    <record id="mrp_routing_workcenter_form_scheduling_alt_wc" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form.scheduling.alt.wc</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <field name="workcenter_id" position="after">
                <field name="alternative_workcenter_ids"
                       string="Centros alternativos"
                       context="{'default_time_cycle_manual': time_cycle_manual}">
                    <list editable="bottom">
                        <field name="sequence" widget="handle"/>
                        <field name="workcenter_id"
                               domain="[('id', '!=', parent.workcenter_id), ('active', '=', True)]"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="time_cycle_manual"/>
                    </list>
                </field>
            </field>
        </field>
    </record>

</odoo>
