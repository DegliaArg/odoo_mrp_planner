<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Programación -->
    <record id="group_scheduling" model="res.groups">
        <field name="name">Programación</field>
        <field name="category_id" ref="odoo_mrp_planner.module_category_mrp_planner"/>
        <field name="comment">Habilita las funciones de programación y reprogramación: pestaña Programaciones en el panel de producción, botones de reprogramación en OFs y KPIs asociados. También permite modificar la configuración de reprogramación.</field>
        <field name="users" eval="[]"/>
    </record>

    <!-- APARCADO (2026-11): el Administrador del planificador YA NO implica
         Programación. Mientras solo está vivo el motor de necesidades (Panel 1),
         el acceso se asigna manualmente usuario por usuario (p.ej. solo "deglia"
         en staging). Así nadie recibe la planificación de forma automática.
    <record id="odoo_mrp_planner.group_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_scheduling'))]"/>
    </record>
    -->


</odoo>
