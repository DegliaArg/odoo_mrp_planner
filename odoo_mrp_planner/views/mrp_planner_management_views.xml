<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         ACCIÓN SERVIDOR — Gerencia (Resumen diario)
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_mrp_planner_gerencia_open" model="ir.actions.server">
        <field name="name">Resumen diario</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_gerencia()</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         VISTA FORM — Panel de Gerencia
         Muestra: demanda · facturado · despachos · embalajes · picking · producido
    ════════════════════════════════════════════════════════════════════ -->
    <record id="mrp_gerencia_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.gerencia.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Gerencia" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- Encabezado -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Resumen diario</h4>
                            </div>
                            <div class="col-auto d-flex gap-2 align-items-center">
                                <widget name="refresh_stamp"/>
                                <button name="action_refresh_gerencia" type="object"
                                        string="Actualizar"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                        </div>

                        <!-- Widget principal -->
                        <widget name="management_overview_widget"/>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         MENÚ — Sección Gerencia (primera, para el CEO)
    ════════════════════════════════════════════════════════════════════ -->
    <menuitem id="mrp_gerencia_menu"
              name="Gerencia"
              parent="mrp_planner_menu_root"
              sequence="5"
              groups="odoo_mrp_planner.group_management_read,odoo_mrp_planner.group_management,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_gerencia_panel_menu"
              name="Resumen diario"
              parent="mrp_gerencia_menu"
              sequence="1"
              action="action_mrp_planner_gerencia_open"
              groups="odoo_mrp_planner.group_management_read,odoo_mrp_planner.group_management,odoo_mrp_planner.group_admin,base.group_system"/>

    <!-- ════════════════════════════════════════════════════════════════════
         AJUSTES — Página Gerencia (tipos de operación de los indicadores)
         Se agrega al notebook de la configuración por herencia para no tocar
         el archivo grande de Ajustes.
    ════════════════════════════════════════════════════════════════════ -->
    <record id="mrp_reschedule_config_form_view_management" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.form.management</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="inherit_id" ref="odoo_mrp_planner.mrp_reschedule_config_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Gerencia" name="management"
                      groups="odoo_mrp_planner.group_management,odoo_mrp_planner.group_admin,base.group_system">
                    <div class="row">
                        <div class="col-7">
                            <group string="Tipos de operación del Resumen diario">
                                <div class="text-muted small mb-2">
                                    Elegí qué tipos de operación alimentan cada indicador de
                                    movimiento del panel de Gerencia. Son propios de esta base,
                                    por eso se configuran acá. La cantidad se mide en piezas movidas.
                                </div>
                                <field name="management_dispatch_picking_type_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Transferencias que cuentan como despachos (validadas)…"/>
                                <field name="management_packing_picking_type_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Transferencias que cuentan como embalajes (listas/pendientes)…"/>
                                <field name="management_picking_picking_type_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True}"
                                       placeholder="Transferencias que cuentan como picking (listas/pendientes)…"/>
                                <div class="text-muted small border-start border-2 ps-2 mt-2">
                                    <b>Despachos:</b> piezas de transferencias ya validadas (estado Hecho) del mes.<br/>
                                    <b>Embalajes / Picking:</b> piezas pendientes <i>ahora</i> (estado Listo/Asignado);
                                    son una foto del momento, no un acumulado del mes.
                                </div>
                            </group>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
