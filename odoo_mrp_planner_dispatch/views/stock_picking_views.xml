<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form de la orden de entrega: botones y auditoría de despacho ── -->
    <record id="view_picking_form_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.form.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <field name="x_dispatch_enabled" invisible="1"/>
                <button name="action_mark_dispatched"
                        type="object"
                        string="Marcar despachado"
                        class="btn-primary"
                        groups="odoo_mrp_planner_dispatch.group_dispatch_validation"
                        invisible="not x_dispatch_enabled or state != 'done' or x_dispatch_state != 'to_dispatch'"
                        help="Confirma que la mercadería salió físicamente. Solo disponible con la entrega validada."/>
                <button name="action_reset_dispatch"
                        type="object"
                        string="Volver a Sin despachar"
                        groups="odoo_mrp_planner.group_admin"
                        invisible="not x_dispatch_enabled or x_dispatch_state != 'dispatched'"
                        confirm="¿Revertir el despacho de esta entrega? La reversa queda registrada en el chatter."
                        help="Reversa de un despacho marcado por error. Solo administradores del planificador."/>
            </xpath>

            <!-- Estado + auditoría en Información adicional -->
            <xpath expr="//page[@name='extra']" position="inside">
                <group string="Despacho" invisible="not x_dispatch_enabled">
                    <field name="x_dispatch_state" readonly="1" widget="badge"
                           decoration-warning="x_dispatch_state == 'to_dispatch'"
                           decoration-success="x_dispatch_state == 'dispatched'"/>
                    <field name="x_dispatch_date" readonly="1"
                           invisible="x_dispatch_state != 'dispatched'"/>
                    <field name="x_dispatch_user_id" readonly="1"
                           invisible="x_dispatch_state != 'dispatched'"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ── Lista de entregas: columna de despacho ── -->
    <record id="vpicktree_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.list.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <!-- Botón de cabecera: aparece al seleccionar remitos en la lista -->
            <xpath expr="//list" position="inside">
                <header>
                    <button name="action_mark_dispatched" type="object"
                            string="Marcar despachado"
                            groups="odoo_mrp_planner_dispatch.group_dispatch_validation"/>
                </header>
            </xpath>
            <field name="state" position="before">
                <field name="x_dispatch_enabled" column_invisible="1"/>
                <!-- invisible por registro: los remitos fuera del circuito (función
                     apagada o tipo excluido en Ajustes) muestran la celda vacía -->
                <field name="x_dispatch_state" string="Despacho" optional="show" widget="badge"
                       invisible="not x_dispatch_enabled"
                       decoration-warning="x_dispatch_state == 'to_dispatch'"
                       decoration-success="x_dispatch_state == 'dispatched'"/>
            </field>
        </field>
    </record>

    <!-- ── Lista de los drills de los paneles: remito + cantidad por línea ──
         Vista dedicada (priority alta para no ser la default de stock.picking);
         los "Ver →" de los paneles la eligen vía list_view_ref. -->
    <record id="view_picking_list_planner_drill" model="ir.ui.view">
        <field name="name">stock.picking.list.planner.drill</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Remitos" create="false">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id" optional="show" string="Contacto"/>
                <field name="origin" optional="show" string="Documento origen"/>
                <field name="picking_type_id" optional="hide" string="Tipo de operación"/>
                <field name="scheduled_date" optional="show" string="Fecha programada"/>
                <field name="date_done" optional="hide" string="Fecha de validación"/>
                <field name="x_qty_pieces" sum="Total" string="Cantidad (Pz)"/>
                <field name="x_dispatch_enabled" column_invisible="1"/>
                <field name="x_dispatch_state" string="Despacho" widget="badge" optional="show"
                       invisible="not x_dispatch_enabled"
                       decoration-warning="x_dispatch_state == 'to_dispatch'"
                       decoration-success="x_dispatch_state == 'dispatched'"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'assigned' or state == 'done'"
                       decoration-muted="state != 'assigned' and state != 'done'"/>
            </list>
        </field>
    </record>

    <!-- ── Lista de los drills de PENDIENTES: demanda, con stock y sin stock ──
         Cada "Ver →" del pendiente muestra las tres cantidades con sus totales:
         los pies de columna cierran con las cards del panel. -->
    <record id="view_picking_list_planner_drill_pending" model="ir.ui.view">
        <field name="name">stock.picking.list.planner.drill.pending</field>
        <field name="model">stock.picking</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Demanda pendiente" create="false">
                <field name="name" decoration-bf="1"/>
                <field name="partner_id" optional="show" string="Contacto"/>
                <field name="origin" optional="show" string="Documento origen"/>
                <field name="picking_type_id" optional="hide" string="Tipo de operación"/>
                <field name="scheduled_date" optional="show" string="Fecha programada"/>
                <field name="x_qty_pieces" sum="Total" string="Demanda (Pz)"/>
                <field name="x_qty_available_chain" sum="Total" string="Con stock (Pz)"/>
                <field name="x_qty_blocked_chain" sum="Total" string="Sin stock (Pz)"/>
                <field name="x_dispatch_enabled" column_invisible="1"/>
                <field name="x_dispatch_state" string="Despacho" widget="badge" optional="hide"
                       invisible="not x_dispatch_enabled"
                       decoration-warning="x_dispatch_state == 'to_dispatch'"
                       decoration-success="x_dispatch_state == 'dispatched'"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'assigned' or state == 'done'"
                       decoration-muted="state != 'assigned' and state != 'done'"/>
            </list>
        </field>
    </record>

    <!-- ── Búsqueda: filtros de despacho ── -->
    <record id="view_picking_search_dispatch" model="ir.ui.view">
        <field name="name">stock.picking.search.dispatch</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_to_dispatch" string="Sin despachar"
                        domain="[('x_dispatch_state', '=', 'to_dispatch'), ('state', '=', 'done')]"
                        help="Salidas validadas pendientes de despacho."/>
                <filter name="filter_dispatched" string="Despachado"
                        domain="[('x_dispatch_state', '=', 'dispatched')]"/>
            </xpath>
        </field>
    </record>


</odoo>
