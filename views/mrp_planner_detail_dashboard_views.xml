<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_planner_detail_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.detail.dashboard.form</field>
        <field name="model">mrp.planner.detail.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- ── Encabezado ──────────────────────────────────── -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h5 class="mb-0 fw-bold">
                                    <field name="dashboard_title" nolabel="1"/>
                                </h5>
                                <small class="text-muted">
                                    <span invisible="context_type != 'request'">Programación de fabricación</span>
                                    <span invisible="context_type != 'production'">Orden de fabricación</span>
                                    <span invisible="context_type != 'purchase'">Orden de compra</span>
                                </small>
                            </div>
                            <div class="col-auto">
                                <button name="action_open_source" type="object"
                                        string="Ver registro →"
                                        class="btn btn-outline-secondary btn-sm"/>
                            </div>
                        </div>

                        <!-- ── ARTÍCULOS DEL PLAN (solo request) ─────────── -->
                        <div class="o_planner_section mb-4" invisible="context_type != 'request'">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-list-alt me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Artículos del plan</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-cube fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="req_item_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check-square-o fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="req_item_confirmed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Confirmadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_mos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_info h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-cog fa-lg text-info mb-2 d-block"/>
                                            <div class="o_planner_number text-info">
                                                <field name="req_item_in_progress" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">En progreso</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_success h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                            <div class="o_planner_number text-success">
                                                <field name="req_item_done" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Completadas</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-clock-o fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="req_item_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Atrasadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_delayed_mos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-refresh fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="req_item_reschedule" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Para reprogramar</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_reschedule_mos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── ALERTAS ────────────────────────────────────── -->
                        <div class="o_planner_section mb-4">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-bell me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Alertas pendientes</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-bell fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation-circle fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="alert_critical" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Críticas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_critical_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation-triangle fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="alert_warning" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Avisos</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_warning_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── REPROGRAMACIONES (request + production) ────── -->
                        <div class="o_planner_section mb-4" invisible="context_type == 'purchase'">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-calendar me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Reprogramaciones</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-calendar fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="plan_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_plans" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-clock-o fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="plan_pending" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Pendientes</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_pending_plans" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_success h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check fa-lg text-success mb-2 d-block"/>
                                            <div class="o_planner_number text-success">
                                                <field name="plan_applied" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Aplicadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_applied_plans" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-success">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── ÓRDENES DE FABRICACIÓN (request + purchase) ── -->
                        <div class="o_planner_section mb-4" invisible="context_type == 'production'">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-industry me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de fabricación</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="mo_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_mos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check-square-o fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="mo_confirmed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Confirmadas</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_info h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-cog fa-lg text-info mb-2 d-block"/>
                                            <div class="o_planner_number text-info">
                                                <field name="mo_in_progress" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">En progreso</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_success h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                            <div class="o_planner_number text-success">
                                                <field name="mo_done" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Completadas</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-warning fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="mo_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Atrasadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_delayed_mos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── ÓRDENES DE COMPRA (request + production) ───── -->
                        <div class="o_planner_section mb-4" invisible="context_type == 'purchase'">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-shopping-cart me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de compra</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-shopping-cart fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="po_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_pos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="po_overdue" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Vencidas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_overdue_pos" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
