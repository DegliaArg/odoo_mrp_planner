<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_mrp_planner_dashboard_open" model="ir.actions.server">
        <field name="name">Panel del planificador</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="mrp_planner_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel del planificador" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- ── Encabezado ───────────────────────────── -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Panel del Planificador</h4>
                            </div>
                            <div class="col-auto">
                                <button name="action_refresh" type="object"
                                        string="Actualizar alertas"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                        </div>

                        <!-- ── ALERTAS PENDIENTES ────────────────────── -->
                        <div class="o_planner_section mb-4">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-bell me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Alertas pendientes</span>
                            </div>

                            <!-- Fila severidad -->
                            <div class="row g-2 mb-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-bell fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_total" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Total</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_all_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation-circle fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="alert_critical" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Críticas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_critical" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation-triangle fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="alert_warning" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Avisos</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_warning" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Fila por tipo -->
                            <div class="row g-2">
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-clock-o fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_mo_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">OFs atrasadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_mo_delayed_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-shopping-cart fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_po_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">OCs vencidas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_po_delayed_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-ban fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_po_cancelled" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">OCs canceladas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_po_cancelled_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-truck fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_receipt_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Recepciones</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_receipt_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-balance-scale fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_qty_mismatch" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Cant. diferentes</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_qty_mismatch_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4 col-lg-2">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-times-circle fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="alert_mo_cancelled" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">OFs canceladas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_view_mo_cancelled_alerts" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── ÓRDENES DE FABRICACIÓN ────────────────── -->
                        <div class="o_planner_section mb-4">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-industry me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de fabricación</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-check-square-o fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="mo_confirmed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Confirmadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_mos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_info h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-cog fa-lg text-info mb-2 d-block"/>
                                            <div class="o_planner_number text-info">
                                                <field name="mo_in_progress" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">En progreso</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_mos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-info">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-warning fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="mo_delayed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Atrasadas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_mos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-refresh fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="mo_reschedule_needed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Para reprogramar</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_mos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── ÓRDENES DE COMPRA ─────────────────────── -->
                        <div class="o_planner_section mb-4">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-shopping-cart me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Órdenes de compra</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_success h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-shopping-bag fa-lg text-success mb-2 d-block"/>
                                            <div class="o_planner_number text-success">
                                                <field name="po_pending" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Activas (a tiempo)</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_pos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-success">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_danger h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-exclamation fa-lg text-danger mb-2 d-block"/>
                                            <div class="o_planner_number text-danger">
                                                <field name="po_overdue" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Vencidas</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_pos_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-danger">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ── PROGRAMACIONES EN CURSO ───────────────── -->
                        <div class="o_planner_section mb-4">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-calendar me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Programaciones en curso</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-list-alt fa-lg text-secondary mb-2 d-block"/>
                                            <div class="o_planner_number">
                                                <field name="request_active" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">En curso</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_requests_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-secondary">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="card o_planner_card o_planner_card_warning h-100">
                                        <div class="card-body text-center py-3">
                                            <i class="fa fa-random fa-lg text-warning mb-2 d-block"/>
                                            <div class="o_planner_number text-warning">
                                                <field name="request_reschedule_needed" nolabel="1"/>
                                            </div>
                                            <div class="o_planner_label">Con reprogramación</div>
                                        </div>
                                        <div class="card-footer p-0">
                                            <button name="action_open_requests_dashboard" type="object"
                                                    class="btn btn-sm btn-link w-100 py-1 text-warning">Ver panel →</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="mrp_planner_menu_dashboard"
              name="Panel"
              parent="mrp_planner_menu_root"
              sequence="1"
              action="action_mrp_planner_dashboard_open"/>

</odoo>
