<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_reschedule.PoDashboardWidget">
        <div class="o_po_dashboard_widget">

            <!-- Filtros de fecha -->
            <div class="row g-2 mb-3">
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Desde</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                </div>
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Hasta</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>
            </div>

            <!-- Pestañas de tipo -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'all' ? ' active' : '')"
                            t-on-click="() => this.setTab('all')">
                        <i class="fa fa-th-list me-1"/>Todas
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'purchase' ? ' active' : '')"
                            t-on-click="() => this.setTab('purchase')">
                        <i class="fa fa-shopping-cart me-1"/>Compras
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'subcontract' ? ' active' : '')"
                            t-on-click="() => this.setTab('subcontract')">
                        <i class="fa fa-industry me-1"/>Subcontratación
                    </button>
                </li>
            </ul>

            <!-- Contenido — dimming durante carga en lugar de spinner full -->
            <div t-att-class="'row g-3 align-items-start' + (state.loading ? ' opacity-50 pe-none' : '')">

                <!-- Izquierda: tarjetas KPI -->
                <div class="col-12 col-lg-4">
                    <div class="row g-2">

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_info h-100"
                                 style="cursor:pointer" t-on-click="onClickRfqs">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-file-text-o fa-lg text-info mb-2 d-block"/>
                                    <div class="o_planner_number text-info" t-esc="state.kpis.rfq"/>
                                    <div class="o_planner_label">Cotizaciones</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_warning h-100"
                                 style="cursor:pointer" t-on-click="onClickToApprove">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-clock-o fa-lg text-warning mb-2 d-block"/>
                                    <div class="o_planner_number text-warning" t-esc="state.kpis.to_approve"/>
                                    <div class="o_planner_label">Por aprobar</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card h-100"
                                 style="cursor:pointer" t-on-click="onClickAll">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                    <div class="o_planner_number" t-esc="state.kpis.total"/>
                                    <div class="o_planner_label">Aprobadas</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_success h-100"
                                 style="cursor:pointer" t-on-click="onClickPending">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-check fa-lg text-success mb-2 d-block"/>
                                    <div class="o_planner_number text-success" t-esc="state.kpis.pending"/>
                                    <div class="o_planner_label">A tiempo</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_danger h-100"
                                 style="cursor:pointer" t-on-click="onClickOverdue">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-exclamation-triangle fa-lg text-danger mb-2 d-block"/>
                                    <div class="o_planner_number text-danger" t-esc="state.kpis.overdue"/>
                                    <div class="o_planner_label">Vencidas</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_danger h-100"
                                 style="cursor:pointer" t-on-click="onClickOverdue">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-exclamation-circle fa-lg text-danger mb-2 d-block"/>
                                    <div class="o_planner_number text-danger" t-esc="state.kpis.overdue_critical"/>
                                    <div class="o_planner_label">Críticas (+5 días)</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Derecha: pestañas de lista -->
                <div class="col-12 col-lg-8">

                    <!-- Sin datos -->
                    <div t-if="isEmpty"
                         class="d-flex align-items-center justify-content-center py-5 text-muted">
                        <div class="text-center small">
                            <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                            Sin órdenes pendientes.
                        </div>
                    </div>

                    <div t-else="">
                        <!-- Pestañas de lista -->
                        <ul class="nav nav-tabs mb-0">
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'overdue' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('overdue')">
                                    <i class="fa fa-exclamation-triangle text-danger me-1"/>
                                    Vencidas
                                    <span t-if="state.kpis.overdue > 0"
                                          class="badge rounded-pill bg-danger ms-1"
                                          t-esc="state.kpis.overdue"/>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'rfqs' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('rfqs')">
                                    <i class="fa fa-file-text-o text-info me-1"/>
                                    Cotizaciones
                                    <span t-if="state.kpis.rfq > 0"
                                          class="badge rounded-pill bg-info ms-1"
                                          t-esc="state.kpis.rfq"/>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'approve' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('approve')">
                                    <i class="fa fa-clock-o text-warning me-1"/>
                                    Por aprobar
                                    <span t-if="state.kpis.to_approve > 0"
                                          class="badge rounded-pill bg-warning text-dark ms-1"
                                          t-esc="state.kpis.to_approve"/>
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de lista con scroll -->
                        <div style="max-height:300px; overflow-y:auto;"
                             class="border border-top-0 rounded-bottom p-2">

                            <div t-if="activeList.length === 0"
                                 class="text-center text-muted small py-3">
                                Sin registros en esta categoría.
                            </div>

                            <table t-else="" class="table table-sm table-hover small mb-0">
                                <thead class="sticky-top bg-white">
                                    <tr class="text-muted">
                                        <th>Referencia</th>
                                        <th>Proveedor</th>
                                        <th t-att-title="state.listTab === 'overdue' ? 'Entrega prevista' : 'Entrega estimada'">
                                            <t t-if="state.listTab === 'overdue'">Vencida el</t>
                                            <t t-else="">Entrega estimada</t>
                                        </th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="activeList" t-as="po" t-key="po.id">
                                        <tr t-att-class="state.listTab === 'overdue' ? 'table-danger' : (state.listTab === 'approve' ? 'table-warning' : '')"
                                            style="cursor:pointer"
                                            t-on-click="() => this.openPo(po.id)">
                                            <td class="fw-semibold" t-esc="po.name"/>
                                            <td t-esc="po.partner"/>
                                            <td t-esc="po.date_planned"/>
                                            <td class="text-end" t-esc="po.amount_total.toFixed(2)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                        </div>

                        <!-- Ver todas -->
                        <div class="text-end mt-1">
                            <button t-if="state.listTab === 'overdue'"
                                    class="btn btn-sm btn-link text-danger p-0 small"
                                    t-on-click="onClickOverdue">Ver todas las vencidas →</button>
                            <button t-if="state.listTab === 'rfqs'"
                                    class="btn btn-sm btn-link text-info p-0 small"
                                    t-on-click="onClickRfqs">Ver todas las cotizaciones →</button>
                            <button t-if="state.listTab === 'approve'"
                                    class="btn btn-sm btn-link text-warning p-0 small"
                                    t-on-click="onClickToApprove">Ver todas por aprobar →</button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </t>

</templates>
