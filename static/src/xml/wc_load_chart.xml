<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_reschedule.WcLoadChartWidget">
        <div class="o_wc_load_chart p-2">

            <!-- Filtros -->
            <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
                <div>
                    <label class="form-label fw-semibold small mb-1 d-block">Desde</label>
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                </div>
                <div>
                    <label class="form-label fw-semibold small mb-1 d-block">Hasta</label>
                    <input type="date" class="form-control form-control-sm"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>
                <div t-if="state.tags.length > 0">
                    <label class="form-label fw-semibold small mb-1 d-block">Sector</label>
                    <select class="form-select form-select-sm" style="min-width:180px"
                            t-on-change="onTagChange">
                        <option value="">Todos los sectores</option>
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <option t-att-value="tag.id"
                                    t-att-selected="state.selectedTag == tag.id"
                                    t-esc="tag.name"/>
                        </t>
                    </select>
                </div>
                <div t-if="state.machines.length > 0">
                    <label class="form-label fw-semibold small mb-1 d-block">Máquina</label>
                    <select class="form-select form-select-sm" style="min-width:180px"
                            t-on-change="onMachineChange">
                        <option value="">Todas</option>
                        <t t-foreach="state.machines" t-as="machine" t-key="machine.id">
                            <option t-att-value="machine.id"
                                    t-att-selected="state.selectedMachine == machine.id"
                                    t-esc="machine.name"/>
                        </t>
                    </select>
                </div>
            </div>

            <!-- Layout: KPIs izquierda + gráfico derecha -->
            <div class="row g-3">

                <!-- KPI cards -->
                <div class="col-12 col-lg-4">
                    <div class="row g-2">

                        <div class="col-6">
                            <div class="card o_planner_card h-100"
                                 t-att-data-kpi-tip="'Horas de capacidad del calendario\nen el período, ajustadas por la\neficiencia de cada centro de trabajo.\nFórmula: Σ horas_calendario × eficiencia_CT'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-clock-o fa-lg text-secondary mb-2 d-block"/>
                                    <div class="o_planner_number text-secondary" t-esc="fmtH(state.kpis.disponible)"/>
                                    <div class="o_planner_label">Disponible</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_info h-100"
                                 t-att-data-kpi-tip="'Horas con operaciones asignadas\nen el período, independientemente\nde si ya se ejecutaron o no.\nFórmula: Ejecutado + Pendiente'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-calendar-check-o fa-lg text-info mb-2 d-block"/>
                                    <div class="o_planner_number text-info" t-esc="fmtH(state.kpis.planificado)"/>
                                    <div class="o_planner_label">Planificado</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card h-100"
                                 t-att-data-kpi-tip="'Porcentaje de capacidad total\nutilizada o asignada en el período.\nVerde &lt;70%  Amarillo 70-89%  Rojo &gt;=90%\nFórmula: Planificado ÷ Disponible × 100'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-tachometer fa-lg mb-2 d-block"
                                       t-att-class="cargaClass(state.kpis.carga_pct)"/>
                                    <div class="o_planner_number"
                                         t-att-class="cargaClass(state.kpis.carga_pct)"
                                         t-esc="state.kpis.carga_pct + '%'"/>
                                    <div class="o_planner_label">Carga</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_success h-100"
                                 t-att-data-kpi-tip="'Horas de operaciones ya finalizadas\nen el período seleccionado.\nFórmula: Σ horas reales de\noperaciones completadas (done)'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                                    <div class="o_planner_number text-success" t-esc="fmtH(state.kpis.ejecutado)"/>
                                    <div class="o_planner_label">Ejecutado</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_warning h-100"
                                 t-att-data-kpi-tip="'Horas de operaciones en curso\no programadas aún no completadas.\nFórmula: Σ horas esperadas de\noperaciones activas en el período'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-hourglass-half fa-lg text-warning mb-2 d-block"/>
                                    <div class="o_planner_number text-warning" t-esc="fmtH(state.kpis.pendiente)"/>
                                    <div class="o_planner_label">Pendiente</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_danger h-100"
                                 t-att-data-kpi-tip="'Capacidad disponible sin ninguna\noperación asignada en el período.\nFórmula:\nDisponible − Ejecutado − Pendiente'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-ban fa-lg text-danger mb-2 d-block"/>
                                    <div class="o_planner_number text-danger" t-esc="fmtH(state.kpis.tiempo_libre)"/>
                                    <div class="o_planner_label">Tiempo libre</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Gráfico -->
                <div class="col-12 col-lg-8 d-flex flex-column">
                    <div class="position-relative" style="flex:1; min-height:0;">
                        <canvas t-ref="chartCanvas"/>

                        <div t-if="state.loading"
                             class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                             style="background:rgba(255,255,255,0.80); z-index:10;">
                            <div class="text-center text-muted">
                                <i class="fa fa-spinner fa-spin fa-2x"/>
                                <div class="mt-2 small">Cargando datos…</div>
                            </div>
                        </div>

                        <div t-if="!state.loading and state.empty"
                             class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                            <div class="text-center">
                                <i class="fa fa-bar-chart fa-2x mb-2 d-block"/>
                                <span class="small">Sin centros de trabajo con actividad para el período seleccionado.</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </t>

</templates>
