<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         PAPERFORMAT — A4 vertical, márgenes chicos (todo en una página)
    ════════════════════════════════════════════════════════════════════ -->
    <record id="paperformat_management_daily" model="report.paperformat">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">7</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         ACCIÓN DE REPORTE
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_report_management_daily" model="ir.actions.report">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_mrp_planner.report_management_daily</field>
        <field name="report_file">odoo_mrp_planner.report_management_daily</field>
        <field name="paperformat_id" ref="paperformat_management_daily"/>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         TEMPLATE — Resumen diario (estética del panel de Gerencia, 1 página)
         Se usa docs/o + web.basic_layout (patrón estándar) para tener el <head>
         con charset UTF-8 correcto (si no, los acentos salen mal) y que 'o' sea
         un registro real (evita el crash por o._name).
    ════════════════════════════════════════════════════════════════════ -->
    <template id="report_management_daily">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family:'Lato','Helvetica Neue',Arial,sans-serif; color:#1e293b; font-size:9px;">

                        <!-- ── Encabezado ─────────────────────────────────── -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:12px;">
                            <tr>
                                <td style="vertical-align:bottom; border-bottom:3px solid #2563eb; padding-bottom:6px;">
                                    <div style="font-size:17px; font-weight:bold; color:#0f172a;" t-out="rep['company_label']"/>
                                    <div style="font-size:11px; color:#64748b; letter-spacing:0.3px;">Resumen diario de Gerencia</div>
                                </td>
                                <td style="vertical-align:bottom; border-bottom:3px solid #2563eb; padding-bottom:6px; text-align:right; font-size:9px; color:#64748b; white-space:nowrap;">
                                    <div>Mes <span style="font-weight:bold; color:#0f172a;" t-out="rep['month']"/></div>
                                    <div>Emitido <span t-out="rep['report_date']"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Tira de KPIs (tarjetas) ────────────────────── -->
                        <table style="width:100%; border-collapse:separate; border-spacing:5px 0; margin-bottom:12px; table-layout:fixed;">
                            <tr>
                                <td t-foreach="rep['kpis']" t-as="k" style="vertical-align:top;">
                                    <div t-attf-style="border:1px solid #e2e8f0; border-top:3px solid {{k['color']}}; border-radius:7px; padding:7px 3px; text-align:center; background:#ffffff;">
                                        <i t-attf-class="fa {{k['icon']}}" t-attf-style="font-size:15px; color:{{k['color']}};"/>
                                        <div style="font-size:13px; font-weight:bold; color:#0f172a; margin-top:3px;" t-out="k['value']"/>
                                        <div style="font-size:7.5px; color:#94a3b8; text-transform:uppercase; letter-spacing:0.3px;" t-out="k['label']"/>
                                        <div t-if="k['delta']" style="font-size:7.5px; margin-top:2px; color:#64748b;">
                                            Hoy
                                            <span t-attf-style="font-weight:bold; color:{{'#16a34a' if k['delta']['dir']=='up' else ('#dc2626' if k['delta']['dir']=='down' else '#64748b')}};">
                                                <t t-out="k['delta']['text']"/>
                                                <i t-if="k['delta']['dir']=='up'" class="fa fa-arrow-up"/>
                                                <i t-if="k['delta']['dir']=='down'" class="fa fa-arrow-down"/>
                                            </span>
                                        </div>
                                    </div>
                                </td>
                                <!-- Tasa de servicio -->
                                <td style="vertical-align:top;">
                                    <div t-attf-style="border:1px solid #e2e8f0; border-top:3px solid {{rep['service_card']['color']}}; border-radius:7px; padding:7px 3px; text-align:center; background:#ffffff;">
                                        <i t-attf-class="fa {{rep['service_card']['icon']}}" t-attf-style="font-size:15px; color:{{rep['service_card']['color']}};"/>
                                        <div t-attf-style="font-size:13px; font-weight:bold; color:{{rep['service_card']['color']}}; margin-top:3px;" t-out="rep['service_card']['value']"/>
                                        <div style="font-size:7.5px; color:#94a3b8; text-transform:uppercase; letter-spacing:0.3px;" t-out="rep['service_card']['label']"/>
                                        <div style="font-size:7.5px; margin-top:2px; color:#64748b;" t-out="rep['service_card']['sub']"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Secciones por familia (3 columnas, con barras) ─ -->
                        <table style="width:100%; border-collapse:collapse; table-layout:fixed;">
                            <tr style="vertical-align:top;">
                                <td t-foreach="rep['sections']" t-as="s" t-attf-style="width:33.33%; padding:{{'0 0 0 6px' if s_index == 2 else ('0 3px' if s_index == 1 else '0 6px 0 0')}};">
                                    <div t-attf-style="font-size:9px; font-weight:bold; color:#fff; background:{{s['color']}}; padding:3px 6px; border-radius:5px 5px 0 0;">
                                        <i t-attf-class="fa {{s['icon']}}" style="margin-right:4px;"/><t t-out="s['title']"/>
                                    </div>
                                    <table style="width:100%; border-collapse:collapse;">
                                        <tr t-foreach="s['rows']" t-as="r"
                                            t-attf-style="border-bottom:1px solid #f1f5f9; background:linear-gradient(to right, {{s['light']}} {{r['bar']}}%, #ffffff {{r['bar']}}%);">
                                            <td style="padding:2px 5px; color:#334155;" t-out="r['name']"/>
                                            <td style="padding:2px 5px; text-align:right; font-weight:bold; color:#0f172a; white-space:nowrap;" t-out="r['value']"/>
                                        </tr>
                                        <tr t-if="s['others']" style="border-bottom:1px solid #f1f5f9; color:#94a3b8;">
                                            <td style="padding:2px 5px; font-style:italic;">Otras familias</td>
                                            <td style="padding:2px 5px; text-align:right; white-space:nowrap;" t-out="s['others']"/>
                                        </tr>
                                        <tr t-attf-style="border-top:2px solid {{s['color']}};">
                                            <td style="padding:3px 5px; font-weight:bold; color:#0f172a;">Total</td>
                                            <td style="padding:3px 5px; text-align:right; font-weight:bold; color:#0f172a; white-space:nowrap;" t-out="s['total']"/>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ── Nota de la tasa de servicio ────────────────── -->
                        <div style="margin-top:10px; font-size:7.5px; color:#94a3b8; border-top:1px solid #f1f5f9; padding-top:5px;" t-out="rep['svc_note']"/>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
