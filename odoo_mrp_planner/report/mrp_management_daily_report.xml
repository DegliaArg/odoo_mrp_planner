<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         PAPERFORMAT — A4 vertical
    ════════════════════════════════════════════════════════════════════ -->
    <record id="paperformat_management_daily" model="report.paperformat">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">9</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_management_daily" model="ir.actions.report">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_mrp_planner.report_management_daily</field>
        <field name="report_file">odoo_mrp_planner.report_management_daily</field>
        <field name="paperformat_id" ref="paperformat_management_daily"/>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         TEMPLATE — Resumen diario (estética Capemi, sin grilla "Excel")
    ════════════════════════════════════════════════════════════════════ -->
    <template id="report_management_daily">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="company or o.env.company"/>

                    <style>
                        /* Mata TODOS los bordes/cajas que mete el layout de la empresa
                           (el que parece Excel). Después reponemos solo líneas suaves. */
                        .article table, .article tr, .article td, .article th,
                        .article thead, .article tbody {
                            border:0 !important; border-radius:0 !important;
                            box-shadow:none !important; background-image:none !important; }

                        .mg-title { font-size:19px; font-weight:700; color:#004b88; margin:0; letter-spacing:.2px; }
                        .mg-sub   { font-size:10px; color:#6b7784; margin:3px 0 0; }
                        .mg-rule  { border:0; border-top:3px solid #004b88; margin:9px 0 14px; }

                        .mg-sec   { font-size:11px; font-weight:700; color:#004b88;
                                    text-transform:uppercase; letter-spacing:.6px;
                                    padding-left:8px; border-left:3px solid #004b88;
                                    margin:16px 0 9px; }

                        /* KPIs */
                        table.mg-kpis { width:100%; border-collapse:separate !important;
                                        border-spacing:7px 0; table-layout:fixed; }
                        .mg-kpi   { background:#f6f9fc; border-radius:10px !important;
                                    padding:12px 8px; text-align:center; }
                        .mg-kpi-v { font-size:18px; font-weight:700; line-height:1.05; }
                        .mg-kpi-l { font-size:7.5px; color:#8a97a3; text-transform:uppercase;
                                    letter-spacing:.5px; margin-top:5px; }
                        .mg-kpi-d { font-size:7.5px; margin-top:4px; }
                        .mg-kpi-s { font-size:7px; color:#9aa6b1; margin-top:3px; }
                        .mg-up    { color:#1e7e34; } .mg-dn { color:#b45309; } .mg-fl { color:#8a97a3; }

                        /* Tablas limpias (sin grilla): banda de título + zebra suave */
                        table.mg-grid { width:100%; border-collapse:collapse !important; table-layout:fixed; }
                        table.mg-grid > tbody > tr > td.mg-col { vertical-align:top; padding:0 5px; }

                        .mg-band  { background:#004b88 !important; color:#fff; font-size:9px;
                                    font-weight:700; text-transform:uppercase; letter-spacing:.4px;
                                    padding:5px 9px; border-radius:7px 7px 0 0 !important; }
                        .mg-band .mg-tot { float:right; font-weight:700; }

                        table.mg-tbl { width:100%; border-collapse:collapse !important;
                                       font-size:8.5px; background:#fff; }
                        table.mg-tbl td { padding:3px 9px !important;
                                          border-bottom:1px solid #eef2f6 !important; }
                        table.mg-tbl td.mg-r { text-align:right; font-weight:700; color:#0f2a43;
                                               white-space:nowrap; }
                        table.mg-tbl tbody tr:nth-child(even) td { background:#f7fafc; }
                        table.mg-tbl td.mg-nm { color:#3d4b57; }
                        .mg-oth td { color:#9aa6b1 !important; font-style:italic; }
                        .mg-ttr td { background:#eef4f9 !important; color:#004b88 !important;
                                     font-weight:700 !important; border-top:2px solid #cfe0ee !important;
                                     border-bottom:0 !important; }
                        .mg-empty { font-size:8px; color:#9aa6b1; padding:7px 9px;
                                    background:#fff; font-style:italic; }
                        .mg-box   { border:1px solid #e6edf3 !important; border-radius:8px !important;
                                    overflow:hidden; }

                        .mg-foot  { border-top:1px solid #e6edf3; margin-top:16px; padding-top:6px;
                                    font-size:7.5px; color:#9aa6b1; }
                    </style>

                    <div class="page">

                        <!-- ══ Título ══ -->
                        <p class="mg-title">Resumen diario de Gerencia</p>
                        <p class="mg-sub">
                            <strong t-out="rep['company_label']"/> ·
                            <t t-out="rep['month_label']"/> · Emitido <t t-out="rep['report_date']"/>
                        </p>
                        <hr class="mg-rule"/>

                        <!-- ══ KPIs ══ -->
                        <table class="mg-kpis o_ignore_layout_styling">
                            <tr>
                                <td t-foreach="rep['kpis']" t-as="k" style="width:16.66%;">
                                    <div class="mg-kpi">
                                        <div class="mg-kpi-v" t-attf-style="color:{{k['accent']}};" t-out="k['value']"/>
                                        <div class="mg-kpi-l" t-out="k['label']"/>
                                        <div t-if="k['delta']" t-attf-class="mg-kpi-d {{'mg-up' if k['delta']['dir']=='up' else ('mg-dn' if k['delta']['dir']=='down' else 'mg-fl')}}">
                                            Hoy <t t-out="k['delta']['text']"/>
                                        </div>
                                        <div t-if="k['sub']" class="mg-kpi-s" t-out="k['sub']"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Por familia ══ -->
                        <p class="mg-sec">Por familia</p>
                        <table class="mg-grid o_ignore_layout_styling">
                            <tr>
                                <td t-foreach="rep['families']" t-as="f" class="mg-col" style="width:33.33%;">
                                    <div class="mg-box">
                                        <div class="mg-band"><t t-out="f['title']"/><span class="mg-tot" t-out="f['total']"/></div>
                                        <table class="mg-tbl">
                                            <tr t-foreach="f['rows']" t-as="r">
                                                <td class="mg-nm" t-out="r['name']"/>
                                                <td class="mg-r" t-out="r['value']"/>
                                            </tr>
                                            <tr t-if="f['others']" class="mg-oth">
                                                <td>Otras familias</td><td class="mg-r" t-out="f['others']"/>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Movimientos por categoría de venta ══ -->
                        <p class="mg-sec">Movimientos por categoría de venta</p>
                        <table class="mg-grid o_ignore_layout_styling">
                            <tr>
                                <td t-foreach="rep['movements']" t-as="mv" class="mg-col" style="width:33.33%;">
                                    <div class="mg-box">
                                        <div class="mg-band"><t t-out="mv['title']"/><span class="mg-tot" t-out="mv['total']"/></div>
                                        <t t-if="mv['configured'] and mv['rows']">
                                            <table class="mg-tbl">
                                                <tr t-foreach="mv['rows']" t-as="r">
                                                    <td class="mg-nm" t-out="r['name']"/>
                                                    <td class="mg-r"><t t-out="r['value']"/> pz</td>
                                                </tr>
                                            </table>
                                        </t>
                                        <div t-else="" class="mg-empty">
                                            <t t-if="not mv['configured']">Sin tipo de operación configurado.</t>
                                            <t t-else="">Sin movimientos en el período.</t>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Pie ══ -->
                        <div class="mg-foot" t-out="rep['svc_note']"/>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
