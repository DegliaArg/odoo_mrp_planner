<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="odoo_mrp_planner_scheduling.SchedulingMatrixWidget">
    <div class="sm-root" t-on-click.stop="closeDropdowns">

        <!-- ── Spinner ── -->
        <div t-if="state.loading" class="sm-loading text-center py-5">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            <p class="text-muted mt-2">Cargando tablero…</p>
        </div>

        <!-- ── Error ── -->
        <div t-elif="state.error" class="alert alert-danger m-3">
            <i class="fa fa-exclamation-triangle me-2"/>
            <t t-esc="state.error"/>
        </div>

        <!-- ── Contenido principal ── -->
        <t t-else="">

            <!-- ══ Barra de filtros ════════════════════════════════════════════ -->
            <div class="sm-filters d-flex flex-wrap align-items-center gap-2 px-3 py-2 border-bottom bg-light">

                <!-- Resolución (zoom) -->
                <div class="sm-filter-group btn-group btn-group-sm" role="group">
                    <t t-foreach="resolutions" t-as="r" t-key="r.key">
                        <button type="button"
                                t-att-class="'btn ' + (state.resolution === r.key ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.setResolution(r.key)"
                                t-esc="r.label"/>
                    </t>
                </div>

                <div class="vr mx-1"/>

                <!-- Sector -->
                <div class="sm-filter-group position-relative">
                    <span class="sm-filter-label text-muted small me-1">Sector:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleTagDropdown">
                        <t t-esc="tagFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.tagDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.tagMenuPos.top}px;left:${state.tagMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleTag(tag.id)">
                                <input type="checkbox"
                                       t-att-checked="state.tagIds.includes(tag.id)"
                                       t-on-click.stop="() => this.toggleTag(tag.id)"/>
                                <span t-esc="tag.name"/>
                            </label>
                        </t>
                        <div t-if="!state.tags.length" class="px-3 py-2 text-muted small">
                            Sin sectores configurados
                        </div>
                    </div>
                </div>

                <!-- CT -->
                <div class="sm-filter-group position-relative" t-if="state.wcs.length">
                    <span class="sm-filter-label text-muted small me-1">CT:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleWcDropdown">
                        <t t-esc="wcFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.wcDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.wcMenuPos.top}px;left:${state.wcMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.wcs" t-as="wc" t-key="wc.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleWc(wc.id)">
                                <input type="checkbox"
                                       t-att-checked="state.wcFilterIds.includes(wc.id)"
                                       t-on-click.stop="() => this.toggleWc(wc.id)"/>
                                <span t-esc="wc.name"/>
                            </label>
                        </t>
                    </div>
                </div>

                <div class="vr mx-1"/>

                <!-- Rango de fechas -->
                <div class="sm-filter-group d-flex align-items-center gap-1">
                    <span class="text-muted small">Desde</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                    <span class="text-muted small">hasta</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>

                <div class="vr mx-1"/>

                <!-- Búsqueda -->
                <div class="sm-filter-group">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Buscar OF o producto…"
                               t-att-value="state.searchText" t-on-input="onSearchChange"/>
                    </div>
                </div>

                <!-- Toggles -->
                <div class="sm-filter-group d-flex align-items-center gap-3 ms-auto">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="sm-hide-empty"
                               t-att-checked="state.hideEmptyRows" t-on-change="toggleHideEmptyRows"/>
                        <label class="form-check-label small text-muted" for="sm-hide-empty">
                            Ocultar CTs vacíos
                        </label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="sm-show-done"
                               t-att-checked="state.showDone" t-on-change="toggleShowDone"/>
                        <label class="form-check-label small text-muted" for="sm-show-done">
                            Mostrar terminadas
                        </label>
                    </div>
                </div>

                <!-- Contador -->
                <div t-if="state.totalBars" class="text-muted small">
                    <strong t-esc="state.totalBars"/> OT
                </div>

            </div><!-- /sm-filters -->

            <!-- ══ Mensaje inicial ══════════════════════════════════════════════ -->
            <div t-if="!state.tagIds.length" class="text-center text-muted py-5">
                <i class="fa fa-sitemap fa-3x mb-3 d-block"/>
                <p>Seleccioná un <strong>sector</strong> para ver el tablero de programación.</p>
            </div>

            <!-- ══ Sin filas ════════════════════════════════════════════════════ -->
            <div t-elif="!state.viewRows.length" class="text-center text-muted py-5">
                <i class="fa fa-calendar-o fa-3x mb-3 d-block"/>
                <p class="fw-semibold">Sin OFs para los filtros seleccionados.</p>
            </div>

            <!-- ══ Tablero ══════════════════════════════════════════════════════ -->
            <div t-elif="state.layout" class="sm-board">
                <div class="sm-scroll">

                    <!-- Header: esquina sticky + eje temporal -->
                    <div class="sm-head-row">
                        <div class="sm-corner"/>
                        <div class="sm-time-head" t-att-style="`width:${state.layout.contentWidthPx}px`">
                            <!-- Grupos (día / semana / mes) -->
                            <div class="sm-groups">
                                <t t-foreach="state.layout.groups" t-as="g" t-key="g_index">
                                    <div class="sm-group"
                                         t-att-style="`left:${g.leftPct}%;width:${g.widthPct}%`">
                                        <span class="sm-group-label" t-esc="g.label"/>
                                        <span class="sm-group-sub" t-esc="g.sublabel"/>
                                    </div>
                                </t>
                            </div>
                            <!-- Ticks -->
                            <div class="sm-ticks">
                                <t t-foreach="state.layout.ticks" t-as="tk" t-key="tk_index">
                                    <div t-att-class="'sm-tick' + (tk.major ? ' sm-tick-major' : '')"
                                         t-att-style="`left:${tk.leftPct}%`">
                                        <span class="sm-tick-label" t-esc="tk.label"/>
                                        <span t-if="tk.sublabel" class="sm-tick-sub" t-esc="tk.sublabel"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Filas -->
                    <t t-foreach="state.viewRows" t-as="row" t-key="row.wc_id || 'unassigned'">

                      <!-- Fila "Sin centro asignado": colapsable, lista simple -->
                      <t t-if="row.is_unassigned">
                        <div class="sm-row sm-row-unassigned">
                            <div class="sm-unassigned-head" t-on-click="toggleUnassigned"
                                 title="OFs sin work orders: no tienen operaciones definidas y por eso no hay centro de trabajo al que asignarlas. (Las de subcontratación se excluyen del tablero.)">
                                <i t-att-class="'fa me-2 ' + (state.unassignedExpanded ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                <i class="fa fa-exclamation-triangle text-warning me-2"/>
                                <span class="fw-semibold"><t t-esc="row.count"/> OFs sin operaciones definidas</span>
                            </div>
                            <div t-if="state.unassignedExpanded" class="sm-unassigned-list">
                                <t t-foreach="row.bars" t-as="bar" t-key="bar.mo_id">
                                    <div class="sm-unassigned-item d-flex align-items-center gap-2">
                                        <span class="sm-ua-ref fw-semibold" t-esc="bar.mo_name"/>
                                        <span class="sm-ua-prod text-truncate flex-grow-1" t-att-title="bar.product_name" t-esc="bar.product_name"/>
                                        <span class="sm-ua-dates text-muted text-nowrap">
                                            <t t-esc="bar.date_start_str"/>
                                            <t t-if="bar.date_finished_str"> → <t t-esc="bar.date_finished_str"/></t>
                                        </span>
                                        <button class="sm-bar-open" t-att-title="'Abrir ' + bar.mo_name"
                                                t-on-click="(ev) => this.openMo(ev, bar)">
                                            <i class="fa fa-external-link"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                      </t>

                      <!-- Fila normal de CT -->
                      <t t-else="">
                        <div class="sm-row" t-att-style="`height:${row.heightPx}px`">

                            <!-- Columna CT sticky -->
                            <div t-att-class="'sm-row-ct' + (row.is_unassigned ? ' sm-row-ct-unassigned' : '')">
                                <div class="sm-ct-name fw-semibold text-truncate" t-att-title="row.wc_name" t-esc="row.wc_name"/>
                                <div class="sm-ct-sub d-flex align-items-center gap-1 mt-1">
                                    <t t-if="row.occupancy">
                                        <span t-att-class="'sm-occ badge ' + occupancyClass(row.occupancy.pct)"
                                              t-att-title="`Planificado ${row.occupancy.planned_hours}h / disponible ${row.occupancy.available_hours}h`">
                                            <t t-esc="row.occupancy.pct"/>%
                                        </span>
                                    </t>
                                    <span t-if="row.bands_failed" class="sm-bands-warn badge"
                                          title="No se pudieron calcular las bandas laborables de este CT (revisar su calendario). El fondo no refleja horario real.">
                                        <i class="fa fa-exclamation-triangle"/> sin bandas
                                    </span>
                                    <t t-foreach="row.tag_names" t-as="tagName" t-key="tagName">
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary sm-sector-badge" t-esc="tagName"/>
                                    </t>
                                </div>
                            </div>

                            <!-- Pista temporal -->
                            <div t-att-class="'sm-row-track' + (row.bands_failed ? ' sm-track-nobands' : '')"
                                 t-att-style="`width:${state.layout.contentWidthPx}px`">

                                <!-- Bandas laborables (blanco sobre fondo gris no-laborable) -->
                                <t t-foreach="row.workBlocks" t-as="wb" t-key="wb_index">
                                    <div class="sm-work" t-att-style="`left:${wb.leftPct}%;width:${wb.widthPct}%`"/>
                                </t>

                                <!-- Tinte nocturno -->
                                <t t-foreach="state.layout.nightBands" t-as="nb" t-key="nb_index">
                                    <div class="sm-night" t-att-style="`left:${nb.leftPct}%;width:${nb.widthPct}%`"/>
                                </t>

                                <!-- Gridlines, divisorias de turno, líneas de día -->
                                <t t-foreach="state.layout.gridlines" t-as="gl" t-key="'g'+gl_index">
                                    <div class="sm-gridline" t-att-style="`left:${gl.leftPct}%`"/>
                                </t>
                                <t t-foreach="state.layout.shiftDividers" t-as="sd" t-key="'s'+sd_index">
                                    <div class="sm-shiftline" t-att-style="`left:${sd.leftPct}%`"/>
                                </t>
                                <t t-foreach="state.layout.dayLines" t-as="dl" t-key="'d'+dl_index">
                                    <div class="sm-dayline" t-att-style="`left:${dl.leftPct}%`"/>
                                </t>
                                <div t-if="state.layout.nowPct !== null" class="sm-nowline"
                                     t-att-style="`left:${state.layout.nowPct}%`"/>

                                <!-- Separadores entre lanes del mismo CT -->
                                <t t-foreach="row.laneSeps" t-as="ls" t-key="'l'+ls_index">
                                    <div class="sm-lane-sep" t-att-style="`top:${ls}px`"/>
                                </t>

                                <!-- Barras (WOs): un segmento por tramo laborable del CT -->
                                <t t-foreach="row.bars" t-as="bar" t-key="bar.wo_id || ('mo'+bar.mo_id)">
                                    <t t-foreach="bar.segs" t-as="seg" t-key="seg_index">
                                        <div t-att-class="'sm-bar sm-bar-seg ' + moStateClass(bar.mo_state) + (bar.overload ? ' sm-bar-over' : '') + ((bar.inconsistent_dates || bar.outside_calendar) ? ' sm-bar-bad' : '') + (seg_first and bar.clipped_start ? ' sm-bar-clip-l' : '') + (seg_last and bar.clipped_end ? ' sm-bar-clip-r' : '')"
                                             t-att-style="segStyle(bar, seg)"
                                             t-att-title="barTitle(bar)"
                                             t-on-click="(ev) => this.toggleBarPopover(ev, bar)">
                                            <span t-if="seg_first and bar.clipped_start" class="sm-clip-badge">‹</span>
                                            <t t-if="seg_first">
                                                <span class="sm-bar-text text-truncate">
                                                    <t t-esc="bar.mo_name"/>
                                                    <span class="sm-bar-prod" t-esc="bar.product_name"/>
                                                </span>
                                                <button class="sm-bar-open" t-att-title="'Abrir ' + bar.mo_name"
                                                        t-on-click="(ev) => this.openMo(ev, bar)">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </t>
                                            <span t-if="seg_last and bar.clipped_end" class="sm-clip-badge sm-clip-badge-r">›</span>
                                        </div>
                                    </t>
                                </t>

                                <!-- Botón "+ Nueva OF": a la derecha de la última barra, al hover de la fila -->
                                <button class="sm-add-btn" title="Nueva OF en este centro"
                                        t-att-style="addBtnStyle(row)"
                                        t-on-click="(ev) => this.onAddClick(ev, row)">
                                    <i class="fa fa-plus"/>
                                </button>

                            </div><!-- /sm-row-track -->
                        </div><!-- /sm-row -->
                      </t><!-- /t-else fila normal -->
                    </t><!-- /t-foreach filas -->

                </div><!-- /sm-scroll -->
            </div><!-- /sm-board -->

        </t><!-- /t-else contenido principal -->

        <!-- ══ Popover de componentes (anclado a la barra) ══════════════════════ -->
        <div t-if="state.popoverKey"
             class="sm-popover shadow border rounded bg-white"
             t-att-style="`position:fixed;top:${state.popoverPos.top}px;left:${state.popoverPos.left}px;z-index:1060`"
             t-on-click.stop="() => {}">
            <div class="sm-popover-head d-flex justify-content-between align-items-center px-2 py-1 border-bottom">
                <span class="fw-semibold small">Componentes</span>
                <button class="btn btn-sm btn-link p-0" t-on-click.stop="_closePopover">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <div class="sm-popover-body p-2">
                <div t-if="isLoadingComp(state.popoverMoId)" class="text-muted small text-center py-1">
                    <i class="fa fa-spinner fa-spin"/>
                </div>
                <t t-elif="getComponents(state.popoverMoId).length">
                    <t t-foreach="getComponents(state.popoverMoId)" t-as="comp" t-key="comp_index">
                        <div class="sm-comp-row d-flex justify-content-between gap-2">
                            <span class="sm-comp-name" t-esc="comp.product_name"/>
                            <span class="sm-comp-qty text-muted text-nowrap">
                                <t t-esc="fmtQty(comp.qty)"/>
                                <t t-if="comp.uom"><span class="ms-1" t-esc="comp.uom"/></t>
                            </span>
                        </div>
                    </t>
                </t>
                <div t-else="" class="text-muted small">Sin componentes.</div>
            </div>
        </div>

    </div><!-- /sm-root -->
</t>

</templates>
