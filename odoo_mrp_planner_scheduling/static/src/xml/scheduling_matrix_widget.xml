<?xml version="1.0" encoding="utf-8"?>
<templates>

<t t-name="odoo_mrp_planner_scheduling.SchedulingMatrixWidget">
    <div t-att-class="'sm-root' + (state.routeMode ? ' sm-route-mode' : '')" t-on-click.stop="closeDropdowns">

        <!-- ── Spinner ── -->
        <div t-if="state.loading" class="sm-loading text-center py-5">
            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
            <p class="text-muted mt-2">Cargando tablero…</p>
        </div>

        <!-- ── Error ── -->
        <div t-elif="state.error" class="alert alert-danger m-3">
            <i class="fa fa-exclamation-triangle me-2"/>
            <t t-esc="state.error"/>
        </div>

        <!-- ── Contenido principal ── -->
        <t t-else="">

            <!-- ══ Barra de filtros ════════════════════════════════════════════ -->
            <div class="sm-filters d-flex flex-nowrap align-items-center gap-2 px-3 py-2 border-bottom bg-light">

                <!-- Resolución (zoom). En modo ruta el zoom arranca en auto-fit del
                     escalonado, pero el usuario puede cambiarlo con estos botones. -->
                <div class="sm-filter-group btn-group btn-group-sm" role="group">
                    <t t-foreach="resolutions" t-as="r" t-key="r.key">
                        <button type="button"
                                t-att-class="'btn ' + (state.resolution === r.key ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.setResolution(r.key)"
                                t-esc="r.label"/>
                    </t>
                </div>

                <!-- Estado (multi-selección): aplica en el tablero y en la ruta.
                     Por defecto Confirmada + En proceso. -->
                <div class="sm-filter-group position-relative">
                    <span class="sm-filter-label text-muted small me-1">Estado:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleStateDropdown">
                        <t t-esc="stateFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.stateDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.stateMenuPos.top}px;left:${state.stateMenuPos.left}px;z-index:1050;min-width:170px`">
                        <t t-foreach="stateOptions" t-as="opt" t-key="opt.key">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleState(opt.key)">
                                <input type="checkbox"
                                       t-att-checked="state.stateFilter.includes(opt.key)"
                                       t-on-click.stop="() => this.toggleState(opt.key)"/>
                                <span t-esc="opt.label"/>
                            </label>
                        </t>
                    </div>
                </div>

                <t t-if="!state.routeMode">
                <div class="vr mx-1"/>

                <!-- Sector -->
                <div class="sm-filter-group position-relative">
                    <span class="sm-filter-label text-muted small me-1">Sector:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleTagDropdown">
                        <t t-esc="tagFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.tagDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.tagMenuPos.top}px;left:${state.tagMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleTag(tag.id)">
                                <input type="checkbox"
                                       t-att-checked="state.tagIds.includes(tag.id)"
                                       t-on-click.stop="() => this.toggleTag(tag.id)"/>
                                <span t-esc="tag.name"/>
                            </label>
                        </t>
                        <div t-if="!state.tags.length" class="px-3 py-2 text-muted small">
                            Sin sectores configurados
                        </div>
                    </div>
                </div>

                <!-- CT -->
                <div class="sm-filter-group position-relative" t-if="state.wcs.length">
                    <span class="sm-filter-label text-muted small me-1">CT:</span>
                    <button class="sm-filter-btn btn btn-sm btn-outline-secondary"
                            t-on-click.stop="toggleWcDropdown">
                        <t t-esc="wcFilterLabel"/>
                        <i class="fa fa-chevron-down ms-1 small"/>
                    </button>
                    <div t-if="state.wcDropdownOpen"
                         class="sm-dropdown shadow-sm border rounded bg-white"
                         t-att-style="`position:fixed;top:${state.wcMenuPos.top}px;left:${state.wcMenuPos.left}px;z-index:1050;min-width:180px`">
                        <t t-foreach="state.wcs" t-as="wc" t-key="wc.id">
                            <label class="sm-dropdown-item d-flex align-items-center gap-2 px-3 py-1 small"
                                   t-on-click.stop="() => this.toggleWc(wc.id)">
                                <input type="checkbox"
                                       t-att-checked="state.wcFilterIds.includes(wc.id)"
                                       t-on-click.stop="() => this.toggleWc(wc.id)"/>
                                <span t-esc="wc.name"/>
                            </label>
                        </t>
                    </div>
                </div>

                <div class="vr mx-1"/>

                <!-- Rango de fechas -->
                <div class="sm-filter-group d-flex align-items-center gap-1">
                    <span class="text-muted small">Desde</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                    <span class="text-muted small">hasta</span>
                    <input type="date" class="form-control form-control-sm sm-date-input"
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>

                <div class="vr mx-1"/>

                <!-- Búsqueda -->
                <div class="sm-filter-group">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="fa fa-search"/></span>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Buscar OF o producto…"
                               t-att-value="state.searchText" t-on-input="onSearchChange"/>
                    </div>
                </div>

                <!-- Toggles -->
                <div class="sm-filter-group d-flex align-items-center gap-3 ms-auto">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="sm-hide-empty"
                               t-att-checked="state.hideEmptyRows" t-on-change="toggleHideEmptyRows"/>
                        <label class="form-check-label small text-muted" for="sm-hide-empty">
                            Ocultar CTs vacíos
                        </label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="sm-hide-weekends"
                               t-att-checked="state.hideWeekends" t-on-change="toggleHideWeekends"/>
                        <label class="form-check-label small text-muted" for="sm-hide-weekends">
                            Ocultar fines de semana
                        </label>
                    </div>
                </div>

                <!-- Contador -->
                <div t-if="state.totalBars" class="text-muted small">
                    <strong t-esc="state.totalBars"/> OT
                </div>
                </t><!-- /!routeMode -->

                <!-- Encabezado de modo ruta / propuesta -->
                <t t-if="state.routeMode">
                    <span t-if="!state.proposalMode" class="sm-route-title">
                        <i class="fa fa-random me-1"/>Ruta de <b t-esc="state.routeHeader.name"/>
                        <span class="text-muted ms-2" t-esc="state.routeHeader.product"/>
                        <span class="text-muted ms-1">· <t t-esc="fmtQty(state.routeHeader.qty)"/> <t t-esc="state.routeHeader.uom"/></span>
                        <span t-if="state.routeTruncated" class="badge bg-warning text-dark ms-2"
                              title="La cadena es muy larga y se mostró parcialmente (límite de nodos). Hay más OFs relacionadas de las que se ven.">
                            <i class="fa fa-exclamation-triangle me-1"/>cadena recortada
                        </span>
                    </span>
                    <span t-if="state.proposalMode" class="sm-route-title">
                        <i class="fa fa-industry me-1"/>Propuesta de fabricación
                        <span class="text-muted ms-2">— la ocupación de cada centro suma la carga existente + la propuesta</span>
                    </span>
                    <div class="form-check form-switch mb-0 ms-auto">
                        <input class="form-check-input" type="checkbox" id="sm-collapse-empty-r"
                               t-att-checked="state.collapseEmpty" t-on-change="toggleCollapseEmpty"/>
                        <label class="form-check-label small text-muted" for="sm-collapse-empty-r"
                               title="Corta del eje los días sin OFs de la cadena, para que las relacionadas queden pegadas. Apagalo para ver el tiempo real entre ellas.">Colapsar vacíos</label>
                    </div>
                    <div class="form-check form-switch mb-0 ms-2">
                        <input class="form-check-input" type="checkbox" id="sm-hide-weekends-r"
                               t-att-checked="state.hideWeekends" t-on-change="toggleHideWeekends"/>
                        <label class="form-check-label small text-muted" for="sm-hide-weekends-r">Ocultar fines de semana</label>
                    </div>
                    <button t-if="!state.proposalMode" class="btn btn-sm btn-outline-secondary ms-2" t-on-click="exitRoute">
                        <i class="fa fa-times me-1"/>Salir de ruta
                    </button>
                </t>

            </div><!-- /sm-filters -->

            <!-- ══ Mensaje inicial ══════════════════════════════════════════════ -->
            <div t-if="!state.tagIds.length and !state.routeMode" class="text-center text-muted py-5">
                <i class="fa fa-sitemap fa-3x mb-3 d-block"/>
                <p>Seleccioná un <strong>sector</strong> para ver el tablero de programación.</p>
            </div>

            <!-- ══ Sin filas ════════════════════════════════════════════════════ -->
            <div t-elif="!state.viewRows.length" class="text-center text-muted py-5">
                <i class="fa fa-calendar-o fa-3x mb-3 d-block"/>
                <p t-if="state.proposalMode" class="fw-semibold">La propuesta no tiene operaciones para dibujar. Calculá el plan primero.</p>
                <p t-else="" class="fw-semibold">Sin OFs para los filtros seleccionados.</p>
            </div>

            <!-- ══ Tablero ══════════════════════════════════════════════════════ -->
            <div t-elif="state.layout" class="sm-board-wrap">
              <div class="sm-board">
                <div class="sm-scroll">

                    <!-- Header: esquina sticky + eje temporal -->
                    <div class="sm-head-row">
                        <div class="sm-corner"/>
                        <div class="sm-time-head" t-att-style="`width:${state.layout.contentWidthPx}px`">
                            <!-- Grupos (día / semana / mes) -->
                            <div class="sm-groups">
                                <t t-foreach="state.layout.groups" t-as="g" t-key="g_index">
                                    <div t-att-class="'sm-group' + (g.weekendWork ? ' sm-weekend-work' : '')"
                                         t-att-style="`left:${g.leftPct}%;width:${g.widthPct}%`"
                                         t-att-title="g.weekendWork ? 'Fin de semana con trabajo programado' : ''">
                                        <span class="sm-group-label" t-esc="g.label"/>
                                        <span class="sm-group-sub" t-esc="g.sublabel"/>
                                        <i t-if="g.weekendWork" class="fa fa-calendar-o ms-1"/>
                                    </div>
                                </t>
                            </div>
                            <!-- Ticks -->
                            <div class="sm-ticks">
                                <t t-foreach="state.layout.ticks" t-as="tk" t-key="tk_index">
                                    <div t-att-class="'sm-tick' + (tk.major ? ' sm-tick-major' : '') + (tk.weekendWork ? ' sm-weekend-work' : '')"
                                         t-att-style="`left:${tk.leftPct}%`"
                                         t-att-title="tk.weekendWork ? 'Fin de semana con trabajo programado' : ''">
                                        <span class="sm-tick-label" t-esc="tk.label"/>
                                        <span t-if="tk.sublabel" class="sm-tick-sub" t-esc="tk.sublabel"/>
                                    </div>
                                </t>
                            </div>
                            <!-- Marcas de corte en el header -->
                            <t t-foreach="state.layout.cuts" t-as="ct" t-key="'hc'+ct_index">
                                <div class="sm-cutline sm-cutline-head" t-att-style="`left:${ct.leftPct}%`"/>
                            </t>
                        </div>
                    </div>

                    <!-- Filas (con encabezados de sector cuando hay varios sectores).
                         Contenedor posicionado para poder superponer el hilo (modo ruta). -->
                    <div class="sm-rows">
                    <t t-foreach="boardItems" t-as="item" t-key="itemKey(item)">

                      <!-- Encabezado de sector (sticky, colapsable) -->
                      <t t-if="item.type === 'header'">
                        <div class="sm-sector-head" t-on-click="() => this.toggleSector(item.group.name)">
                            <div class="sm-sector-head-inner">
                                <i t-att-class="'fa me-2 ' + (item.group.collapsed ? 'fa-chevron-right' : 'fa-chevron-down')"/>
                                <span class="fw-bold" t-esc="item.group.name"/>
                                <span class="sm-sector-meta text-muted ms-2 small">
                                    <t t-esc="item.group.ctCount"/> CT · <t t-esc="item.group.avgOcc"/>% ocup. prom
                                </span>
                            </div>
                        </div>
                      </t>

                      <!-- Fila "Sin operaciones definidas": colapsable, lista simple -->
                      <t t-elif="item.type === 'unassigned'">
                        <t t-set="row" t-value="item.row"/>
                        <div class="sm-row sm-row-unassigned">
                            <div class="sm-unassigned-head" t-on-click="toggleUnassigned"
                                 title="OFs sin work orders: no tienen operaciones definidas y por eso no hay centro de trabajo al que asignarlas. (Las de subcontratación se excluyen del tablero.)">
                                <i t-att-class="'fa me-2 ' + (state.unassignedExpanded ? 'fa-chevron-down' : 'fa-chevron-right')"/>
                                <i class="fa fa-exclamation-triangle text-warning me-2"/>
                                <span class="fw-semibold"><t t-esc="row.count"/> OFs sin operaciones definidas</span>
                            </div>
                            <div t-if="state.unassignedExpanded" class="sm-unassigned-list">
                                <t t-foreach="row.bars" t-as="bar" t-key="bar.mo_id">
                                    <div class="sm-unassigned-item d-flex align-items-center gap-2">
                                        <span class="sm-ua-ref fw-semibold" t-esc="bar.mo_name"/>
                                        <span class="sm-ua-prod text-truncate flex-grow-1" t-att-title="bar.product_name" t-esc="bar.product_name"/>
                                        <span class="sm-ua-dates text-muted text-nowrap">
                                            <t t-esc="bar.date_start_str"/>
                                            <t t-if="bar.date_finished_str"> → <t t-esc="bar.date_finished_str"/></t>
                                        </span>
                                        <button class="sm-bar-open" t-att-title="'Abrir ' + bar.mo_name"
                                                t-on-click="(ev) => this.openMo(ev, bar)">
                                            <i class="fa fa-external-link"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                      </t>

                      <!-- Fila normal de CT -->
                      <t t-else="">
                        <t t-set="row" t-value="item.row"/>
                        <div t-att-class="'sm-row' + (item.alt ? ' sm-row-alt' : '')"
                             t-att-style="`height:${row.heightPx}px`">

                            <!-- Columna CT sticky -->
                            <div t-att-class="'sm-row-ct' + (row.is_unassigned ? ' sm-row-ct-unassigned' : '')">
                                <div class="sm-ct-name fw-semibold text-truncate d-flex align-items-center gap-1"
                                     t-att-title="row.wc_name">
                                    <span t-if="state.routeMode and row.route_seq" class="sm-route-seq" t-esc="row.route_seq"/>
                                    <span class="text-truncate" t-esc="row.wc_name"/>
                                </div>
                                <div class="sm-ct-sub d-flex align-items-center gap-1 mt-1">
                                    <!-- En modo ruta las barras son solo la cadena: el % de ocupación
                                         no reflejaría la carga real del CT, así que se oculta. En modo
                                         PROPUESTA sí se muestra: es el dato clave (existente + propuesta). -->
                                    <t t-if="row.occupancy and (!state.routeMode or state.proposalMode)">
                                        <span t-att-class="'sm-occ badge ' + occupancyClass(row.occupancy.pct)"
                                              t-att-title="occTitle(row.occupancy)">
                                            <t t-esc="row.occupancy.pct"/>%
                                        </span>
                                    </t>
                                    <span t-if="row.bands_failed" class="sm-bands-warn badge"
                                          title="No se pudieron calcular las bandas laborables de este CT (revisar su calendario). El fondo no refleja horario real.">
                                        <i class="fa fa-exclamation-triangle"/> sin bandas
                                    </span>
                                    <t t-foreach="row.tag_names" t-as="tagName" t-key="tagName">
                                        <span class="badge bg-secondary bg-opacity-25 text-secondary sm-sector-badge" t-esc="tagName"/>
                                    </t>
                                </div>
                            </div>

                            <!-- Pista temporal -->
                            <div t-att-class="'sm-row-track' + (row.bands_failed ? ' sm-track-nobands' : '')"
                                 t-att-style="`width:${state.layout.contentWidthPx}px`">

                                <!-- Bandas laborables (blanco sobre fondo gris no-laborable) -->
                                <t t-foreach="row.workBlocks" t-as="wb" t-key="wb_index">
                                    <div class="sm-work" t-att-style="`left:${wb.leftPct}%;width:${wb.widthPct}%`"/>
                                </t>

                                <!-- Tinte nocturno -->
                                <t t-foreach="state.layout.nightBands" t-as="nb" t-key="nb_index">
                                    <div class="sm-night" t-att-style="`left:${nb.leftPct}%;width:${nb.widthPct}%`"/>
                                </t>

                                <!-- Gridlines, divisorias de turno, líneas de día -->
                                <t t-foreach="state.layout.gridlines" t-as="gl" t-key="'g'+gl_index">
                                    <div class="sm-gridline" t-att-style="`left:${gl.leftPct}%`"/>
                                </t>
                                <t t-foreach="state.layout.shiftDividers" t-as="sd" t-key="'s'+sd_index">
                                    <div class="sm-shiftline" t-att-style="`left:${sd.leftPct}%`"/>
                                </t>
                                <t t-foreach="state.layout.dayLines" t-as="dl" t-key="'d'+dl_index">
                                    <div class="sm-dayline" t-att-style="`left:${dl.leftPct}%`"/>
                                </t>
                                <!-- Marcas de corte donde el eje saltea días ocultos -->
                                <t t-foreach="state.layout.cuts" t-as="ct" t-key="'c'+ct_index">
                                    <div class="sm-cutline" t-att-style="`left:${ct.leftPct}%`"
                                         t-att-title="ct.gapDays ? ct.gapDays + ' día(s) sin actividad (colapsado)' : 'tiempo sin actividad (colapsado)'"/>
                                </t>
                                <div t-if="state.layout.nowPct !== null" class="sm-nowline"
                                     t-att-style="`left:${state.layout.nowPct}%`"/>

                                <!-- Separadores entre lanes del mismo CT -->
                                <t t-foreach="row.laneSeps" t-as="ls" t-key="'l'+ls_index">
                                    <div class="sm-lane-sep" t-att-style="`top:${ls}px`"/>
                                </t>

                                <!-- Barras (WOs): continua, partida solo por día completo no laborable -->
                                <t t-foreach="row.bars" t-as="bar" t-key="bar.wo_id || ('mo'+bar.mo_id)">
                                    <!-- Conector punteado entre tramos de la misma OF -->
                                    <div t-if="bar.segs.length > 1" class="sm-bar-conn" t-att-style="connStyle(bar)"/>
                                    <t t-foreach="bar.segs" t-as="seg" t-key="seg_index">
                                        <div t-att-class="'sm-bar sm-bar-seg ' + segCorner(bar, seg_first, seg_last) + ' ' + moStateClass(bar.mo_state) + (bar.overload ? ' sm-bar-over' : '') + ((bar.inconsistent_dates || bar.outside_calendar) ? ' sm-bar-bad' : '') + (seg_first and bar.clipped_start ? ' sm-bar-clip-l' : '') + (seg_last and bar.clipped_end ? ' sm-bar-clip-r' : '') + (isUnscheduledBar(bar) ? ' sm-bar-unsched' : '') + (isTreeBar(bar) ? ' sm-bar-tree' : '') + (isFocusedBar(bar) ? ' sm-bar-focus' : '') + (bar.is_alternative ? ' sm-bar-alt' : '')"
                                             t-att-style="segStyle(bar, seg)"
                                             t-att-title="barTitle(bar)"
                                             t-on-click="(ev) => this.toggleBarPopover(ev, bar)">
                                            <span t-if="seg_first and bar.clipped_start" class="sm-clip-badge">‹</span>
                                            <t t-if="seg_first">
                                                <div class="sm-bar-body">
                                                    <div class="sm-bar-l1">
                                                        <span class="sm-bar-ref" t-esc="bar.mo_name"/>
                                                        <span class="sm-bar-ref-short" t-esc="shortRef(bar.mo_name)"/>
                                                        <span t-if="bar.overload" class="sm-bar-warn">SOLAPADA</span>
                                                        <span t-elif="isUnscheduledBar(bar)" class="sm-bar-unsched-badge badge"
                                                              title="Operación sin programar: ubicada por las fechas de la OF (su WO no tiene inicio).">sin programar</span>
                                                        <span t-else="" class="sm-bar-state badge"
                                                              t-att-class="moStateClass(bar.mo_state)"
                                                              t-esc="moStateLabel(bar.mo_state)"/>
                                                    </div>
                                                    <div class="sm-bar-l2">
                                                        <t t-esc="bar.product_name"/>
                                                        <t t-if="bar.qty"> · <t t-esc="fmtQty(bar.qty)"/> <t t-esc="bar.uom"/></t>
                                                        <t t-if="bar.date_start_str"> · <t t-esc="bar.date_start_str"/></t>
                                                    </div>
                                                </div>
                                                <button t-if="!state.proposalMode" class="sm-bar-open" t-att-title="'Abrir ' + bar.mo_name"
                                                        t-on-click="(ev) => this.openMo(ev, bar)">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </t>
                                            <span t-else="" class="sm-seg-cont">…continúa</span>
                                            <span t-if="seg_last and bar.clipped_end" class="sm-clip-badge sm-clip-badge-r">›</span>
                                        </div>
                                    </t>
                                </t>

                                <!-- Botón "+ Nueva OF": a la derecha de la última barra, al hover de la fila -->
                                <button t-if="!state.routeMode" class="sm-add-btn" title="Nueva OF en este centro"
                                        t-att-style="addBtnStyle(row)"
                                        t-on-click="(ev) => this.onAddClick(ev, row)">
                                    <i class="fa fa-plus"/>
                                </button>

                            </div><!-- /sm-row-track -->
                        </div><!-- /sm-row -->
                      </t><!-- /t-else fila normal -->
                    </t><!-- /t-foreach filas -->

                    <!-- Hilo conector de la cadena (modo ruta): componente → consumidora -->
                    <svg t-if="routeThread" class="sm-thread"
                         t-att-style="`width:${routeThread.width}px;height:${routeThread.height}px`"
                         t-att-width="routeThread.width" t-att-height="routeThread.height">
                        <defs>
                            <marker id="sm-thread-arrow" markerWidth="7" markerHeight="7"
                                    refX="6" refY="3" orient="auto" markerUnits="userSpaceOnUse">
                                <path d="M0,0 L7,3 L0,6 Z" fill="#7A3FF2"/>
                            </marker>
                        </defs>
                        <t t-foreach="routeThread.lines" t-as="ln" t-key="ln_index">
                            <path t-att-d="threadPath(ln)" class="sm-thread-line"
                                  marker-end="url(#sm-thread-arrow)"/>
                        </t>
                    </svg>
                    </div><!-- /sm-rows -->

                </div><!-- /sm-scroll -->
                <div t-if="state.layout.cutFootnote" class="sm-cut-foot text-muted small px-3 py-1">
                    <i class="fa fa-scissors me-1"/><t t-esc="state.layout.cutFootnote"/>
                </div>
              </div><!-- /sm-board -->

              <!-- Panel lateral: árbol de OFs relacionadas (modo ruta) -->
              <div t-if="state.routeMode" class="sm-route-panel">
                  <div class="sm-route-panel-head">
                      Cadena de OFs relacionadas
                      <span class="text-muted fw-normal small ms-1">· clic para marcar, Shift para varias</span>
                  </div>
                  <div class="sm-route-panel-body">
                      <t t-foreach="state.relatedTree" t-as="node" t-key="node.mo_id">
                          <div t-att-class="'sm-tree-node sm-tree-' + node.relation + (state.routeSelectedIds.includes(node.mo_id) ? ' sm-tree-current' : '')"
                               t-att-style="`padding-left:${8 + node.level * 12}px`"
                               t-on-click="(ev) => this.selectRouteMo(node.mo_id, ev)"
                               t-att-title="node.name + ' — ' + node.product">
                              <div class="d-flex align-items-center gap-1">
                                  <span class="sm-tree-rel" t-esc="relLabel(node.relation)"/>
                                  <span class="fw-semibold" t-esc="node.name"/>
                                  <span class="sm-bar-state badge ms-auto" t-att-class="moStateClass(node.state)"
                                        t-esc="moStateLabel(node.state)"/>
                              </div>
                              <div class="sm-tree-prod text-truncate" t-esc="node.product"/>
                              <div class="sm-tree-meta text-muted">
                                  <t t-esc="fmtQty(node.qty)"/> <t t-esc="node.uom"/>
                                  <t t-if="node.date_start"> · <t t-esc="node.date_start"/></t>
                              </div>
                          </div>
                      </t>
                  </div>
              </div>
            </div><!-- /sm-board-wrap -->

        </t><!-- /t-else contenido principal -->

        <!-- ══ Popover de componentes (anclado a la barra) ══════════════════════ -->
        <div t-if="state.popoverKey"
             class="sm-popover shadow border rounded bg-white"
             t-att-style="`position:fixed;top:${state.popoverPos.top}px;left:${state.popoverPos.left}px;z-index:1060`"
             t-on-click.stop="() => {}">
            <div class="sm-popover-head d-flex justify-content-between align-items-center px-2 py-1 border-bottom">
                <span class="fw-semibold small">Componentes</span>
                <button class="btn btn-sm btn-link p-0" t-on-click.stop="_closePopover">
                    <i class="fa fa-times"/>
                </button>
            </div>
            <div class="sm-popover-body p-2">
                <div t-if="isLoadingComp(state.popoverMoId)" class="text-muted small text-center py-1">
                    <i class="fa fa-spinner fa-spin"/>
                </div>
                <t t-elif="getComponents(state.popoverMoId).length">
                    <t t-foreach="getComponents(state.popoverMoId)" t-as="comp" t-key="comp_index">
                        <div class="sm-comp-row d-flex justify-content-between gap-2">
                            <span class="sm-comp-name" t-esc="comp.product_name"/>
                            <span class="sm-comp-qty text-muted text-nowrap">
                                <t t-esc="fmtQty(comp.qty)"/>
                                <t t-if="comp.uom"><span class="ms-1" t-esc="comp.uom"/></t>
                            </span>
                        </div>
                    </t>
                </t>
                <div t-else="" class="text-muted small">Sin componentes.</div>
            </div>
            <div class="sm-popover-foot border-top p-2">
                <button class="btn btn-sm btn-primary w-100"
                        t-on-click.stop="() => this.enterRoute(state.popoverMoId)">
                    <i class="fa fa-random me-1"/>Ver ruta de la OF
                </button>
            </div>
        </div>

    </div><!-- /sm-root -->
</t>

</templates>
