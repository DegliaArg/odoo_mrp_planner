<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Tipos de origen: modo de abastecimiento (crear/editar/borrar) ── -->
    <record id="mrp_product_type_planning_list" model="ir.ui.view">
        <field name="name">mrp.product.type.planning.list</field>
        <field name="model">mrp.product.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de origen" editable="bottom">
                <field name="name"/>
                <field name="supply_mode"/>
                <field name="lead_time_days"/>
            </list>
        </field>
    </record>

    <record id="action_mrp_product_type" model="ir.actions.act_window">
        <field name="name">Tipos de origen</field>
        <field name="res_model">mrp.product.type</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="mrp_product_type_planning_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Definí los tipos de origen</p>
            <p>Cada tipo indica cómo lo planifica el motor: Fabricar, Comprar o
               (en blanco) no planificar. El lead time es el plazo de reposición por defecto.</p>
        </field>
    </record>

    <menuitem id="mrp_scheduling_menu_product_types"
              name="Tipos de origen"
              parent="odoo_mrp_planner_scheduling.mrp_scheduling_menu_root"
              sequence="95"
              action="action_mrp_product_type"
              groups="odoo_mrp_planner_scheduling.group_scheduling"/>

    <!-- ── Vista propia de configuración del módulo de Planificación ── -->
    <record id="mrp_scheduling_config_form_view" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.scheduling.form</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de planificación" create="false" delete="false">
                <sheet>
                    <h2>Planificación</h2>

                    <!-- El acceso al módulo se controla por el grupo "Programación"
                         (no hay interruptor maestro). Las opciones del reprogramador en
                         cascada (fallback de CT, prioridad, heurística) se retiran de la UI
                         mientras esa función está aparcada; los campos siguen en el modelo. -->
                    <group string="Motor de necesidades (planificación de producción)">
                        <div class="text-muted small mb-2">
                            Parámetros del cálculo de necesidades de producción: factor de stock
                            de seguridad y almacenes considerados.
                        </div>
                        <field name="safety_factor"/>
                        <field name="planning_warehouse_id" options="{'no_create': True}"/>
                        <field name="manufacturing_warehouse_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Modos de abastecimiento (tipos de origen)">
                        <div class="text-muted small mb-2">
                            Cada tipo de origen indica cómo lo planifica el motor:
                            <b>Fabricar</b> (lógica de producción interna) o <b>Comprar</b>
                            (lógica de proveedor). Los que quedan en blanco no se planifican.
                        </div>
                        <button name="%(action_mrp_product_type)d" type="action"
                                string="Gestionar tipos de origen" class="btn-link"
                                icon="fa-arrow-right"/>
                    </group>
                    <group string="Mantenimiento">
                        <div class="text-muted small mb-2">
                            Recorre la BOM una sola vez y guarda, en cada artículo, el componente
                            fabricado (producción interna) y el componente que se compra (compra-venta). El
                            panel usa esos campos precalculados y no explora la BOM en cada carga.
                            Conviene correrlo tras cambios en listas de materiales o rutas.
                        </div>
                        <button name="action_recompute_planning_sources" type="object"
                                string="Recalcular planificación" class="btn-primary"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción: abre el singleton de config apuntando a la vista de scheduling ── -->
    <record id="action_mrp_scheduling_config" model="ir.actions.act_window">
        <field name="name">Configuración de planificación</field>
        <field name="res_model">mrp.reschedule.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_scheduling_config_form_view"/>
        <field name="res_id" ref="odoo_mrp_planner.mrp_reschedule_config_singleton"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False, 'no_pager': 1}</field>
    </record>

</odoo>
