<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista propia de configuración del módulo de Planificación ── -->
    <record id="mrp_scheduling_config_form_view" model="ir.ui.view">
        <field name="name">mrp.reschedule.config.scheduling.form</field>
        <field name="model">mrp.reschedule.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de planificación" create="false" delete="false">
                <sheet>
                    <h2>Planificación</h2>

                    <!-- ══ HABILITACIÓN MAESTRA ══════════════════════════════════ -->
                    <group string="Activación">
                        <field name="enable_scheduling" widget="scheduling_toggle" nolabel="1"/>
                        <div class="text-muted small border-start border-2 ps-2 mt-1">
                            <p class="mb-1">
                                Interruptor maestro del módulo de Planificación. Instalar el
                                módulo <b>no</b> lo activa: se habilita desde aquí.
                            </p>
                            <p class="mb-0">
                                Cuando está <b>desactivado</b> se ocultan el menú de
                                Planificación y la pestaña de centros de trabajo de los
                                artículos para los usuarios no administradores.
                            </p>
                        </div>
                    </group>

                    <!-- Nota: las opciones del reprogramador en cascada (fallback de CT,
                         prioridad, heurística) se retiran de la UI mientras esa función
                         está aparcada. Los campos siguen en el modelo. -->
                    <group string="Motor de necesidades (planificación de producción)">
                        <div class="text-muted small mb-2">
                            Parámetros del cálculo de necesidades de producción: factor de stock
                            de seguridad, almacén cuyo stock se considera, y qué tipo de artículo
                            es de producción interna.
                        </div>
                        <field name="safety_factor"/>
                        <field name="planning_warehouse_id" options="{'no_create': True}"/>
                        <field name="manufacturing_type_id" options="{'no_create': True}"/>
                        <field name="manufacturing_warehouse_id" options="{'no_create': True}"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción: abre el singleton de config apuntando a la vista de scheduling ── -->
    <record id="action_mrp_scheduling_config" model="ir.actions.act_window">
        <field name="name">Configuración de planificación</field>
        <field name="res_model">mrp.reschedule.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mrp_scheduling_config_form_view"/>
        <field name="res_id" ref="odoo_mrp_planner.mrp_reschedule_config_singleton"/>
        <field name="target">current</field>
        <field name="context">{'create': False, 'delete': False, 'no_pager': 1}</field>
    </record>

</odoo>
