<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="seq_mrp_reschedule_plan" model="ir.sequence">
            <field name="name">Plan de reprogramación en cascada</field>
            <field name="code">mrp.reschedule.plan</field>
            <field name="prefix">RESCH/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- ── Vista búsqueda de planes ── -->
    <record id="mrp_reschedule_plan_search" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.search</field>
        <field name="model">mrp.reschedule.plan</field>
        <field name="arch" type="xml">
            <search string="Buscar planes">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="Borrador"   name="draft"      domain="[('state','=','draft')]"/>
                <filter string="Calculados" name="calculated" domain="[('state','=','calculated')]"/>
                <filter string="Aplicados"  name="applied"    domain="[('state','=','applied')]"/>
                <separator/>
                <filter string="Archivados" name="archived"   domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado"       name="group_state"       context="{'group_by': 'state'}"/>
                    <filter string="Orden pivot"  name="group_production"  context="{'group_by': 'production_id'}"/>
                    <filter string="Aplicado por" name="group_applied_by"  context="{'group_by': 'applied_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Vista lista de planes ── -->
    <record id="mrp_reschedule_plan_list" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.list</field>
        <field name="model">mrp.reschedule.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de reprogramación" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="production_id" optional="show"/>
                <field name="replan_from" optional="show"/>
                <field name="new_finish_date" optional="show"/>
                <field name="delta_display"/>
                <field name="line_count" string="Líneas"/>
                <field name="applied_date" optional="show"/>
                <field name="applied_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'calculated'"
                       decoration-success="state == 'applied'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="create_uid" optional="hide"/>
                <field name="create_date" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Vista formulario del plan ── -->
    <record id="mrp_reschedule_plan_form" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.form</field>
        <field name="model">mrp.reschedule.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de reprogramación en cascada">

                <header>
                    <button name="action_calculate"
                            type="object"
                            string="Calcular"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apply"
                            type="object"
                            string="Aplicar cambios"
                            class="btn-primary"
                            groups="odoo_mrp_planner.group_prod,odoo_mrp_planner.group_admin,base.group_system"
                            invisible="state != 'calculated'"
                            confirm="¿Confirmar la reprogramación? Esta acción actualizará las fechas de las órdenes de fabricación y compra marcadas."/>
                    <button name="action_reset_draft"
                            type="object"
                            string="Recalcular"
                            class="btn-secondary"
                            invisible="state != 'calculated'"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancelar plan"
                            class="btn-secondary"
                            invisible="state in ('applied', 'cancelled')"
                            confirm="¿Cancelar este plan? Las líneas calculadas serán eliminadas y el plan pasará a estado Cancelado de forma definitiva. Para rehacer la programación deberá crear un nuevo plan."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,applied,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_gantt"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o"
                                invisible="state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="line_count"/>
                                </span>
                                <span class="o_stat_text">Gantt propuesto</span>
                            </div>
                        </button>
                        <button name="action_open_current_gantt"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                invisible="state == 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Gantt</span>
                                <span class="o_stat_text">actual</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Configuración">
                            <field name="production_id"
                                   domain="[('state', 'in', ['confirmed', 'progress', 'to_close'])]"
                                   readonly="state in ('applied', 'cancelled')"/>
                            <field name="new_finish_date"
                                   invisible="not production_id"
                                   readonly="state in ('applied', 'cancelled')"/>
                            <field name="replan_from"
                                   invisible="production_id"
                                   readonly="state in ('applied', 'cancelled')"/>
                            <field name="delta_display" readonly="1"/>
                        </group>
                        <group string="Aplicación" invisible="state != 'applied'">
                            <field name="applied_date" readonly="1"/>
                            <field name="applied_by" readonly="1"/>
                        </group>
                    </group>

                    <field name="line_ids"
                           readonly="state in ('applied', 'cancelled')"
                           nolabel="1">
                        <list string="Líneas"
                              editable="bottom"
                              decoration-muted="is_anchor and not forced_start_date"
                              decoration-bf="level == 0 and record_type == 'mrp'"
                              decoration-info="record_type == 'mrp' and not warning_type and not is_anchor"
                              decoration-warning="record_type == 'purchase' and not warning_type"
                              decoration-danger="warning_type == 'confirmed_po'"
                              decoration-success="warning_type == 'child_adjusted'">

                            <!-- FIX [FASE-6]: reschedule_sequence solo puede aparecer una vez; el widget handle ya gestiona el orden -->
                            <field name="reschedule_sequence"
                                   widget="handle"
                                   readonly="level != 0 or record_type != 'mrp' or is_anchor"/>
                            <field name="type_label"
                                   string="Tipo"
                                   readonly="1"/>
                            <field name="apply"
                                   string="Aplicar"
                                   readonly="is_anchor and not forced_start_date"/>
                            <field name="is_anchor"
                                   string="Fijo"
                                   readonly="record_type != 'mrp'"
                                   widget="boolean_toggle"/>
                            <field name="forced_start_date"
                                   string="Inicio forzado"
                                   readonly="not is_anchor or record_type != 'mrp'"
                                   optional="show"/>
                            <field name="record_label"
                                   string="Referencia"
                                   readonly="1"/>
                            <field name="description_label"
                                   string="Producto / Proveedor"
                                   readonly="1"/>
                            <field name="product_qty_display"
                                   string="Cantidad"
                                   readonly="1"
                                   optional="show"/>
                            <field name="workcenter_label"
                                   string="Centros de trabajo"
                                   readonly="1"
                                   optional="show"/>
                            <field name="duration_hours"
                                   string="Duración (hs)"
                                   readonly="record_type != 'mrp' or is_anchor"
                                   optional="show"/>
                            <field name="current_date_finish"
                                   string="Fin actual"
                                   readonly="1"/>
                            <field name="new_date_finish"
                                   string="Nuevo fin"
                                   readonly="1"/>
                            <field name="date_delta_display"
                                   string="Δ Tiempo"
                                   readonly="1"/>
                            <field name="state_display"
                                   string="Estado"
                                   readonly="1"/>
                            <field name="warning_message"
                                   string="Advertencia"
                                   readonly="1"
                                   optional="show"/>

                            <field name="record_type"        column_invisible="True"/>
                            <field name="level"              column_invisible="True"/>
                            <field name="warning_type"       column_invisible="True"/>
                            <field name="production_id"      column_invisible="True"/>
                            <field name="purchase_id"        column_invisible="True"/>
                            <field name="current_date_start" column_invisible="True"/>
                            <field name="new_date_start"     column_invisible="True"/>
                        </list>
                    </field>
                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- ── Vista Gantt del estado ACTUAL (antes del replan) ── -->
    <record id="mrp_reschedule_plan_line_gantt_current" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.line.gantt.current</field>
        <field name="model">mrp.reschedule.plan.line</field>
        <field name="arch" type="xml">
            <gantt date_start="current_date_start"
                   date_stop="current_date_finish"
                   string="Estado actual (antes del replan)"
                   default_scale="day"
                   color="color"
                   create="0"
                   edit="0"
                   delete="0">
                <field name="record_label"/>
                <field name="description_label"/>
                <field name="workcenter_label"/>
                <field name="product_qty_display"/>
                <field name="state_display"/>
                <field name="color"/>
            </gantt>
        </field>
    </record>

    <!-- ── Vista Gantt de líneas ── -->
    <record id="mrp_reschedule_plan_line_gantt" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.line.gantt</field>
        <field name="model">mrp.reschedule.plan.line</field>
        <field name="arch" type="xml">
            <gantt date_start="new_date_start"
                   date_stop="new_date_finish"
                   string="Cambios propuestos"
                   default_scale="day"
                   color="color"
                   create="0"
                   edit="0"
                   delete="0">
                <field name="record_label"/>
                <field name="description_label"/>
                <field name="workcenter_label"/>
                <field name="product_qty_display"/>
                <field name="current_date_finish"/>
                <field name="state_display"/>
                <field name="color"/>
            </gantt>
        </field>
    </record>

    <!-- ── Vista lista de líneas WC ── -->
    <record id="mrp_reschedule_wc_line_list" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.wc.line.list</field>
        <field name="model">mrp.reschedule.plan.wc.line</field>
        <field name="arch" type="xml">
            <list string="Carga de centros de trabajo" create="0" edit="0" delete="0">
                <field name="plan_name"     string="Plan"/>
                <field name="plan_state"    string="Estado plan" widget="badge"
                       decoration-info="plan_state == 'calculated'"
                       decoration-success="plan_state == 'applied'"/>
                <field name="workcenter_id" string="Centro de trabajo"/>
                <field name="record_label"  string="OF"/>
                <field name="wo_name"       string="Operación"/>
                <field name="new_date_start"  string="Inicio propuesto"/>
                <field name="new_date_finish" string="Fin propuesto"/>
            </list>
        </field>
    </record>

    <!-- ── Vista Gantt de carga de WC ── -->
    <record id="mrp_reschedule_wc_line_gantt" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.wc.line.gantt</field>
        <field name="model">mrp.reschedule.plan.wc.line</field>
        <field name="arch" type="xml">
            <gantt date_start="new_date_start"
                   date_stop="new_date_finish"
                   string="Carga de centros de trabajo (propuesto)"
                   default_scale="day"
                   color="color"
                   create="0"
                   edit="0"
                   delete="0">
                <field name="record_label"/>
                <field name="wo_name"/>
                <field name="plan_name"/>
                <field name="plan_state"/>
                <field name="workcenter_id"/>
                <field name="color"/>
            </gantt>
        </field>
    </record>

    <!-- ── Vista Gantt global de líneas (árbol de órdenes) ── -->
    <record id="mrp_reschedule_plan_line_gantt_global" model="ir.ui.view">
        <field name="name">mrp.reschedule.plan.line.gantt.global</field>
        <field name="model">mrp.reschedule.plan.line</field>
        <field name="arch" type="xml">
            <gantt date_start="new_date_start"
                   date_stop="new_date_finish"
                   string="Árbol de órdenes (propuesto)"
                   default_scale="day"
                   color="color"
                   create="0"
                   edit="0"
                   delete="0">
                <field name="record_label"/>
                <field name="description_label"/>
                <field name="type_label"/>
                <field name="current_date_finish"/>
                <field name="plan_id"/>
                <field name="color"/>
            </gantt>
        </field>
    </record>

    <!-- ── Acción lista de planes ── -->
    <record id="action_mrp_reschedule_plan" model="ir.actions.act_window">
        <field name="name">Planes de reprogramación</field>
        <field name="res_model">mrp.reschedule.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mrp_reschedule_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un plan de reprogramación
            </p>
            <p>
                <strong>Modo pivot:</strong> seleccioná una orden de fabricación, fijá su nueva
                fecha de fin y calculá el impacto en cascada sobre las órdenes subsecuentes.
            </p>
            <p>
                <strong>Modo global:</strong> dejá la orden pivot vacía y fijá una fecha de inicio
                para reprogramar todas las órdenes activas de forma óptima.
            </p>
        </field>
    </record>

    <!-- ── Menús bajo "Planificador" (root definido en mrp_reschedule_alert_views.xml) ── -->
    <menuitem id="mrp_reschedule_menu_plans"
              name="Reprogramación"
              parent="mrp_produccion_menu"
              sequence="20"
              action="action_mrp_reschedule_plan"
              groups="odoo_mrp_planner.group_scheduling,odoo_mrp_planner.group_admin"/>

</odoo>
