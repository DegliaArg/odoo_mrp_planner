<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="odoo_mrp_planner.PurchaseAnalysisWidget">
    <div class="o_purchase_analysis_widget">

        <!-- ── Filtros ─────────────────────────────────────────────────────── -->
        <div class="o_pca_filters card mb-3 border-0 bg-light px-3 py-2">
            <div class="d-flex align-items-center gap-3 flex-wrap">

                <!-- Sector -->
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold">Sector:</span>
                    <select class="form-select form-select-sm" style="width:auto;min-width:180px"
                            t-on-change="onTagChange">
                        <option value="">Seleccionar sector…</option>
                        <t t-foreach="state.tags" t-as="tag" t-key="tag.id">
                            <option t-att-value="tag.id"
                                    t-att-selected="state.tagIds.length &amp;&amp; state.tagIds[0] == tag.id">
                                <t t-esc="tag.name"/>
                            </option>
                        </t>
                    </select>
                    <t t-if="!state.tags.length">
                        <span class="text-muted small fst-italic">Sin sectores configurados</span>
                    </t>
                </div>

                <!-- CT (se habilita cuando hay sector seleccionado) -->
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small fw-semibold">CT:</span>
                    <select class="form-select form-select-sm" style="width:auto;min-width:180px"
                            t-att-disabled="!state.tagIds.length"
                            t-on-change="onWcChange">
                        <option value="">Todos</option>
                        <t t-foreach="state.wcs" t-as="wc" t-key="wc.id">
                            <option t-att-value="wc.id"
                                    t-att-selected="state.wcFilterId == wc.id">
                                <t t-esc="wc.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <!-- Toggle terminadas -->
                <button t-att-class="'btn btn-sm ' + (state.hideFinished ? 'btn-warning' : 'btn-outline-secondary')"
                        t-on-click="toggleHideFinished"
                        title="Mostrar u ocultar OFs ya terminadas">
                    <i t-att-class="'fa me-1 ' + (state.hideFinished ? 'fa-eye-slash' : 'fa-eye')"/>
                    Terminadas
                </button>

                <!-- Fechas (al final, separadas del resto) -->
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <span class="text-muted small fw-semibold">OT desde:</span>
                    <input type="date" class="form-control form-control-sm" style="width:145px"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                    <span class="text-muted small">hasta:</span>
                    <input type="date" class="form-control form-control-sm" style="width:145px"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>

            </div>
        </div>

        <!-- ── Sin sector seleccionado ────────────────────────────────────── -->
        <t t-if="!state.tagIds.length &amp;&amp; !state.loading">
            <div class="text-center text-muted py-5">
                <i class="fa fa-filter fa-2x mb-2 d-block"/>
                <p class="mb-0">Seleccioná un sector para ver el análisis.</p>
            </div>
        </t>

        <!-- ── Loading ─────────────────────────────────────────────────────── -->
        <t t-if="state.loading">
            <div class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x mb-2 d-block"/>
                <p class="mb-0">Cargando…</p>
            </div>
        </t>

        <!-- ── Error ───────────────────────────────────────────────────────── -->
        <t t-if="state.error &amp;&amp; !state.loading">
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-triangle me-1"/>
                <t t-esc="state.error"/>
            </div>
        </t>

        <!-- ── Sin resultados ──────────────────────────────────────────────── -->
        <t t-if="!state.loading &amp;&amp; !state.error &amp;&amp; state.tagIds.length &amp;&amp; !filteredWcRows().length">
            <div class="text-center text-muted py-5">
                <i class="fa fa-inbox fa-2x mb-2 d-block"/>
                <p class="mb-0">No hay OTs del sector en el período seleccionado.</p>
            </div>
        </t>

        <!-- ── Tabla CT × Semana ───────────────────────────────────────────── -->
        <t t-if="!state.loading &amp;&amp; filteredWcRows().length">

            <div class="table-responsive mb-3">
                <table class="table table-bordered table-sm o_pca_matrix" style="min-width:500px">
                    <thead class="table-light">
                        <tr>
                            <th class="o_pca_wc_header" style="min-width:150px;vertical-align:middle">
                                Centro de trabajo
                            </th>
                            <t t-foreach="state.weekKeys" t-as="wk" t-key="wk">
                                <th class="text-center o_pca_week_header" style="min-width:140px">
                                    <div class="fw-bold">
                                        <t t-esc="state.weekLabels[wk].label"/>
                                        <span class="text-muted fw-normal ms-1">
                                            <t t-esc="state.weekLabels[wk].year"/>
                                        </span>
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem">
                                        <t t-esc="fmtDate(state.weekLabels[wk].date_from)"/>
                                        <span> – </span>
                                        <t t-esc="fmtDate(state.weekLabels[wk].date_to)"/>
                                    </div>
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="filteredWcRows()" t-as="row" t-key="row.wc_id">
                            <tr>
                                <td class="o_pca_wc_cell fw-semibold align-middle" style="background:#f8f9fa">
                                    <t t-esc="row.wc_name"/>
                                </td>
                                <t t-foreach="state.weekKeys" t-as="wk" t-key="wk">
                                    <td class="o_pca_cell align-top p-1">
                                        <t t-foreach="row.cells[wk]" t-as="mo" t-key="mo.wo_id">
                                            <div t-att-class="'o_pca_mo_chip rounded p-1 mb-1 border ' + (state.activeMoId == mo.mo_id ? 'border-primary bg-primary bg-opacity-10' : (mo.has_late_pos ? 'border-danger' : 'border-light bg-light'))"
                                                 style="cursor:pointer;font-size:0.8rem"
                                                 t-on-click="() => this.selectMo(mo)">
                                                <div class="d-flex align-items-center gap-1">
                                                    <i t-att-class="'fa fa-fw fa-xs ' + moAlertIcon(mo) + ' ' + moAlertClass(mo)"/>
                                                    <span class="fw-semibold text-truncate flex-grow-1" style="max-width:100px" t-esc="mo.mo_name"/>
                                                    <button class="btn p-0 ms-auto o_pca_chip_open"
                                                            title="Abrir OF"
                                                            t-on-click.stop="() => this.openMo(mo)">
                                                        <i class="fa fa-external-link fa-xs text-muted"/>
                                                    </button>
                                                </div>
                                                <div class="text-muted text-truncate" style="font-size:0.72rem;max-width:130px" t-esc="mo.product_name"/>
                                                <div class="d-flex align-items-center gap-2 mt-1" style="font-size:0.72rem">
                                                    <span t-att-class="moStateClass(mo.state)" t-esc="mo.state_label"/>
                                                    <span class="text-muted">
                                                        <i class="fa fa-shopping-cart fa-xs me-1"/>
                                                        <t t-esc="mo.pos_count"/>
                                                    </span>
                                                </div>

                                                <!-- Lista inline de OCs (visible solo cuando el chip está activo) -->
                                                <t t-if="state.activeMoId == mo.mo_id">
                                                    <div class="mt-1 pt-1 border-top">
                                                        <t t-if="!mo.pos.length">
                                                            <span class="text-muted fst-italic" style="font-size:0.7rem">Sin OCs</span>
                                                        </t>
                                                        <t t-foreach="mo.pos" t-as="poc" t-key="poc.po_id + '_' + poc.product">
                                                            <div class="d-flex align-items-center gap-1 mb-1" style="font-size:0.7rem">
                                                                <i t-att-class="'fa fa-xs fa-fw ' + (poc.is_late ? 'fa-exclamation-triangle text-danger' : 'fa-minus text-muted')"/>
                                                                <span class="text-truncate flex-grow-1" style="max-width:85px" t-esc="poc.product"/>
                                                                <span t-att-class="poStateClass(poc.state)" style="font-size:0.65rem;padding:1px 4px;flex-shrink:0" t-esc="poc.state_label"/>
                                                            </div>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- ── Panel de detalle: OCs de la OF seleccionada ─────────────── -->
            <t t-if="state.activeMoData">
                <div class="o_pca_detail card border-primary mb-3">
                    <div class="card-header d-flex align-items-center gap-2 py-2 bg-primary bg-opacity-10">
                        <i class="fa fa-industry text-primary"/>
                        <span class="fw-bold text-primary" t-esc="state.activeMoData.mo_name"/>
                        <span class="text-muted">–</span>
                        <span t-esc="state.activeMoData.product_name"/>
                        <span class="text-muted small">
                            (<t t-esc="fmtQty(state.activeMoData.qty)"/>
                            <span class="ms-1"><t t-esc="state.activeMoData.uom"/></span>)
                        </span>
                        <span t-att-class="moStateClass(state.activeMoData.state)" t-esc="state.activeMoData.state_label"/>
                        <button class="btn btn-sm btn-link p-0" title="Abrir OF"
                                t-on-click="() => this.openMo(state.activeMoData)">
                            <i class="fa fa-external-link"/>
                        </button>
                        <button class="btn btn-sm btn-link text-muted ms-auto p-0" title="Cerrar"
                                t-on-click="closeMoDetail">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <t t-if="!state.activeMoData.pos.length">
                            <div class="px-4 py-3 text-muted fst-italic small">
                                Sin órdenes de compra encontradas en la cadena MTO.
                            </div>
                        </t>
                        <t t-if="state.activeMoData.pos.length">
                            <table class="table table-sm table-hover mb-0" style="font-size:0.82rem">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">OC</th>
                                        <th>Proveedor</th>
                                        <th>Componente</th>
                                        <th class="text-center">F. Entrega</th>
                                        <th class="text-end">Pedido</th>
                                        <th class="text-end">Recibido</th>
                                        <th class="text-center">%</th>
                                        <th class="text-center">Estado</th>
                                        <th/>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.activeMoData.pos" t-as="po" t-key="po.po_id + '_' + po.product">
                                        <tr t-att-class="rowClass(po)">
                                            <td class="ps-3" style="white-space:nowrap">
                                                <t t-esc="po.po_name"/>
                                                <t t-if="po.is_subcontract">
                                                    <span class="badge bg-info text-dark ms-1" title="Subcontratación">SC</span>
                                                </t>
                                            </td>
                                            <td t-esc="po.partner"/>
                                            <td class="text-muted" t-esc="po.product"/>
                                            <td class="text-center">
                                                <t t-if="po.is_late">
                                                    <span class="text-danger fw-semibold">
                                                        <i class="fa fa-exclamation-triangle me-1"/>
                                                        <t t-esc="fmtDate(po.date_planned)"/>
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="fmtDate(po.date_planned)"/>
                                                </t>
                                            </td>
                                            <td class="text-end" t-esc="fmtQty(po.qty_ordered)"/>
                                            <td class="text-end" t-esc="fmtQty(po.qty_received)"/>
                                            <td class="text-center">
                                                <t t-if="po.pct_received >= 100">
                                                    <span class="text-success fw-semibold">
                                                        <i class="fa fa-check me-1"/>100%
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="fmtPct(po.pct_received)"/>
                                                </t>
                                            </td>
                                            <td class="text-center">
                                                <span t-att-class="poStateClass(po.state)" t-esc="po.state_label"/>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-link p-0"
                                                        title="Abrir OC"
                                                        t-on-click="() => this.openPo(po)">
                                                    <i class="fa fa-external-link"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </t>

        </t>
        <!-- fin contenido -->

    </div>
</t>

</templates>
