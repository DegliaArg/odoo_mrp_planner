<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Lista ──────────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_list" model="ir.ui.view">
        <field name="name">mrp.forecast.line.list</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <list string="Forecast" editable="bottom" default_order="period desc, product_id">
                <field name="period" widget="date" string="Período" options="{'datepicker': {'defaultView': 'months', 'minViewMode': 'months'}}"/>
                <field name="period_display" string="Mes" readonly="1"/>
                <field name="product_id" domain="[('sale_ok', '=', True)]"/>
                <field name="forecast_qty" string="Cantidad forecast"/>
                <field name="uom_id" string="Unidad" readonly="1"/>
                <field name="company_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ── Formulario ────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_form" model="ir.ui.view">
        <field name="name">mrp.forecast.line.form</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <form string="Línea de forecast">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id" domain="[('sale_ok', '=', True)]"/>
                            <field name="forecast_qty"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="period"/>
                            <field name="period_display" readonly="1"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Búsqueda ──────────────────────────────────────────────────────── -->
    <record id="mrp_forecast_line_search" model="ir.ui.view">
        <field name="name">mrp.forecast.line.search</field>
        <field name="model">mrp.forecast.line</field>
        <field name="arch" type="xml">
            <search string="Forecast">
                <field name="product_id"/>
                <field name="period"/>
                <separator/>
                <filter string="Este mes" name="this_month"
                        domain="[('period', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                  ('period', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="Próximos 3 meses" name="next_3m"
                        domain="[('period', '&gt;=', context_today().strftime('%Y-%m-01')),
                                  ('period', '&lt;=', (context_today() + relativedelta(months=2, day=31)).strftime('%Y-%m-%d'))]"/>
                <!-- Nota: relativedelta(months=2, day=31) produce el último día del tercer mes
                     completo (julio=hoy → fin = sep-30), cubriendo correctamente 3 meses. -->
                <group expand="0" string="Agrupar por">
                    <filter string="Artículo"   name="by_product"   context="{'group_by': 'product_id'}"/>
                    <filter string="Período"    name="by_period"    context="{'group_by': 'period:month'}"/>
                    <filter string="Empresa"    name="by_company"   context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Acción principal (líneas) ─────────────────────────────────────── -->
    <record id="action_mrp_forecast_line" model="ir.actions.act_window">
        <field name="name">Forecast de Ventas</field>
        <field name="res_model">mrp.forecast.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_next_3m': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay líneas de forecast aún.
            </p>
            <p>
                Cargá manualmente o usá el botón <strong>Importar desde Excel</strong> para cargar datos en bloque.
            </p>
        </field>
    </record>

    <!-- ── Vista del panel de Ventas ────────────────────────────────────── -->
    <record id="mrp_ventas_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.ventas.dashboard.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel de Ventas" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- Encabezado -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Panel de Ventas</h4>
                            </div>
                            <div class="col-auto">
                                <button name="action_refresh" type="object"
                                        string="Actualizar"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                            <field name="can_see_forecast"     invisible="1"/>
                            <field name="can_edit_forecast"    invisible="1"/>
                            <field name="show_sales_chart_sec" invisible="1"/>
                            <field name="show_forecast_sec"    invisible="1"/>
                        </div>

                        <!-- PRODUCTOS MÁS VENDIDOS -->
                        <div class="o_planner_section mb-4" invisible="not show_sales_chart_sec">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-bar-chart me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Productos más vendidos</span>
                            </div>
                            <widget name="sales_chart_widget"/>
                        </div>

                        <!-- FORECAST -->
                        <div class="o_planner_section mb-4" invisible="not can_see_forecast or not show_forecast_sec">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-table me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Forecast</span>
                            </div>
                            <widget name="forecast_widget"/>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Vista Análisis de Clientes ──────────────────────────────────── -->
    <record id="mrp_customer_analysis_form" model="ir.ui.view">
        <field name="name">mrp.customer.analysis.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Análisis de Clientes" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Análisis de Clientes</h4>
                            </div>
                            <field name="show_customer_analysis_sec" invisible="1"/>
                        </div>

                        <div class="o_planner_section mb-4" invisible="not show_customer_analysis_sec">
                            <div class="o_planner_section_title mb-3">
                                <i class="fa fa-users me-2 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Clientes</span>
                            </div>
                            <widget name="customer_analysis_widget"/>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción de servidor: Análisis de Clientes ──────────────────────── -->
    <record id="action_mrp_customer_analysis_open" model="ir.actions.server">
        <field name="name">Análisis de Clientes</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_customer_analysis()</field>
    </record>

    <!-- ── Acción de servidor para abrir el panel de Ventas ──────────────── -->
    <record id="action_mrp_ventas_dashboard_open" model="ir.actions.server">
        <field name="name">Panel de Ventas</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_ventas()</field>
    </record>

    <!-- ── Barra superior 2: Ventas (hijo del app root, NO app separada) ─── -->
    <menuitem id="mrp_ventas_menu"
              name="Ventas"
              parent="mrp_planner_menu_root"
              sequence="20"
              groups="odoo_mrp_planner.group_sales_read,odoo_mrp_planner.group_sales,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_ventas_panel_menu"
              name="Panel de Ventas"
              parent="mrp_ventas_menu"
              sequence="1"
              action="action_mrp_ventas_dashboard_open"
              groups="odoo_mrp_planner.group_sales_read,odoo_mrp_planner.group_sales,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_ventas_customer_analysis_menu"
              name="Análisis de Clientes"
              parent="mrp_ventas_menu"
              sequence="3"
              action="action_mrp_customer_analysis_open"
              groups="odoo_mrp_planner.group_sales_read,odoo_mrp_planner.group_sales,odoo_mrp_planner.group_admin,base.group_system"/>

    <menuitem id="mrp_ventas_forecast_lineas_menu"
              name="Líneas de Forecast"
              parent="mrp_ventas_menu"
              sequence="5"
              action="action_mrp_forecast_line"
              groups="odoo_mrp_planner.group_sales_read,odoo_mrp_planner.group_sales,odoo_mrp_planner.group_admin,base.group_system"/>

</odoo>
