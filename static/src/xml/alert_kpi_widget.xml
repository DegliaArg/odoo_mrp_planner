<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.AlertKpiWidget">
        <div t-att-class="'o_alert_kpi_widget' + (state.loading ? ' opacity-50 pe-none' : '')">

            <!-- Filtro de estados -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="small text-muted">Estado OF:</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Filtro de estados de OF">
                    <button type="button"
                            title="Confirmada — OF planificada, sin iniciar producción"
                            t-att-class="'btn ' + (isStateActive('confirmed') ? 'btn-info' : 'btn-outline-info')"
                            t-on-click="() => onStateToggle('confirmed')">
                        Confirmada
                    </button>
                    <button type="button"
                            title="En progreso — producción formalmente iniciada"
                            t-att-class="'btn ' + (isStateActive('progress') ? 'btn-primary' : 'btn-outline-primary')"
                            t-on-click="() => onStateToggle('progress')">
                        En progreso
                    </button>
                    <button type="button"
                            title="Por cerrar — producción completa pendiente de cierre formal"
                            t-att-class="'btn ' + (isStateActive('to_close') ? 'btn-warning text-dark' : 'btn-outline-warning')"
                            t-on-click="() => onStateToggle('to_close')">
                        Por cerrar
                    </button>
                </div>
            </div>

            <!-- KPI cards -->
            <div class="row g-2">

                <div class="col-6 col-md-3">
                    <div class="card o_planner_card h-100"
                         title="OFs activas cuya fecha de fin planificada ya superó la fecha actual. El sistema genera esta alerta automáticamente cuando date_finished &lt; hoy. Indica retrasos que requieren acción inmediata.">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-clock-o fa-lg text-secondary mb-2 d-block"/>
                            <div class="o_planner_number" t-esc="fmt(state.kpis.mo_delayed)"/>
                            <div class="o_planner_label">OFs atrasadas</div>
                        </div>
                        <div class="card-footer p-0">
                            <button t-if="state.kpis.mo_delayed > 0"
                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                    t-on-click="onViewDelayed">Ver →</button>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card o_planner_card h-100"
                         title="OFs activas con fecha de fin próxima a vencer, dentro del horizonte de advertencia configurado en los parámetros del planificador. Permite anticipar retrasos antes de que ocurran.">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-hourglass-half fa-lg text-warning mb-2 d-block"/>
                            <div class="o_planner_number text-warning" t-esc="fmt(state.kpis.mo_upcoming)"/>
                            <div class="o_planner_label">OFs por vencer</div>
                        </div>
                        <div class="card-footer p-0">
                            <button t-if="state.kpis.mo_upcoming > 0"
                                    class="btn btn-sm btn-link w-100 py-1 text-warning"
                                    t-on-click="onViewUpcoming">Ver →</button>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card o_planner_card h-100"
                         title="OFs completadas donde la cantidad producida difiere de la cantidad planificada más allá de la tolerancia configurada. Indica desvíos en la producción que pueden afectar inventario o entregas.">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-balance-scale fa-lg text-secondary mb-2 d-block"/>
                            <div class="o_planner_number" t-esc="fmt(state.kpis.qty_mismatch)"/>
                            <div class="o_planner_label">Cant. diferentes</div>
                        </div>
                        <div class="card-footer p-0">
                            <button t-if="state.kpis.qty_mismatch > 0"
                                    class="btn btn-sm btn-link w-100 py-1 text-secondary"
                                    t-on-click="onViewMismatch">Ver →</button>
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="card o_planner_card h-100"
                         title="OFs que fueron canceladas mientras tenían materiales reservados u operaciones pendientes. Requieren revisión para liberar recursos, reasignar demanda o replanificar.">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-ban fa-lg text-muted mb-2 d-block"/>
                            <div class="o_planner_number" t-esc="fmt(state.kpis.mo_cancelled)"/>
                            <div class="o_planner_label">OFs canceladas</div>
                        </div>
                        <div class="card-footer p-0">
                            <button t-if="state.kpis.mo_cancelled > 0"
                                    class="btn btn-sm btn-link w-100 py-1 text-muted"
                                    t-on-click="onViewCancelled">Ver →</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
