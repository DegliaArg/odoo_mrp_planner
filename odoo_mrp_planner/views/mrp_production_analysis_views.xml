<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vista del Panel de Análisis de producción ──────────────────────── -->
    <record id="mrp_production_analysis_form" model="ir.ui.view">
        <field name="name">mrp.production.analysis.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Análisis de producción" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">

                        <!-- Encabezado -->
                        <div class="row align-items-center mb-4 pb-3 o_planner_header">
                            <div class="col">
                                <h4 class="mb-0 fw-bold">Análisis de producción</h4>
                            </div>
                            <div class="col-auto d-flex gap-2 align-items-center">
                                <widget name="refresh_stamp"/>
                                <button name="action_refresh_production_analysis" type="object"
                                        string="Actualizar"
                                        class="btn btn-outline-primary btn-sm"/>
                            </div>
                        </div>

                        <widget name="production_analysis_widget"/>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Acción de servidor para abrir el panel ─────────────────────────── -->
    <record id="action_mrp_production_analysis_open" model="ir.actions.server">
        <field name="name">Análisis de producción</field>
        <field name="model_id" ref="odoo_mrp_planner.model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_production_analysis()</field>
    </record>

    <!-- Submenú bajo Producción (se suma; el Panel de Producción queda igual) -->
    <menuitem id="mrp_produccion_analisis_menu"
              name="Análisis de producción"
              parent="odoo_mrp_planner.mrp_planeacion_menu"
              sequence="2"
              action="action_mrp_production_analysis_open"
              groups="odoo_mrp_planner.group_prod_read,odoo_mrp_planner.group_prod,odoo_mrp_planner.group_admin,base.group_system"/>

</odoo>
