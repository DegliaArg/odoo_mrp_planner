<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         ACCIÓN SERVIDOR — Inicio (mosaico de paneles)
    ════════════════════════════════════════════════════════════════════ -->
    <record id="action_mrp_planner_home_open" model="ir.actions.server">
        <field name="name">Inicio</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_home()</field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         VISTA FORM — Inicio
    ════════════════════════════════════════════════════════════════════ -->
    <record id="mrp_home_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.home.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Inicio" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard container-fluid p-4">
                        <widget name="home_launcher_widget"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         MENÚ — Inicio (primero: el módulo aterriza acá por defecto)
    ════════════════════════════════════════════════════════════════════ -->
    <menuitem id="mrp_home_menu"
              name="Inicio"
              parent="mrp_planner_menu_root"
              sequence="1"
              action="action_mrp_planner_home_open"
              groups="odoo_mrp_planner.group_management_read,odoo_mrp_planner.group_management,odoo_mrp_planner.group_prod_read,odoo_mrp_planner.group_prod,odoo_mrp_planner.group_purchase,odoo_mrp_planner.group_purchase_admin,odoo_mrp_planner.group_sales_read,odoo_mrp_planner.group_sales,odoo_mrp_planner.group_inventory_read,odoo_mrp_planner.group_inventory_admin,odoo_mrp_planner.group_admin,base.group_system"/>

</odoo>
