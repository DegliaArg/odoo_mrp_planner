<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="odoo_mrp_planner_scheduling.ProductionNeedsWidget">
    <div class="o_production_needs_widget">

        <!-- ════ Barra de controles (una fila, estilo KPIs) ════ -->
        <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Mes a programar</label>
                <input type="date" class="form-control form-control-sm" style="max-width:150px;"
                       t-att-value="state.targetMonth"
                       t-on-change="(ev) => this.onFilterChange('targetMonth', ev)"/>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">Promedio desde</label>
                <input type="date" class="form-control form-control-sm" style="max-width:150px;"
                       t-att-value="state.dateFrom"
                       t-on-change="(ev) => this.onFilterChange('dateFrom', ev)"/>
            </div>
            <div class="d-flex align-items-center gap-1">
                <label class="form-label mb-0 small text-muted">hasta</label>
                <input type="date" class="form-control form-control-sm" style="max-width:150px;"
                       t-att-value="state.dateTo"
                       t-on-change="(ev) => this.onFilterChange('dateTo', ev)"/>
            </div>
            <!-- Filtro de origen (multiselección) -->
            <div class="position-relative">
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                        t-on-click="() => this.toggleMenu('origin')">
                    <i class="fa fa-filter"/>Origen
                    <span t-if="state.originFilter.length" class="badge rounded-pill text-bg-primary"
                          t-esc="state.originFilter.length"/>
                    <i class="fa fa-caret-down"/>
                </button>
                <div t-if="isMenuOpen('origin')" class="card shadow position-absolute mt-1"
                     style="z-index:30; min-width:230px; max-height:320px; overflow:auto;">
                    <div class="p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-muted">Origen</span>
                            <button class="btn btn-link btn-sm p-0 text-decoration-none"
                                    t-on-click="() => this.clearOriginFilter()">Limpiar</button>
                        </div>
                        <t t-foreach="originOptions" t-as="o" t-key="o">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       t-att-id="'orig_' + o_index"
                                       t-att-checked="isOriginActive(o)"
                                       t-on-change="() => this.toggleOriginTok(o)"/>
                                <label class="form-check-label small" t-att-for="'orig_' + o_index"
                                       t-esc="o"/>
                            </div>
                        </t>
                        <div t-if="!originOptions.length" class="text-muted small">Sin datos.</div>
                    </div>
                </div>
            </div>
            <!-- Filtro de estado (multiselección) -->
            <div class="position-relative">
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                        t-on-click="() => this.toggleMenu('state')">
                    <i class="fa fa-filter"/>Estado
                    <span t-if="state.stateFilter.length" class="badge rounded-pill text-bg-primary"
                          t-esc="state.stateFilter.length"/>
                    <i class="fa fa-caret-down"/>
                </button>
                <div t-if="isMenuOpen('state')" class="card shadow position-absolute mt-1"
                     style="z-index:30; min-width:230px; max-height:320px; overflow:auto;">
                    <div class="p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-muted">Estado</span>
                            <button class="btn btn-link btn-sm p-0 text-decoration-none"
                                    t-on-click="() => this.clearStateFilter()">Limpiar</button>
                        </div>
                        <t t-foreach="stateOptions" t-as="st" t-key="st">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       t-att-id="'st_' + st_index"
                                       t-att-checked="isStateActive(st)"
                                       t-on-change="() => this.toggleStateTok(st)"/>
                                <label class="form-check-label small" t-att-for="'st_' + st_index"
                                       t-esc="st"/>
                            </div>
                        </t>
                        <div t-if="!stateOptions.length" class="text-muted small">Sin datos.</div>
                    </div>
                </div>
            </div>
            <!-- Selector de columnas (mostrar/ocultar) -->
            <div class="position-relative">
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                        t-on-click="() => this.toggleMenu('cols')">
                    <i class="fa fa-table"/>Columnas
                    <span t-if="hiddenColsCount" class="badge rounded-pill text-bg-secondary"
                          t-attf-title="{{hiddenColsCount}} ocultas" t-esc="hiddenColsCount"/>
                    <i class="fa fa-caret-down"/>
                </button>
                <div t-if="isMenuOpen('cols')" class="card shadow position-absolute mt-1"
                     style="z-index:30; min-width:240px; max-height:340px; overflow:auto;">
                    <div class="p-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-muted">Columnas visibles</span>
                            <button class="btn btn-link btn-sm p-0 text-decoration-none"
                                    t-on-click="() => this.resetCols()">Restablecer</button>
                        </div>
                        <t t-foreach="allCols" t-as="c" t-key="c.key">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       t-att-id="'col_' + c.key"
                                       t-att-checked="state.visibleCols[c.key]"
                                       t-on-change="() => this.toggleCol(c.key)"/>
                                <label class="form-check-label small" t-att-for="'col_' + c.key"
                                       t-esc="c.label"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1 flex-grow-1" style="min-width:160px;">
                <i class="fa fa-search text-muted"/>
                <input type="text" class="form-control form-control-sm"
                       placeholder="Buscar código o descripción…"
                       t-att-value="state.search"
                       t-on-input="(ev) => { state.search = ev.target.value; }"/>
            </div>
            <button class="btn btn-outline-primary btn-sm" t-on-click="() => this.load()"
                    t-att-disabled="state.loading">
                <i class="fa fa-refresh me-1"/>Actualizar
            </button>
        </div>

        <!-- ════ Cards KPI (fila de 5, estilo paneles) ════ -->
        <div class="d-flex gap-2 mb-3 flex-wrap">
            <div class="flex-fill" style="min-width:0; flex-basis:0;">
                <div class="card o_planner_card o_planner_kpi_card_lg h-100" role="button"
                     t-att-class="isCardActive('all') ? 'border-primary' : ''"
                     t-on-click="() => this.setStateFilter('all')"
                     title="Total de artículos analizados (vendibles o con forecast en la ventana).">
                    <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                        <i class="fa fa-cubes fa-lg text-secondary mb-1 d-block"/>
                        <div t-att-class="'o_planner_number ' + kpiCls(state.kpis.total)" t-esc="state.kpis.total || 0"/>
                        <div class="o_planner_label">Artículos</div>
                    </div>
                </div>
            </div>
            <div class="flex-fill" style="min-width:0; flex-basis:0;">
                <div class="card o_planner_card o_planner_kpi_card_lg h-100" role="button"
                     t-att-class="isCardActive('Programar') ? 'border-success' : ''"
                     t-on-click="() => this.setStateFilter('Programar')"
                     title="Artículos listos para disparar la OF (estado Programar).">
                    <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                        <i class="fa fa-cogs fa-lg text-success mb-1 d-block"/>
                        <div class="o_planner_number text-success" t-esc="state.kpis.a_programar || 0"/>
                        <div class="o_planner_label">A programar</div>
                    </div>
                </div>
            </div>
            <div class="flex-fill" style="min-width:0; flex-basis:0;">
                <div class="card o_planner_card o_planner_kpi_card_lg h-100" role="button"
                     t-att-class="isCardActive('necesidad') ? 'border-primary' : ''"
                     t-on-click="() => this.setStateFilter('necesidad')"
                     title="Artículos cuya posición de stock no alcanza el stock objetivo (necesidad neta > 0).">
                    <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                        <i class="fa fa-exclamation-triangle fa-lg text-secondary mb-1 d-block"/>
                        <div t-att-class="'o_planner_number ' + kpiCls(state.kpis.con_necesidad)" t-esc="state.kpis.con_necesidad || 0"/>
                        <div class="o_planner_label">Con necesidad</div>
                    </div>
                </div>
            </div>
            <div class="flex-fill" style="min-width:0; flex-basis:0;">
                <div class="card o_planner_card o_planner_kpi_card_lg h-100"
                     title="Suma de unidades sugeridas a fabricar (producción interna y compra-venta).">
                    <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                        <i class="fa fa-industry fa-lg text-secondary mb-1 d-block"/>
                        <div t-att-class="'o_planner_number ' + kpiCls(state.kpis.necesidad_fabricacion)"
                             t-esc="this.f(state.kpis.necesidad_fabricacion)"/>
                        <div class="o_planner_label">Necesidad a fabricar (u.)</div>
                    </div>
                </div>
            </div>
            <div class="flex-fill" style="min-width:0; flex-basis:0;">
                <div class="card o_planner_card o_planner_kpi_card_lg h-100" role="button"
                     t-att-class="isCardActive('Revisar') ? 'border-warning' : ''"
                     t-on-click="() => this.setStateFilter('Revisar')"
                     title="Artículos que requieren revisión de datos (origen, máquina, mínimo, cantidad).">
                    <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                        <i class="fa fa-wrench fa-lg text-warning mb-1 d-block"/>
                        <div class="o_planner_number text-warning" t-esc="state.kpis.a_revisar || 0"/>
                        <div class="o_planner_label">A revisar</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════ Título de sección + acciones ════ -->
        <div class="d-flex align-items-center mb-2 gap-2">
            <div class="o_planner_section_title">
                <i class="fa fa-list-alt me-2 text-muted"/>
                <span class="fw-bold text-muted small">Necesidades por artículo</span>
            </div>
            <span t-foreach="state.stateFilter" t-as="sf" t-key="sf" class="badge text-bg-light border">
                <t t-esc="sf"/>
                <i class="fa fa-times ms-1" role="button" t-on-click="() => this.toggleStateTok(sf)"/>
            </span>
            <span t-foreach="state.originFilter" t-as="of" t-key="of" class="badge text-bg-light border">
                <t t-esc="of"/>
                <i class="fa fa-times ms-1" role="button" t-on-click="() => this.toggleOriginTok(of)"/>
            </span>
            <span class="text-muted small ms-1"
                  t-esc="'Almacén: ' + (state.meta.warehouse_name || '—') + ' · ventana ' + (state.meta.n_months || 0) + ' meses · factor ' + (state.meta.safety_factor || '')"/>
            <div class="ms-auto">
                <button class="btn btn-success btn-sm rounded-pill px-3" t-if="selectedCount > 0"
                        t-on-click="() => this.generateSelected()"
                        t-att-disabled="state.generating">
                    <i class="fa fa-truck me-1"/>Generar <t t-esc="selectedCount"/> OF
                </button>
            </div>
        </div>

        <!-- ════ Tabla (estilo tabla de forecast: bordeada, compacta, header sticky) ════ -->
        <div t-if="state.loading" class="text-center text-muted py-5">
            <i class="fa fa-spinner fa-spin me-2"/>Calculando necesidades…
        </div>
        <t t-else="">
            <div t-if="!visibleRows.length" class="text-center text-muted py-4 border rounded">
                <i class="fa fa-inbox fa-2x mb-2 d-block opacity-50"/>
                Sin artículos para los filtros seleccionados.
            </div>
            <div t-else="" class="border rounded" style="overflow:auto; max-height:66vh;">
                <table class="table table-sm table-bordered table-hover mb-0 o_needs_table"
                       style="min-width:900px; font-size:12px;">
                    <thead style="position:sticky; top:0; z-index:3;">
                        <tr>
                            <th class="text-center align-middle"
                                style="width:34px; padding:4px 6px; background:var(--bs-tertiary-bg, #f8f9fa);">
                                <input t-if="hasSelectable" type="checkbox" class="form-check-input"
                                       t-att-checked="selectedCount > 0"
                                       t-on-click="() => this.toggleAll()"/>
                            </th>
                            <th class="align-middle" t-att-style="'padding:4px 8px; cursor:pointer; user-select:none; background:var(--bs-tertiary-bg, #f8f9fa);' + colStyle('name')"
                                t-on-click="() => this.sortBy('name')">
                                <div class="o_th_cell">Artículo<i t-att-class="sortIcon('name')"/></div>
                                <div class="o_col_resize_handle" t-on-mousedown="(ev) => this.onResizeStart('name', ev)" t-on-click.stop=""/>
                            </th>
                            <t t-foreach="dataCols" t-as="c" t-key="c.key">
                                <th t-att-class="'align-middle text-' + c.align"
                                    t-att-style="'padding:4px 8px; cursor:pointer; user-select:none; background:var(--bs-tertiary-bg, #f8f9fa);' + colStyle(c.key)"
                                    t-att-title="c.title" t-on-click="() => this.sortBy(c.key)">
                                    <div class="o_th_cell"><t t-esc="c.label"/><i t-att-class="sortIcon(c.key)"/></div>
                                    <div class="o_col_resize_handle" t-on-mousedown="(ev) => this.onResizeStart(c.key, ev)" t-on-click.stop=""/>
                                </th>
                            </t>
                            <th class="align-middle" t-att-style="'padding:4px 8px; cursor:pointer; user-select:none; background:var(--bs-tertiary-bg, #f8f9fa);' + colStyle('state')"
                                t-on-click="() => this.sortBy('state')">
                                <div class="o_th_cell">Estado<i t-att-class="sortIcon('state')"/></div>
                                <div class="o_col_resize_handle" t-on-mousedown="(ev) => this.onResizeStart('state', ev)" t-on-click.stop=""/>
                            </th>
                            <th class="text-center align-middle" style="width:42px; padding:4px 6px; background:var(--bs-tertiary-bg, #f8f9fa);"/>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="visibleRows" t-as="row" t-key="row.product_id"
                            t-att-class="state.selected[row.product_id] ? 'o_row_selected' : ''">
                            <td class="text-center" style="padding:3px 6px;">
                                <input t-if="this.isSelectable(row)" type="checkbox" class="form-check-input"
                                       t-att-checked="state.selected[row.product_id]"
                                       t-on-click="() => this.toggleRow(row)"/>
                            </td>
                            <td style="padding:3px 8px; white-space:nowrap;">
                                <div class="fw-semibold text-truncate" style="max-width:280px;" t-att-title="row.name" t-esc="row.name"/>
                            </td>
                            <t t-foreach="dataCols" t-as="c" t-key="c.key">
                                <td t-att-class="cellClass(row, c)" style="padding:3px 8px;">
                                    <t t-if="c.key === 'origin'">
                                        <span t-if="row.origin" class="badge rounded-pill text-bg-light border fw-normal" t-esc="row.origin"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </t>
                                    <t t-elif="c.key === 'sale_category'">
                                        <span t-if="row.sale_category" t-att-class="saleCatBadge(row.sale_category)"
                                              style="font-size:10px; padding:2px 7px;" t-esc="row.sale_category"/>
                                        <span t-else="" class="text-muted">—</span>
                                    </t>
                                    <t t-elif="c.type === 'text'">
                                        <span class="text-truncate d-inline-block" style="max-width:160px;"
                                              t-att-title="row[c.key]" t-esc="row[c.key] || '—'"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="cellValue(row, c)"/>
                                    </t>
                                </td>
                            </t>
                            <td style="padding:3px 8px;">
                                <span class="badge rounded-pill" t-att-class="this.stateClass(row.state)"
                                      t-att-title="row.state_reason" t-esc="row.state"/>
                            </td>
                            <td class="text-center" style="padding:3px 6px;">
                                <button t-if="this.isSelectable(row)"
                                        class="btn btn-success rounded-circle d-inline-flex align-items-center justify-content-center p-0"
                                        style="width:26px; height:26px;"
                                        t-on-click="() => this.generateRow(row)"
                                        t-att-disabled="state.generating"
                                        title="Generar la OF de este artículo">
                                    <i class="fa fa-truck" style="font-size:11px;"/>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>

    </div>
</t>

</templates>
