<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.UnmetDemandWidget">
        <div class="o_unmet_demand_widget" style="font-size:13px; min-height:400px;">

            <!-- ══ FILTROS DEL GRÁFICO (afectan SOLO al gráfico) ═══════════════ -->
            <div class="d-flex align-items-center gap-1 mb-2 flex-wrap">
                <div class="d-flex align-items-center gap-1">
                    <input type="date" class="form-control form-control-sm" style="font-size:10px; padding:1px 4px; width:112px;"
                           title="Fecha inicial del período del gráfico."
                           t-att-value="state.chartDateFrom" t-on-change="onChartDateFromChange"/>
                    <span class="text-muted" style="font-size:10px;">→</span>
                    <input type="date" class="form-control form-control-sm" style="font-size:10px; padding:1px 4px; width:112px;"
                           title="Fecha final del período del gráfico."
                           t-att-value="state.chartDateTo" t-on-change="onChartDateToChange"/>
                </div>
                <div class="vr" style="height:20px;"/>
                <div class="btn-group btn-group-sm" role="group" aria-label="Dimensión del gráfico">
                    <t t-foreach="[['customer','Cliente'],['product','Producto'],['family','Familia']]" t-as="d" t-key="d[0]">
                        <button t-att-class="'btn ' + (state.chartDimension === d[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                style="font-size:10px; padding:1px 6px;"
                                t-att-title="'Agrupar el gráfico por ' + d[1]"
                                t-on-click="() => this.setChartDimension(d[0])">
                            <t t-esc="d[1]"/>
                        </button>
                    </t>
                </div>
                <div class="vr" style="height:20px;"/>
                <div class="btn-group btn-group-sm" role="group" aria-label="Valorización del gráfico">
                    <button t-att-class="'btn ' + (effChartAmountMethod === 'pxq' ? 'btn-primary' : 'btn-outline-secondary')"
                            style="font-size:10px; padding:1px 6px;"
                            title="PxQ: precio de lista × cantidad pendiente."
                            t-on-click="() => this.setChartAmountMethod('pxq')">PxQ</button>
                    <button t-att-class="'btn ' + (effChartAmountMethod === 'real' ? 'btn-primary' : 'btn-outline-secondary')"
                            style="font-size:10px; padding:1px 6px;"
                            title="Real: precio efectivo de la línea (con descuentos) × cantidad pendiente."
                            t-on-click="() => this.setChartAmountMethod('real')">Real</button>
                </div>
                <i t-if="state.chartLoading" class="fa fa-spinner fa-spin text-muted ms-1" title="Cargando gráfico…"/>
            </div>

            <!-- Cabecera del gráfico: título + métrica + Top-N -->
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="small text-muted fw-semibold"
                      t-esc="'Top ' + state.chartTopN + ' por ' + chartDimensionLabel.toLowerCase()"/>
                <div class="d-flex align-items-center gap-2">
                    <div class="btn-group btn-group-sm" role="group" aria-label="Métrica del gráfico">
                        <button t-att-class="'btn ' + (state.chartMetric === 'amount' ? 'btn-primary' : 'btn-outline-secondary')"
                                style="font-size:10px; padding:1px 6px;"
                                title="Ordenar el gráfico por monto pendiente."
                                t-on-click="() => this.setChartMetric('amount')">Monto</button>
                        <button t-att-class="'btn ' + (state.chartMetric === 'qty' ? 'btn-primary' : 'btn-outline-secondary')"
                                style="font-size:10px; padding:1px 6px;"
                                title="Ordenar el gráfico por unidades pendientes."
                                t-on-click="() => this.setChartMetric('qty')">Unidades</button>
                    </div>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Cantidad a mostrar">
                        <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                            <button t-att-class="'btn ' + (state.chartTopN === n ? 'btn-primary' : 'btn-outline-secondary')"
                                    style="font-size:10px; padding:1px 6px;"
                                    t-att-title="'Mostrar el top ' + n + ' en el gráfico'"
                                    t-on-click="() => this.setChartTopN(n)">
                                <t t-esc="'Top ' + n"/>
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <!-- Gráfico -->
            <div t-if="state.chartLoading and !state.chartData" class="text-center text-muted py-4">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>
            <div t-elif="state.chartError" class="alert alert-danger py-2 mb-2" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                Error al cargar el gráfico: <strong><t t-esc="state.chartError"/></strong>
            </div>
            <div t-elif="!chartRowsAll.length" class="text-center text-muted py-4">
                <i class="fa fa-bar-chart fa-2x mb-2 d-block opacity-50"/>
                <span>No hay demanda insatisfecha para el filtro del gráfico.</span>
            </div>
            <div t-else="" style="position:relative; height:280px;" class="mb-3">
                <canvas t-ref="chartCanvas"/>
            </div>

            <hr class="mt-0 mb-3"/>

            <!-- ══ FILTROS + BÚSQUEDA + BOTONES (cards + tabla, todo en una fila) ═ -->
            <div class="d-flex align-items-center gap-1 mb-3 flex-wrap">
                <div class="d-flex align-items-center gap-1">
                    <input type="date" class="form-control form-control-sm" style="font-size:10px; padding:1px 4px; width:112px;"
                           title="Fecha inicial del período de las cards y la tabla."
                           t-att-value="state.dateFrom" t-on-change="onDateFromChange"/>
                    <span class="text-muted" style="font-size:10px;">→</span>
                    <input type="date" class="form-control form-control-sm" style="font-size:10px; padding:1px 4px; width:112px;"
                           title="Fecha final del período de las cards y la tabla."
                           t-att-value="state.dateTo" t-on-change="onDateToChange"/>
                </div>
                <div class="vr" style="height:20px;"/>
                <div class="btn-group btn-group-sm" role="group" aria-label="Dimensión de la tabla">
                    <t t-foreach="[['customer','Cliente'],['product','Producto'],['family','Familia']]" t-as="d" t-key="d[0]">
                        <button t-att-class="'btn ' + (state.dimension === d[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                style="font-size:10px; padding:1px 6px;"
                                t-att-title="'Agregar cards y tabla por ' + d[1]"
                                t-on-click="() => this.setDimension(d[0])">
                            <t t-esc="d[1]"/>
                        </button>
                    </t>
                </div>
                <div class="vr" style="height:20px;"/>
                <div class="btn-group btn-group-sm" role="group" aria-label="Valorización de la tabla">
                    <button t-att-class="'btn ' + (effAmountMethod === 'pxq' ? 'btn-primary' : 'btn-outline-secondary')"
                            style="font-size:10px; padding:1px 6px;"
                            title="PxQ: precio de lista × cantidad pendiente."
                            t-on-click="() => this.setAmountMethod('pxq')">PxQ</button>
                    <button t-att-class="'btn ' + (effAmountMethod === 'real' ? 'btn-primary' : 'btn-outline-secondary')"
                            style="font-size:10px; padding:1px 6px;"
                            title="Real: precio efectivo de la línea (con descuentos) × cantidad pendiente."
                            t-on-click="() => this.setAmountMethod('real')">Real</button>
                </div>
                <i t-if="state.loading" class="fa fa-spinner fa-spin text-muted" title="Cargando cards y tabla…"/>

                <PlannerSearchBar
                    widgetKey="'unmet_demand'"
                    placeholder="'Buscar ' + dimensionLabel.toLowerCase() + '…'"
                    t-props="{
                        search:            state.productSearch,
                        activeGroupBy:     groupBy,
                        groupByDefs:       groupByDefs,
                        onSearch:          (t) => this.setSearch(t),
                        onGroupByChange:   (k) => this.setGroupBy(k),
                        showFavorites:     true,
                        numericFields:     numColOptions,
                        numFilters:        state.numFilters,
                        onNumFilterAdd:    (c) => this.addNumFilter(c),
                        onNumFilterRemove: (i) => this.removeNumFilter(i)
                    }"/>
                <div class="form-check form-switch d-flex align-items-center gap-2 ps-0 mb-0"
                        t-att-title="state.showAll ? 'Mostrando TODAS las entidades del período (el pie de tabla cuadra con las tarjetas). Activá para filtrar solo las que tienen faltante.' : 'Filtrando solo las entidades con faltante. Desactivá para mostrar todas (el pie de tabla cuadra con las tarjetas).'">
                    <input class="form-check-input ms-0 mt-0" type="checkbox" role="switch"
                           id="unmet_only_shortage"
                           t-att-checked="!state.showAll"
                           t-on-change="toggleShowAll"/>
                    <label class="form-check-label text-nowrap" for="unmet_only_shortage" style="cursor:pointer;">Solo faltantes</label>
                </div>
                <div class="position-relative" t-on-click.stop="">
                    <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1"
                            title="Elegir qué columnas mostrar en la tabla"
                            t-on-click="toggleColsDropdown">
                        <i class="fa fa-columns"/>
                        <span>Columnas</span>
                        <i t-att-class="'fa ' + (state.colsDropdownOpen ? 'fa-chevron-up' : 'fa-chevron-down')"/>
                    </button>
                    <div t-if="state.colsDropdownOpen"
                         class="dropdown-menu show shadow p-2"
                         style="min-width:200px; position:absolute; z-index:1050; top:100%; right:0; margin-top:2px;">
                        <p class="small text-muted mb-1 px-1">Columnas de la tabla</p>
                        <t t-foreach="optionalColumns" t-as="col" t-key="col.key">
                            <div class="form-check mb-1">
                                <input type="checkbox" class="form-check-input"
                                       t-att-id="'ud_col_' + col.key"
                                       t-att-checked="isColVisible(col.key)"
                                       t-on-change="() => this.toggleCol(col.key)"/>
                                <label class="form-check-label small" t-att-for="'ud_col_' + col.key">
                                    <t t-esc="col.label"/>
                                </label>
                            </div>
                        </t>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-success d-flex align-items-center gap-1"
                        title="Exportar la tabla visible a Excel (.xls)"
                        t-on-click="exportToExcel">
                    <i class="fa fa-download"/>
                    <span>Exportar</span>
                </button>
            </div>

            <!-- Estados de cards + tabla -->
            <div t-if="state.loading and !state.data" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>
            <div t-elif="state.loadError" class="alert alert-danger py-2 mb-2" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                Error al cargar la demanda insatisfecha: <strong><t t-esc="state.loadError"/></strong>
            </div>
            <div t-elif="!baseRows.length" class="text-center text-muted py-5">
                <i class="fa fa-check-circle fa-3x mb-3 d-block opacity-50"/>
                <span>No hay demanda insatisfecha para los filtros de cards y tabla.</span>
            </div>

            <t t-else="">
                <!-- Cards globales -->
                <div class="d-flex gap-2 mb-3 flex-wrap">
                    <!-- 1 · Demanda real -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('total_ordered')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i class="fa fa-shopping-cart fa-lg text-secondary mb-1 d-block"/>
                                <div t-att-class="'o_planner_number ' + kpiNumClass(fmt(kpis.total_ordered))" t-esc="fmt(kpis.total_ordered)"/>
                                <div class="o_planner_label">Demanda real</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" title="Ver todas las líneas del período (columna Demanda real)"
                                        t-on-click="() => this.openCardLines('ordered')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <!-- 2 · Cumplimiento de demanda -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('total_delivered')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i class="fa fa-truck fa-lg text-secondary mb-1 d-block"/>
                                <div t-att-class="'o_planner_number ' + kpiNumClass(fmt(kpis.total_delivered))" t-esc="fmt(kpis.total_delivered)"/>
                                <div class="o_planner_label">Cumplimiento de demanda</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" title="Ver las líneas con entrega del período (columna Cumplimiento de demanda)"
                                        t-on-click="() => this.openCardLines('delivered')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <!-- 3 · Pendiente (u.) -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('total_unmet_qty')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i class="fa fa-cubes fa-lg text-secondary mb-1 d-block"/>
                                <div t-att-class="'o_planner_number ' + kpiNumClass(fmt(kpis.total_unmet_qty))" t-esc="fmt(kpis.total_unmet_qty)"/>
                                <div class="o_planner_label">Pendiente (u.)</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" title="Ver las líneas con backlog pendiente del período (columna Pendiente)"
                                        t-on-click="() => this.openCardLines('pending')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <!-- 4 · Valorización del pendiente -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('total_unmet_amount')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i class="fa fa-exclamation-circle fa-lg text-danger mb-1 d-block"/>
                                <div t-att-class="'o_planner_number text-danger ' + kpiNumClass(fmtMoney(kpis.total_unmet_amount))"
                                     t-esc="fmtMoney(kpis.total_unmet_amount)"/>
                                <div class="o_planner_label">Valorización del pendiente</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" title="Ver las líneas con backlog y su valorización real (subtotal × pendiente ÷ pedido)"
                                        t-on-click="() => this.openCardLines('value')">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <!-- 5 · Clientes/Productos/Familias afectados -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('total_rows')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i class="fa fa-list fa-lg text-secondary mb-1 d-block"/>
                                <div t-att-class="'o_planner_number ' + kpiNumClass(fmt(kpis.total_rows))" t-esc="fmt(kpis.total_rows)"/>
                                <div class="o_planner_label"><t t-esc="dimensionPlural"/> afectados</div>
                            </div>
                            <div class="card-footer p-0">
                                <button class="btn btn-sm btn-link w-100 py-1" title="Ver las líneas con backlog agrupadas por la dimensión activa"
                                        t-on-click="() => this.openCardLines('pending', true)">Ver →</button>
                            </div>
                        </div>
                    </div>
                    <!-- 6 · Tasa de cumplimiento (indicador, sin drill) -->
                    <div class="flex-fill" style="min-width:130px; flex-basis:0;">
                        <div class="card o_planner_card o_planner_kpi_card_lg h-100" t-att-title="kpiTooltip('fulfillment_pct')">
                            <div class="card-body text-center py-2 d-flex flex-column justify-content-center">
                                <i t-att-class="'fa fa-percent fa-lg mb-1 d-block ' + fulfillClass(kpis.fulfillment_pct)"/>
                                <div t-att-class="'o_planner_number ' + fulfillClass(kpis.fulfillment_pct) + ' ' + kpiNumClass(fmtPct(kpis.fulfillment_pct))" t-esc="fmtPct(kpis.fulfillment_pct)"/>
                                <div class="o_planner_label">Tasa de cumplimiento</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pestañas de agrupamiento (mismo patrón que forecast / análisis de clientes) -->
                <t t-if="groupBy and allGroupsForTabs">
                    <ul class="nav nav-tabs mb-0" style="flex-wrap:nowrap; overflow-x:auto;">
                        <t t-foreach="allGroupsForTabs" t-as="g" t-key="'tab_' + g.key">
                            <li class="nav-item">
                                <button t-att-class="'nav-link px-3 py-1 ' + ((state.selectedGroup === g.key or (state.selectedGroup === null and g_index === 0)) ? 'active fw-semibold' : 'text-muted')"
                                        style="font-size:12px; white-space:nowrap;"
                                        t-att-title="'Ver solo el grupo: ' + g.label"
                                        t-on-click="() => this.setGroup(g.key)">
                                    <t t-esc="g.label"/>
                                    <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="g.count"/>)</span>
                                </button>
                            </li>
                        </t>
                    </ul>
                </t>

                <!-- Tabla de detalle (columnas reordenables por drag y redimensionables) -->
                <div class="border rounded bg-white" style="overflow:auto;">
                    <table class="table table-sm table-hover mb-0" style="font-size:12px; table-layout:fixed;">
                        <colgroup>
                            <col t-foreach="columns" t-as="col" t-key="col.key"
                                 t-att-style="cols.colGroupStyle(col.key)"/>
                        </colgroup>
                        <thead style="position:sticky; top:0; background:#f8f9fa; z-index:1;">
                            <tr>
                                <t t-foreach="columns" t-as="col" t-key="col.key">
                                    <th t-att-class="(col.align === 'end' ? 'text-end' : 'text-start') + ' user-select-none' + (cols.state.dragOver === col.key ? ' o_col_drag_over' : '')"
                                        style="padding:4px 8px; cursor:pointer; white-space:nowrap; position:relative;"
                                        t-att-title="colTitle(col)"
                                        t-att-data-col-key="col.key"
                                        t-att-data-sort-key="col.sortKey || ''"
                                        t-att-draggable="col.fixed ? 'false' : 'true'"
                                        t-on-click="onHeaderClick"
                                        t-on-dragstart="cols.onDragStart"
                                        t-on-dragover="cols.onDragOver"
                                        t-on-drop="cols.onDrop"
                                        t-on-dragend="cols.onDragEnd">
                                        <t t-esc="col.label"/>
                                        <i t-att-class="sortIcon(col.key)" style="opacity:0.6;"/>
                                        <div class="o_col_resize_handle"
                                             t-att-data-col-key="col.key"
                                             t-on-mousedown.stop="cols.onResizeStart"
                                             t-on-click.stop="() => {}"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="pagedRows" t-as="row" t-key="row.key">
                                <t t-call="odoo_mrp_planner.UnmetDemandDetailRow"/>
                                <t t-if="canExpand and state.expandedKey === row.key"
                                   t-call="odoo_mrp_planner.UnmetDemandExpandRow"/>
                            </t>
                        </tbody>
                        <tfoot t-if="pagedRowsAll.length" style="position:sticky; bottom:0; background:#f1f3f5; z-index:1;">
                            <tr style="border-top:2px solid #dee2e6;">
                                <t t-foreach="columns" t-as="col" t-key="col.key">
                                    <td t-att-class="(col.align === 'end' ? 'text-end' : 'text-start') + ' fw-bold'"
                                        style="padding:4px 8px; white-space:nowrap;">
                                        <t t-if="col.fixed">Total (<t t-esc="pagedRowsAll.length"/>)</t>
                                        <t t-elif="col.key === 'unmet_amount'">
                                            <span class="text-danger" t-esc="footerText(col)"/>
                                        </t>
                                        <t t-else="" t-esc="footerText(col)"/>
                                    </td>
                                </t>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Paginación: flechas a los extremos (ancho completo), info al centro -->
                <div class="d-flex align-items-center justify-content-between mt-2" t-if="totalPages > 1">
                    <button class="btn btn-outline-secondary btn-sm" t-att-disabled="!hasPrevPage"
                            t-on-click="prevPage" title="Página anterior">
                        <i class="fa fa-chevron-left"/>
                    </button>
                    <span class="small text-muted">
                        <t t-esc="pagedRowsAll.length"/> <t t-esc="dimensionPlural.toLowerCase()"/> · página <t t-esc="state.page"/> de <t t-esc="totalPages"/>
                    </span>
                    <button class="btn btn-outline-secondary btn-sm" t-att-disabled="!hasNextPage"
                            t-on-click="nextPage" title="Página siguiente">
                        <i class="fa fa-chevron-right"/>
                    </button>
                </div>
            </t>

        </div>
    </t>

    <!-- Fila de detalle de la tabla (reutilizada en modo normal y agrupado).
         Requiere `row` y `columns` en el scope. -->
    <t t-name="odoo_mrp_planner.UnmetDemandDetailRow">
        <tr t-att-style="canExpand ? 'cursor:pointer;' : ''"
            t-att-class="canExpand and state.expandedKey === row.key ? 'table-active' : ''"
            t-on-click="() => this.toggleExpand(row)">
            <t t-foreach="columns" t-as="col" t-key="col.key">
                <td t-att-class="col.align === 'end' ? 'text-end' : 'text-start'"
                    t-att-style="col.key === 'diagnosis' ? 'padding:3px 8px; white-space:normal; vertical-align:middle;' : 'padding:3px 8px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;'"
                    t-att-title="cellTooltip(col, row)">
                    <t t-if="col.key === 'unmet_amount'">
                        <span class="fw-semibold text-danger" t-esc="cellText(row, col)"/>
                    </t>
                    <t t-elif="col.key === 'fulfillment_pct'">
                        <span t-att-class="fulfillClass(row.fulfillment_pct)" t-esc="cellText(row, col)"/>
                    </t>
                    <t t-elif="col.key === 'unmet_pct'">
                        <span t-att-class="unmetSeverityClass(row.unmet_pct)" t-esc="cellText(row, col)"/>
                    </t>
                    <t t-elif="col.key === 'diagnosis'">
                        <t t-if="rowSituation(row).na">
                            <span class="text-muted">—</span>
                        </t>
                        <t t-else="">
                            <span t-att-style="'display:inline-flex; align-items:center; gap:5px; white-space:normal; text-align:left; font-size:11px; font-weight:500; line-height:1.2; padding:3px 9px; border-radius:12px; ' + rowSituation(row).chip">
                                <i t-att-class="'fa ' + rowSituation(row).icon"/>
                                <span t-esc="rowSituation(row).text"/>
                            </span>
                        </t>
                    </t>
                    <t t-elif="col.key === 'category'">
                        <span t-if="row.category"
                              t-att-style="'display:inline-block; min-width:18px; padding:0 5px; border-radius:3px; line-height:18px; font-size:10px; font-weight:bold; color:#fff; background:' + catColor(row.category)"
                              t-esc="row.category"/>
                        <span t-else="" class="text-muted">—</span>
                    </t>
                    <t t-elif="col.fixed">
                        <i t-if="canExpand"
                           t-att-class="'fa me-1 text-muted ' + (state.expandedKey === row.key ? 'fa-caret-down' : 'fa-caret-right')"/>
                        <t t-esc="cellText(row, col)"/>
                    </t>
                    <t t-else="" t-esc="cellText(row, col)"/>
                </td>
            </t>
        </tr>
    </t>

    <!-- Panel de entregabilidad (fila expandida), en lenguaje natural. Requiere `row`. -->
    <t t-name="odoo_mrp_planner.UnmetDemandExpandRow">
        <tr>
            <td t-att-colspan="columns.length" style="padding:12px 16px; background:#f8f9fa; border-top:none;">
                <t t-set="a" t-value="state.expandData[row.key]"/>

                <t t-if="!a">
                    <div class="d-flex align-items-center gap-2 py-2">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"/>
                        <span class="text-muted small">Analizando…</span>
                    </div>
                </t>
                <t t-elif="a.error">
                    <div class="text-danger small">No se pudo analizar este producto.</div>
                </t>
                <t t-elif="a.index_pct === null">
                    <div class="text-muted small">No hay datos suficientes para analizar este producto.</div>
                </t>
                <t t-else="">
                    <!-- Banner: card blanca con borde de color (estética del detalle de cliente) -->
                    <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-white rounded shadow-sm"
                         t-att-style="'border-left:4px solid ' + deliveryDiagnosis(a.diagnosis).color + ';'">
                        <i t-att-class="'fa fa-2x ' + deliveryDiagnosis(a.diagnosis).icon"
                           t-att-style="'color:' + deliveryDiagnosis(a.diagnosis).color + ';'"/>
                        <div class="flex-grow-1" style="min-width:0;">
                            <div class="fw-bold" t-att-style="'color:' + deliveryDiagnosis(a.diagnosis).color + ';'"
                                 t-esc="deliveryDiagnosis(a.diagnosis).label"/>
                            <div class="small text-muted" t-esc="deliveryNarrative(a)"/>
                        </div>
                        <div class="text-center px-2" style="min-width:100px;">
                            <div class="fw-bold lh-1" style="font-size:1.5rem;"
                                 t-att-style="'color:' + deliveryDiagnosis(a.diagnosis).color + '; font-size:1.5rem; line-height:1;'">
                                <t t-esc="Math.round(a.days_stock)"/><span class="fw-normal text-muted" style="font-size:0.9rem;">/<t t-esc="Math.round(a.days_pending)"/></span>
                            </div>
                            <div class="small text-muted">días con stock</div>
                            <div class="text-muted" style="font-size:9px;">(de los días pendientes)</div>
                        </div>
                    </div>

                    <!-- Detalle por pedido (izq., con scroll) + curva de stock (der., protagonista) -->
                    <div class="d-flex gap-3 align-items-start flex-wrap">
                        <div style="flex:1 1 380px; min-width:0;">
                            <div class="o_planner_section_title mb-1">
                                <i class="fa fa-list-ul me-1 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Detalle por pedido</span>
                                <span class="text-muted ms-1" style="font-size:11px;">(<t t-esc="a.lines.length"/>)</span>
                            </div>
                            <div style="max-height:280px; overflow-y:auto;">
                                <table class="table table-sm table-hover mb-0" style="font-size:11px;">
                                    <tbody>
                                        <tr t-foreach="a.lines" t-as="ln" t-key="ln_index">
                                            <td style="border-top:none;">
                                                <a href="#" class="fw-semibold text-decoration-none"
                                                   t-on-click.prevent.stop="() => this.openOrder(ln.order_id)"
                                                   t-esc="ln.order"/>
                                            </td>
                                            <td class="text-end text-muted" style="border-top:none;"><t t-esc="fmt(ln.pending)"/> pendientes</td>
                                            <td class="text-end" style="border-top:none;">
                                                <span t-att-class="deliveryDiagnosis(ln.pct &gt;= 66 ? 'fulfillment' : (ln.pct &lt;= 33 ? 'shortage' : 'mixed')).text">
                                                    hubo stock <t t-esc="Math.round(ln.days_stock)"/> de <t t-esc="Math.round(ln.days_total)"/> días
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <!-- Curva de stock durante la espera (protagonista) -->
                        <div t-if="a.curve and a.curve.length" style="flex:2 1 520px; min-width:320px;">
                            <div class="o_planner_section_title mb-1">
                                <i class="fa fa-area-chart me-1 text-muted"/>
                                <span class="text-uppercase fw-bold text-muted small">Stock durante la espera</span>
                            </div>
                            <div class="bg-white rounded border p-2" style="height:280px;">
                                <canvas t-ref="deliveryChartCanvas"/>
                            </div>
                        </div>
                    </div>
                </t>
            </td>
        </tr>
    </t>

</templates>
