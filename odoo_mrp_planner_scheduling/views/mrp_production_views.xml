<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Acción servidor: botón en vista lista de MOs ── -->
    <record id="action_mrp_reschedule" model="ir.actions.server">
        <field name="name">Reprogramar en cascada</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="groups_id" eval="[(4, ref('odoo_mrp_planner_scheduling.group_scheduling'))]"/>
        <field name="code">
action = records.action_open_reschedule_plan()
        </field>
    </record>

    <!-- ── Extensión del form de mrp.production: botones de reprogramación ── -->
    <record id="mrp_production_form_reschedule_buttons" model="ir.ui.view">
        <field name="name">mrp.production.form.reschedule.buttons</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reschedule_plans"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="reschedule_plan_count == 0"
                        groups="odoo_mrp_planner_scheduling.group_scheduling">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="reschedule_plan_count"/>
                        </span>
                        <span class="o_stat_text">Planes</span>
                    </div>
                </button>
                <button name="action_open_reschedule_plan"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o"
                        invisible="not x_reschedule_needed"
                        groups="odoo_mrp_planner_scheduling.group_scheduling">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Reprogramar</span>
                        <span class="o_stat_text">sugerido</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
