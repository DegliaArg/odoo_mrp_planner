<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_reschedule.PoDashboardWidget">
        <div class="o_po_dashboard_widget" t-ref="poRoot">

            <!-- Filtros de fecha y estado OC -->
            <div class="row g-2 mb-3">
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Desde</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateFrom"
                           t-on-change="onDateFromChange"/>
                </div>
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Hasta</label>
                    <input type="date" class="form-control form-control-sm d-inline-block"
                           style="width:auto"
                           t-att-value="state.dateTo"
                           t-on-change="onDateToChange"/>
                </div>
                <div class="col-auto">
                    <label class="col-form-label col-form-label-sm me-1">Estado OC</label>
                    <select class="form-select form-select-sm d-inline-block" style="width:auto"
                            t-on-change="onOcFilterChange">
                        <option value="overdue" t-att-selected="state.ocFilter === 'overdue'">Vencidas</option>
                        <option value="all"     t-att-selected="state.ocFilter === 'all'">Todas</option>
                        <option value="pending" t-att-selected="state.ocFilter === 'pending'">A tiempo</option>
                        <option value="rfqs"    t-att-selected="state.ocFilter === 'rfqs'">Cotizaciones</option>
                        <option value="approve" t-att-selected="state.ocFilter === 'approve'">Por aprobar</option>
                    </select>
                </div>
            </div>

            <!-- Pestañas de tipo -->
            <ul class="nav nav-pills mb-3">
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'all' ? ' active' : '')"
                            t-on-click="() => this.setTab('all')">
                        <i class="fa fa-th-list me-1"/>Todas
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'purchase' ? ' active' : '')"
                            t-on-click="() => this.setTab('purchase')">
                        <i class="fa fa-shopping-cart me-1"/>Compras
                    </button>
                </li>
                <li class="nav-item">
                    <button t-att-class="'nav-link' + (state.tab === 'subcontract' ? ' active' : '')"
                            t-on-click="() => this.setTab('subcontract')">
                        <i class="fa fa-industry me-1"/>Subcontratación
                    </button>
                </li>
            </ul>

            <!-- Contenido — dimming durante carga en lugar de spinner full -->
            <div t-att-class="'row g-3' + (state.loading ? ' opacity-50 pe-none' : '')">

                <!-- Izquierda: tarjetas KPI -->
                <div class="col-12 col-lg-4 o_kpi_height_src">
                    <div class="row g-2">

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_info h-100"
                                 style="cursor:pointer" t-on-click="onClickRfqs"
                                 t-att-data-kpi-tip="'OCs en estado de solicitud de\ncotización, aún no aprobadas.\nEstados: Borrador · Enviada al proveedor'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-file-text-o fa-lg text-info mb-2 d-block"/>
                                    <div class="o_planner_number text-info" t-esc="fmt(state.kpis.rfq)"/>
                                    <div class="o_planner_label">Cotizaciones</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_warning h-100"
                                 style="cursor:pointer" t-on-click="onClickToApprove"
                                 t-att-data-kpi-tip="'OCs que requieren aprobación\nadicional antes de ser confirmadas.\nEstado: Por aprobar (to approve)'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-clock-o fa-lg text-warning mb-2 d-block"/>
                                    <div class="o_planner_number text-warning" t-esc="fmt(state.kpis.to_approve)"/>
                                    <div class="o_planner_label">Por aprobar</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card h-100"
                                 style="cursor:pointer" t-on-click="onClickAll"
                                 t-att-data-kpi-tip="'OCs aprobadas con recepción\npendiente dentro del período.\nEstado: Aprobada\nRecepción: pendiente o parcial'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-list fa-lg text-secondary mb-2 d-block"/>
                                    <div class="o_planner_number" t-esc="fmt(state.kpis.total)"/>
                                    <div class="o_planner_label">Aprobadas</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_success h-100"
                                 style="cursor:pointer" t-on-click="onClickPending"
                                 t-att-data-kpi-tip="'OCs aprobadas cuya fecha de\nentrega prevista aún no venció.\nCondición: fecha_entrega &gt;= hoy\nEstado: Aprobada'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-check fa-lg text-success mb-2 d-block"/>
                                    <div class="o_planner_number text-success" t-esc="fmt(state.kpis.pending)"/>
                                    <div class="o_planner_label">A tiempo</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_danger h-100"
                                 style="cursor:pointer" t-on-click="onClickOverdue"
                                 t-att-data-kpi-tip="'OCs aprobadas cuya fecha de\nentrega prevista ya venció.\nCondición: fecha_entrega &lt; hoy\nEstado: Aprobada, sin recepción total'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-exclamation-triangle fa-lg text-danger mb-2 d-block"/>
                                    <div class="o_planner_number text-danger" t-esc="fmt(state.kpis.overdue)"/>
                                    <div class="o_planner_label">Vencidas</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="card o_planner_card o_planner_card_danger h-100"
                                 style="cursor:pointer" t-on-click="onClickOverdue"
                                 t-att-data-kpi-tip="'OCs vencidas con más de 5 días\nde retraso sobre la fecha de entrega.\nCondición: retraso &gt; 5 días\nRequieren atención inmediata'">
                                <div class="card-body text-center py-3">
                                    <i class="fa fa-exclamation-circle fa-lg text-danger mb-2 d-block"/>
                                    <div class="o_planner_number text-danger" t-esc="fmt(state.kpis.overdue_critical)"/>
                                    <div class="o_planner_label">Críticas (+<t t-esc="state.kpis.po_critical_days || 5"/> días)</div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Derecha: pestañas de lista -->
                <div class="col-12 col-lg-8">

                    <!-- Sin datos -->
                    <div t-if="isEmpty"
                         class="d-flex align-items-center justify-content-center border rounded o_table_scroll"
                         style="height:350px;">
                        <div class="text-center small text-muted">
                            <i class="fa fa-check-circle fa-2x mb-2 d-block text-success"/>
                            Sin órdenes pendientes.
                        </div>
                    </div>

                    <div t-else="" class="d-flex flex-column o_table_scroll" style="height:350px; overflow:hidden;">
                        <!-- Pestañas de lista (movimientos de stock) -->
                        <ul class="nav nav-tabs mb-0 flex-wrap" style="flex-shrink:0;">
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (!state.listTab ? ' active' : '')"
                                        t-on-click="() => this.setListTab(null)">
                                    <i class="fa fa-shopping-cart text-primary me-1"/>
                                    OCs
                                </button>
                            </li>
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'receipts' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('receipts')">
                                    <i class="fa fa-arrow-down text-primary me-1"/>
                                    Recepciones
                                    <span t-if="state.kpis.receipts_overdue > 0"
                                          class="badge rounded-pill bg-danger ms-1"
                                          t-esc="fmt(state.kpis.receipts_overdue)"/>
                                </button>
                            </li>
                            <li class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'deliveries' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('deliveries')">
                                    <i class="fa fa-arrow-up text-secondary me-1"/>
                                    Entregas
                                    <span t-if="state.kpis.deliveries_overdue > 0"
                                          class="badge rounded-pill bg-danger ms-1"
                                          t-esc="fmt(state.kpis.deliveries_overdue)"/>
                                </button>
                            </li>
                            <li t-if="state.show_services_tab" class="nav-item">
                                <button t-att-class="'nav-link py-1 px-3 small' + (state.listTab === 'services' ? ' active' : '')"
                                        t-on-click="() => this.setListTab('services')">
                                    <i class="fa fa-briefcase text-info me-1"/>
                                    Servicios
                                    <span t-if="state.kpis.services_total > 0"
                                          class="badge rounded-pill bg-info ms-1"
                                          t-esc="fmt(state.kpis.services_total)"/>
                                </button>
                            </li>
                        </ul>

                        <!-- Contenido de lista con scroll (split table) -->
                        <div class="border border-top-0 rounded-bottom d-flex flex-column"
                             style="overflow:hidden; flex:1; min-height:0;">

                            <div t-if="activeList.length === 0"
                                 class="d-flex align-items-center justify-content-center flex-grow-1">
                                <div class="text-center text-muted small">Sin registros en esta categoría.</div>
                            </div>

                            <!-- OCs — controladas por el dropdown Estado OC -->
                            <t t-elif="!state.listTab">
                                <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                    <colgroup>
                                        <col style="width:20%"/><col style="width:38%"/>
                                        <col style="width:24%"/><col style="width:18%"/>
                                    </colgroup>
                                    <thead>
                                        <tr class="text-muted o_sortable_header">
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('partner')">Proveedor <i t-att-class="sortIcon('partner')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('date_planned')">
                                                <t t-if="state.ocFilter === 'overdue'">Vencida el</t>
                                                <t t-else="">Entrega estimada</t>
                                                <i t-att-class="sortIcon('date_planned')"/>
                                            </th>
                                            <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('amount_total')">Total <i t-att-class="sortIcon('amount_total')"/></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                    <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                        <colgroup>
                                            <col style="width:20%"/><col style="width:38%"/>
                                            <col style="width:24%"/><col style="width:18%"/>
                                        </colgroup>
                                        <tbody>
                                            <t t-foreach="sortedList" t-as="po" t-key="po.id">
                                                <tr t-att-class="state.ocFilter === 'overdue' ? 'table-danger' : (state.ocFilter === 'approve' ? 'table-warning' : '')"
                                                    style="cursor:pointer"
                                                    t-att-data-po-id="po.id"
                                                    t-on-click="openPoFromRow">
                                                    <td class="fw-semibold" t-esc="po.name"/>
                                                    <td t-esc="po.partner"/>
                                                    <td t-esc="po.date_planned"/>
                                                    <td class="text-end" t-esc="fmtAmt(po.amount_total)"/>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Recepciones (stock.picking incoming) -->
                            <t t-elif="state.listTab === 'receipts'">
                                <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                    <colgroup>
                                        <col style="width:4%"/>
                                        <col style="width:16%"/><col style="width:28%"/>
                                        <col style="width:18%"/><col style="width:9%"/><col style="width:25%"/>
                                    </colgroup>
                                    <thead>
                                        <tr class="text-muted o_sortable_header">
                                            <th/>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('partner')">Proveedor <i t-att-class="sortIcon('partner')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('scheduled_date')">Fecha prevista <i t-att-class="sortIcon('scheduled_date')"/></th>
                                            <th class="text-center" style="cursor:pointer" t-on-click="() => this.sortBy('overdue')">Estado <i t-att-class="sortIcon('overdue')"/></th>
                                            <th class="text-center" style="cursor:pointer" t-on-click="() => this.sortBy('availability')">Disponibilidad <i t-att-class="sortIcon('availability')"/></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                    <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                        <colgroup>
                                            <col style="width:4%"/>
                                            <col style="width:16%"/><col style="width:28%"/>
                                            <col style="width:18%"/><col style="width:9%"/><col style="width:25%"/>
                                        </colgroup>
                                        <tbody>
                                            <t t-foreach="sortedList" t-as="pick" t-key="pick.id">
                                                <!-- Fila principal -->
                                                <tr t-att-class="pick.overdue ? 'table-danger' : ''"
                                                    style="cursor:pointer"
                                                    t-att-data-pick-id="pick.id"
                                                    t-on-click="openPickingFromRow">
                                                    <td class="text-center ps-1 pe-0"
                                                        t-on-click.stop="() => this.toggleExpand(pick.id)"
                                                        style="cursor:default;"
                                                        title="Ver / ocultar líneas">
                                                        <i t-att-class="state.expandedIds[pick.id] ? 'fa fa-chevron-down text-primary' : 'fa fa-chevron-right text-muted'"/>
                                                    </td>
                                                    <td class="fw-semibold" t-esc="pick.name"/>
                                                    <td t-esc="pick.partner"/>
                                                    <td t-esc="pick.scheduled_date"/>
                                                    <td class="text-center">
                                                        <t t-if="pick.overdue">
                                                            <span class="badge text-bg-danger"
                                                                  t-att-title="`Vencida hace ${pick.days_late} días`">
                                                                +<t t-esc="pick.days_late"/>d
                                                            </span>
                                                        </t>
                                                        <t t-else="">
                                                            <i class="fa fa-clock-o text-muted" title="Recepción pendiente: dentro de plazo"/>
                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-if="pick.availability === 'assigned'"
                                                              class="badge text-bg-success"
                                                              title="Cantidades completas, lista para validar">Lista</span>
                                                        <span t-elif="pick.availability === 'partially_available'"
                                                              class="badge text-bg-warning"
                                                              title="Recepción parcial iniciada">Parcial</span>
                                                        <span t-elif="pick.availability === 'confirmed' || pick.availability === 'waiting'"
                                                              class="badge text-bg-secondary"
                                                              title="Sin cantidades ingresadas aún">Sin iniciar</span>
                                                        <span t-else="" class="text-muted">—</span>
                                                    </td>
                                                </tr>
                                                <!-- Filas de líneas (expandibles) -->
                                                <t t-if="state.expandedIds[pick.id]">
                                                    <t t-if="pick.lines.length === 0">
                                                        <tr class="table-light">
                                                            <td colspan="6" class="text-muted fst-italic small ps-4">Sin líneas pendientes.</td>
                                                        </tr>
                                                    </t>
                                                    <t t-foreach="pick.lines" t-as="line" t-key="line_index">
                                                        <tr class="table-light" style="cursor:default;">
                                                            <td/>
                                                            <td colspan="2" class="ps-3 text-muted small fst-italic" t-esc="line.product"/>
                                                            <td class="small text-muted">
                                                                <t t-esc="fmt(line.demand)"/>
                                                                <span class="ms-1 text-secondary" t-esc="line.uom"/>
                                                            </td>
                                                            <td/>
                                                            <td class="text-center small">
                                                                <t t-if="line.reserved >= line.demand - 0.001">
                                                                    <span class="badge text-bg-success" title="Completamente recibido">Recibido</span>
                                                                </t>
                                                                <t t-elif="line.reserved > 0.001">
                                                                    <span class="badge text-bg-warning"
                                                                          t-att-title="`Recibido: ${fmt(line.reserved)} / ${fmt(line.demand)} ${line.uom}`">
                                                                        <t t-esc="fmt(line.reserved)"/> / <t t-esc="fmt(line.demand)"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge text-bg-secondary" title="Sin cantidades ingresadas aún">Pendiente</span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Entregas (component deliveries to subcontractors) -->
                            <t t-elif="state.listTab === 'deliveries'">
                                <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                    <colgroup>
                                        <col style="width:4%"/>
                                        <col style="width:16%"/><col style="width:28%"/>
                                        <col style="width:18%"/><col style="width:9%"/><col style="width:25%"/>
                                    </colgroup>
                                    <thead>
                                        <tr class="text-muted o_sortable_header">
                                            <th/>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('partner')">Proveedor <i t-att-class="sortIcon('partner')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('scheduled_date')">Fecha prevista <i t-att-class="sortIcon('scheduled_date')"/></th>
                                            <th class="text-center" style="cursor:pointer" t-on-click="() => this.sortBy('overdue')">Estado <i t-att-class="sortIcon('overdue')"/></th>
                                            <th class="text-center" style="cursor:pointer" t-on-click="() => this.sortBy('availability')">Disponibilidad <i t-att-class="sortIcon('availability')"/></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                    <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                        <colgroup>
                                            <col style="width:4%"/>
                                            <col style="width:16%"/><col style="width:28%"/>
                                            <col style="width:18%"/><col style="width:9%"/><col style="width:25%"/>
                                        </colgroup>
                                        <tbody>
                                            <t t-foreach="sortedList" t-as="pick" t-key="pick.id">
                                                <!-- Fila principal -->
                                                <tr t-att-class="pick.overdue ? 'table-danger' : ''"
                                                    style="cursor:pointer"
                                                    t-att-data-pick-id="pick.id"
                                                    t-on-click="openPickingFromRow">
                                                    <td class="text-center ps-1 pe-0"
                                                        t-on-click.stop="() => this.toggleExpand(pick.id)"
                                                        style="cursor:default;"
                                                        title="Ver / ocultar líneas">
                                                        <i t-att-class="state.expandedIds[pick.id] ? 'fa fa-chevron-down text-primary' : 'fa fa-chevron-right text-muted'"/>
                                                    </td>
                                                    <td class="fw-semibold" t-esc="pick.name"/>
                                                    <td t-esc="pick.partner"/>
                                                    <td t-esc="pick.scheduled_date"/>
                                                    <td class="text-center">
                                                        <i t-if="pick.overdue"
                                                           class="fa fa-exclamation-triangle text-danger"
                                                           title="Entrega vencida: la fecha programada ya pasó"/>
                                                        <i t-else=""
                                                           class="fa fa-clock-o text-muted"
                                                           title="Entrega pendiente: dentro de plazo"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-if="pick.availability === 'assigned'"
                                                              class="badge text-bg-success"
                                                              title="Stock totalmente reservado y listo para despachar">Disponible</span>
                                                        <span t-elif="pick.availability === 'partially_available'"
                                                              class="badge text-bg-warning"
                                                              title="Stock parcialmente reservado. Algunos productos faltan">Parcialmente</span>
                                                        <span t-elif="pick.availability === 'confirmed' || pick.availability === 'waiting'"
                                                              class="badge text-bg-danger"
                                                              title="Sin stock reservado. Ejecutar Comprobar disponibilidad en Odoo">No disponible</span>
                                                        <span t-else="" class="text-muted">—</span>
                                                    </td>
                                                </tr>
                                                <!-- Filas de líneas (expandibles) -->
                                                <t t-if="state.expandedIds[pick.id]">
                                                    <t t-if="pick.lines.length === 0">
                                                        <tr class="table-light">
                                                            <td colspan="6" class="text-muted fst-italic small ps-4">Sin líneas de movimiento.</td>
                                                        </tr>
                                                    </t>
                                                    <t t-foreach="pick.lines" t-as="line" t-key="line_index">
                                                        <tr class="table-light" style="cursor:default;">
                                                            <td/>
                                                            <td colspan="2" class="ps-3 text-muted small fst-italic" t-esc="line.product"/>
                                                            <td class="small text-muted">
                                                                <t t-esc="fmt(line.demand)"/>
                                                                <span class="ms-1 text-secondary" t-esc="line.uom"/>
                                                            </td>
                                                            <td/>
                                                            <td class="text-center small">
                                                                <t t-if="line.reserved >= line.demand - 0.001">
                                                                    <span class="badge text-bg-success" title="Totalmente reservado">OK</span>
                                                                </t>
                                                                <t t-elif="line.reserved > 0.001">
                                                                    <span class="badge text-bg-warning"
                                                                          t-att-title="`Reservado: ${fmt(line.reserved)} / ${fmt(line.demand)} ${line.uom}`">
                                                                        <t t-esc="fmt(line.reserved)"/> / <t t-esc="fmt(line.demand)"/>
                                                                    </span>
                                                                </t>
                                                                <t t-else="">
                                                                    <span class="badge text-bg-danger" title="Sin stock reservado">Sin stock</span>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Servicios -->
                            <t t-elif="state.listTab === 'services'">
                                <table class="table table-sm small mb-0" style="table-layout:fixed; flex-shrink:0;">
                                    <colgroup>
                                        <col style="width:20%"/><col style="width:38%"/>
                                        <col style="width:24%"/><col style="width:18%"/>
                                    </colgroup>
                                    <thead>
                                        <tr class="text-muted o_sortable_header">
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('name')">Referencia <i t-att-class="sortIcon('name')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('partner')">Proveedor <i t-att-class="sortIcon('partner')"/></th>
                                            <th style="cursor:pointer" t-on-click="() => this.sortBy('date_planned')">Entrega estimada <i t-att-class="sortIcon('date_planned')"/></th>
                                            <th class="text-end" style="cursor:pointer" t-on-click="() => this.sortBy('amount_total')">Total <i t-att-class="sortIcon('amount_total')"/></th>
                                        </tr>
                                    </thead>
                                </table>
                                <div style="flex:1; overflow-y:auto; min-height:0; scrollbar-gutter:stable;">
                                    <table class="table table-sm table-hover small mb-0" style="table-layout:fixed;">
                                        <colgroup>
                                            <col style="width:20%"/><col style="width:38%"/>
                                            <col style="width:24%"/><col style="width:18%"/>
                                        </colgroup>
                                        <tbody>
                                            <t t-foreach="sortedList" t-as="svc" t-key="svc.id">
                                                <tr style="cursor:pointer"
                                                    t-att-data-po-id="svc.id"
                                                    t-on-click="openPoFromRow">
                                                    <td class="fw-semibold" t-esc="svc.name"/>
                                                    <td t-esc="svc.partner"/>
                                                    <td t-esc="svc.date_planned"/>
                                                    <td class="text-end" t-esc="fmtAmt(svc.amount_total)"/>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <!-- Paginación -->
                            <div t-if="totalPages > 1"
                                 class="d-flex align-items-center justify-content-between px-2 py-1 border-top"
                                 style="flex-shrink:0;">
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasPrevPage"
                                        t-on-click="prevPage">
                                    <i class="fa fa-chevron-left"/>
                                </button>
                                <small class="text-muted">
                                    Pág. <t t-esc="state.page"/> / <t t-esc="totalPages"/>
                                    · <t t-esc="fmt(activeCount)"/> registros
                                </small>
                                <button class="btn btn-sm btn-outline-secondary py-0 px-2"
                                        t-att-disabled="!hasNextPage"
                                        t-on-click="nextPage">
                                    <i class="fa fa-chevron-right"/>
                                </button>
                            </div>

                        </div>
                    </div>

                </div>

            </div>

            <!-- Ver todas (fuera del kpiRow para no afectar la alineación) -->
            <div t-if="!isEmpty" class="text-end mt-1">
                <button t-if="!state.listTab &amp;&amp; state.ocFilter === 'overdue'"
                        class="btn btn-sm btn-link text-danger p-0 small"
                        t-on-click="onClickOverdue">Ver todas las vencidas →</button>
                <button t-if="!state.listTab &amp;&amp; state.ocFilter === 'rfqs'"
                        class="btn btn-sm btn-link text-info p-0 small"
                        t-on-click="onClickRfqs">Ver todas las cotizaciones →</button>
                <button t-if="!state.listTab &amp;&amp; state.ocFilter === 'approve'"
                        class="btn btn-sm btn-link text-warning p-0 small"
                        t-on-click="onClickToApprove">Ver todas por aprobar →</button>
                <button t-if="!state.listTab &amp;&amp; state.ocFilter === 'all'"
                        class="btn btn-sm btn-link text-secondary p-0 small"
                        t-on-click="onClickAll">Ver todas las aprobadas →</button>
                <button t-if="!state.listTab &amp;&amp; state.ocFilter === 'pending'"
                        class="btn btn-sm btn-link text-success p-0 small"
                        t-on-click="onClickPending">Ver todas a tiempo →</button>
            </div>
        </div>
    </t>

</templates>
