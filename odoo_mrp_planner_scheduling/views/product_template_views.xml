<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Artículo: pestaña Planificador (centros de trabajo compatibles) ── -->
    <record id="product_template_form_scheduling_workcenters" model="ir.ui.view">
        <field name="name">product.template.form.scheduling.workcenters</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Pestaña de planificación: visible para los usuarios del grupo
                 Programación (sin toggle maestro; el grupo es la única fuente de verdad). -->
            <xpath expr="//notebook" position="inside">
                <page string="Planificación" name="mrp_planner_tab"
                      groups="odoo_mrp_planner_scheduling.group_scheduling">
                    <group>
                        <group string="Abastecimiento">
                            <field name="vulcanizado_id" options="{'no_create': True}"/>
                            <field name="min_per_shift"/>
                            <field name="purchase_product_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Centros de trabajo (máquina preferida)">
                        <field name="x_centros_compatibles" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="workcenter_id" required="1"/>
                                <field name="is_preferred"/>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="exclusion_reason" invisible="active"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
