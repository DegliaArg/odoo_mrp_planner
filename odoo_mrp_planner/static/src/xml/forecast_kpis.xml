<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- KPI cards del widget de forecast (dos filas de 5 cards).
         Llamado desde ForecastWidget dentro de un t-if="state.data". -->
    <t t-name="odoo_mrp_planner.ForecastKpis">

        <!-- Vista alternativa: desglose de entregas físicas por mes de pedido.
             Reemplaza las cards de KPIs al apretar "Ver →" en Entregas físicas;
             "← Volver" restaura los KPIs. -->
        <t t-if="state.delBreakdownOpen">
            <div class="o_planner_fade_in"
                 t-att-style="state.kpiZoneMinHeight ? ('min-height:' + state.kpiZoneMinHeight + 'px') : ''">
            <div class="d-flex align-items-center gap-2 mb-2">
                <button class="btn btn-sm btn-outline-secondary"
                        title="Volver a los indicadores"
                        t-on-click="() => state.delBreakdownOpen = false">
                    <i class="fa fa-arrow-left me-1"/>Volver
                </button>
                <span class="fw-semibold">Entregas físicas por mes de pedido</span>
                <span class="text-muted small"
                      title="Unidades entregadas físicamente en el período (albaranes validados), desglosadas por el mes en que se confirmó el pedido de origen.">
                    <i class="fa fa-info-circle"/>
                </span>
            </div>
            <div class="row row-cols-2 row-cols-md-5 g-2 mb-2">
                <!-- Una card por mes de pedido, mismo estilo que los KPIs -->
                <div class="col" t-foreach="delByOrderMonthRows" t-as="r" t-key="r.key">
                    <div class="card o_planner_card h-100 o_planner_card_clickable"
                         t-att-title="r.key === ''
                             ? 'Salidas validadas sin pedido de venta en el sistema (pedido eliminado, devolución a proveedor o remito manual). Clic para ver los movimientos.'
                             : 'Unidades entregadas en el período de pedidos confirmados en ' + r.label + '. Clic para ver los movimientos.'"
                         t-on-click="() => this.openDrillDeliveredByOrderMonth(r)">
                        <div class="card-body text-center py-3">
                            <i t-att-class="'fa fa-lg mb-2 d-block ' + (r.key === '' ? 'fa-question-circle text-warning' : 'fa-calendar text-info')"/>
                            <div t-att-class="'o_planner_number ' + (r.key === '' ? 'text-warning' : 'text-info')">
                                <t t-esc="fmt(r.qty) + ' Pz'"/>
                            </div>
                            <div class="o_planner_label" t-esc="r.label"/>
                        </div>
                        <div class="card-footer p-0">
                            <button t-att-class="'btn btn-sm btn-link w-100 py-1 ' + (r.key === '' ? 'text-warning' : 'text-info')"
                                    title="Ver los movimientos de salida de este grupo"
                                    t-on-click.stop="() => this.openDrillDeliveredByOrderMonth(r)">Ver →</button>
                        </div>
                    </div>
                </div>
                <!-- Card Total: la sublista completa del período -->
                <div class="col">
                    <div class="card o_planner_card h-100 o_planner_card_clickable border-info"
                         title="Coincide con el KPI Entregas físicas. Clic para ver todos los movimientos del período."
                         t-on-click="openDrillDelivered">
                        <div class="card-body text-center py-3">
                            <i class="fa fa-truck fa-lg text-info mb-2 d-block"/>
                            <div class="o_planner_number text-info fw-bold">
                                <t t-esc="fmt(filteredKpis.total_delivered) + ' Pz'"/>
                            </div>
                            <div class="o_planner_label fw-semibold">Total del período</div>
                        </div>
                        <div class="card-footer p-0">
                            <button class="btn btn-sm btn-link w-100 py-1 text-info"
                                    title="Ver todos los movimientos de salida del período"
                                    t-on-click.stop="openDrillDelivered">Ver →</button>
                        </div>
                    </div>
                </div>
                <div class="col" t-if="!delByOrderMonthRows.length">
                    <div class="text-muted small py-3">Sin entregas físicas en el período seleccionado.</div>
                </div>
            </div>
            </div><!-- /fade + min-height -->
        </t>

        <t t-else="">
        <div t-ref="kpiZone" class="o_planner_fade_in">

        <!-- Fila 1: volúmenes -->
        <div class="row row-cols-2 row-cols-md-5 g-2 mb-2">
            <!-- Card 1: Demanda forecast -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('forecast')"
                     t-on-click="openDrillForecast">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-bar-chart fa-lg text-primary mb-2 d-block"/>
                        <div class="o_planner_number"><t t-esc="fmt(filteredKpis.total_forecast) + ' Pz'"/></div>
                        <div class="o_planner_label">Demanda forecast</div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" t-on-click.stop="openDrillForecast">Ver →</button>
                    </div>
                </div>
            </div>
            <!-- Card 2: Demanda real -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('so_demand')"
                     t-on-click="openDrillSoDemand">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-shopping-cart fa-lg mb-2 d-block" style="color:#7952b3;"/>
                        <div class="o_planner_number" style="color:#7952b3;"><t t-esc="fmt(filteredKpis.total_so_demand) + ' Pz'"/></div>
                        <div class="o_planner_label">Demanda real</div>
                        <div t-if="filteredKpis.so_demand_no_fc > 0"
                             class="text-warning mt-1"
                             style="font-size:10px; line-height:1.3; cursor:pointer;"
                             t-att-title="fmt(filteredKpis.so_demand_no_fc) + ' Pz del total corresponden a artículos SIN línea de forecast (ya incluidas) – clic para ver el detalle'"
                             t-on-click.stop="openDrillSoDemandNoFc">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="fmt(filteredKpis.so_demand_no_fc)"/> sin FC
                        </div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" style="color:#7952b3;" t-on-click.stop="openDrillSoDemand">Ver →</button>
                    </div>
                </div>
            </div>
            <!-- Card 3: Producción planificada -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('mos')"
                     t-on-click="openDrillMos">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-industry fa-lg text-secondary mb-2 d-block"/>
                        <div class="o_planner_number"><t t-esc="fmt(filteredKpis.total_mos) + ' Pz'"/></div>
                        <div class="o_planner_label">Producción planificada</div>
                        <div t-if="filteredKpis.mos_no_fc > 0"
                             class="text-warning mt-1"
                             style="font-size:10px; line-height:1.3; cursor:pointer;"
                             t-att-title="fmt(filteredKpis.mos_no_fc) + ' Pz del total corresponden a artículos SIN línea de forecast (ya incluidas) – clic para ver el detalle'"
                             t-on-click.stop="openDrillMosNoFc">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="fmt(filteredKpis.mos_no_fc)"/> sin FC
                        </div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" t-on-click.stop="openDrillMos">Ver →</button>
                    </div>
                </div>
            </div>
            <!-- Card 4: Entregas Físicas — "Ver →" abre el desglose por mes de
                 pedido (reemplaza los KPIs); la sublista completa se alcanza
                 desde la fila Total del desglose. -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('delivered')"
                     t-on-click="openDelBreakdown">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-truck fa-lg text-info mb-2 d-block"/>
                        <div class="o_planner_number text-info"><t t-esc="fmt(filteredKpis.total_delivered) + ' Pz'"/></div>
                        <div class="o_planner_label">Entregas físicas</div>
                        <div t-if="filteredKpis.delivered_no_fc > 0"
                             class="text-warning mt-1"
                             style="font-size:10px; line-height:1.3; cursor:pointer;"
                             t-att-title="fmt(filteredKpis.delivered_no_fc) + ' Pz del total corresponden a artículos SIN línea de forecast (ya incluidas) – clic para ver el detalle'"
                             t-on-click.stop="openDrillDeliveredNoFc">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="fmt(filteredKpis.delivered_no_fc)"/> sin FC
                        </div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1 text-info"
                                title="Ver el desglose por mes de pedido"
                                t-on-click.stop="openDelBreakdown">Ver →</button>
                    </div>
                </div>
            </div>
            <!-- Card 5: Cumplimiento de demanda -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('demand_delivered')"
                     t-on-click="openDrillDemandDelivered">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-check-circle fa-lg text-success mb-2 d-block"/>
                        <div class="o_planner_number"><t t-esc="fmt(filteredKpis.total_demand_delivered) + ' Pz'"/></div>
                        <div class="o_planner_label">Cumplimiento de demanda</div>
                        <div t-if="filteredKpis.demand_delivered_no_fc > 0"
                             class="text-warning mt-1"
                             style="font-size:10px; line-height:1.3; cursor:pointer;"
                             t-att-title="fmt(filteredKpis.demand_delivered_no_fc) + ' Pz del total corresponden a artículos SIN línea de forecast (ya incluidas) – clic para ver el detalle'"
                             t-on-click.stop="openDrillDemandDeliveredNoFc">
                            <i class="fa fa-exclamation-triangle me-1"/><t t-esc="fmt(filteredKpis.demand_delivered_no_fc)"/> sin FC
                        </div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" t-on-click.stop="openDrillDemandDelivered">Ver →</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fila 2: métricas -->
        <div class="row row-cols-2 row-cols-md-5 g-2 mb-3">
            <!-- Card 1: Precisión forecast -->
            <div class="col">
                <div class="card o_planner_card h-100">
                    <div class="card-body text-center py-3"
                         t-att-title="accGlobalTooltip()">
                        <i class="fa fa-bullseye fa-lg mb-2 d-block text-secondary"/>
                        <div t-att-class="'o_planner_number ' + accClass(filteredKpis.overall_forecast_acc)">
                            <t t-esc="fmtPct(filteredKpis.overall_forecast_acc)"/>
                        </div>
                        <div class="o_planner_label"
                             t-esc="state.data.acc_formula === 'mape' ? 'MAPE' : state.data.acc_formula === 'wape' ? 'WAPE' : state.data.acc_formula === 'wmape' ? 'WMAPE' : state.data.acc_formula === 'bias' ? 'Sesgo forecast' : 'Precisión forecast'"/>
                        <div class="d-flex flex-wrap justify-content-center gap-1 mt-1">
                            <t t-foreach="accSecondaryPills()" t-as="pill" t-key="pill.key">
                                <span class="text-muted border rounded px-1"
                                      style="font-size:0.62rem; line-height:1.4;">
                                    <t t-esc="pill.label"/>: <t t-esc="fmtPct(pill.value)"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Card 2: Brecha demanda vs fc — indicador puro, sin drill (era un
                 duplicado del Ver de "Demanda real" y una brecha no tiene sublista propia) -->
            <div class="col">
                <div class="card o_planner_card h-100"
                     t-att-title="demandGapTooltip()">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                        <i class="fa fa-arrows-h fa-lg mb-2 d-block text-secondary"/>
                        <div t-att-class="'o_planner_number ' + demandGapClass(filteredKpis.demand_gap_pct)">
                            <t t-esc="fmtGapPct(filteredKpis.demand_gap_pct)"/>
                        </div>
                        <div class="o_planner_label">Brecha demanda vs fc.</div>
                    </div>
                    <div class="card-footer p-0 o_planner_footer_spacer">
                        <button class="btn btn-sm btn-link w-100 py-1">·</button>
                    </div>
                </div>
            </div>
            <!-- Card 3: Brecha OF vs fc — indicador puro, sin drill (era un
                 duplicado del Ver de "Producción planificada") -->
            <div class="col">
                <div class="card o_planner_card h-100"
                     t-att-title="mosGapTooltip()">
                    <div class="card-body text-center py-3 d-flex flex-column justify-content-center">
                        <i t-att-class="'fa fa-lg mb-2 d-block ' + (filteredKpis.mos_gap_pct >= 0 ? 'fa-check-circle text-success' : 'fa-exclamation-triangle text-danger')"/>
                        <div t-att-class="'o_planner_number ' + mosGapClass(filteredKpis.mos_gap_pct)">
                            <t t-esc="fmtGapPct(filteredKpis.mos_gap_pct)"/>
                        </div>
                        <div class="o_planner_label">Brecha OF vs fc.</div>
                    </div>
                    <div class="card-footer p-0 o_planner_footer_spacer">
                        <button class="btn btn-sm btn-link w-100 py-1">·</button>
                    </div>
                </div>
            </div>
            <!-- Card 4: Tasa física -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('svc')"
                     t-on-click="openDrillDelivered">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-truck fa-lg mb-2 d-block text-secondary"/>
                        <div t-att-class="'o_planner_number ' + svcClass(filteredKpis.overall_service_rate)">
                            <t t-esc="fmtPct(filteredKpis.overall_service_rate)"/>
                        </div>
                        <div class="o_planner_label">Tasa física</div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" t-on-click.stop="openDrillDelivered">Ver →</button>
                    </div>
                </div>
            </div>
            <!-- Card 5: Tasa de cumplimiento -->
            <div class="col">
                <div class="card o_planner_card h-100 o_planner_card_clickable"
                     t-att-title="fcKpiTooltip('demand_svc')"
                     t-on-click="openDrillDemandDelivered">
                    <div class="card-body text-center py-3">
                        <i class="fa fa-check-circle fa-lg mb-2 d-block text-secondary"/>
                        <div t-att-class="'o_planner_number ' + svcClass(filteredKpis.overall_demand_service_rate)">
                            <t t-esc="fmtPct(filteredKpis.overall_demand_service_rate)"/>
                        </div>
                        <div class="o_planner_label">Tasa de cumplimiento</div>
                    </div>
                    <div class="card-footer p-0">
                        <button class="btn btn-sm btn-link w-100 py-1" t-on-click.stop="openDrillDemandDelivered">Ver →</button>
                    </div>
                </div>
            </div>
        </div>

        </div><!-- /kpiZone -->
        </t><!-- /t-else (cards de KPIs) -->

    </t>

</templates>
