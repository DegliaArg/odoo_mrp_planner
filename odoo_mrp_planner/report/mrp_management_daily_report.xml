<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════════════════════════
         PAPERFORMAT — A4 vertical
    ════════════════════════════════════════════════════════════════════ -->
    <record id="paperformat_management_daily" model="report.paperformat">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">9</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_management_daily" model="ir.actions.report">
        <field name="name">Resumen diario de Gerencia</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_mrp_planner.report_management_daily</field>
        <field name="report_file">odoo_mrp_planner.report_management_daily</field>
        <field name="paperformat_id" ref="paperformat_management_daily"/>
    </record>

    <!-- ════════════════════════════════════════════════════════════════════
         TEMPLATE — Resumen diario (estética Capemi: one-pager ejecutivo con
         membrete de marca, barras proporcionales, badges "Ahora" y pie propio).
         Sin web.external_layout: header/footer propios para controlar el diseño.
    ════════════════════════════════════════════════════════════════════ -->
    <template id="report_management_daily">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="company or o.env.company"/>
                <div class="article o_ignore_layout_styling">

                    <style>
                        .article { color:#24323d;
                                   font-family:"Lato","Helvetica Neue",Arial,sans-serif; }
                        .article td { border:0; }

                        /* ── Membrete ── */
                        table.mg-head { width:100%; border-collapse:collapse; }
                        .mg-brandcell { width:132px; vertical-align:middle; }
                        .mg-brand { border:2px solid #004b88; border-radius:9px;
                                    padding:9px 11px; text-align:center; background:#f4f8fc; }
                        .mg-logo  { max-height:40px; max-width:112px; }
                        .mg-brandtxt { font-size:18px; font-weight:800; color:#004b88;
                                       letter-spacing:1px; }
                        .mg-headmid { vertical-align:middle; padding-left:16px; }
                        .mg-title { font-size:23px; font-weight:700; color:#004b88;
                                    margin:0; letter-spacing:.2px; }
                        .mg-sub   { font-size:11.5px; color:#6b7784; margin:4px 0 0; }
                        .mg-headright { vertical-align:middle; text-align:right;
                                        white-space:nowrap; }
                        .mg-emit-l { font-size:9px; color:#9aa6b1; text-transform:uppercase;
                                     letter-spacing:.6px; }
                        .mg-emit-v { font-size:12.5px; font-weight:700; color:#24323d; margin-top:3px; }
                        .mg-rule  { border:0; border-top:3px solid #004b88; margin:13px 0 22px; }

                        .mg-sec   { font-size:13.5px; font-weight:700; color:#004b88;
                                    text-transform:uppercase; letter-spacing:.6px;
                                    padding-left:9px; border-left:4px solid #004b88;
                                    margin:30px 0 15px; }

                        /* ── KPIs (mismo ancho y misma altura) ── */
                        table.mg-kpis { width:100%; border-collapse:separate;
                                        border-spacing:8px 0; table-layout:fixed; }
                        /* El estilo de card vive en el td: así todas las celdas de la
                           fila comparten altura (uniformes) aunque tengan más líneas. */
                        .mg-kpis > tbody > tr > td { vertical-align:top; width:16.66%;
                                    background:#f6f9fc; border-top:3px solid #004b88;
                                    border-radius:0 0 10px 10px; padding:19px 6px 18px;
                                    text-align:center; }
                        .mg-kpi-v { font-size:17.5px; font-weight:800; line-height:1.1;
                                    white-space:nowrap; }
                        .mg-kpi-l { font-size:8.5px; color:#8a97a3; text-transform:uppercase;
                                    letter-spacing:.5px; margin-top:9px; font-weight:700; }
                        .mg-kpi-d { font-size:8.5px; margin-top:7px; }
                        .mg-kpi-s { font-size:8px; color:#9aa6b1; margin-top:4px; }
                        .mg-up    { color:#1e7e34; } .mg-dn { color:#b45309; } .mg-fl { color:#8a97a3; }

                        /* ── Cajas + bandas ── */
                        table.mg-grid { width:100%; border-collapse:collapse; table-layout:fixed; }
                        table.mg-grid > tbody > tr > td.mg-col { vertical-align:top; padding:0 5px; }
                        .mg-col:first-child { padding-left:0 !important; }
                        .mg-col:last-child  { padding-right:0 !important; }
                        /* Sin overflow:hidden ni radio en el cuerpo: el clip con
                           border-radius deja hairlines en los bordes en Adobe (no en
                           Chrome). Radio solo arriba (caja + banda); cuerpo recto. */
                        .mg-box   { border:1px solid #e6edf3; border-radius:9px 9px 0 0; }
                        .mg-band  { background:#004b88; color:#fff; font-size:11.5px; font-weight:700;
                                    text-transform:uppercase; letter-spacing:.4px; padding:9px 12px;
                                    border-radius:8px 8px 0 0; }
                        .mg-band .mg-tot { float:right; font-weight:700; white-space:nowrap; }
                        .mg-u     { font-size:8px; opacity:.8; }
                        .mg-now   { display:inline-block; background:#eaf1f8; color:#004b88;
                                    font-size:7.5px; font-weight:700; letter-spacing:.5px;
                                    padding:2px 6px; border-radius:8px; margin-left:6px;
                                    vertical-align:middle; }

                        /* ── Tablas ── */
                        table.mg-tbl { width:100%; border-collapse:collapse; font-size:11px;
                                       background:#fff; table-layout:fixed; }
                        table.mg-tbl td { padding:7px 12px; border-bottom:1px solid #eef2f6;
                                          vertical-align:middle; }
                        .mg-colh td { font-size:8.5px; color:#9aa6b1; text-transform:uppercase;
                                      letter-spacing:.5px; font-weight:700; background:#fff;
                                      padding-top:9px; padding-bottom:6px; }
                        .mg-nm    { color:#3d4b57; }
                        .mg-r     { text-align:right; font-weight:700; color:#0f2a43; white-space:nowrap; }
                        .mg-money { color:#004b88; }
                        table.mg-tbl tbody tr:nth-child(even) td { background:#f7fafc; }
                        /* Última fila sin borde inferior: evita la línea doble contra
                           el borde de la caja (se ve en Adobe). */
                        table.mg-tbl tr:last-child td { border-bottom:0; }
                        .mg-oth td { color:#9aa6b1; font-style:italic; }

                        /* ── Barras proporcionales ── */
                        .mg-barcell { padding-left:5px !important; padding-right:5px !important; }
                        .mg-barwrap { background:#e8eef4; border-radius:5px; height:10px;
                                      width:100%; overflow:hidden; }
                        .mg-bar     { background:#4a7fb5; height:10px; border-radius:5px; }

                        .mg-empty { font-size:10.5px; color:#9aa6b1; padding:12px 12px;
                                    background:#fff; font-style:italic; }

                        /* ── Pie ── */
                        .mg-foot  { text-align:center; border-top:1px solid #e6edf3;
                                    margin-top:26px; padding-top:12px; font-size:9px; color:#9aa6b1; }
                        .mg-foot strong { color:#6b7784; }
                    </style>

                    <div class="page">

                        <!-- ══ Membrete ══ -->
                        <table class="mg-head">
                            <tr>
                                <td class="mg-brandcell">
                                    <div class="mg-brand">
                                        <img t-if="rep['brand_logo']" t-att-src="rep['brand_logo']" class="mg-logo"/>
                                        <span t-else="" class="mg-brandtxt" t-out="rep['company_name']"/>
                                    </div>
                                </td>
                                <td class="mg-headmid">
                                    <p class="mg-title">Resumen diario de Gerencia</p>
                                    <p class="mg-sub">
                                        <strong t-out="rep['company_label']"/> · <t t-out="rep['month_label']"/>
                                    </p>
                                </td>
                                <td class="mg-headright">
                                    <div class="mg-emit-l">Emitido</div>
                                    <div class="mg-emit-v" t-out="rep['report_date']"/>
                                </td>
                            </tr>
                        </table>
                        <hr class="mg-rule"/>

                        <!-- ══ KPIs ══ -->
                        <table class="mg-kpis">
                            <tr>
                                <td t-foreach="rep['kpis']" t-as="k" style="width:16.66%;">
                                    <div class="mg-kpi">
                                        <div class="mg-kpi-v" t-attf-style="color:{{k['accent']}};" t-out="k['value']"/>
                                        <div class="mg-kpi-l" t-out="k['label']"/>
                                        <div t-if="k['delta']" t-attf-class="mg-kpi-d {{'mg-up' if k['delta']['dir']=='up' else ('mg-dn' if k['delta']['dir']=='down' else 'mg-fl')}}">
                                            Hoy <t t-out="k['delta']['text']"/>
                                        </div>
                                        <div t-foreach="k['subs']" t-as="s" class="mg-kpi-s" t-out="s"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Por familia: Demanda + Producido (50/50) ══ -->
                        <p class="mg-sec">Por familia</p>
                        <table class="mg-grid">
                            <tr>
                                <td t-foreach="rep['fam_pair']" t-as="f" class="mg-col" style="width:50%;">
                                    <div class="mg-box">
                                        <div class="mg-band"><t t-out="f['title']"/>
                                            <span class="mg-tot"><t t-out="f['total']"/> <span class="mg-u">pz</span></span>
                                        </div>
                                        <table class="mg-tbl">
                                            <colgroup><col style="width:40%;"/><col style="width:34%;"/><col style="width:26%;"/></colgroup>
                                            <tr class="mg-colh"><td t-out="f['col1']"/><td/><td class="mg-r">Piezas</td></tr>
                                            <tr t-foreach="f['rows']" t-as="r">
                                                <td class="mg-nm" t-out="r['name']"/>
                                                <td class="mg-barcell"><div class="mg-barwrap"><div class="mg-bar" t-attf-style="width:{{r['bar']}}%;"/></div></td>
                                                <td class="mg-r" t-out="r['value']"/>
                                            </tr>
                                            <tr t-if="f['others']" class="mg-oth">
                                                <td>Otras familias</td><td/><td class="mg-r" t-out="f['others']"/>
                                            </tr>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Facturado por familia (ancho completo) ══ -->
                        <div class="mg-box" style="margin-top:18px;">
                            <div class="mg-band"><t t-out="rep['fam_invoice']['title']"/>
                                <span class="mg-tot"><t t-out="rep['fam_invoice']['total_pz']"/>
                                    <span class="mg-u">pz</span> · <t t-out="rep['fam_invoice']['total_amount']"/></span>
                            </div>
                            <table class="mg-tbl">
                                <colgroup><col style="width:30%;"/><col style="width:24%;"/><col style="width:19%;"/><col style="width:27%;"/></colgroup>
                                <tr class="mg-colh">
                                    <td t-out="rep['fam_invoice']['col1']"/><td/>
                                    <td class="mg-r">Piezas</td><td class="mg-r">Monto</td>
                                </tr>
                                <tr t-foreach="rep['fam_invoice']['rows']" t-as="r">
                                    <td class="mg-nm" t-out="r['name']"/>
                                    <td class="mg-barcell"><div class="mg-barwrap"><div class="mg-bar" t-attf-style="width:{{r['bar']}}%;"/></div></td>
                                    <td class="mg-r" t-out="r['qty']"/>
                                    <td class="mg-r mg-money" t-out="r['amount']"/>
                                </tr>
                                <tr t-if="rep['fam_invoice']['others']" class="mg-oth">
                                    <td>Otras familias</td><td/>
                                    <td class="mg-r" t-out="rep['fam_invoice']['others']['qty']"/>
                                    <td class="mg-r" t-out="rep['fam_invoice']['others']['amount']"/>
                                </tr>
                            </table>
                        </div>

                        <!-- ══ Movimientos por categoría de venta ══ -->
                        <p class="mg-sec">Movimientos por categoría de venta</p>
                        <table class="mg-grid">
                            <tr>
                                <td t-foreach="rep['movements']" t-as="mv" class="mg-col" style="width:33.33%;">
                                    <div class="mg-box">
                                        <div class="mg-band"><t t-out="mv['title']"/>
                                            <span t-if="mv['now']" class="mg-now">Ahora</span>
                                            <span class="mg-tot"><t t-out="mv['total']"/> <span class="mg-u">pz</span></span>
                                        </div>
                                        <t t-if="mv['configured'] and mv['rows']">
                                            <table class="mg-tbl">
                                                <colgroup><col style="width:36%;"/><col style="width:36%;"/><col style="width:28%;"/></colgroup>
                                                <tr t-foreach="mv['rows']" t-as="r">
                                                    <td class="mg-nm" t-out="r['name']"/>
                                                    <td class="mg-barcell"><div class="mg-barwrap"><div class="mg-bar" t-attf-style="width:{{r['bar']}}%;"/></div></td>
                                                    <td class="mg-r" t-out="r['value']"/>
                                                </tr>
                                            </table>
                                        </t>
                                        <div t-else="" class="mg-empty">
                                            <t t-if="not mv['configured']">Sin tipo de operación configurado.</t>
                                            <t t-else="">Sin movimientos en el período.</t>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ Pie corporativo ══ -->
                        <div class="mg-foot" t-out="rep['footer']"/>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
