<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción servidor para abrir el dashboard (crea una instancia transient fresca) -->
    <record id="action_mrp_planner_dashboard_open" model="ir.actions.server">
        <field name="name">Panel del planificador</field>
        <field name="model_id" ref="model_mrp_planner_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <!-- Vista form del dashboard -->
    <record id="mrp_planner_dashboard_form" model="ir.ui.view">
        <field name="name">mrp.planner.dashboard.form</field>
        <field name="model">mrp.planner.dashboard</field>
        <field name="arch" type="xml">
            <form string="Panel del planificador" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_planner_dashboard">

                        <!-- Encabezado -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h2 class="mb-0 text-primary">Panel del planificador</h2>
                            <button name="action_refresh"
                                    type="object"
                                    string="Actualizar alertas"
                                    class="btn btn-primary"/>
                        </div>

                        <!-- ──────────────────────────────────────────── -->
                        <!-- Sección: Alertas                             -->
                        <!-- ──────────────────────────────────────────── -->
                        <div class="o_planner_section_title">
                            <span class="fw-bold text-uppercase text-muted small">Alertas pendientes</span>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-3">
                            <button name="action_view_all_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-bell">
                                <field name="alert_total" widget="statinfo" string="Total"/>
                            </button>
                            <button name="action_view_critical"
                                    type="object"
                                    class="oe_stat_button o_planner_stat o_planner_critical"
                                    icon="fa-exclamation-circle">
                                <field name="alert_critical" widget="statinfo" string="Críticas"/>
                            </button>
                            <button name="action_view_warning"
                                    type="object"
                                    class="oe_stat_button o_planner_stat o_planner_warning"
                                    icon="fa-exclamation-triangle">
                                <field name="alert_warning" widget="statinfo" string="Avisos"/>
                            </button>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <button name="action_view_mo_delayed_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-clock-o">
                                <field name="alert_mo_delayed" widget="statinfo" string="OFs atrasadas"/>
                            </button>
                            <button name="action_view_po_delayed_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-shopping-cart">
                                <field name="alert_po_delayed" widget="statinfo" string="OCs vencidas"/>
                            </button>
                            <button name="action_view_receipt_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-truck">
                                <field name="alert_receipt_delayed" widget="statinfo" string="Recepciones demoradas"/>
                            </button>
                            <button name="action_view_qty_mismatch_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-balance-scale">
                                <field name="alert_qty_mismatch" widget="statinfo" string="Cant. diferentes"/>
                            </button>
                            <button name="action_view_mo_cancelled_alerts"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-times-circle">
                                <field name="alert_mo_cancelled" widget="statinfo" string="OFs canceladas"/>
                            </button>
                        </div>

                        <hr class="my-4"/>

                        <!-- ──────────────────────────────────────────── -->
                        <!-- Sección: Órdenes de fabricación              -->
                        <!-- ──────────────────────────────────────────── -->
                        <div class="o_planner_section_title">
                            <span class="fw-bold text-uppercase text-muted small">Órdenes de fabricación</span>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <button name="action_view_confirmed_mos"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-check-square-o">
                                <field name="mo_confirmed" widget="statinfo" string="Confirmadas"/>
                            </button>
                            <button name="action_view_in_progress_mos"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-cog">
                                <field name="mo_in_progress" widget="statinfo" string="En progreso"/>
                            </button>
                            <button name="action_view_delayed_mos"
                                    type="object"
                                    class="oe_stat_button o_planner_stat o_planner_critical"
                                    icon="fa-warning">
                                <field name="mo_delayed" widget="statinfo" string="Atrasadas"/>
                            </button>
                            <button name="action_view_reschedule_needed"
                                    type="object"
                                    class="oe_stat_button o_planner_stat o_planner_warning"
                                    icon="fa-refresh">
                                <field name="mo_reschedule_needed" widget="statinfo" string="Para reprogramar"/>
                            </button>
                        </div>

                        <hr class="my-4"/>

                        <!-- ──────────────────────────────────────────── -->
                        <!-- Sección: Órdenes de compra                   -->
                        <!-- ──────────────────────────────────────────── -->
                        <div class="o_planner_section_title">
                            <span class="fw-bold text-uppercase text-muted small">Órdenes de compra</span>
                        </div>

                        <div class="d-flex flex-wrap gap-3 mb-4">
                            <button name="action_view_pending_pos"
                                    type="object"
                                    class="oe_stat_button o_planner_stat"
                                    icon="fa-shopping-bag">
                                <field name="po_pending" widget="statinfo" string="Activas"/>
                            </button>
                            <button name="action_view_overdue_pos"
                                    type="object"
                                    class="oe_stat_button o_planner_stat o_planner_critical"
                                    icon="fa-exclamation">
                                <field name="po_overdue" widget="statinfo" string="Vencidas"/>
                            </button>
                        </div>

                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menú: Panel (primero en el menú Planificador) -->
    <menuitem id="mrp_planner_menu_dashboard"
              name="Panel"
              parent="mrp_planner_menu_root"
              sequence="1"
              action="action_mrp_planner_dashboard_open"/>

</odoo>
