<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="odoo_mrp_planner.SalesChartWidget">
        <div class="o_sales_chart_widget">

            <!-- Fila única de filtros -->
            <div class="d-flex flex-nowrap align-items-center gap-1 mb-3">

                <!-- Período -->
                <div class="btn-group btn-group-sm" role="group">
                    <t t-foreach="[['1m','1m'],['3m','3m'],['6m','6m'],['12m','12m']]"
                       t-as="p" t-key="p[0]">
                        <button t-att-class="'btn ' + (state.period === p[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                t-att-title="'Ventas de los últimos ' + p[1]"
                                style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                t-on-click="() => this.setPeriod(p[0])">
                            <t t-esc="p[1]"/>
                        </button>
                    </t>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Métrica -->
                <div class="btn-group btn-group-sm" role="group">
                    <button t-att-class="'btn ' + (state.metric === 'qty' ? 'btn-info' : 'btn-outline-secondary')"
                            title="Unidades vendidas"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setMetric('qty')">Unid.</button>
                    <button t-att-class="'btn ' + (state.metric === 'amount' ? 'btn-info' : 'btn-outline-secondary')"
                            title="Importe total"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setMetric('amount')">$</button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Top N + Todos -->
                <div class="btn-group btn-group-sm" role="group">
                    <t t-foreach="[10, 20, 50]" t-as="n" t-key="n">
                        <button t-att-class="'btn ' + (state.topN === n ? 'btn-secondary' : 'btn-outline-secondary')"
                                t-att-title="'Top ' + n + ' productos'"
                                style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                t-on-click="() => this.setTopN(n)">
                            T<t t-esc="n"/>
                        </button>
                    </t>
                    <button t-att-class="'btn ' + (state.topN === 0 ? 'btn-secondary' : 'btn-outline-secondary')"
                            title="Todos los productos"
                            style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                            t-on-click="() => this.setTopN(0)">All</button>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Fuente -->
                <div class="btn-group btn-group-sm" role="group">
                    <t t-foreach="[['sales','OVs'],['rfq','Cotiz.'],['all','Ambas'],['deliveries','Entrega']]"
                       t-as="d" t-key="d[0]">
                        <button t-att-class="'btn ' + (state.docType === d[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                t-att-title="d[0] === 'sales' ? 'OVs confirmadas' : d[0] === 'rfq' ? 'Cotizaciones' : d[0] === 'all' ? 'Ambas' : 'Entregas físicas'"
                                style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                t-on-click="() => this.setDocType(d[0])">
                            <t t-esc="d[1]"/>
                        </button>
                    </t>
                </div>

                <div class="vr" style="height:20px;"/>

                <!-- Categoría de venta -->
                <div class="d-flex align-items-center gap-1">
                    <span style="font-size:10px;" class="text-muted fw-semibold">Cat.:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="[['','Todas'],['A','A'],['B','B'],['C','C'],['D','D'],['E','E'],['__none__','—']]"
                           t-as="c" t-key="c[0]">
                            <button t-att-class="'btn ' + (state.saleCategory === c[0] ? 'btn-dark' : 'btn-outline-secondary')"
                                    t-att-title="c[0] === '' ? 'Todas las categorías' : c[0] === '__none__' ? 'Sin categoría' : 'Cat. ' + c[0]"
                                    style="font-size:10px; padding:1px 5px; white-space:nowrap;"
                                    t-on-click="() => this.setSaleCat(c[0])">
                                <t t-esc="c[1]"/>
                            </button>
                        </t>
                    </div>
                </div>

                <!-- Categoría de producto -->
                <div t-if="state.productCategs.length" class="d-flex align-items-center gap-1">
                    <span style="font-size:10px;" class="text-muted fw-semibold">Cat.:</span>
                    <select class="form-select form-select-sm" style="min-width:90px; max-width:130px; font-size:10px;"
                            title="Filtrar por familia de producto"
                            t-on-change="setProductCat">
                        <option value="">Todas</option>
                        <t t-foreach="state.productCategs" t-as="cat" t-key="cat.id">
                            <option t-att-value="cat.id" t-esc="cat.name"/>
                        </t>
                    </select>
                </div>

            </div>

            <!-- Cargando -->
            <div t-if="state.loading" class="text-center text-muted py-5">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <!-- Sin datos -->
            <div t-elif="!state.rows.length" class="text-center text-muted py-5">
                <i class="fa fa-bar-chart fa-3x mb-3 d-block opacity-50"/>
                <span>No hay ventas registradas para los filtros seleccionados.</span>
            </div>

            <!-- Gráficos: torta + barras -->
            <div t-else="" class="d-flex gap-3 align-items-start">

                <!-- Torta — distribución por categoría de venta (1/3) -->
                <div style="flex:1; min-width:0;">
                    <p class="text-center small text-muted fw-semibold mb-1" style="font-size:11px;">
                        Distribución por categoría de venta
                    </p>
                    <div style="position:relative; height:340px;">
                        <canvas t-ref="pieCanvas"/>
                    </div>
                </div>

                <!-- Barras — top N productos (2/3) -->
                <div style="flex:2; min-width:0; position:relative; height:360px;">
                    <canvas t-ref="salesCanvas"/>
                </div>

            </div>

        </div>
    </t>

</templates>
